@using Physiquinator.Core.Models
@using Physiquinator.Core.Formatting
@inject IJSRuntime JS
@inject WorkoutHistoryRepository HistoryRepository
@inject WeightUnitService WeightUnitService
@inject IStringLocalizer<UiText> Loc

<MudDialog Class="plan-exercise-sheet">
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsNew ? Loc["Add exercise"] : Loc["Edit exercise"])</MudText>
    </TitleContent>
    <DialogContent>
        <form @onsubmit="Confirm" @onsubmit:preventDefault class="plan-exercise-sheet__form">
            <MudStack Spacing="3" Class="plan-exercise-sheet__body">
                <MudAutocomplete T="string"
                                 @bind-Value="_name"
                                 id="exercise-sheet-name-input"
                                 Variant="Variant.Filled"
                                 Label="@Loc["Exercise name"]"
                                 Placeholder="@Loc["e.g. Bench press"]"
                                 SearchFunc="SearchExerciseNamesAsync"
                                 CoerceValue="false"
                                 ResetValueOnEmptyText="true"
                                 MaxItems="50"
                                 Dense="false"
                                 autocapitalize="words"
                                 @onfocus="OnExerciseNameFocus" />

            <MudSelect Value="_logType"
                       ValueChanged="OnLogTypeChanged"
                       Variant="Variant.Filled"
                       Label="@Loc["Exercise type"]"
                       Class="mb-2"
                       T="ExerciseLogType">
                <MudSelectItem Value="ExerciseLogType.WeightAndReps">@Loc["Weight & Reps"]</MudSelectItem>
                <MudSelectItem Value="ExerciseLogType.BodyweightReps">@Loc["Bodyweight (Reps)"]</MudSelectItem>
                <MudSelectItem Value="ExerciseLogType.Duration">@Loc["Duration (seconds)"]</MudSelectItem>
            </MudSelect>

            <SetMetricStepper Label="@Loc["Sets"]"
                              @bind-Value="_setCount"
                              Step="1"
                              Min="1"
                              IsInteger="true"
                              Format="0"
                              InputMode="numeric" />
            <SetMetricStepper Label="@Loc["Warm-up sets"]"
                              @bind-Value="_warmupSetCount"
                              Step="1"
                              Min="0"
                              Max="20"
                              IsInteger="true"
                              Format="0"
                              InputMode="numeric" />
            <SetMetricStepper Label="@Loc["Rest (seconds)"]"
                              @bind-Value="_restSeconds"
                              Step="5"
                              Min="0"
                              IsInteger="true"
                              Format="0"
                              InputMode="numeric" />

            <MudSelect T="string"
                       Value="_supersetGroupId"
                       ValueChanged="OnSupersetGroupChanged"
                       Variant="Variant.Filled"
                       Label="@Loc["Superset group"]"
                       Class="mb-2"
                       HelperText="@Loc["Exercises in the same group are logged back-to-back without rest."]">
                <MudSelectItem Value="@string.Empty">@Loc["None"]</MudSelectItem>
                <MudSelectItem Value="@("A")">A</MudSelectItem>
                <MudSelectItem Value="@("B")">B</MudSelectItem>
                <MudSelectItem Value="@("C")">C</MudSelectItem>
                <MudSelectItem Value="@("D")">D</MudSelectItem>
            </MudSelect>
            <SetMetricStepper @key="@($"reps-stepper-{_logType}")"
                              Label="@(_logType == ExerciseLogType.Duration ? Loc["Default duration (seconds)"] : Loc["Default reps"])"
                              @bind-Value="_defaultReps"
                              Step="1"
                              Min="0"
                              IsInteger="true"
                              Format="0"
                              InputMode="numeric" />
            
            @if (_logType != ExerciseLogType.Duration)
            {
                <SetMetricStepper @key="@($"weight-stepper-{_logType}")"
                                  Label="@DefaultWeightLabel"
                                  Value="@DefaultWeightDisplay"
                                  ValueChanged="OnDefaultWeightChanged"
                                  Step="@DefaultWeightStep"
                                  Min="@DefaultWeightMin"
                                  Format="0.#"
                                  InputMode="decimal" />
            }

                <div class="plan-exercise-sheet__footer">
                    <MudButton Variant="Variant.Text"
                               FullWidth="true"
                               OnClick="Cancel">
                        @Loc["Cancel"]
                    </MudButton>
                    <MudButton Color="Color.Primary"
                               Variant="Variant.Filled"
                               FullWidth="true"
                               ButtonType="ButtonType.Submit"
                               Disabled="@ConfirmDisabled">
                        @Loc["Save exercise"]
                    </MudButton>
                </div>
            </MudStack>
        </form>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public ExercisePlan Exercise { get; set; } = new();

    [Parameter]
    public bool IsNew { get; set; }

    private string _name = "";
    private double? _setCount;
    private double? _warmupSetCount;
    private double? _restSeconds;
    private double? _defaultReps;
    private double? _defaultWeightKg;
    private ExerciseLogType _logType = ExerciseLogType.WeightAndReps;
    private string _supersetGroupId = "";
    private List<string> _exerciseNames = [];

    private bool ConfirmDisabled => string.IsNullOrWhiteSpace(_name);

    private string DefaultWeightLabel =>
        _logType == ExerciseLogType.BodyweightReps
            ? Loc["Default weight offset ({0})", ExerciseWeightFormatter.UnitSuffix(WeightUnitService.Current)]
            : Loc["Default weight ({0})", ExerciseWeightFormatter.UnitSuffix(WeightUnitService.Current)];

    private double? DefaultWeightDisplay =>
        _defaultWeightKg is { } kg
            ? ExerciseWeightFormatter.ToDisplay(kg, WeightUnitService.Current)
            : null;

    private double DefaultWeightStep => WeightUnitService.Current == WeightUnit.Pounds ? 5 : 2.5;

    private double DefaultWeightMin => _logType == ExerciseLogType.BodyweightReps
        ? ExerciseWeightFormatter.ToDisplay(-200, WeightUnitService.Current)
        : 0;

    private void OnDefaultWeightChanged(double? displayValue) =>
        _defaultWeightKg = displayValue.HasValue
            ? ExerciseWeightFormatter.ToKg(displayValue.Value, WeightUnitService.Current)
            : null;

    private void OnSupersetGroupChanged(string groupId)
    {
        _supersetGroupId = groupId;
    }

    protected override async Task OnInitializedAsync()
    {
        _name = Exercise.Name;
        _setCount = Exercise.SetCount;
        _warmupSetCount = Exercise.WarmupSetCount;
        _restSeconds = Exercise.RestIntervalSeconds;
        _defaultReps = Exercise.DefaultReps;
        _defaultWeightKg = Exercise.DefaultWeightKg;
        _logType = Exercise.LogType;
        _supersetGroupId = Exercise.SupersetGroupId ?? "";
        _exerciseNames = [.. await HistoryRepository.GetExerciseNamesAsync(100)];
    }

    private Task<IEnumerable<string>> SearchExerciseNamesAsync(string? text, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(text))
            return Task.FromResult<IEnumerable<string>>(_exerciseNames);

        var query = text.Trim();
        return Task.FromResult<IEnumerable<string>>(
            _exerciseNames.Where(n => n.Contains(query, StringComparison.OrdinalIgnoreCase)));
    }

    private void Cancel() => MudDialog.Cancel();

    private void Confirm()
    {
        if (ConfirmDisabled)
            return;

        var updated = new ExercisePlan
        {
            Id = Exercise.Id,
            Name = _name.Trim(),
            SetCount = Math.Max(1, (int)Math.Round(_setCount ?? 1)),
            WarmupSetCount = Math.Clamp((int)Math.Round(_warmupSetCount ?? 0), 0, 20),
            SupersetGroupId = string.IsNullOrWhiteSpace(_supersetGroupId) ? null : _supersetGroupId,
            RestIntervalSeconds = Math.Max(0, (int)Math.Round(_restSeconds ?? 0)),
            Order = Exercise.Order,
            DefaultReps = _defaultReps.HasValue ? (int)Math.Round(_defaultReps.Value) : null,
            DefaultWeightKg = _logType == ExerciseLogType.Duration ? null : _defaultWeightKg,
            LogType = _logType
        };

        MudDialog.Close(DialogResult.Ok(updated));
    }

    private async Task OnLogTypeChanged(ExerciseLogType type)
    {
        // Add a small delay to allow event propagation to finish
        // and popovers to close before structural changes occur.
        await Task.Delay(50);
        _logType = type;
        StateHasChanged();
    }

    private async Task OnExerciseNameFocus()
    {
        try
        {
            await JS.InvokeVoidAsync("physiquinator.scrollSelectorIntoView", "#exercise-sheet-name-input");
        }
        catch (Exception)
        {
            // JS interop might not be ready or fail during initialization/disposal.
        }
    }
}