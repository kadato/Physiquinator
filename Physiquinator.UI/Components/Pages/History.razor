@page "/history"
@using System.Globalization
@using MudBlazor.Charts
@inject WorkoutHistoryRepository HistoryRepo
@inject NavigationManager Navigation
@inject WorkoutStatsService StatsService
@inject WorkoutScheduleService ScheduleService
@inject UserProfileService UserProfileService
@inject ISnackbar Snackbar
<MudStack Spacing="3">
    <PageHeader Title="Workout history" ShowBack="false" />
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        Tap a day on the grid to filter the list. Each square is one calendar day; weeks run Monday–Sunday.
    </MudText>

    @if (_sessions == null || _activityByDay == null || _listSessions == null || _summary == null)
    {
        <LoadingCenter Label="Loading history…" />
    }
    else
    {
        <MudTextField T="string"
                      Value="_searchText"
                      ValueChanged="OnSearchTextChanged"
                      Placeholder="Search by plan name..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true"
                      Variant="Variant.Outlined"
                      Class="mb-2" />

        <MudPaper Class="pa-4 history-heatmap-panel" Elevation="1">
            <ActivityHeatmap CountsByDay="_activityByDay"
                             Weeks="@HeatmapWeeks"
                             EndLocal="@_heatmapEndLocal"
                             Schedule="@_schedule"
                             SelectedDay="_selectedDay"
                             SelectedDayChanged="OnSelectedDayChanged" />
        </MudPaper>

        <div class="history-stats">
            <MudPaper Class="history-stat" Elevation="0">
                <span class="history-stat__value">@_summary.CurrentStreakWorkoutDays</span>
                <span class="history-stat__label">Streak</span>
            </MudPaper>
            <MudPaper Class="history-stat" Elevation="0">
                <span class="history-stat__value">@_summary.LongestStreakWorkoutDays</span>
                <span class="history-stat__label">Longest streak</span>
            </MudPaper>
            <MudPaper Class="history-stat" Elevation="0">
                <span class="history-stat__value">@_summary.ThisWeekSessionCount</span>
                <span class="history-stat__label">This week</span>
            </MudPaper>
            <MudPaper Class="history-stat" Elevation="0">
                <span class="history-stat__value">@_summary.LastWeekSessionCount</span>
                <span class="history-stat__label">Last week</span>
            </MudPaper>
        </div>

        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            @if (_schedule is { Count: > 0 })
            {
                <text>A streak day is any scheduled training day with at least one logged session. Rest days never break it; skipped training days do.</text>
            }
            else
            {
                <text>A streak day is any calendar day with at least one logged session.</text>
            }
        </MudText>

        <MudPaper Class="pa-3 bodyweight-panel" Elevation="1">
            <div class="bodyweight-panel__header">
                <MudText Typo="Typo.h6">Bodyweight</MudText>
                @if (_latestBodyweight is { } latest)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                        @ExerciseWeightFormatter.FormatKg(latest.BodyweightKg) kg · @UiDateFormats.DateOnlyCompact(latest.DateOnly)
                    </MudChip>
                }
            </div>

            @if (_bodyweightSeries.Count >= 2)
            {
                <div class="bodyweight-chart">
                    <MudChart T="double"
                              ChartType="ChartType.Line"
                              ChartSeries="@_bodyweightSeries"
                              ChartLabels="@_bodyweightLabels"
                              ChartOptions="@_bodyweightChartOptions"
                              Width="100%"
                              Height="240px" />
                </div>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                    Log your weight each day to see the trend here.
                </MudText>
            }

            <div class="bodyweight-log-row">
                <SetMetricStepper Value="@_bodyweightInput"
                                  ValueChanged="OnBodyweightInputChanged"
                                  Step="0.5"
                                  Min="1"
                                  Max="500"
                                  IsInteger="false"
                                  Format="0.##"
                                  Compact="true"
                                  Unit="kg"
                                  Placeholder="@_bodyweightDefault" />
                <button type="button"
                        class="bodyweight-log-row__log-btn"
                        @onclick="LogBodyweightAsync"
                        disabled="@(!CanLogBodyweight)">
                    <MudIcon Icon="@Icons.Material.Filled.MonitorWeight" Size="Size.Small" />
                    Log
                </button>
            </div>

            @if (_bodyweightEntries.Count > 0)
            {
                <div class="bodyweight-entries">
                    @foreach (var e in _bodyweightEntries)
                    {
                        <div class="bodyweight-entry">
                            <span class="bodyweight-entry__date">@UiDateFormats.DateOnlyCompact(e.DateOnly)</span>
                            <span class="bodyweight-entry__value">@ExerciseWeightFormatter.FormatKg(e.BodyweightKg) kg</span>
                            <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           Class="bodyweight-entry__delete"
                                           aria-label="Delete entry"
                                           OnClick="@(() => DeleteBodyweightAsync(e))" />
                        </div>
                    }
                </div>
            }
        </MudPaper>

        @if (_selectedDay != null)
        {
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudChip T="string" Color="Color.Primary" OnClose="ClearDayFilter">
                    @UiDateFormats.DateOnlyCompact(_selectedDay.Value)
                </MudChip>
                @if (!_listSessions.Any())
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">— none logged.</MudText>
                }
            </MudStack>
        }

        @if (!_sessions.Any())
        {
            <EmptyState Message="No logged workouts yet. Start a plan from home."
                        Icon="@Icons.Material.Outlined.History" />
        }
        else if (!_listSessions.Any() && _selectedDay != null)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Pick another day or clear the filter.
            </MudText>
        }
        else
        {
            <div class="history-session-list">
                @foreach (var s in _listSessions)
                {
                    var sid = s.Id;
                    <div @key="s.Id" class="history-session-card" @onclick="@(() => OpenSession(sid))">
                        <div class="history-session-card__inner">
                            <div class="history-session-card__left">
                                <div class="history-session-card__info">
                                    <span class="history-session-card__title">@s.PlanName</span>
                                    <span class="history-session-card__subtitle">
                                        @UiDateFormats.LocalDateTimeCompact(s.StartedAtUtc)
                                        @if (s.EndedAtUtc != null)
                                        {
                                            <span> · @UiDateFormats.LocalDateTimeCompact(s.EndedAtUtc.Value)</span>
                                        }
                                        else
                                        {
                                            <span class="history-session-card__badge-inprogress">In progress</span>
                                        }
                                    </span>
                                </div>
                            </div>
                            <div class="history-session-card__right">
                                @if (s.EndedAtUtc == null && s.TryGetPlanId() is { } continuePlanId)
                                {
                                    <div @onclick:stopPropagation="true">
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Class="history-session-card__continue-btn"
                                                   OnClick="@(() => ContinueWorkout(continuePlanId))">
                                            Continue
                                        </MudButton>
                                    </div>
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="history-session-card__chevron" />
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</MudStack>

@code {
    private const int HeatmapWeeks = 53;
    private const int BodyweightEntryLimit = 90;

    private sealed record BodyweightEntry(DateOnly DateOnly, double BodyweightKg);

    private IReadOnlyList<WorkoutSessionLogEntity>? _sessions;
    private IReadOnlyList<WorkoutSessionLogEntity>? _listSessions;
    private IReadOnlyList<WorkoutSessionLogEntity>? _daySessions;
    private IReadOnlyDictionary<DateOnly, int>? _activityByDay;
    private IReadOnlySet<DayOfWeek>? _schedule;
    private DateOnly _heatmapEndLocal;
    private WorkoutDaySummary? _summary;
    private DateOnly? _selectedDay;
    private string _searchText = "";

    private List<BodyweightEntry> _bodyweightEntries = [];
    private BodyweightEntry? _latestBodyweight;
    private double? _bodyweightInput;
    private double? _bodyweightDefault;
    private string[] _bodyweightLabels = Array.Empty<string>();
    private sealed class BodyweightSeriesList : List<ChartSeries<double>> { }
    private BodyweightSeriesList _bodyweightSeries = [];
    private LineChartOptions _bodyweightChartOptions = new();

    private void OpenSession(string sessionId) =>
        Navigation.NavigateTo(AppRoutes.HistorySession(sessionId));

    private void ContinueWorkout(Guid planId) =>
        Navigation.NavigateTo(AppRoutes.Workout(planId));

    protected override async Task OnInitializedAsync()
    {
        _heatmapEndLocal = DateOnly.FromDateTime(DateTime.Today);
        _schedule = ScheduleService.IsSet ? ScheduleService.Days : null;

        var statsTask = StatsService.GetSummaryAsync(_heatmapEndLocal, HeatmapWeeks);
        var sessionsTask = HistoryRepo.GetRecentSessionsAsync(100);
        var bodyweightTask = HistoryRepo.GetBodyweightLogsAsync(BodyweightEntryLimit);
        await Task.WhenAll(sessionsTask, statsTask, bodyweightTask);

        _sessions = await sessionsTask;
        (_summary, _activityByDay) = await statsTask;
        MapBodyweightEntries(await bodyweightTask);
        _bodyweightInput = _latestBodyweight?.BodyweightKg
            ?? UserProfileService.GetActiveProfile()?.BodyweightKg;
        _bodyweightDefault = _bodyweightInput;
        await UpdateSessionsListAsync();
    }

    private void MapBodyweightEntries(IReadOnlyList<BodyweightLogEntity> rows)
    {
        _bodyweightEntries = [.. rows
            .Where(r => DateOnly.TryParseExact(
                r.Date, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out _))
            .Select(r => new BodyweightEntry(
                DateOnly.ParseExact(r.Date, "yyyy-MM-dd", CultureInfo.InvariantCulture),
                r.BodyweightKg))];
        _latestBodyweight = _bodyweightEntries.FirstOrDefault();
        BuildBodyweightChart();
    }

    private async Task RefreshBodyweightAsync()
    {
        MapBodyweightEntries(await HistoryRepo.GetBodyweightLogsAsync(BodyweightEntryLimit));
    }

    private void BuildBodyweightChart()
    {
        var chronological = _bodyweightEntries.AsEnumerable().Reverse().ToList();
        _bodyweightLabels = chronological
            .Select(e => UiDateFormats.DateOnlyCompact(e.DateOnly))
            .ToArray();
        _bodyweightSeries = [ new ChartSeries<double>
        {
            Name = "Bodyweight",
            Data = chronological.Select(e => e.BodyweightKg).ToArray()
        } ];

        var values = chronological.Select(e => e.BodyweightKg).ToList();
        var maxValue = values.Count > 0 ? values.Max() : 0;
        _bodyweightChartOptions = new LineChartOptions
        {
            YAxisRequireZeroPoint = false,
            ShowDataMarkers = true,
            MaxNumYAxisTicks = 5,
            YAxisToStringFunc = value => value.ToString("0.#", CultureInfo.InvariantCulture),
            YAxisSuggestedMax = maxValue > 0 ? ChartAxisScale.SuggestYAxisMax(maxValue) : null,
            XAxisLabelRotation = chronological.Count > 6 ? -35 : 0
        };
    }

    private bool CanLogBodyweight => _bodyweightInput is { } weight && weight > 0;

    private void OnBodyweightInputChanged(double? value) => _bodyweightInput = value;

    private async Task LogBodyweightAsync()
    {
        if (!CanLogBodyweight) return;

        var kg = _bodyweightInput!.Value;
        var today = DateOnly.FromDateTime(DateTime.Today);
        await HistoryRepo.UpsertBodyweightLogAsync(today, kg);

        var profile = UserProfileService.GetActiveProfile();
        if (profile != null)
        {
            UserProfileService.UpdateBodyweight(profile.Id, kg);
        }

        _bodyweightDefault = kg;
        await RefreshBodyweightAsync();
        Snackbar.Add("Bodyweight logged.", Severity.Success);
    }

    private async Task DeleteBodyweightAsync(BodyweightEntry entry)
    {
        await HistoryRepo.DeleteBodyweightLogAsync(entry.DateOnly);
        await RefreshBodyweightAsync();
        Snackbar.Add("Entry removed.", Severity.Info);
    }

    private async Task UpdateSessionsListAsync()
    {
        if (_sessions == null) return;

        IEnumerable<WorkoutSessionLogEntity> source;
        if (_selectedDay == null)
        {
            source = _sessions;
        }
        else
        {
            if (_daySessions == null)
            {
                _daySessions = await HistoryRepo.GetSessionsForLocalDayAsync(_selectedDay.Value);
            }
            source = _daySessions;
        }

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var query = _searchText.Trim();
            source = source.Where(s => s.PlanName.Contains(query, StringComparison.OrdinalIgnoreCase));
        }

        _listSessions = source.ToList();
    }

    private async Task OnSearchTextChanged(string text)
    {
        _searchText = text;
        await UpdateSessionsListAsync();
    }
 
    private async Task OnSelectedDayChanged(DateOnly? day)
    {
        _selectedDay = day;
        _daySessions = null;
        await UpdateSessionsListAsync();
    }
 
    private Task ClearDayFilter() => OnSelectedDayChanged(null);
}
