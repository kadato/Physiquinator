@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.Extensions.Logging
@using Physiquinator.Core.Services
@inject ThemeService ThemeService
@inject AppInitializationService AppInit
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject IAppUpdateService AppUpdateService
@inject AppUpdateSettingsService AppUpdateSettings
@inject WorkoutSessionService SessionService
@inject ILogger<MainLayout> Logger
@inject IJSRuntime JSRuntime

@{
    var appShellClasses = "app-shell" +
        (_showBottomNav ? string.Empty : " app-shell--immersive") +
        (_useFixedDockPadding ? " app-shell--fixed-dock" : string.Empty);
}

<MudThemeProvider Theme="PhysiquinatorThemes.Default" @bind-IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<!-- THESIS: A workout is a meet. Every set is an attempt declared, loaded, judged. Category ships dark gym photo + neon halo; we refuse image-as-atmosphere and give the sport's own Operate interface, the attempt board. -->
<!-- OWN-WORLD: Tokyo Night #1A1B26 / #D5D6DB, ink #C0CAF5 / #1A1B26, hairline 1px muted blue, plate red #F7768E blue #7AA2F7 gold #E0AF68, amber #E0AF68 live, mono tokens 11px 0.14em, 12-col 40px, crosshair + and 8px dot matrix, 0 radius mechanical tiles -->
<!-- STORY: Hybrid daily athlete sweeps the board in seconds: streak, this week, last, 53-week flap heatmap, plan cards as attempt forms. Then logs sets thumb-fast, watches seven-seg rest tick, sees PR as GOOD LIFT -->
<!-- FIRST VIEWPORT: Sticky top rail 56px (PHYSIQUINATOR mono left, REST 01:14 amber center when live, ◯◯● lights right). Below, flap meet card (3 tiles) + flap heatmap micro-tiles, then triplicate plan cards with plate-color load dots + ink START foot -->
<!-- FORM: Split-flap mechanical display + design-annual plate proofs, assigned #6, Tokyo Night palette, raised with zone tonal, hairline-edge, density-tier, damped-needle disciplines -->
<!-- FINISH: unreviewed and undocumented is unfinished. This build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance -->
@if (AppInit.IsReady)
{
    <div class="@appShellClasses">
        <a class="skip-link" href="#main-content" @onclick="OnSkipClicked">@("Skip to content")</a>
        <header class="app-rail">
            <span class="app-rail__mark">PHYSIQUINATOR</span>
            <nav class="app-rail__tabs" aria-label="@("Primary")">
                <NavLink href="@AppRoutes.Home" class="app-nav-tab app-rail-tab" Match="NavLinkMatch.All" ActiveClass="app-nav-tab--active">
                    <span class="app-rail-tab__label">@("Home")</span>
                </NavLink>
                <NavLink href="@AppRoutes.History" class="app-nav-tab app-rail-tab" Match="NavLinkMatch.Prefix" ActiveClass="app-nav-tab--active">
                    <span class="app-rail-tab__label">@("History")</span>
                </NavLink>
                <NavLink href="@AppRoutes.Settings" class="app-nav-tab app-rail-tab" Match="NavLinkMatch.Prefix" ActiveClass="app-nav-tab--active">
                    <span class="app-rail-tab__label">@("Settings")</span>
                </NavLink>
            </nav>
            <span class="app-rail__lights" aria-hidden="true"><i></i><i></i><i></i></span>
        </header>
        <nav class="app-nav-pill" aria-label="@("Main navigation")">
            <div class="app-nav-pill__inner">
                <NavLink href="@AppRoutes.Home" class="app-nav-tab" Match="NavLinkMatch.All" ActiveClass="app-nav-tab--active">
                    <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small" />
                    <span class="app-nav-tab__label">@("Home")</span>
                </NavLink>
                <NavLink href="@AppRoutes.History" class="app-nav-tab" Match="NavLinkMatch.Prefix" ActiveClass="app-nav-tab--active">
                    <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" />
                    <span class="app-nav-tab__label">@("History")</span>
                </NavLink>
                <NavLink href="@AppRoutes.Settings" class="app-nav-tab" Match="NavLinkMatch.Prefix" ActiveClass="app-nav-tab--active">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" />
                    <span class="app-nav-tab__label">@("Settings")</span>
                </NavLink>
            </div>
        </nav>

        <main class="app-main-scroll" id="main-content" tabindex="-1">
            <MudContainer MaxWidth="MaxWidth.Small" Class="pb-4 app-page-container">
                @Body
            </MudContainer>
        </main>

        @if (ShouldShowBackFab())
        {
            <MudIconButton Class="app-fab app-fab--secondary app-fab--bl-1 app-fab--back"
                           Icon="@Icons.Material.Filled.ArrowBack"
                           OnClick="GoBack"
                           aria-label="@("Go back")" />
        }
    </div>
}
else
{
    <SplashScreen ErrorMessage="@_initError"
                  RetryRequested="RetryInitializationAsync" />
}

@code {
    private bool _isDark = true;
    private bool _showBottomNav = true;
    private bool _useFixedDockPadding;
    private string? _initError;
    private bool _updatePromptShown;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await AppInit.EnsureInitializedAsync();
            SyncThemeFromService();
            _ = CheckForUpdatesAndPromptAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "App initialization failed");
            _initError = "Your data failed to load.";
        }
    }

    /// <summary>
    /// Checks for a newer release once per session and shows the update dialog.
    /// Skipped when automatic checking is disabled or a workout is in progress.
    /// </summary>
    private async Task CheckForUpdatesAndPromptAsync()
    {
        if (_updatePromptShown)
            return;

        _updatePromptShown = true;

        if (!AppUpdateSettings.AutoCheckEnabled)
            return;

        try
        {
            UpdateCheckResult result = await AppUpdateService.CheckForUpdatesAsync();
            if (!result.IsUpdateAvailable || result.Latest is null)
                return;

            if (SessionService.CurrentPlan != null)
                return;

            var parameters = new DialogParameters<UpdateDialog>
            {
                { x => x.Release, result.Latest },
                { x => x.DownloadUrl, result.DownloadUrl },
            };

            var options = new DialogOptions
            {
                CloseButton = true,
                CloseOnEscapeKey = true,
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
            };

            await DialogService.ShowAsync<UpdateDialog>("Update available", parameters, options);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Update check failed; skipping update prompt");
        }
    }

    private async Task RetryInitializationAsync()
    {
        _initError = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            await AppInit.ReinitializeAsync();
            SyncThemeFromService();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "App initialization failed on retry");
            _initError = "Your data failed to load.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("physiquinator.initFabAutoHide");
            }
            catch (JSDisconnectedException)
            {
                // Circuit gone. Scroll hiding is cosmetic only.
            }
        }

        UpdateNavigationState();
    }

    protected override void OnInitialized()
    {
        ThemeService.ThemeChanged += OnAppStateChanged;
        AppInit.ProgressChanged += OnAppStateChanged;
        Navigation.LocationChanged += OnLocationChanged;
        SyncThemeFromService();
        UpdateNavigationState();
    }

    private void OnAppStateChanged()
    {
        SyncThemeFromService();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateNavigationState();
        _ = InvokeAsync(StateHasChanged);
    }

    private void SyncThemeFromService() => _isDark = ThemeService.EffectiveTheme == ThemePreference.Dark;

    private void UpdateNavigationState()
    {
        var relativeUri = Navigation.ToBaseRelativePath(Navigation.Uri);
        var path = relativeUri.Split('?')[0].TrimEnd('/');
        _showBottomNav = ShouldShowBottomNav(path);
        _useFixedDockPadding = !_showBottomNav
            ? !path.StartsWith(AppRoutes.WorkoutRoutePrefix, StringComparison.Ordinal)
            : ShouldShowBackFab(path);
    }

    private static bool ShouldShowBottomNav(string path)
    {
        if (path.StartsWith(AppRoutes.WorkoutRoutePrefix, StringComparison.Ordinal)) return false;
        if (path == AppRoutes.PlanRoutePath || path.StartsWith(AppRoutes.PlanRoutePrefix, StringComparison.Ordinal)) return false;
        if (path.StartsWith(AppRoutes.HistoryRoutePrefix, StringComparison.Ordinal)) return false;
        return true;
    }

    private bool ShouldShowBackFab() =>
        ShouldShowBackFab(Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].TrimEnd('/'));

    private static bool ShouldShowBackFab(string path)
    {
        // Root page: nothing to go back to. The nav pill already anchors the app.
        if (path.Length == 0)
            return false;

        // Top-level tab pages: the nav pill is one tap away, so no back FAB.
        if (path == "history" || path == "settings")
            return false;

        // Exclude plan editor route which has its own Close/Cancel and Save FABs
        if (path == AppRoutes.PlanRoutePath || path.StartsWith(AppRoutes.PlanRoutePrefix, StringComparison.Ordinal))
            return false;

        // Exclude the active workout route: leaving is guarded and End/Discard
        // are the page's own controls. A back FAB would bypass the guard.
        if (path.StartsWith(AppRoutes.WorkoutRoutePrefix, StringComparison.Ordinal))
            return false;

        return true;
    }

    private async Task GoBack()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("physiquinatorHelpers.goBackOrHome");
        }
        catch (JSDisconnectedException)
        {
            Navigation.NavigateTo(AppRoutes.Home);
        }
    }

    private async Task OnSkipClicked()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("physiquinator.focusMain");
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone. Nothing to focus.
        }
    }

    public void Dispose()
    {
        ThemeService.ThemeChanged -= OnAppStateChanged;
        AppInit.ProgressChanged -= OnAppStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
