@* Rest countdown panel with add / reset / skip controls. *@
@inject WorkoutSessionService SessionService
@implements IDisposable

<MudPaper Class="@PanelClass" Elevation="0">
    <div class="rest-timer-active">
        <div class="rest-timer-display @(IsRestComplete ? "rest-timer-display--complete" : "")">
            @if (IsRestComplete)
            {
                <div class="rest-timer-complete-content">
                    <span class="rest-timer-complete-icon-box">
                        <MudIcon Icon="@Icons.Material.Filled.AlarmOn"
                                 Class="rest-timer-complete-icon"
                                 aria-hidden="true" />
                    </span>
                    <div class="rest-timer-complete-text">
                        <span class="rest-timer-complete-title" style="font-family:'Chakra Petch','JetBrains Mono',sans-serif !important;">TIME'S UP!</span>
                        <span class="rest-timer-complete-subtitle">READY FOR NEXT SET</span>
                    </div>
                </div>
            }
            else
            {
                @* Ticking digits are aria-hidden. The live region below announces transitions instead of every second.
                   Chakra Petch Bold 700 uses fixed 1ch slots. Each digit has the same advance as a mono font.
                   The timer shows no leading zeros. Its width adapts to the characters it needs. The whole group stays centered. *@
                <div class='rest-timer-digits @DigitsClass' role="timer" aria-hidden="true" style="font-family:'Chakra Petch','JetBrains Mono',sans-serif !important; font-weight:700;">
                    @if (RestSecondsRemaining >= 60)
                    {
                        @foreach (char c in MinutesText)
                        {
                            <span class="rest-timer-unit" aria-hidden="true">@c</span>
                        }
                        <span class="rest-timer-separator" aria-hidden="true">
                            <span class="timer-dot"></span>
                            <span class="timer-dot"></span>
                        </span>
                        <span class="rest-timer-unit" aria-hidden="true">@SecondsTensPadded</span>
                        <span class="rest-timer-unit" aria-hidden="true">@SecondsUnitsPadded</span>
                    }
                    else
                    {
                        @foreach (char c in SecondsText)
                        {
                            <span class="rest-timer-unit" aria-hidden="true">@c</span>
                        }
                    }
                </div>
            }
        </div>

        <span class="rest-timer-live-status"
              aria-live="polite"
              style="position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0">@LiveStatus</span>

        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2" Class="rest-timer-controls">
            <button type="button"
                    class="rest-timer-add-btn"
                    aria-label="@(string.Format("Add {0} seconds of rest", AddRestSeconds))"
                    @onclick="() => OnAddTime.InvokeAsync(AddRestSeconds)">+@AddTimeLabel</button>
            <MudIconButton Icon="@Icons.Material.Filled.Replay"
                           Color="Color.Default"
                           aria-label="@("Reset rest")"
                           OnClick="OnReset"
                           Size="Size.Large" />
            <MudIconButton Icon="@Icons.Material.Filled.SkipNext"
                           Color="Color.Default"
                           aria-label="@("Skip rest")"
                           OnClick="OnSkip"
                           Size="Size.Large" />
        </MudStack>

        <div class="rest-timer-edge-track" aria-hidden="true">
            <div class="rest-timer-edge-fill @EdgeFillClass"></div>
        </div>
    </div>
</MudPaper>

@code {
    private const int ImminentRestThresholdSeconds = 10;
    private const int UrgentRestThresholdSeconds = 5;

    /// <summary>Live seconds that remain. The panel reads them from the session service on each render. It re-renders on its own timer ticks without asking the parent page to re-render.</summary>
    private int RestSecondsRemaining => SessionService.RestSecondsRemaining;

    private string MinutesText => (RestSecondsRemaining / 60).ToString();
    private string SecondsText => (RestSecondsRemaining % 60).ToString();
    private string SecondsTensPadded => (RestSecondsRemaining % 60 / 10).ToString();
    private string SecondsUnitsPadded => (RestSecondsRemaining % 60 % 10).ToString();

    private string? _liveStatus;
    private int _lastActiveDurationSeconds;

    [Parameter, EditorRequired]
    public bool IsRestComplete { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }

    [Parameter]
    public EventCallback OnSkip { get; set; }

    /// <summary>Requests extra rest time in seconds, for example 15 or 30, while the countdown runs.</summary>
    [Parameter]
    public EventCallback<int> OnAddTime { get; set; }

    /// <summary>Seconds added by the + button. The user can change this in Settings.</summary>
    [Parameter]
    public int AddRestSeconds { get; set; } = 30;

    /// <summary>
    /// Re-renders the panel in place so the rest countdown can update each
    /// second without re-rendering the parent page and its exercise cards.
    /// </summary>
    public void Refresh()
    {
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        SessionService.RestStateChanged += OnSessionRestStateChanged;
    }

    public void Dispose()
    {
        SessionService.RestStateChanged -= OnSessionRestStateChanged;
    }

    /// <summary>
    /// One polite screen-reader announcement per rest transition (started,
    /// extended, ended) instead of per-second aria-label churn. The session
    /// only fires <see cref="WorkoutSessionService.RestStateChanged"/> on
    /// material changes, and the digits themselves are aria-hidden.
    /// </summary>
    private void OnSessionRestStateChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            if (!SessionService.IsResting)
                _liveStatus = "Rest ended";
            else if (SessionService.ActiveRestDurationSeconds != _lastActiveDurationSeconds)
                _liveStatus = "Rest started";
            else
                _liveStatus = "Rest time added";
            _lastActiveDurationSeconds = SessionService.ActiveRestDurationSeconds;
            StateHasChanged();
        });
    }

    private string LiveStatus => _liveStatus ?? string.Empty;

    private string PanelClass =>
        IsRestComplete
            ? "rest-timer-panel rest-timer-panel--active rest-timer-panel--complete"
            : "rest-timer-panel rest-timer-panel--active";

    private string DigitsClass
    {
        get
        {
            if (RestSecondsRemaining <= UrgentRestThresholdSeconds)
                return "rest-timer-digits--urgent";
            if (RestSecondsRemaining <= ImminentRestThresholdSeconds)
                return "rest-timer-digits--imminent";
            return "";
        }
    }

    private string EdgeFillClass
    {
        get
        {
            if (RestSecondsRemaining <= UrgentRestThresholdSeconds)
                return "rest-timer-edge-fill--urgent";
            if (RestSecondsRemaining <= ImminentRestThresholdSeconds)
                return "rest-timer-edge-fill--imminent";
            return "";
        }
    }

    private string AddTimeLabel => FormatSeconds(AddRestSeconds);

    private static string FormatSeconds(int seconds)
    {
        if (seconds < 60)
            return $"{seconds}s";
        var m = seconds / 60;
        var s = seconds % 60;
        return $"{m}:{s:D2}";
    }
}
