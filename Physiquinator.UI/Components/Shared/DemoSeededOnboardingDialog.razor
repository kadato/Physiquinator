
<MudDialog>
    <TitleContent>
        <div class="d-flex align-items-center gap-3">
            <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h5" Class="fw-bold">@("Welcome to Physiquinator!")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Class="py-2">
            <MudText Typo="Typo.body1" Class="mud-text-secondary">
                @("Sample workout plans (Push, Pull, Legs) and one year of mock history are preloaded in the") <strong>Demo User</strong> @("profile.")
            </MudText>

            <MudPaper Class="pa-4 onboarding-tip" Elevation="0">
                <MudStack Spacing="2">
                    <div class="d-flex align-items-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.GroupAdd" Color="Color.Primary" Size="Size.Medium" />
                        <MudText Typo="Typo.subtitle1" Class="fw-semibold">@("Multi-user profiles")</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @("Create custom profiles in") <strong>@("Settings")</strong>. @("Each profile runs in an isolated local database with separate plans, progress, and history.")
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-4 onboarding-tip onboarding-tip--warning" Elevation="0">
                <MudStack Spacing="2">
                    <div class="d-flex align-items-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.DeleteForever" Color="Color.Warning" Size="Size.Medium" />
                        <MudText Typo="Typo.subtitle1" Class="fw-semibold">@("Removing demo data")</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @("To start fresh, switch to your profile in") <strong>@("Settings")</strong> @("and delete the") <strong>Demo User</strong>.
                    </MudText>
                </MudStack>
            </MudPaper>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close" FullWidth="true" Class="py-2 mt-2">
            @("Get started")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private void Close() => MudDialog.Close();
}
