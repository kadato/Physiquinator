@page "/plan"
@page "/plan/{PlanId:guid}"
@using Microsoft.Extensions.Logging
@inject WorkoutPlanService PlanService
@inject WorkoutHistoryRepository HistoryRepository
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IFileTransferService FileTransfer
@inject TimeProvider TimeProvider
@inject ILogger<PlanWorkout> Logger
@inject IJSRuntime JS
@inject IStringLocalizer<UiText> Loc

<PageTitle>@PageTitleText</PageTitle>

@if (_loading)
{
    <DetailSkeleton />
}
else if (_planNotFound)
{
    <MudAlert Severity="Severity.Error">@Loc["This workout plan was not found."]</MudAlert>
}
else
{
    <div class="plan-page app-fab-page-padding">
    <PageHeader Title="@PageTitleText" ShowBack="false" />

    @if (!IsNew && !string.IsNullOrWhiteSpace(PlanName))
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary plan-page__subtitle mb-3">@PlanName</MudText>
    }

    <MudForm @bind-IsValid="_formValid">
        <MudStack Spacing="3" Class="plan-editor-stack">
            <section class="plan-section">
                <MudText Typo="Typo.overline" Class="plan-section__label">@Loc["Plan details"]</MudText>
                <MudPaper Class="plan-details-card plan-section__card pa-3" Elevation="0">
                    <MudStack Spacing="2">
                        <MudTextField T="string"
                                      Value="PlanName"
                                      ValueChanged="OnPlanNameChanged"
                                      Variant="Variant.Filled"
                                      Label="@Loc["Plan name"]"
                                      Placeholder="@Loc["e.g. Push day"]"
                                      Required="true"
                                      RequiredError="@Loc["Plan name is required"]"
                                      Immediate="true"
                                      autocapitalize="words"
                                      autocomplete="off"
                                      enterkeyhint="done" />
                        <MudGrid Spacing="2" Class="plan-details-card__grid">
                            <MudItem xs="6">
                                <SetMetricStepper Label="@Loc["Default sets"]"
                                                  @bind-Value="DefaultSetCountValue"
                                                  Step="1"
                                                  Min="1"
                                                  IsInteger="true"
                                                  Format="0"
                                                  InputMode="numeric" />
                            </MudItem>
                            <MudItem xs="6">
                                <SetMetricStepper Label="@Loc["Default rest (s)"]"
                                                  @bind-Value="RestIntervalSecondsValue"
                                                  Step="5"
                                                  Min="0"
                                                  IsInteger="true"
                                                  Format="0"
                                                  InputMode="numeric" />
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudPaper>
            </section>

            <section class="plan-section">
                <MudText Typo="Typo.overline" Class="plan-section__label">@Loc["Exercises"]</MudText>

                @if (!Exercises.Any())
                {
                    <EmptyState Message="@Loc["Add your first exercise to build this plan."]"
                                Icon="@Icons.Material.Outlined.FitnessCenter">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="FocusAddExercise">
                            @Loc["Add exercise"]
                        </MudButton>
                    </EmptyState>
                }
                else
                {
                    <PlanExerciseList Exercises="Exercises"
                                      SortableVersion="_sortableVersion"
                                      OnReordered="HandleReordered"
                                      OnEdit="EditExerciseAsync"
                                      OnDelete="ConfirmRemoveExerciseAsync"
                                      OnMoveUp="MoveExerciseUp"
                                      OnMoveDown="MoveExerciseDown" />
                }

                <form @onsubmit="AddExerciseAsync" @onsubmit:preventDefault class="plan-add-exercise">
                    <MudTextField @bind-Value="NewExerciseName"
                                  @ref="_newExerciseField"
                                  id="new-exercise-input"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Placeholder="@Loc["Add exercise…"]"
                                  Class="plan-add-exercise__input"
                                  Immediate="true"
                                  autocapitalize="words"
                                  autocomplete="off"
                                  enterkeyhint="done"
                                  @onfocus="OnAddExerciseFocus" />
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Class="plan-add-exercise__btn"
                               ButtonType="ButtonType.Submit"
                               Disabled="@string.IsNullOrWhiteSpace(NewExerciseName)">
                        @Loc["Add"]
                    </MudButton>
                </form>
            </section>
        </MudStack>
    </MudForm>

    <PlanEditorFooter IsNew="IsNew"
                  SaveDisabled="@SaveDisabled"
                  OnSave="Save"
                  OnCancel="GoHome"
                  OnExport="ExportCurrentPlan" />
    </div>
}

@code {
    [Parameter]
    public Guid? PlanId { get; set; }

    private MudTextField<string>? _newExerciseField;
    private bool _formValid;
    private bool _dirty;
    private bool _planLoadComplete;
    private bool _planNotFound;
    private bool _loading => PlanId.HasValue && !_planLoadComplete;
    private string PlanName { get; set; } = "Workout";
    private int RestIntervalSeconds { get; set; } = 60;
    private int DefaultSetCount { get; set; } = 4;
    private List<ExercisePlan> Exercises { get; set; } = new();
    private string NewExerciseName { get; set; } = "";
    private int _sortableVersion;
    private bool IsNew => PlanId == null;
    private string PageTitleText => IsNew ? Loc["New plan"] : Loc["Edit plan"];

    private bool CanSave => !string.IsNullOrWhiteSpace(PlanName)
        && Exercises.Any()
        && Exercises.All(e => !string.IsNullOrWhiteSpace(e.Name));

    private bool SaveDisabled => !CanSave;

    private double? DefaultSetCountValue
    {
        get => DefaultSetCount;
        set
        {
            DefaultSetCount = Math.Max(1, (int)Math.Round(value ?? 1));
            _dirty = true;
        }
    }

    private double? RestIntervalSecondsValue
    {
        get => RestIntervalSeconds;
        set
        {
            RestIntervalSeconds = Math.Max(0, (int)Math.Round(value ?? 0));
            _dirty = true;
        }
    }

    private void OnPlanNameChanged(string value)
    {
        PlanName = value;
        _dirty = true;
    }

    protected override async Task OnInitializedAsync()
    {
        if (PlanId.HasValue)
        {
            var plan = await PlanService.GetPlanAsync(PlanId.Value);
            if (plan != null)
            {
                PlanName = plan.Name;
                RestIntervalSeconds = plan.RestIntervalSeconds;
                DefaultSetCount = plan.DefaultSetCount;
                Exercises = plan.Exercises.OrderBy(e => e.Order).Select(CloneExercise).ToList();
            }
            else
            {
                _planNotFound = true;
            }
            _planLoadComplete = true;
        }
        _dirty = false;
    }

    private void BumpSortable() => _sortableVersion++;

    private void HandleReordered((int OldIndex, int NewIndex) args)
    {
        var (oldIndex, newIndex) = args;
        if (oldIndex < 0 || newIndex < 0 || oldIndex >= Exercises.Count || newIndex >= Exercises.Count)
            return;

        var item = Exercises[oldIndex];
        Exercises.RemoveAt(oldIndex);
        Exercises.Insert(newIndex, item);
        RenumberExercises();
        BumpSortable();
        _dirty = true;
    }

    private async Task GoHome()
    {
        if (_dirty)
        {
            var confirmed = await DialogService.ConfirmAsync(
                Loc["Discard changes?"],
                Loc["You have unsaved changes to this plan. Leave without saving?"],
                confirmText: Loc["Discard"],
                confirmColor: Color.Error);
            if (!confirmed) return;
        }

        Navigation.NavigateTo(AppRoutes.Home);
    }

    private async Task FocusAddExercise()
    {
        if (_newExerciseField != null)
            await _newExerciseField.FocusAsync();
    }

    private async Task AddExerciseAsync()
    {
        if (string.IsNullOrWhiteSpace(NewExerciseName))
            return;

        var name = NewExerciseName.Trim();
        if (Exercises.Any(e => string.Equals(e.Name, name, StringComparison.OrdinalIgnoreCase)))
        {
            Snackbar.Add(Loc["'{0}' is already in this plan.", name], Severity.Warning);
            return;
        }

        var exercise = new ExercisePlan
        {
            Name = name,
            SetCount = DefaultSetCount,
            Order = Exercises.Count,
            RestIntervalSeconds = RestIntervalSeconds
        };
        NewExerciseName = "";
        BumpSortable();
        await EditExerciseAsync(exercise, isNew: true, insertAtEnd: true);
    }

    private async Task OnAddExerciseFocus()
    {
        try
        {
            await JS.InvokeVoidAsync("physiquinator.scrollSelectorIntoView", "#new-exercise-input");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Scroll to input failed");
        }
    }

    private async Task EditExerciseAsync(int index)
    {
        if (index < 0 || index >= Exercises.Count)
            return;

        await EditExerciseAsync(Exercises[index], isNew: false);
    }

    private async Task EditExerciseAsync(ExercisePlan exercise, bool isNew = false, bool insertAtEnd = false)
    {
        var parameters = new DialogParameters<PlanExerciseSheet>
        {
            { x => x.Exercise, CloneExercise(exercise) },
            { x => x.IsNew, isNew }
        };
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            Position = DialogPosition.BottomCenter,
        };

        var dialog = await DialogService.ShowAsync<PlanExerciseSheet>(
            isNew ? Loc["Add exercise"] : Loc["Edit exercise"],
            parameters,
            options);
        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is ExercisePlan updated)
        {
            var isDuplicate = Exercises.Any(e =>
                e.Id != updated.Id
                && string.Equals(e.Name, updated.Name, StringComparison.OrdinalIgnoreCase));
            if (isDuplicate)
            {
                Snackbar.Add(Loc["'{0}' is already in this plan.", updated.Name], Severity.Warning);
                return;
            }

            if (isNew && insertAtEnd)
                Exercises.Add(updated);
            else
            {
                var idx = Exercises.FindIndex(e => e.Id == exercise.Id);
                if (idx >= 0)
                    Exercises[idx] = updated;
            }

            RenumberExercises();
            BumpSortable();
            _dirty = true;
        }
        else if (isNew && insertAtEnd)
        {
            BumpSortable();
        }
    }

    private static ExercisePlan CloneExercise(ExercisePlan source) => new()
    {
        Id = source.Id,
        Name = source.Name,
        SetCount = source.SetCount,
        WarmupSetCount = source.WarmupSetCount,
        SupersetGroupId = source.SupersetGroupId,
        Order = source.Order,
        RestIntervalSeconds = source.RestIntervalSeconds,
        DefaultReps = source.DefaultReps,
        DefaultWeightKg = source.DefaultWeightKg,
        LogType = source.LogType
    };

    private async Task ConfirmRemoveExerciseAsync(int index)
    {
        if (index < 0 || index >= Exercises.Count)
            return;

        var removed = Exercises[index];
        var name = removed.Name;
        var confirmed = await DialogService.ConfirmAsync(
            Loc["Delete exercise"],
            Loc["Delete '{0}' from this plan?", name],
            confirmText: Loc["Delete"],
            confirmColor: Color.Error);

        if (!confirmed)
            return;

        Exercises.RemoveAt(index);
        RenumberExercises();
        BumpSortable();
        _dirty = true;

        Snackbar.Add(
            Loc["'{0}' removed.", name],
            Severity.Success,
            options =>
            {
                options.Action = Loc["Undo"];
                options.ActionColor = Color.Primary;
                options.RequireInteraction = true;
                options.OnClick = _ => RestoreRemovedExerciseAsync(index, removed);
            });
    }

    private async Task RestoreRemovedExerciseAsync(int index, ExercisePlan exercise)
    {
        Exercises.Insert(Math.Min(index, Exercises.Count), exercise);
        RenumberExercises();
        BumpSortable();
        _dirty = true;
        Snackbar.Add(Loc["'{0}' restored.", exercise.Name], Severity.Success);
        await InvokeAsync(StateHasChanged);
    }

    private void MoveExerciseUp(int index) => HandleReordered((index, index - 1));

    private void MoveExerciseDown(int index) => HandleReordered((index, index + 1));

    private void RenumberExercises()
    {
        for (var i = 0; i < Exercises.Count; i++)
            Exercises[i].Order = i;
    }

    private async Task Save()
    {
        if (!CanSave)
            return;

        var plan = new WorkoutPlan
        {
            Id = PlanId ?? Guid.NewGuid(),
            Name = PlanName.Trim(),
            RestIntervalSeconds = RestIntervalSeconds,
            DefaultSetCount = DefaultSetCount,
            Exercises = Exercises.Select((e, i) => new ExercisePlan
            {
                Id = e.Id,
                Name = e.Name.Trim(),
                SetCount = e.SetCount,
                WarmupSetCount = e.WarmupSetCount,
                SupersetGroupId = e.SupersetGroupId,
                Order = i,
                RestIntervalSeconds = e.RestIntervalSeconds,
                DefaultReps = e.DefaultReps,
                DefaultWeightKg = e.DefaultWeightKg,
                LogType = e.LogType
            }).ToList()
        };
        await PlanService.SavePlanAsync(plan);

        // Update in-progress session snapshot if one exists for this plan
        var openSession = await HistoryRepository.GetInProgressSessionForPlanAsync(plan.Id);
        if (openSession != null)
        {
            var newSnapshot = WorkoutPlanService.SerializePlanToJson(plan);
            await HistoryRepository.UpdateSessionSnapshotAsync(openSession.Id, newSnapshot);
        }

        Snackbar.Add(Loc["Plan saved."], Severity.Success);
        _dirty = false;
        Navigation.NavigateTo(AppRoutes.Home);
    }

    private async Task ExportCurrentPlan()
    {
        if (!PlanId.HasValue)
            return;

        try
        {
            var json = await PlanService.ExportPlanToJsonAsync(PlanId.Value);
            await FileTransfer.ExportJsonAsync(
                FileTransferNames.JsonFileName(FileTransferNames.SafeFileStem(PlanName), TimeProvider.GetLocalNow()),
                json);
            Snackbar.Add(Loc["Plan exported."], Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Loc["Export failed: {0}", ex.Message], Severity.Error);
        }
    }
}
