@using Microsoft.JSInterop
@using Physiquinator.Core.Models
@implements IAsyncDisposable
@inject IJSRuntime JS

<div id="plan-exercise-sortable-list"
     class="plan-exercise-list">
    @foreach (var group in ExerciseGroups)
    {
        if (group.GroupId is not null)
        {
            <div class="plan-exercise-group plan-exercise-group--superset" data-group="@group.GroupId">
                <div class="plan-exercise-group__header">
                    <span>SUPERSET @group.GroupId</span>
                    <span class="plan-exercise-group__count">@group.Items.Count exercises</span>
                </div>
                @foreach (var item in group.Items)
                {
                    var idx = item.OriginalIndex;
                    <PlanExerciseRow Exercise="item.Exercise"
                                     Index="idx"
                                     CanMoveUp="@(idx > 0)"
                                     CanMoveDown="@(idx < Exercises.Count - 1)"
                                     OnMoveUp="@(() => OnMoveUp.InvokeAsync(idx))"
                                     OnMoveDown="@(() => OnMoveDown.InvokeAsync(idx))"
                                     OnEdit="@(() => OnEdit.InvokeAsync(idx))"
                                     OnDelete="@(() => OnDelete.InvokeAsync(idx))" />
                }
            </div>
        }
        else
        {
            var item = group.Items[0];
            var idx = item.OriginalIndex;
            <PlanExerciseRow Exercise="item.Exercise"
                             Index="idx"
                             CanMoveUp="@(idx > 0)"
                             CanMoveDown="@(idx < Exercises.Count - 1)"
                             OnMoveUp="@(() => OnMoveUp.InvokeAsync(idx))"
                             OnMoveDown="@(() => OnMoveDown.InvokeAsync(idx))"
                             OnEdit="@(() => OnEdit.InvokeAsync(idx))"
                             OnDelete="@(() => OnDelete.InvokeAsync(idx))" />
        }
    }
</div>

@code {
    private const string SortableListId = "plan-exercise-sortable-list";

    [Parameter, EditorRequired]
    public IReadOnlyList<ExercisePlan> Exercises { get; set; } = Array.Empty<ExercisePlan>();

    [Parameter]
    public int SortableVersion { get; set; }

    [Parameter]
    public EventCallback<(int OldIndex, int NewIndex)> OnReordered { get; set; }

    [Parameter]
    public EventCallback<int> OnEdit { get; set; }

    [Parameter]
    public EventCallback<int> OnDelete { get; set; }

    [Parameter]
    public EventCallback<int> OnMoveUp { get; set; }

    [Parameter]
    public EventCallback<int> OnMoveDown { get; set; }

    private DotNetObjectReference<PlanExerciseList>? _dotNetRef;
    private int _lastSortableCount = -1;
    private int _lastSortableVersion = -1;
    private bool _sortableReady;

    private IReadOnlyList<ExerciseGroup> ExerciseGroups => BuildGroups();

    private sealed record GroupItem(ExercisePlan Exercise, int OriginalIndex);
    private sealed record ExerciseGroup(string? GroupId, IReadOnlyList<GroupItem> Items);

    private IReadOnlyList<ExerciseGroup> BuildGroups()
    {
        var result = new List<ExerciseGroup>();
        for (var i = 0; i < Exercises.Count;)
        {
            var current = Exercises[i];
            var groupId = current.SupersetGroupId;
            if (!string.IsNullOrEmpty(groupId))
            {
                var items = new List<GroupItem>();
                var j = i;
                while (j < Exercises.Count && string.Equals(Exercises[j].SupersetGroupId, groupId, StringComparison.Ordinal))
                {
                    items.Add(new GroupItem(Exercises[j], j));
                    j++;
                }

                if (items.Count >= 2)
                {
                    result.Add(new ExerciseGroup(groupId, items));
                    i = j;
                    continue;
                }
            }

            result.Add(new ExerciseGroup(null, new[] { new GroupItem(current, i) }));
            i++;
        }

        return result;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Exercises.Count == 0)
        {
            if (_lastSortableCount != 0)
            {
                await DestroySortableAsync();
                _lastSortableCount = 0;
                _lastSortableVersion = SortableVersion;
                _sortableReady = false;
            }
            return;
        }

        var needsInit = !_sortableReady
            || _lastSortableCount != Exercises.Count
            || _lastSortableVersion != SortableVersion
            || firstRender;

        if (!needsInit)
            return;

        var ready = await InitSortableAsync();
        if (ready)
        {
            _sortableReady = true;
            _lastSortableCount = Exercises.Count;
            _lastSortableVersion = SortableVersion;
            return;
        }

        _sortableReady = false;
        await Task.Delay(50);
        ready = await InitSortableAsync();
        if (ready)
        {
            _sortableReady = true;
            _lastSortableCount = Exercises.Count;
            _lastSortableVersion = SortableVersion;
        }
    }

    private async ValueTask<bool> InitSortableAsync()
    {
        _dotNetRef ??= DotNetObjectReference.Create(this);
        return await SortableJsInterop.TryInitAsync(JS, SortableListId, _dotNetRef, "planReorder.init", "planReorder.destroy");
    }

    private async ValueTask DestroySortableAsync() =>
        await SortableJsInterop.DestroyAsync(JS, "planReorder.destroy");

    [JSInvokable]
    public async Task OnExerciseReordered(int oldIndex, int newIndex)
    {
        if (oldIndex < 0 || newIndex < 0 || oldIndex >= Exercises.Count || newIndex >= Exercises.Count)
            return;

        if (oldIndex == newIndex)
            return;

        await OnReordered.InvokeAsync((oldIndex, newIndex));
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        await Physiquinator.UI.Services.JsSafeInvoker.RunSafeAsync(() => DestroySortableAsync().AsTask());

        _dotNetRef?.Dispose();
    }
}
