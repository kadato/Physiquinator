@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using MudBlazor
@using Physiquinator.Core.Services
@using Physiquinator.UI
@implements IDisposable
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject ThemeService ThemeService

<MudThemeProvider Theme="PhysiquinatorThemes.Default" IsDarkMode="_isDark" />
<main class="auth-shell">
    <MudPaper Elevation="6" Class="auth-card">
        <div class="auth-brand">Physiquinator</div>
        <p class="auth-tagline">Workout tracking, on-device AI assistance, and Model Context Protocol agent integration.</p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">@_error</MudAlert>
        }

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Size="Size.Large"
                   Class="mb-4"
                   Disabled="_busy"
                   OnClick="SubmitDemoAsync">
            Explore demo
        </MudButton>

        <MudDivider Class="mb-4" />

        <MudTextField @bind-Value="_username"
                      Label="Username"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mb-4"
                      autocomplete="username"
                      enterkeyhint="next"
                      autocapitalize="off"
                      Disabled="_busy"
                      Immediate="true" />
        <MudTextField @bind-Value="_password"
                      Label="Password"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      InputType="InputType.Password"
                      Class="mb-6"
                      autocomplete="@(_mode == AuthMode.Register ? "new-password" : "current-password")"
                      enterkeyhint="go"
                      Disabled="_busy"
                      Immediate="true"
                      @onkeydown="HandleEnterKey" />

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   FullWidth="true"
                   Disabled="_busy"
                   OnClick="SubmitAsync">
            @(_mode == AuthMode.Login ? "Sign in" : "Register")
        </MudButton>

        <MudButton Variant="Variant.Text"
                   FullWidth="true"
                   Disabled="_busy"
                   OnClick="ToggleModeAsync">
            @(_mode == AuthMode.Login ? "Need an account? Register" : "Already registered? Sign in")
        </MudButton>
    </MudPaper>
</main>

@code {
    private enum AuthMode { Login, Register }

    private AuthMode _mode = AuthMode.Login;
    private string _username = string.Empty;
    private string _password = string.Empty;
    private string? _error;
    private bool _busy;
    private bool _isDark;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // The login page renders outside the app shell, so resolve the
            // browser/system theme here instead of relying on the shell init.
            await ThemeService.EnsureInitializedAsync();
        }
        catch
        {
            // Theme stays at the service default when JS interop is unavailable.
        }

        _isDark = ThemeService.EffectiveTheme == ThemePreference.Dark;
        ThemeService.ThemeChanged += OnThemeChanged;
    }

    private void OnThemeChanged()
    {
        _isDark = ThemeService.EffectiveTheme == ThemePreference.Dark;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.ThemeChanged -= OnThemeChanged;
    }

    private void ToggleModeAsync()
    {
        _mode = _mode == AuthMode.Login ? AuthMode.Register : AuthMode.Login;
        _error = null;
    }

    private async Task HandleEnterKey(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SubmitAsync();
        }
    }

    private async Task SubmitDemoAsync()
    {
        if (_busy)
            return;

        _busy = true;
        _error = null;
        try
        {
            LoginCallResult result = await JSRuntime.InvokeAsync<LoginCallResult>("physiquinatorAuth.demoLogin");
            if (!result.Ok)
            {
                _error = string.IsNullOrWhiteSpace(result.Message)
                    ? "Demo account is unavailable."
                    : result.Message;
                return;
            }

            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch
        {
            _error = "Could not connect to the server.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SubmitAsync()
    {
        if (_busy)
            return;

        _busy = true;
        _error = null;
        try
        {
            var endpoint = _mode == AuthMode.Login ? "login" : "register";
            LoginCallResult result = await JSRuntime.InvokeAsync<LoginCallResult>(
                "physiquinatorAuth.login", endpoint, _username, _password);
            if (!result.Ok)
            {
                _error = string.IsNullOrWhiteSpace(result.Message)
                    ? "Authentication failed."
                    : result.Message;
                return;
            }

            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch
        {
            _error = "Could not connect to the server.";
        }
        finally
        {
            _busy = false;
        }
    }

    // Deserialized from the JS auth call.
    private sealed record LoginCallResult(bool Ok, string Message);
}
