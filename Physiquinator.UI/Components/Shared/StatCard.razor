<MudPaper Class="stat-card" Elevation="0">
    <span @key="@DisplayValue" class="stat-card__value flap-tick @ValueClass">@DisplayValue</span>
    <span class="stat-card__label">@Label</span>
</MudPaper>

@code {
    [Parameter]
    public string Value { get; set; } = "";

    [Parameter]
    public string Label { get; set; } = "";

    [Parameter]
    public string? ValueClass { get; set; }

    // Keep numbers and units grouped so digits never wrap mid-number
    private string DisplayValue => Value;
}
