@page "/"
@using Physiquinator.Core.Formatting
@using Physiquinator.Core.Services
@using Physiquinator.UI.Components.Shared
@implements IAsyncDisposable
@inject WorkoutPlanService PlanService
@inject WorkoutHistoryRepository HistoryRepository
@inject WorkoutSessionService SessionService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject UserProfileService UserProfileService
@inject IDemoSeedPreferences DemoSeedPreferences
@inject IAppPreferences Preferences
@inject IJSRuntime JS
@inject WorkoutStatsService StatsService
@inject IFileTransferService FileTransfer
@inject TimeProvider TimeProvider
@inject WorkoutScheduleService ScheduleService
@inject Physiquinator.Core.Services.Ai.AiAssistantService AiAssistant

<PageTitle>@("Home")</PageTitle>

<MudStack Spacing="3" Class="home-page app-fab-page-padding" aria-busy="@_isLoading">
    <PageHeader Title="Physiquinator" Class="home-header">
        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                       aria-label="Refresh"
                       Disabled="@_isLoading"
                       OnClick="RefreshAsync" />
    </PageHeader>


    @if (_isLoading)
    {
        <HomeSkeleton />
    }
    else
    {
    @if (_inProgressSession != null || _summary != null)
    {
        var hasHero = _inProgressSession != null && _inProgressPlanId != null;
        <section class="home-overview @(hasHero ? "home-overview--with-hero" : "")" aria-label="@("Overview")">
            @if (_inProgressSession != null && _inProgressPlanId is { } heroPlanId)
            {
                <MudPaper Class="home-hero" Elevation="0">
                    <MudStack Spacing="2" Class="home-hero__stack">
                        <div class="home-hero__header">
                            <span class="home-hero__label">
                                <span class="home-hero__dot" aria-hidden="true"></span>
                                @("In progress")
                            </span>
                        </div>
                        <MudText Typo="Typo.h2" Class="home-hero__title">@_inProgressSession.PlanName</MudText>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Class="home-hero__continue"
                                   StartIcon="@Icons.Material.Filled.PlayArrow"
                                   OnClick="@(() => Navigation.NavigateTo(AppRoutes.Workout(heroPlanId)))">
                            @("Continue workout")
                        </MudButton>
                    </MudStack>
                    <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   Class="home-hero__discard"
                                   aria-label="@("Discard workout")"
                                   OnClick="DeleteInProgressWorkoutAsync" />
                </MudPaper>
            }

            @if (_summary != null)
            {
                <div class="home-stats">
                    <StatCard Value="@_summary.CurrentStreakWorkoutDays.ToString()" Label="@("Streak")" />
                    <StatCard Value="@_summary.ThisWeekSessionCount.ToString()" Label="@("This week")" />
                    <StatCard Value="@LastSessionLabel" Label="@("Last workout")" ValueClass="stat-card__value--date" />
                </div>
            }
        </section>
    }

    @if (_summary != null)
    {
        <MudPaper Class="pa-4 home-heatmap-panel" Elevation="0">
            <div class="heatmap-legend" role="note" aria-label="Heatmap legend weeks 01 to 53, today hollow circle, scheduled dashed, missed error hatch"><span>WEEKS 01—53</span><span class="hm-key"><i class="hm-glyph hm-glyph--today"></i>TODAY</span><span class="hm-key"><i class="hm-glyph hm-glyph--scheduled"></i>SCHEDULED</span><span class="hm-key"><i class="hm-glyph hm-glyph--missed"></i>MISSED</span></div>
            <ActivityHeatmap CountsByDay="_activityByDay"
                             Weeks="@HomeStatsWeeks"
                             EndLocal="@_homeHeatmapEndLocal"
                             GetScheduleForDate="ScheduleService.GetScheduleForDate" />
        </MudPaper>
    }

    <section aria-label="@("Your plans")">
        <div class="home-plans-header">
            <div class="home-plans-header__title-group">
                <MudText Typo="Typo.h2" Class="home-plans-header__title">@("Your plans")</MudText>
                @if (_plans != null && _plans.Count > 0)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_plans.Count</MudChip>
                }
            </div>
            <div class="home-plans-header__actions">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add"
                           Class="home-plans-new-btn"
                           OnClick="@(() => Navigation.NavigateTo(AppRoutes.PlanEditor))">
                    @("New plan")
                </MudButton>
            </div>
        </div>

        @if (_plans == null || !_plans.Any())
        {
            <EmptyState Message="@("No plans yet. Create your first workout plan to get started.")"
                        Icon="@Icons.Material.Outlined.FitnessCenter">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(() => Navigation.NavigateTo(AppRoutes.PlanEditor))">
                    @("New plan")
                </MudButton>
            </EmptyState>
        }
        else
        {
            <div id="@HomePlanSortableListId" class="home-plan-list">
                @{
                    var sortedPlans = SortedPlans.ToList();
                }
                @for (var i = 0; i < sortedPlans.Count; i++)
                {
                    var plan = sortedPlans[i];
                    <PlanCard PlanName="@plan.Name"
                              ExerciseCount="@plan.Exercises.Count"
                              LastDoneLabel="@LastDoneLabelFor(plan.Id)"
                              PlanIndex="@(i + 1)"
                              CanMoveUp="@(i > 0)"
                              CanMoveDown="@(i < sortedPlans.Count - 1)"
                              OnMoveUp="@(() => MovePlanAsync(plan.Id, -1))"
                              OnMoveDown="@(() => MovePlanAsync(plan.Id, 1))"
                              OnStart="@(() => StartWorkoutAsync(plan.Id, plan.Name))"
                              OnEdit="@(() => Navigation.NavigateTo(AppRoutes.Plan(plan.Id)))"
                              OnExport="@(() => ExportSinglePlan(plan.Id, plan.Name))"
                              OnDelete="@(() => DeletePlan(plan.Id, plan.Name))" />
                }
            </div>
        }
    </section>
    }
</MudStack>

@if (AiAssistant.GetSettings().Enabled)
{
    <button type="button"
            class="app-fab app-fab--secondary app-fab--br-1"
            aria-label="@("AI assistant")"
            @onclick="OpenAiChatAsync">
        <MudIcon Icon="@Icons.Material.Filled.SmartToy" />
    </button>
}

@code {
    private const int HomeStatsWeeks = 53;
    private const string HomePlanSortableListId = "home-plan-sortable-list";

    private List<WorkoutPlan>? _plans;
    private WorkoutSessionLogEntity? _inProgressSession;
    private Guid? _inProgressPlanId;
    private WorkoutDaySummary? _summary;
    private IReadOnlyDictionary<DateOnly, int> _activityByDay = new Dictionary<DateOnly, int>();
    private IReadOnlyDictionary<string, DateTime> _lastSessionByPlan = new Dictionary<string, DateTime>();
    private WorkoutSessionLogEntity? _lastSession;
    private DateOnly _homeHeatmapEndLocal;
    private bool _isLoading = true;
    private DotNetObjectReference<Home>? _dotNetRef;
    private int _lastSortableCount = -1;
    private bool _sortableReady;

    private string LastSessionLabel =>
        _lastSession == null
            ? "Never"
            : UiDateFormats.DateOnlyCompact(DateOnly.FromDateTime(_lastSession.StartedAtUtc.ToLocalTime()));

    private string LastDoneLabelFor(Guid planId) =>
        _lastSessionByPlan.TryGetValue(planId.ToString(), out var lastUtc)
            ? FormatLastDone(lastUtc)
            : "Never done";

    private static string FormatLastDone(DateTime lastUtc)
    {
        var local = lastUtc.ToLocalTime().Date;
        var days = (DateTime.Today - local).Days;
        if (days <= 0) return "Done today";
        if (days == 1) return "Done yesterday";
        if (days < 7) return string.Format("Done {0} days ago", days);
        return string.Format("Last done {0}", UiDateFormats.LocalDateCompact(lastUtc));
    }

    private List<WorkoutPlan> SortedPlans =>
        _sortedPlans ??= (_plans ?? []).OrderBy(p => p.SortOrder).ThenByDescending(p => p.CreatedAt).ToList();
    private List<WorkoutPlan>? _sortedPlans;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var endLocal = DateOnly.FromDateTime(DateTime.Today);
        _homeHeatmapEndLocal = endLocal;

        var summaryTask = StatsService.GetSummaryAsync(endLocal, HomeStatsWeeks);
        var plansTask = PlanService.GetAllPlansAsync();
        var recentTask = HistoryRepository.GetRecentSessionsAsync(1);
        var inProgressTask = HistoryRepository.GetAnyInProgressSessionAsync();
        var lastDoneTask = HistoryRepository.GetLastSessionDateByPlanAsync();

        await Task.WhenAll(summaryTask, plansTask, recentTask, inProgressTask, lastDoneTask);

        (_summary, _activityByDay) = await summaryTask;
        _plans = await plansTask;
        _sortedPlans = null;
        var recent = await recentTask;
        _lastSession = recent.FirstOrDefault();
        _inProgressSession = await inProgressTask;
        _inProgressPlanId = _inProgressSession?.TryGetPlanId();
        _lastSessionByPlan = await lastDoneTask;
        _isLoading = false;
    }

    private async Task RefreshAsync()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format("Could not refresh: {0}", ex.Message), Severity.Error);
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task StartWorkoutAsync(Guid planId, string planName)
    {
        var open = await HistoryRepository.GetInProgressSessionForPlanAsync(planId);
        if (open != null)
        {
            var continueExisting = await DialogService.ConfirmAsync(
                "Workout in progress",
                string.Format("You have an unfinished session for '{0}'.", planName),
                confirmText: "Continue",
                confirmColor: Color.Primary,
                cancelText: "Start new");

            if (continueExisting)
            {
                Navigation.NavigateTo(AppRoutes.Workout(planId));
                return;
            }

            await HistoryRepository.EndSessionAsync(open.Id);
            await RefreshInProgressAsync();
            Navigation.NavigateTo(AppRoutes.Workout(planId, forceNew: true));
            return;
        }

        var anyOpen = await HistoryRepository.GetAnyInProgressSessionAsync();
        if (anyOpen != null && anyOpen.TryGetPlanId() is { } otherPlanId && otherPlanId != planId)
        {
            var continueOther = await DialogService.ConfirmAsync(
                "Another workout in progress",
                string.Format("You have an unfinished session for '{0}'. Continue that workout?", anyOpen.PlanName),
                confirmText: "Continue",
                confirmColor: Color.Primary,
                cancelText: "Start new");

            if (continueOther)
            {
                Navigation.NavigateTo(AppRoutes.Workout(otherPlanId));
                return;
            }

            await HistoryRepository.EndSessionAsync(anyOpen.Id);
            await RefreshInProgressAsync();
        }

        Navigation.NavigateTo(AppRoutes.Workout(planId));
    }

    private async Task RefreshInProgressAsync()
    {
        _inProgressSession = await HistoryRepository.GetAnyInProgressSessionAsync();
        _inProgressPlanId = _inProgressSession?.TryGetPlanId();
    }

    private async Task DeleteInProgressWorkoutAsync()
    {
        if (_inProgressSession == null) return;

        var planName = _inProgressSession.PlanName;
        var confirmed = await DialogService.ConfirmAsync(
            "Discard workout",
            ConfirmDialogService.DiscardWorkoutMessage(planName),
            confirmText: "Discard",
            cancelText: "Cancel",
            confirmColor: Color.Error);

        if (!confirmed) return;

        await HistoryRepository.DeleteSessionAsync(_inProgressSession.Id);
        SessionService.EndWorkout();
        await RefreshInProgressAsync();
        Snackbar.Add("Workout discarded.", Severity.Success);
    }

    private async Task DeletePlan(Guid planId, string planName)
    {
        var plan = _plans?.FirstOrDefault(p => p.Id == planId);
        var confirmed = await DialogService.ConfirmAsync(
            "Delete plan",
            string.Format("Delete '{0}'? You can undo this for a short time after.", planName),
            confirmText: "Delete",
            confirmColor: Color.Error);

        if (!confirmed)
            return;

        await PlanService.DeletePlanAsync(planId);
        _plans = await PlanService.GetAllPlansAsync();
        _sortedPlans = null;
        Snackbar.Add(
            "Plan deleted.",
            Severity.Success,
            options =>
            {
                options.Action = "Undo";
                options.ActionColor = Color.Primary;
                options.RequireInteraction = true;
                options.OnClick = _ => RestoreDeletedPlanAsync(plan);
            });
    }

    private async Task RestoreDeletedPlanAsync(WorkoutPlan? plan)
    {
        if (plan == null)
            return;

        await PlanService.SavePlanAsync(plan);
        _plans = await PlanService.GetAllPlansAsync();
        _sortedPlans = null;
        Snackbar.Add(string.Format("'{0}' restored.", plan.Name), Severity.Success);
    }

    private async Task ExportSinglePlan(Guid planId, string planName)
    {
        try
        {
            var json = await PlanService.ExportPlanToJsonAsync(planId);
            await FileTransfer.ExportJsonAsync(
                FileTransferNames.JsonFileName(FileTransferNames.SafeFileStem(planName), TimeProvider.GetLocalNow()),
                json);
            Snackbar.Add(string.Format("'{0}' exported.", planName), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format("Export failed: {0}", ex.Message), Severity.Error);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var showModal = DemoSeedPreferences.Get(UserProfileService.ShowFirstTimeSeedModalKey, false);
            if (showModal)
            {
                // Reset the flag immediately to prevent double opens
                DemoSeedPreferences.Set(UserProfileService.ShowFirstTimeSeedModalKey, false);

                var options = new DialogOptions { CloseOnEscapeKey = false, CloseButton = false, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };
                await DialogService.ShowAsync<Shared.DemoSeededOnboardingDialog>("Welcome to Physiquinator!", options);
            }
        }

        if (_plans == null || _plans.Count <= 1)
        {
            if (_lastSortableCount > 0)
            {
                await DestroySortableAsync();
                _lastSortableCount = 0;
                _sortableReady = false;
            }
            return;
        }

        var needsInit = !_sortableReady || _lastSortableCount != _plans.Count || firstRender;
        if (needsInit)
        {
            var ready = await InitSortableAsync();
            if (ready)
            {
                _sortableReady = true;
                _lastSortableCount = _plans.Count;
            }
        }
    }

    private async ValueTask<bool> InitSortableAsync()
    {
        _dotNetRef ??= DotNetObjectReference.Create(this);
        return await SortableJsInterop.TryInitAsync(JS, HomePlanSortableListId, _dotNetRef, "homePlansReorder.init", "homePlansReorder.destroy");
    }

    private async ValueTask DestroySortableAsync() =>
        await SortableJsInterop.DestroyAsync(JS, "homePlansReorder.destroy");

    [JSInvokable]
    public async Task OnPlanReordered(int oldIndex, int newIndex)
    {
        if (_plans == null || oldIndex < 0 || newIndex < 0 || oldIndex >= _plans.Count || newIndex >= _plans.Count)
            return;

        if (oldIndex == newIndex)
            return;

        // Perform local reordering
        var sortedPlans = SortedPlans.ToList();
        var itemToMove = sortedPlans[oldIndex];
        sortedPlans.RemoveAt(oldIndex);
        sortedPlans.Insert(newIndex, itemToMove);

        // Persist the new ordering in a single transaction
        await PlanService.ReorderPlansAsync(sortedPlans.Select(p => p.Id).ToList());

        // Reload plans from DB to make sure they are in sync
        _plans = await PlanService.GetAllPlansAsync();
        _sortedPlans = null;

        await InvokeAsync(StateHasChanged);
    }

    private async Task MovePlanAsync(Guid planId, int direction)
    {
        if (_plans == null || _plans.Count <= 1) return;

        var sorted = SortedPlans.ToList();
        var index = sorted.FindIndex(p => p.Id == planId);
        var target = index + direction;
        if (index < 0 || target < 0 || target >= sorted.Count) return;

        (sorted[index], sorted[target]) = (sorted[target], sorted[index]);

        await PlanService.ReorderPlansAsync(sorted.Select(p => p.Id).ToList());
        _plans = await PlanService.GetAllPlansAsync();
        _sortedPlans = null;
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await DestroySortableAsync();
        }
        catch (JSDisconnectedException)
        {
            // WebView disposed
        }

        _dotNetRef?.Dispose();
    }

    private async Task OpenAiChatAsync()
    {
        var options = new DialogOptions
        {
            CloseButton = false,
            CloseOnEscapeKey = true,
            NoHeader = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };
        await DialogService.ShowAsync<AiChatModal>("Physiquinator AI", options);
    }
}

