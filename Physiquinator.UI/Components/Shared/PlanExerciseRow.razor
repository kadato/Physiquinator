@using Physiquinator.Core.Formatting
@using Physiquinator.Core.Models
@using Physiquinator.Core.Services
@inject IStringLocalizer<UiText> Loc
@inject WeightUnitService WeightUnit

<div class="plan-exercise-row mud-paper mud-elevation-1" @key="Exercise.Id">
    <div class="plan-exercise-row__main">
        <button type="button"
                class="plan-exercise-handle"
                aria-label="@Loc["Drag to reorder {0}", Exercise.Name]">
            <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Medium" />
        </button>

        <button type="button"
                class="plan-exercise-row__body"
                @onclick="OnEdit">
            <span class="plan-exercise-row__index" aria-hidden="true">@DisplayIndex</span>
            <span class="plan-exercise-row__text">
                <span class="plan-exercise-row__name">
                    @Exercise.Name
                    @if (!string.IsNullOrEmpty(Exercise.SupersetGroupId))
                    {
                        <span class="plan-exercise-row__chip plan-exercise-row__chip--superset"
                              aria-label="@Loc["Superset group {0}", Exercise.SupersetGroupId]">@Exercise.SupersetGroupId</span>
                    }
                </span>
                <span class="plan-exercise-row__summary mud-text-secondary">@Summary</span>
            </span>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="plan-exercise-row__chevron" />
        </button>
    </div>

    <div class="plan-exercise-row__actions">
        @if (CanMoveUp || CanMoveDown)
        {
            <MudStack Row="true" Spacing="0" Class="plan-exercise-row__moves">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                               Size="Size.Small"
                               Class="plan-exercise-row__move"
                               Disabled="!CanMoveUp"
                               aria-label="@Loc["Move {0} up", Exercise.Name]"
                               OnClick="MoveUp" />
                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward"
                               Size="Size.Small"
                               Class="plan-exercise-row__move"
                               Disabled="!CanMoveDown"
                               aria-label="@Loc["Move {0} down", Exercise.Name]"
                               OnClick="MoveDown" />
            </MudStack>
        }
        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                       Color="Color.Error"
                       Size="Size.Small"
                       Class="plan-exercise-row__delete"
                       aria-label="@Loc["Delete {0}", Exercise.Name]"
                       OnClick="OnDelete" />
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ExercisePlan Exercise { get; set; }

    [Parameter]
    public int Index { get; set; }

    [Parameter]
    public bool CanMoveUp { get; set; }

    [Parameter]
    public bool CanMoveDown { get; set; }

    [Parameter]
    public EventCallback OnEdit { get; set; }

    [Parameter]
    public EventCallback OnDelete { get; set; }

    [Parameter]
    public EventCallback<int> OnMoveUp { get; set; }

    [Parameter]
    public EventCallback<int> OnMoveDown { get; set; }

    private Task MoveUp() => OnMoveUp.InvokeAsync(Index);

    private Task MoveDown() => OnMoveDown.InvokeAsync(Index);

    private int DisplayIndex => Index + 1;

    private string Summary => FormatSummary(Exercise, WeightUnit.Current, Loc);

    internal static string FormatSummary(ExercisePlan exercise, WeightUnit unit, IStringLocalizer<UiText> loc)
    {
        var parts = new List<string>
        {
            loc["{0} sets", exercise.TotalSetCount]
        };

        if (exercise.WarmupSetCount > 0)
            parts.Add(loc["{0} warm-up", exercise.WarmupSetCount]);

        parts.Add(loc["{0}s rest", exercise.RestIntervalSeconds]);

        if (exercise.DefaultReps.HasValue)
            parts.Add(loc["{0} reps", exercise.DefaultReps]);

        if (exercise.DefaultWeightKg.HasValue)
            parts.Add(loc["{0}", ExerciseWeightFormatter.FormatWeightWithUnit(exercise.DefaultWeightKg.Value, unit)]);

        return string.Join(" · ", parts);
    }
}
