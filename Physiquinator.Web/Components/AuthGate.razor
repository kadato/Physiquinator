@using Microsoft.AspNetCore.Components.Authorization
@using Physiquinator.UI
@using Physiquinator.Web.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject WebUserContext UserContext

@if (_authenticationChecked)
{
    @if (_isAuthenticated)
    {
        <DbSyncHost />
        <Routes />
    }
    else
    {
        <LoginPanel />
    }
}

@code {
    private bool _authenticationChecked;
    private bool _isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAuthenticated = state.User.Identity?.IsAuthenticated == true;
        if (_isAuthenticated)
        {
            // Must run before Routes resolves any app service, so the per-user
            // database path provider knows which account's data to open.
            UserContext.SetFromPrincipal(state.User);
        }
        _authenticationChecked = true;
    }
}
