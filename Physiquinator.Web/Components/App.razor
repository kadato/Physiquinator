@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Rendering
@using Physiquinator.Core
@using Physiquinator.UI

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Physiquinator - Workout Tracking, AI Assistant, and Agent API</title>
    <meta name="description" content="Cross-platform workout tracking with a smart rest timer, progress analytics, an on-device AI assistant, and an MCP agent API." />
    <meta property="og:title" content="Physiquinator" />
    <meta property="og:description" content="Workout tracking with a smart rest timer, progress analytics, and an AI assistant. Try the live demo." />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0E0F17" />
    <base href="/" />
    <script src="js/app-boot.js"></script>
    <style>
        /* Pre-CSS paint colors match the Tokyo Night tokens in app-overrides.css. */
        html[data-theme="dark"] body {
            background-color: #0E0F17 !important;
            color: #C0CAF5;
        }
        html[data-theme="light"] body {
            background-color: #D5D6DB !important;
            color: #1A1B26;
        }
        /* Startup splash: paints from raw HTML before Blazor connects, then
           hides itself as soon as any real content renders into #app. */
        .app-splash {
            position: fixed;
            inset: 0;
            z-index: 3000;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 1.25rem;
            padding: 2rem;
            box-sizing: border-box;
            text-align: center;
            background-color: #0E0F17;
            color: #C0CAF5;
        }
        .app-splash__logo svg {
            width: 11.9rem;
            height: 11.9rem;
        }
        .app-splash__logo svg g {
            fill: #7AA2F7;
        }
        html[data-theme="light"] .app-splash {
            background-color: #D5D6DB;
            color: #1A1B26;
        }
        html[data-theme="light"] .app-splash__logo svg g {
            fill: #24283B;
        }
        #app:has(> :not(.app-splash)) .app-splash {
            display: none;
        }
    </style>
    <link href="_content/MudBlazor/MudBlazor.min.css?v=9.7.0" rel="stylesheet" />
    <link rel="stylesheet" href="_content/Physiquinator.UI/css/app-overrides.css?v=54" />
    <link rel="stylesheet" href="_content/Physiquinator.UI/Physiquinator.UI.bundle.scp.css" />
    <link rel="stylesheet" href="css/web.css" />
    <style>
        html, body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; box-sizing: border-box; }
        body { display: flex; flex-direction: column; }
        #app { display: flex; flex-direction: column; width: 100%; flex: 1 1 0%; min-height: 0; overflow: hidden; }
        .app-shell { display: flex; flex-direction: column; flex: 1; min-height: 0; height: 100%; overflow: hidden; }
        .app-main-scroll { flex: 1 1 auto; min-height: 0; overflow-x: hidden; overflow-y: auto; }
        .app-tab-bar { flex-shrink: 0; }
    </style>
    <link rel="icon" type="image/svg+xml" href="_content/Physiquinator.UI/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="_content/Physiquinator.UI/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="_content/Physiquinator.UI/apple-touch-icon.png" />
</head>

<body>

    <div id="app">
        <output class="app-splash" aria-live="polite" aria-busy="true" aria-label="Loading application">
            <div class="app-splash__logo" aria-hidden="true">
                <svg viewBox="0 0 456 456" xmlns="http://www.w3.org/2000/svg">
                    <g fill="#7AA2F7" transform="translate(60,60) scale(10.5)">
                        <circle cx="16" cy="5.6" r="3.4" />
                        <path d="M12.6,4.6 C12.6,2.3 14.1,1.2 16,1.2 C17.9,1.2 19.4,2.3 19.4,4.6 L19.4,5.6 C19.4,6.6 18.6,7.2 16,7.2 C13.4,7.2 12.6,6.6 12.6,5.6 Z" />
                        <path d="M13.6,10.4 C10,10.5 6.3,11.9 4.2,14.1 C3.3,15.3 3.3,16.4 4.3,17.6 L11.9,26.6 C12.6,27.6 13.4,28.3 14.6,28.9 H17.4 C18.6,28.3 19.4,27.6 20.1,26.6 L27.7,17.6 C28.7,16.4 28.7,15.3 27.8,14.1 C25.7,11.9 22,10.5 18.4,10.4 Z" />
                    </g>
                </svg>
            </div>
        </output>
        <AuthGate @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    </div>

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <button type="button" class="dismiss" aria-label="Dismiss error">🗙</button>
    </div>

    <!-- sortable.min.js and html2canvas.min.js are lazy-loaded on demand -->
    <script src="_content/Physiquinator.UI/js/theme.js"></script>
    <script src="_content/Physiquinator.UI/js/stepperDrag.js"></script>
    <script src="_content/Physiquinator.UI/js/appHelpers.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js?v=9.7.0"></script>
    <script src="js/dbSync.js"></script>
    <script src="js/fileTransfer.js"></script>
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script type="module" src="js/dbSyncBootstrap.js"></script>

    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />

</body>
</html>
