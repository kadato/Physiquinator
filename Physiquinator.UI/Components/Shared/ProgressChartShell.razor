<MudPaper Class="@Class" Elevation="0">
    <div class="progress-chart-header mb-3">
        <span class="section-plate-title">@Title</span>
    </div>
    @if (HasData)
    {
        <div class="progress-chart-plot" role="img" aria-label="@($"{Title} trend chart. Detailed values are listed in the table below.")">
            <div aria-hidden="true">
                @ChildContent
            </div>
        </div>
        <p class="sr-only">@($"{Title} chart. Refer to the data table below for exact values.")</p>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@EmptyMessage</MudText>
    }
</MudPaper>

@code {
    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public bool HasData { get; set; }

    [Parameter]
    public string EmptyMessage { get; set; } = "";

    [Parameter]
    public string Class { get; set; } = "pa-3 exercise-progress-chart";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
