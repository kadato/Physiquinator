@page "/history/exercise-progress/{PlanId:guid}/{ExerciseName}"
@implements IAsyncDisposable
@using System.Globalization
@using MudBlazor.Charts
@inject WorkoutHistoryRepository HistoryRepo
@inject WorkoutPlanService PlanService
@inject NavigationManager Navigation
@inject UserProfileService UserProfileService
@inject IDialogService DialogService
@inject WeightUnitService WeightUnitService
@inject IJSRuntime JS

<PageTitle>@_decodedExerciseName</PageTitle>

<PageHeader Title="@_decodedExerciseName">
    @if (_ready && _rows.Any())
    {
        <MudButton Variant="Variant.Text"
                   Size="Size.Small"
                   Class="premium-btn"
                   StartIcon="@Icons.Material.Filled.EmojiEvents"
                   OnClick="ShowPersonalRecordsAsync">
            @("PRs")
        </MudButton>
    }
</PageHeader>

@if (!_ready)
{
    <DetailSkeleton />
}
else
{
    <MudStack Spacing="3">
        @if (_planMissing)
        {
            <MudAlert Severity="Severity.Warning">
                @("This plan no longer exists, but its logged history is still shown here.")
            </MudAlert>
        }

        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2" Class="exercise-progress-controls">
            @if (_availableExercises.Count > 1)
            {
                <MudSelect T="string"
                           Label="@("Exercise")"
                           Variant="Variant.Outlined"
                           Dense="true"
                           Margin="Margin.Dense"
                           Class="exercise-progress-picker"
                           Value="_decodedExerciseName"
                           ValueChanged="OnExerciseChanged">
                    @foreach (var exName in _availableExercises)
                    {
                        <MudSelectItem Value="@exName">@exName</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudSelect T="ExerciseProgressRange"
                       Label="@("Range")"
                       Variant="Variant.Outlined"
                       Dense="true"
                       Margin="Margin.Dense"
                       AnchorOrigin="Origin.BottomRight"
                       TransformOrigin="Origin.TopRight"
                       Class="exercise-progress-range"
                       Value="_range"
                       ValueChanged="OnRangeChanged">
                <MudSelectItem Value="ExerciseProgressRange.Last10">@("Last 10 sessions")</MudSelectItem>
                <MudSelectItem Value="ExerciseProgressRange.Last30">@("Last 30 sessions")</MudSelectItem>
                <MudSelectItem Value="ExerciseProgressRange.Last60">@("Last 60 sessions")</MudSelectItem>
                <MudSelectItem Value="ExerciseProgressRange.All">@("All sessions")</MudSelectItem>
            </MudSelect>
        </MudStack>

        @if (!_rows.Any())
        {
            <EmptyState Message="@("No sets logged for this exercise on this plan yet.")"
                        Icon="@Icons.Material.Outlined.FitnessCenter" />
        }
        else
        {
            <div class="history-stats">
                <StatCard Value="@FormatSummaryBestValue()" Label="@(_logType == ExerciseLogType.Duration ? "Best time" : "Best weight")" />
                <StatCard Value="@FormatSummaryVolumeValue()" Label="@("Best volume")" />
                <StatCard Value="@FormatSummaryTotalReps()" Label="@("Total reps")" />
            </div>

            @if (MetricOptions.Count > 1)
            {
                <div class="exercise-metric-tabs" role="tablist" aria-label="Metric view">
                    @foreach (var metric in MetricOptions)
                    {
                        <button type="button"
                                role="tab"
                                aria-selected="@(_metric == metric ? "true" : "false")"
                                class="exercise-metric-tab @(_metric == metric ? "exercise-metric-tab--active" : "")"
                                @onclick="@(() => SetMetric(metric))">
                            @MetricLabel(metric)
                        </button>
                    }
                </div>
            }

            <MudPaper Class="pa-3 exercise-progress-chart" Elevation="0">
                <MudText Typo="Typo.h2" Class="settings-card__title mb-2">@GetSeriesName()</MudText>
                @if (_hasChartData)
                {
                    <div class="exercise-progress-chart__plot">
                        <MudChart T="double"
                                  ChartType="ChartType.Line"
                                  ChartSeries="@_chartSeries"
                                  ChartLabels="@_chartLabels"
                                  ChartOptions="@_chartOptions"
                                  Width="100%"
                                  Height="@_chartHeightPx" />
                    </div>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @("Log sets to see the chart.")
                    </MudText>
                }
            </MudPaper>

            <MudPaper Class="premium-table" Elevation="0">
                <div class="infinite-table-list">
                    <div class="infinite-table-head @(_logType == ExerciseLogType.Duration ? "infinite-table-head--4" : "infinite-table-head--5")">
                        <span>@("Date")</span>
                        @if (_logType == ExerciseLogType.Duration)
                        {
                            <span>@("Total time")</span>
                            <span>@("Sets")</span>
                        }
                        else if (_logType == ExerciseLogType.BodyweightReps)
                        {
                            <span>@("Best offset")</span>
                            <span>@("Reps (total)")</span>
                            <span>@("Sets")</span>
                        }
                        else
                        {
                            <span>@(string.Format("{0} (best)", ExerciseWeightFormatter.UnitSuffix(WeightUnitService.Current)))</span>
                            <span>@("Reps (total)")</span>
                            <span>@("Sets")</span>
                        }
                        <span class="infinite-table-head__action" />
                    </div>
                    @foreach (var row in _rows.Take(_loadedListCount))
                    {
                        var item = row;
                        <div @key="item.SessionId" class="infinite-table-row @(_logType == ExerciseLogType.Duration ? "infinite-table-row--4" : "infinite-table-row--5")">
                            <span>@UiDateFormats.LocalDateCompact(item.StartedAtUtc)</span>
                            @if (_logType == ExerciseLogType.Duration)
                            {
                                <span>@(string.Format("{0}s", item.TotalReps))</span>
                                <span>@item.SetCount</span>
                            }
                            else
                            {
                                <span>@FormatBestWeight(item.BestWeightKg)</span>
                                <span>@item.TotalReps</span>
                                <span>@item.SetCount</span>
                            }
                            <span class="infinite-table-row__action">
                                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                               Size="Size.Small"
                                               Variant="Variant.Text"
                                               Class="exercise-progress-table__open premium-btn"
                                               aria-label="@("Open session")"
                                               OnClick="@(() => GoSession(item.SessionId))" />
                            </span>
                        </div>
                    }
                </div>
                @if (_isLoadingMore)
                {
                    <div class="history-infinite-scroll-loading" aria-hidden="true">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                    </div>
                }
                @if (_hasMoreListItems)
                {
                    <div id="@LoadMoreSentinelId" class="history-infinite-scroll-sentinel" aria-hidden="true"></div>
                }
            </MudPaper>
        }
    </MudStack>
}

@code {
    private enum ExerciseProgressRange
    {
        Last10,
        Last30,
        Last60,
        All
    }

    private enum ChartMetric
    {
        Volume,
        BestWeight,
        TotalReps,
        TotalTime
    }

    [Parameter]
    public Guid PlanId { get; set; }

    [Parameter]
    public string ExerciseName { get; set; } = "";

    private const int AllTimeMaxSessions = 200;
    private const int ListPageSize = 50;
    private const string LoadMoreSentinelId = "exercise-progress-load-more-sentinel";
    private ExerciseLogType _logType = ExerciseLogType.WeightAndReps;

    private bool _ready;
    private bool _planMissing;
    private string _decodedExerciseName = "";
    private List<string> _availableExercises = [];
    private IReadOnlyList<ExerciseSessionProgressEntry> _rows = Array.Empty<ExerciseSessionProgressEntry>();
    private int _loadedListCount;
    private bool _hasMoreListItems;
    private bool _isLoadingMore;
    private bool _sentinelObserved;
    private DotNetObjectReference<ExerciseProgress>? _dotNetRef;
    private ExerciseProgressRange _range = ExerciseProgressRange.Last30;
    private ChartMetric _metric = ChartMetric.Volume;
    private string[] _chartLabels = Array.Empty<string>();
    private ChartSeriesList _chartSeries = [];
    private LineChartOptions _chartOptions = new();
    private string _chartHeightPx = "200px";

    private const int MaxChartAxisLabels = 6;
    private double? _bodyweightKg;
    private double? _bodyweightPercent;

    private int ActiveMaxSessions => _range switch
    {
        ExerciseProgressRange.Last10 => 10,
        ExerciseProgressRange.Last60 => 60,
        ExerciseProgressRange.All => AllTimeMaxSessions,
        _ => 30
    };

    private string FormatSummaryBestValue()
    {
        if (_rows.Count == 0) return "-";
        if (_logType == ExerciseLogType.Duration)
        {
            var maxTime = _rows.Max(r => r.TotalReps);
            return $"{maxTime}s";
        }
        var maxWeight = _rows.Max(r => r.BestWeightKg);
        return FormatBestWeight(maxWeight);
    }

    private string FormatSummaryVolumeValue()
    {
        if (_rows.Count == 0) return "-";
        var maxVol = _rows.Max(r => r.TotalVolumeKg);
        return ExerciseWeightFormatter.FormatWeightWithUnit(maxVol, WeightUnitService.Current);
    }

    private string FormatSummaryTotalReps()
    {
        if (_rows.Count == 0) return "0";
        return _rows.Sum(r => (long)r.TotalReps).ToString("N0", CultureInfo.InvariantCulture);
    }

    private IReadOnlyList<ChartMetric> MetricOptions => _logType switch
    {
        ExerciseLogType.Duration => [ChartMetric.TotalTime],
        _ => [ChartMetric.Volume, ChartMetric.BestWeight, ChartMetric.TotalReps]
    };

    private static string MetricLabel(ChartMetric metric) => metric switch
    {
        ChartMetric.Volume => "Volume",
        ChartMetric.BestWeight => "Best weight",
        ChartMetric.TotalReps => "Total reps",
        _ => "Total time"
    };

    private void GoSession(string sessionId) =>
        Navigation.NavigateTo(AppRoutes.HistorySession(sessionId));

    private void OnExerciseChanged(string newExerciseName)
    {
        if (string.Equals(_decodedExerciseName, newExerciseName, StringComparison.OrdinalIgnoreCase)) return;
        Navigation.NavigateTo(AppRoutes.ExerciseProgress(PlanId, newExerciseName));
    }

    private async Task ShowPersonalRecordsAsync()
    {
        if (string.IsNullOrWhiteSpace(_decodedExerciseName)) return;

        IReadOnlyList<ExerciseSetLogRow> rows =
            await HistoryRepo.GetExerciseSetLogRowsAsync(PlanId, _decodedExerciseName);
        PersonalRecords records = PersonalRecordCalculator.Compute(rows, _logType, _bodyweightKg, _bodyweightPercent);

        var parameters = new DialogParameters<PersonalRecordsDialog>
        {
            { x => x.ExerciseName, _decodedExerciseName },
            { x => x.Records, records },
            { x => x.LogType, _logType },
            { x => x.BodyweightKg, _bodyweightKg },
        };
        var options = new DialogOptions
        {
            CloseButton = false,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
        };

        await DialogService.ShowAsync<PersonalRecordsDialog>("Personal records", parameters, options);
    }

    protected override async Task OnParametersSetAsync()
    {
        _ready = false;
        _decodedExerciseName = Uri.UnescapeDataString(ExerciseName ?? "");
        _bodyweightKg = UserProfileService.GetActiveProfile().BodyweightKg;
        if (string.IsNullOrWhiteSpace(_decodedExerciseName))
        {
            _rows = Array.Empty<ExerciseSessionProgressEntry>();
            _planMissing = false;
            BuildChartData();
            _ready = true;
            return;
        }

        var plan = await PlanService.GetPlanAsync(PlanId);
        _availableExercises = plan?.Exercises.Select(e => e.Name).Distinct().ToList() ?? [];
        var ex = plan?.Exercises.FirstOrDefault(e => string.Equals(e.Name, _decodedExerciseName, StringComparison.OrdinalIgnoreCase));
        _planMissing = ex == null;
        _logType = ex?.LogType ?? ExerciseLogType.WeightAndReps;
        _bodyweightPercent = ex?.BodyweightPercent;
        _metric = _logType == ExerciseLogType.Duration ? ChartMetric.TotalTime : ChartMetric.Volume;
        await LoadRowsAsync();
        BuildChartData();
        ResetListPaging();
        _ready = true;
    }

    private async Task LoadRowsAsync()
    {
        _rows = await HistoryRepo.GetExerciseSessionProgressAsync(
            PlanId, _decodedExerciseName, ActiveMaxSessions, _bodyweightKg, _logType, _bodyweightPercent);
    }

    /// <summary>Reveals the next chunk of session rows for the lazy list (no pagination UI).</summary>
    private void ResetListPaging()
    {
        _loadedListCount = Math.Min(ListPageSize, _rows.Count);
        _hasMoreListItems = _loadedListCount < _rows.Count;
    }
    public Task<bool> OnLoadMoreVisible()
    {
        if (_isLoadingMore || !_hasMoreListItems || _rows.Count == 0)
            return Task.FromResult(false);

        _isLoadingMore = true;
        _loadedListCount = Math.Min(_loadedListCount + ListPageSize, _rows.Count);
        _hasMoreListItems = _loadedListCount < _rows.Count;
        _isLoadingMore = false;
        StateHasChanged();
        return Task.FromResult(_hasMoreListItems);
    }

    private async Task OnRangeChanged(ExerciseProgressRange range)
    {
        _range = range;
        await LoadRowsAsync();
        BuildChartData();
        ResetListPaging();
    }

    private void SetMetric(ChartMetric metric)
    {
        _metric = metric;
        BuildChartData();
    }

    private void BuildChartData()
    {
        if (_rows.Count == 0)
        {
            _chartLabels = Array.Empty<string>();
            _chartSeries = [];
            _hasChartData = false;
            return;
        }

        var count = _rows.Count;
        var dates = new DateTime[count];
        var values = new double[count];
        var hasPositive = false;
        for (var i = 0; i < count; i++)
        {
            var row = _rows[count - 1 - i];
            dates[i] = row.StartedAtUtc;
            var v = GetMetricValue(row);
            values[i] = v;
            if (v > 0) hasPositive = true;
        }
        _hasChartData = hasPositive;

        _chartLabels = SparseChartLabelBuilder.BuildLabels(
            dates,
            UiDateFormats.LocalDateChartAxis,
            MaxChartAxisLabels);

        _chartSeries =
        [
            new ChartSeries<double>
            {
                Name = GetSeriesName(),
                Data = values
            }
        ];

        var maxValue = values.Max();

        var rotateXLabels = count > 4;
        _chartHeightPx = rotateXLabels ? "220px" : "200px";
        ChartAxisScale.Scale? axisScale = maxValue > 0 ? ChartAxisScale.SuggestYAxis(maxValue) : null;
        _chartOptions = new LineChartOptions
        {
            YAxisRequireZeroPoint = false,
            ShowDataMarkers = false,
            MaxNumYAxisTicks = 5,
            YAxisTicks = axisScale is { } s ? Math.Max(1, (int)Math.Ceiling(s.TickStep)) : 1,
            YAxisToStringFunc = FormatYAxisTick,
            YAxisSuggestedMax = axisScale?.Max,
            XAxisLabelRotation = rotateXLabels ? -35 : 0
        };
    }

    private double GetMetricValue(ExerciseSessionProgressEntry row) => _metric switch
    {
        ChartMetric.BestWeight => row.BestWeightKg is { } kg
            ? ExerciseWeightFormatter.ToDisplay(kg, WeightUnitService.Current)
            : 0,
        ChartMetric.TotalReps or ChartMetric.TotalTime => row.TotalReps,
        _ => ExerciseWeightFormatter.ToDisplay(row.TotalVolumeKg, WeightUnitService.Current)
    };

    private string GetSeriesName()
    {
        var unitSuffix = ExerciseWeightFormatter.UnitSuffix(WeightUnitService.Current);
        return _metric switch
        {
            ChartMetric.BestWeight => string.Format("Best weight ({0})", unitSuffix),
            ChartMetric.TotalReps => "Total reps",
            ChartMetric.TotalTime => "Total duration in seconds",
            _ => string.Format("Volume ({0})", unitSuffix)
        };
    }

    private static string FormatYAxisTick(double value) =>
        value.ToString("0", System.Globalization.CultureInfo.InvariantCulture);

    private string FormatBestWeight(double? weight)
    {
        if (_logType == ExerciseLogType.BodyweightReps)
            return ExerciseWeightFormatter.FormatBodyweightOffset(weight, _bodyweightKg, WeightUnitService.Current);
        return weight is { } w ? ExerciseWeightFormatter.FormatWeightWithUnit(w, WeightUnitService.Current) : "-";
    }

    private bool _hasChartData;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_hasMoreListItems)
        {
            if (_sentinelObserved)
            {
                await InfiniteScrollInterop.DisposeAsync(JS, LoadMoreSentinelId);
                _sentinelObserved = false;
            }
            return;
        }

        if (!_sentinelObserved)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await InfiniteScrollInterop.ObserveAsync(JS, LoadMoreSentinelId, _dotNetRef, nameof(OnLoadMoreVisible));
            _sentinelObserved = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_sentinelObserved)
        {
            try
            {
                await InfiniteScrollInterop.DisposeAsync(JS, LoadMoreSentinelId);
            }
            catch (JSDisconnectedException)
            {
                // WebView disposed
            }
            _sentinelObserved = false;
        }

        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }
}
