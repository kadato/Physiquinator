@* User profile management: create, switch, rename, and delete isolated profiles. *@
@inject IStringLocalizer<UiText> Loc

<MudPaper Class="pa-4 settings-card" Elevation="0">
    <div class="settings-card__header">
        <MudIcon Icon="@Icons.Material.Outlined.People" Class="settings-card__icon" />
        <MudText Typo="Typo.h6" Class="settings-card__title">@Loc["User profiles"]</MudText>
    </div>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        @Loc["Create, switch, or manage isolated user profiles. Each profile stores its own plans and history."]
    </MudText>

    <MudStack Spacing="2" Class="mb-3">
        @foreach (var profile in _profiles)
        {
            var isActive = profile.Id == _activeProfile.Id;
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="@($"pa-3 profile-row {(isActive ? "profile-row--active" : "")}")">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudAvatar Color="@(isActive ? Color.Primary : Color.Default)" Size="Size.Medium">
                        @profile.Name.Substring(0, Math.Min(profile.Name.Length, 2)).ToUpper()
                    </MudAvatar>
                    <MudStack Spacing="0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.body1" Class="fw-semibold">@profile.Name</MudText>
                            @if (isActive)
                            {
                                <span class="active-badge">@Loc["Active"]</span>
                            }
                        </MudStack>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                            @Loc["Created:"] @profile.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        </MudText>
                    </MudStack>
                </MudStack>

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    @if (!isActive)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Medium"
                                        OnClick="@(() => SwitchProfileAsync(profile.Id))"
                                        title="@Loc["Switch Profile"]"
                                        aria-label="@Loc["Switch to profile {0}", profile.Name]"
                                       Class="icon-btn-square" />
                    }

                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Variant="Variant.Outlined"
                                   Color="Color.Info"
                                   Size="Size.Medium"
                                   OnClick="@(() => RenameProfileAsync(profile.Id, profile.Name))"
                                   title="@Loc["Rename Profile"]"
                                   aria-label="@Loc["Rename profile {0}", profile.Name]"
                                   Class="icon-btn-square" />

                    @if (profile.Id != UserProfileService.DemoProfileId)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       Size="Size.Medium"
                                       OnClick="@(() => DeleteProfileAsync(profile.Id, profile.Name))"
                                       title="@Loc["Delete Profile"]"
                                       aria-label="@Loc["Delete profile {0}", profile.Name]"
                                       Class="icon-btn-square" />
                    }
                </MudStack>
            </MudStack>
        }
    </MudStack>

    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="CreateProfileAsync" Class="btn-premium-ghost">
        @Loc["Add Profile"]
    </MudButton>
</MudPaper>

@code {
    [Inject]
    private UserProfileService UserProfileService { get; set; } = null!;

    [Inject]
    private IDialogService DialogService { get; set; } = null!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = null!;

    [Inject]
    private NavigationManager Navigation { get; set; } = null!;

    [Inject]
    private WorkoutSessionService SessionService { get; set; } = null!;

    private List<UserProfile> _profiles = new();
    private UserProfile _activeProfile = new();

    protected override void OnInitialized()
    {
        _profiles = UserProfileService.GetProfiles();
        _activeProfile = UserProfileService.GetActiveProfile();
    }

    private async Task CreateProfileAsync()
    {
        var parameters = new DialogParameters { ["Name"] = "" };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ProfileInputDialog>(Loc["Create Profile"], parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is string name)
        {
            try
            {
                UserProfileService.CreateProfile(name);
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
                return;
            }
            _profiles = UserProfileService.GetProfiles();
            Snackbar.Add(Loc["Profile '{0}' created.", name.Trim()], Severity.Success);
        }
    }

    private async Task RenameProfileAsync(Guid id, string currentName)
    {
        var parameters = new DialogParameters { ["Name"] = currentName };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ProfileInputDialog>(Loc["Rename Profile"], parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is string name)
        {
            try
            {
                UserProfileService.RenameProfile(id, name);
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
                return;
            }
            _profiles = UserProfileService.GetProfiles();
            if (_activeProfile.Id == id)
            {
                _activeProfile.Name = name.Trim();
            }
            Snackbar.Add(Loc["Profile renamed to '{0}'.", name.Trim()], Severity.Success);
        }
    }

    private async Task DeleteProfileAsync(Guid id, string name)
    {
        var isActive = id == _activeProfile.Id;
        var confirmed = await DialogService.ConfirmAsync(
            Loc["Delete profile?"],
            isActive
                ? Loc["'{0}' is your current profile. Deleting it permanently erases its history, plans, and database file, and switches you to the Demo User profile.", name]
                : Loc["Are you sure you want to delete profile '{0}'? This will permanently delete its workout history, plans, and database file.", name],
            confirmText: Loc["Delete"],
            confirmColor: Color.Error);

        if (!confirmed) return;

        try
        {
            await UserProfileService.DeleteProfileAsync(id);
            Snackbar.Add(Loc["Profile '{0}' deleted.", name], Severity.Success);
            Navigation.NavigateTo(AppRoutes.Settings, forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Loc["Could not delete profile: {0}", ex.Message], Severity.Error);
        }
    }

    private async Task SwitchProfileAsync(Guid id)
    {
        if (SessionService.CurrentPlan != null)
        {
            var confirmed = await DialogService.ConfirmAsync(
                Loc["Workout in progress"],
                Loc["Switching profiles ends your current workout. Switch anyway?"],
                confirmText: Loc["Switch"],
                confirmColor: Color.Primary);
            if (!confirmed) return;
        }

        try
        {
            await UserProfileService.SwitchProfileAsync(id);
            Snackbar.Add(Loc["Switched profile."], Severity.Success);
            Navigation.NavigateTo(AppRoutes.Settings, forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Loc["Failed to switch profile: {0}", ex.Message], Severity.Error);
        }
    }
}
