@* Rest countdown panel with add / reset / skip controls. *@
@inject WorkoutSessionService SessionService
@inject IStringLocalizer<UiText> Loc
@implements IDisposable

<MudPaper Class="@PanelClass" Elevation="2">
    <div class="rest-timer-active">
        <div class="rest-timer-display">
            @if (IsRestComplete)
            {
                <MudIcon Icon="@Icons.Material.Filled.Check"
                         Class="rest-timer-check"
                         aria-hidden="true" />
            }
            else
            {
                @* Ticking digits are aria-hidden: the live region below
                   announces transitions instead of every second. *@
                <div class='rest-timer-digits @DigitsClass @(60 > RestSecondsRemaining ? "rest-timer-digits--seconds-only" : "") @(10 > RestSecondsRemaining ? "rest-timer-digits--single-digit" : "")' role="timer" aria-hidden="true">
                    <span class="rest-timer-unit rest-timer-unit--minutes">@FormatMinutes(RestSecondsRemaining)</span>
                    <span class="rest-timer-separator">:</span>
                    <span class="rest-timer-unit rest-timer-unit--seconds-tens">@FormatSecondsTens(RestSecondsRemaining)</span>
                    <span class="rest-timer-unit rest-timer-unit--seconds-units">@FormatSecondsUnits(RestSecondsRemaining)</span>
                </div>
            }
        </div>

        <span class="rest-timer-live-status"
              aria-live="polite"
              style="position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0">@LiveStatus</span>

        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2" Class="rest-timer-controls">
            <button type="button"
                    class="rest-timer-add-btn"
                    aria-label="@Loc["Add {0} seconds of rest", AddRestSeconds]"
                    @onclick="() => OnAddTime.InvokeAsync(AddRestSeconds)">+@AddTimeLabel</button>
            <MudIconButton Icon="@Icons.Material.Filled.Replay"
                           Color="Color.Default"
                           aria-label="@Loc["Reset rest"]"
                           OnClick="OnReset"
                           Size="Size.Large" />
            @if (!IsRestComplete)
            {
                <MudIconButton Icon="@Icons.Material.Filled.SkipNext"
                               Color="Color.Default"
                               aria-label="@Loc["Skip rest"]"
                               OnClick="OnSkip"
                               Size="Size.Large" />
            }
        </MudStack>

        <div class="rest-timer-edge-track" aria-hidden="true">
            <div class="rest-timer-edge-fill @EdgeFillClass"></div>
        </div>
    </div>
</MudPaper>

@code {
    private const int ImminentRestThresholdSeconds = 10;
    private const int UrgentRestThresholdSeconds = 5;

    /// <summary>Live seconds remaining, read from the session service on each render so the panel can re-render on its own timer ticks without the parent page re-rendering.</summary>
    private int RestSecondsRemaining => SessionService.RestSecondsRemaining;

    private string? _liveStatus;
    private int _lastActiveDurationSeconds;

    [Parameter, EditorRequired]
    public bool IsRestComplete { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }

    [Parameter]
    public EventCallback OnSkip { get; set; }

    /// <summary>Requests extra rest time in seconds (e.g. 15 or 30) while the countdown runs.</summary>
    [Parameter]
    public EventCallback<int> OnAddTime { get; set; }

    /// <summary>Seconds added by the + button (user-configurable in Settings).</summary>
    [Parameter]
    public int AddRestSeconds { get; set; } = 30;

    /// <summary>
    /// Re-renders the panel in place so the rest countdown can update each
    /// second without re-rendering the parent page and its exercise cards.
    /// </summary>
    public void Refresh()
    {
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        SessionService.RestStateChanged += OnSessionRestStateChanged;
    }

    public void Dispose()
    {
        SessionService.RestStateChanged -= OnSessionRestStateChanged;
    }

    /// <summary>
    /// One polite screen-reader announcement per rest transition (started,
    /// extended, ended) instead of per-second aria-label churn. The session
    /// only fires <see cref="WorkoutSessionService.RestStateChanged"/> on
    /// material changes, and the digits themselves are aria-hidden.
    /// </summary>
    private void OnSessionRestStateChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            if (!SessionService.IsResting)
                _liveStatus = Loc["Rest ended"];
            else if (SessionService.ActiveRestDurationSeconds != _lastActiveDurationSeconds)
                _liveStatus = Loc["Rest started"];
            else
                _liveStatus = Loc["Rest time added"];
            _lastActiveDurationSeconds = SessionService.ActiveRestDurationSeconds;
            StateHasChanged();
        });
    }

    private string LiveStatus => _liveStatus ?? string.Empty;

    private string PanelClass =>
        IsRestComplete
            ? "rest-timer-panel rest-timer-panel--active rest-timer-panel--complete"
            : "rest-timer-panel rest-timer-panel--active";

    private string DigitsClass
    {
        get
        {
            if (RestSecondsRemaining <= UrgentRestThresholdSeconds)
                return "rest-timer-digits--urgent";
            if (RestSecondsRemaining <= ImminentRestThresholdSeconds)
                return "rest-timer-digits--imminent";
            return "";
        }
    }

    private string EdgeFillClass
    {
        get
        {
            if (RestSecondsRemaining <= UrgentRestThresholdSeconds)
                return "rest-timer-edge-fill--urgent";
            if (RestSecondsRemaining <= ImminentRestThresholdSeconds)
                return "rest-timer-edge-fill--imminent";
            return "";
        }
    }

    private string AddTimeLabel => FormatSeconds(AddRestSeconds);

    private static string FormatSeconds(int seconds)
    {
        if (seconds < 60)
            return $"{seconds}s";
        var m = seconds / 60;
        var s = seconds % 60;
        return $"{m}:{s:D2}";
    }

    private static string FormatMinutes(int totalSeconds) => $"{totalSeconds / 60:D2}";

    private static string FormatSecondsTens(int totalSeconds) => $"{totalSeconds % 60 / 10}";

    private static string FormatSecondsUnits(int totalSeconds) => $"{totalSeconds % 60 % 10}";
}
