    private async Task ImportPlans()
    {
        try
        {
            var json = await FileTransfer.PickJsonAsync(Loc["Select workout plan JSON file"]);
            if (json == null)
                return;

            PlanImportPreview preview;
            try
            {
                preview = await PlanService.PreviewPlansImportAsync(json);
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
                return;
            }

            var proceed = await ShowImportPreviewAsync(
                Loc["Import plans"],
                [
                    (Loc["Plans in file"], preview.Total.ToString()),
                    (Loc["New plans"], preview.New.ToString()),
                    (Loc["Will overwrite"], preview.Overwritten.ToString()),
                ],
                Loc["Plans with the same ID replace the existing one. Everything else is added."]);

            if (!proceed)
                return;

            var importedCount = 0;
            try
            {
                var plans = await PlanService.ImportPlansFromJsonAsync(json);
                importedCount = plans.Count;
            }
            catch
            {
                await PlanService.ImportPlanFromJsonAsync(json);
                importedCount = 1;
            }

            await RefreshPlanCountAsync();
            Snackbar.Add(Loc["Imported {0} plan(s).", importedCount], Severity.Success);
            Navigation.NavigateTo(AppRoutes.Home);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Loc["Import failed: {0}", ex.Message], Severity.Error);
        }
    }

