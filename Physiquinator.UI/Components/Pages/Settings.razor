    private async Task ImportAllData()
    {
        try
        {
            var json = await FileTransfer.PickJsonAsync(Loc["Select full backup JSON file"]);
            if (json == null)
                return;

            var preview = await BackupRestoreService.PreviewImportAsync(json);

            var proceed = await ShowImportPreviewAsync(
                Loc["Import all data"],
                [
                    (Loc["Plans"], preview.PlansImported.ToString()),
                    (Loc["Workouts"], preview.SessionsImported.ToString()),
                    (Loc["Set logs"], preview.SetsImported.ToString()),
                    (Loc["Schedule entries"], preview.SchedulesImported.ToString()),
                    (Loc["Settings"], preview.PreferencesImported.ToString()),
                ],
                Loc["Everything in the backup is merged into this device. Existing matching entries are replaced."]);

            if (!proceed)
                return;

            var result = await BackupRestore.ImportAllDataAsync(json);
            SyncFromService();
            await RefreshPlanCountAsync();
            await RefreshHistoryCountAsync();
            Snackbar.Add(
                Loc["Restored {0} plan(s), {1} workout(s), {2} set(s), {3} schedule entry(s), {4} setting(s).",
                    result.PlansImported, result.SessionsImported, result.SetsImported,
                    result.SchedulesImported, result.PreferencesImported],
                Severity.Success);
            Navigation.NavigateTo(AppRoutes.Home);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Loc["Import failed: {0}", ex.Message], Severity.Error);
        }
    }

    private async Task<bool> ShowImportPreviewAsync(
        string title,
        IReadOnlyList<(string Label, string Value)> rows,
        string note)
    {
        var parameters = new DialogParameters<ImportPreviewDialog>
        {
            { x => x.Title, title },
            { x => x.Rows, rows },
            { x => x.Note, note },
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
        };

        var dialog = await DialogService.ShowAsync<ImportPreviewDialog>(Loc["Import"], parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false };
    }

    private async Task RemoveAllDataAsync()
    {
        var confirmed = await DialogService.ConfirmAsync(
            Loc["Remove all data?"],
            Loc["This cannot be undone. Export any backups you need before continuing."],
            confirmText: Loc["Remove"],
            confirmColor: Color.Error);

        if (!confirmed)
            return;

        try
        {
            await AppDataReset.ClearAllLocalDataAsync();
            SyncFromService();
            await RefreshPlanCountAsync();
            await RefreshHistoryCountAsync();
            Snackbar.Add(Loc["All local data has been removed."], Severity.Success);
            Navigation.NavigateTo(AppRoutes.Home);
        }
        catch (Exception ex)
        {
            Snackbar.Add(Loc["Could not remove data: {0}", ex.Message], Severity.Error);
        }
    }

    private async Task CheckForUpdatesAsync()
    {
        _checkingForUpdates = true;
        _latestRelease = null;
        _updateAvailable = false;
        _downloadUrl = null;
        try
        {
            var result = await AppUpdateService.CheckForUpdatesAsync();
            _latestRelease = result.Latest;
            _updateAvailable = result.IsUpdateAvailable;
            _downloadUrl = result.DownloadUrl;
            if (!_updateAvailable)
            {
                Snackbar.Add(Loc["You are on the latest version."], Severity.Success);
            }
            else if (string.IsNullOrEmpty(_downloadUrl))
            {
                Snackbar.Add(Loc["A newer version is available, but in-app updates are not supported on this platform."], Severity.Info);
            }
            else if (result.Latest is { } release)
            {
                var parameters = new DialogParameters<UpdateDialog>
                {
                    { x => x.Release, release },
                    { x => x.DownloadUrl, _downloadUrl },
                };

                var options = new DialogOptions
                {
                    CloseButton = true,
                    CloseOnEscapeKey = true,
                    MaxWidth = MaxWidth.Small,
                    FullWidth = true,
                };

                await DialogService.ShowAsync<UpdateDialog>(Loc["Update available"], parameters, options);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(Loc["Could not check for updates: {0}", ex.Message], Severity.Error);
        }
        finally
        {
            _checkingForUpdates = false;
        }
    }

    public void Dispose()
    {
        ThemeService.ThemeChanged -= HandleSettingsChanged;
        RestAlertSettings.Changed -= HandleSettingsChanged;
        WorkoutSchedule.Changed -= HandleSettingsChanged;
    }
