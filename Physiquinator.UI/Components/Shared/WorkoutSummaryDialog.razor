@* Post-workout recap: session stats plus any personal records set this session.
   Authored as a plate proof in the system language: volt icon box, stat plates
   with tinted values, drawn PR marks, and one volt action. *@

<MudDialog>
    <TitleContent>
        <div class="wsd__title">
            <span class="dialog-title-icon-box wsd__title-icon" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" />
            </span>
            <span class="wsd__title-text">
                <span class="wsd__title-heading">@("Workout complete!")</span>
                <span class="wsd__title-plan">@PlanName</span>
            </span>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="wsd__stats">
            <div class="wsd__stat">
                <span class="wsd__stat-value wsd__stat-value--duration">@DurationLabel</span>
                <span class="wsd__stat-label">@("Duration")</span>
            </div>
            @if (!string.IsNullOrEmpty(VolumeLabel))
            {
                <div class="wsd__stat">
                    <span class="wsd__stat-value wsd__stat-value--volume">@VolumeLabel.Replace(" ", "\u00A0")</span>
                    <span class="wsd__stat-label">@("Volume")</span>
                </div>
            }
            <div class="wsd__stat">
                <span class="wsd__stat-value wsd__stat-value--sets">@SetsLogged</span>
                <span class="wsd__stat-label">@(SetsLogged == 1 ? "Set logged" : "Sets logged")</span>
            </div>
        </div>

        @if (PersonalRecords.Any())
        {
            <div class="wsd__prs">
                <span class="wsd__prs-overline">@("New personal records")</span>
                @foreach (var pr in PersonalRecords)
                {
                    <div class="wsd__pr">
                        <span class="wsd__pr-mark" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.Star" />
                        </span>
                        <span class="wsd__pr-text">
                            <strong>@pr.ExerciseName</strong>
                            <span class="wsd__pr-detail">@pr.Message</span>
                        </span>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="wsd__no-prs">@("No new personal records this session.")</p>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Class="py-2"
                   OnClick="Close">
            @("Back to home")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public string PlanName { get; set; } = "Workout";

    [Parameter]
    public string DurationLabel { get; set; } = "0 min";

    [Parameter]
    public string VolumeLabel { get; set; } = "";

    [Parameter]
    public int SetsLogged { get; set; }

    [Parameter]
    public IReadOnlyList<WorkoutSummaryPr> PersonalRecords { get; set; } = [];

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private void Close() => MudDialog.Close();
}
