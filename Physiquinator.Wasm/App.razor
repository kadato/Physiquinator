@using Microsoft.JSInterop
@using Physiquinator.UI

@if (_ready)
{
    <Routes />
}
else
{
    <output class="app-splash" aria-live="polite" aria-busy="true" aria-label="Loading application">
        <div class="app-splash__logo" aria-hidden="true">
            <svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Physiquinator">
                <rect x="62" y="62" width="392" height="392" fill="#414770"/>
                <rect x="52" y="52" width="392" height="392" fill="#FAFF00" stroke="#10111A" stroke-width="6"/>
                <path d="M52 52 H444 V59 H52 Z" fill="white" opacity="0.42"/>
                <path d="M52 52 V444 H59 V52 Z" fill="white" opacity="0.42"/>
                <g fill="#414770" transform="translate(10,10)">
                    <rect x="216" y="124" width="64" height="82"/>
                    <polygon points="128,216 368,216 296,376 200,376"/>
                </g>
                <g fill="#10111A">
                    <rect x="216" y="124" width="64" height="82"/>
                    <polygon points="128,216 368,216 296,376 200,376"/>
                </g>
            </svg>
        </div>
        <p class="app-splash__status" style="color:#C0CAF5;">@_status</p>
        @if (_error != null)
        {
            <p class="app-splash__error" style="max-width:32rem;color:#7a1f1f;background:#fff3f3;border:1px solid #e0a0a0;padding:0.75rem;border-radius:0.5rem;">@_error</p>
            <div style="display:flex;gap:0.75rem;flex-wrap:wrap;justify-content:center;">
                <button class="app-splash__retry" @onclick="RetryAsync" style="padding:0.6rem 1rem;border:1px solid #10111A;background:#fff;color:#10111A;cursor:pointer;">Retry</button>
                <button class="app-splash__clear" @onclick="ClearAndReloadAsync" style="padding:0.6rem 1rem;border:1px solid #10111A;background:#10111A;color:#FAFF00;cursor:pointer;">Clear local data and reload</button>
            </div>
        }
    </output>
}

@code {
    private bool _ready;
    private bool _initializing;
    private string _status = "Preparing your local database...";
    private string? _error;

    [Inject]
    private WasmDbPersistence Persistence { get; set; } = default!;

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    [Inject]
    private ILogger<App> Logger { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initializing)
        {
            return;
        }
        _initializing = true;
        await InitializeAsync();
    }

    private async Task InitializeAsync()
    {
        _error = null;
        _status = "Preparing your local database...";
        await InvokeAsync(StateHasChanged);

        bool restoreOk = false;
        try
        {
            // Never brick the app: bound the restore to 12s. A hang here was
            // the hard-refresh forever spinner.
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(12));
            await Persistence.RestoreAllAsync(cts.Token).WaitAsync(cts.Token);
            Logger.LogInformation("Database restore completed");
            restoreOk = true;
        }
        catch (OperationCanceledException ex)
        {
            Logger.LogWarning(ex, "Database restore timed out after 12s");
            _error = "Restore timed out. Your browser may have blocked Cache Storage. Try Retry, or clear local data.";
            _status = "Restore timed out";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Database restore failed");
            _error = $"Restore failed: {ex.Message}";
            _status = "Restore failed";
        }

        // PageHide hook is best effort. Never let it block the boot gate.
        try
        {
            using var cts2 = new CancellationTokenSource(TimeSpan.FromSeconds(5));
            await Persistence.InstallPageHideSaveHookAsync(cts2.Token).WaitAsync(cts2.Token);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "PageHide hook install failed");
        }

        _ = StartAutosaveLoopAsync();

        // Always proceed: a fresh empty database is better than an infinite spinner.
        // If we had an error we still show it briefly, but we unblock the app so
        // the user can reach Settings and export or reset.
        if (!restoreOk && _error != null)
        {
            // Keep the error visible for 1.5s before unblocking, so the user sees it.
            await Task.Delay(1500);
        }

        _ready = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RetryAsync()
    {
        _ready = false;
        _initializing = false;
        _error = null;
        _status = "Preparing your local database...";
        await InvokeAsync(StateHasChanged);
        // OnAfterRender will not re-fire, so trigger directly.
        _initializing = true;
        await InitializeAsync();
    }

    private async Task ClearAndReloadAsync()
    {
        try
        {
            await Persistence.ClearAllAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Clear Cache Storage failed");
        }
        try
        {
            await JS.InvokeVoidAsync("eval", "try{localStorage.clear()}catch(e){}");
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "localStorage clear failed, ignored");
        }
        try
        {
            await JS.InvokeVoidAsync("eval", "location.reload()");
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Reload failed, ignored");
        }
    }

    private async Task StartAutosaveLoopAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(20));
            while (await timer.WaitForNextTickAsync())
            {
                try
                {
                    await Persistence.SaveAllAsync();
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Autosave failed");
                }
            }
        }
        catch (OperationCanceledException ex)
        {
            Logger.LogDebug(ex, "Autosave loop canceled");
        }
    }
}
