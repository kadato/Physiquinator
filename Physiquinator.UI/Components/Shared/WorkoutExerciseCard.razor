@* Accordion card for one exercise in the active workout. Shows set logging steppers for
   upcoming exercises and editable set rows for completed ones. *@
@using Physiquinator.Core.Formatting
@using Physiquinator.Core.Models
@inject WeightUnitService WeightUnitService
@inject IStringLocalizer<UiText> Loc

<MudCard Class="@CardClass" @key="Exercise.Id" data-exercise-index="@ExerciseIndex">
    <button type="button" class="@HeaderClass" @onclick="@OnHeaderClick">
        <div class="header-left">
            @if (IsCompleted)
            {
                <span class="completed-icon mr-2" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.Check" />
                </span>
                <MudText Typo="Typo.h6" Class="exercise-name font-weight-bold text-decoration-line-through">@Exercise.Name</MudText>
            }
            else
            {
                <MudText Typo="Typo.h6" Class="exercise-name font-weight-bold">@Exercise.Name</MudText>
            }
        </div>
        <div class="header-right">
            @if (!string.IsNullOrEmpty(Exercise.SupersetGroupId))
            {
                <span class="workout-superset-badge" aria-label="@Loc["Superset group {0}", Exercise.SupersetGroupId]">S@(Exercise.SupersetGroupId)</span>
            }
            <span class="@PillClass">@CompletedSetsCount/@Exercise.TotalSetCount</span>
            @if (CanMoveUp || CanMoveDown)
            {
                <div @onclick:stopPropagation="true" class="exercise-move-controls">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                   Size="Size.Small"
                                   Class="exercise-move-btn"
                                   Disabled="!CanMoveUp"
                                   aria-label="@Loc["Move {0} up", Exercise.Name]"
                                   OnClick="MoveUp" />
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward"
                                   Size="Size.Small"
                                   Class="exercise-move-btn"
                                   Disabled="!CanMoveDown"
                                   aria-label="@Loc["Move {0} down", Exercise.Name]"
                                   OnClick="MoveDown" />
                </div>
            }
            @if (!IsCompleted)
            {
                <div @onclick:stopPropagation="true">
                    <MudIconButton Icon="@Icons.Material.Filled.SkipNext"
                                   Size="Size.Small"
                                   Class="exercise-skip-btn"
                                   aria-label="@Loc["Skip {0}", Exercise.Name]"
                                   OnClick="SkipExercise" />
                </div>
            }
            <MudIcon Icon="@(IsExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Class="ml-2" />
        </div>
    </button>

    @if (IsExpanded && !IsCompleted)
    {
        <MudCardContent Class="pt-0">
            <MudProgressLinear Color="Color.Primary" Value="@GetProgressValue(CompletedSetsCount, Exercise.TotalSetCount)" Class="mb-3" />

                <div class="set-logging-rows">
                    @{
                        var activeSetIndex = ActiveSetIndex >= Exercise.TotalSetCount ? 0 : ActiveSetIndex;
                        var inputs = GetInputs(ExerciseIndex, activeSetIndex);
                        var defaultWeight = inputs.Weight ?? Exercise.DefaultWeightKg ?? 0.0;
                        var defaultReps = inputs.Reps ?? Exercise.DefaultReps ?? DefaultReps;
                        var isWarmupActive = activeSetIndex < Exercise.WarmupSetCount;
                    }

                    <div class="set-active-panel">
                        @if (isWarmupActive)
                        {
                            <span class="warmup-chip">@Loc["Warm-up"]</span>
                        }
                        <div class="set-stepper-rows">
                            @if (Exercise.LogType != ExerciseLogType.Duration)
                            {
                                <SetMetricStepper Value="@ToDisplayWeight(inputs.Weight)"
                                                  ValueChanged="@(val => OnWeightChanged.InvokeAsync((ExerciseIndex, activeSetIndex, ToKgWeight(val))))"
                                                  Step="@WeightStep"
                                                  Min="@WeightMin"
                                                  IsInteger="false"
                                                  Format="0.##"
                                                  Compact="true"
                                                  Unit='@(Exercise.LogType == ExerciseLogType.BodyweightReps && (inputs.Weight == 0 || !inputs.Weight.HasValue) ? "" : UnitSuffix)'
                                                  CustomDisplayText="@(Exercise.LogType == ExerciseLogType.BodyweightReps ? GetBodyweightStepperDisplayText(inputs.Weight) : null)"
                                                  Placeholder="@ToDisplayWeight(defaultWeight)" />
                            }
                            <SetMetricStepper Value="@((double?)inputs.Reps)"
                                              ValueChanged="@(val => OnRepsChanged.InvokeAsync((ExerciseIndex, activeSetIndex, val.HasValue ? (int)Math.Round(val.Value) : (int?)null)))"
                                              Step="1"
                                              Min="1"
                                              IsInteger="true"
                                              Format="0"
                                              Compact="true"
                                              Unit='@(Exercise.LogType == ExerciseLogType.Duration ? "s" : "reps")'
                                              Placeholder="@((double)defaultReps)" />
                        </div>
                        <button type="button"
                                class="log-set-btn"
                                @onclick="@(() => OnToggleSet.InvokeAsync((ExerciseIndex, activeSetIndex)))"
                                disabled="@IsCompleting"
                                aria-label="@Loc["Log set"]">
                            <MudIcon Icon="@Icons.Material.Filled.Check" />
                        </button>
                    </div>
                </div>
        </MudCardContent>
    }

    @if (IsExpanded && IsCompleted)
    {
        <MudCardContent Class="pt-0">
            @if (CompletedSetRows.Any())
            {
                @foreach (var row in CompletedSetRows)
                {
                    var isWarmupRow = row.SetIndex < Exercise.WarmupSetCount;
                    <div class="set-completed-row @(isWarmupRow ? "set-completed-row--warmup" : "")">
                        <div class="set-completed-row__header">
                            @if (isWarmupRow)
                            {
                                <span class="warmup-chip warmup-chip--row">@Loc["Warm-up {0}", row.SetIndex + 1]</span>
                            }
                            else
                            {
                                <span class="set-completed-row__label">@Loc["Set {0}", row.SetIndex + 1]</span>
                            }
                        </div>
                        <div class="set-stepper-rows">
                            @if (Exercise.LogType != ExerciseLogType.Duration)
                            {
                                <SetMetricStepper Value="@ToDisplayWeight(row.WeightKg)"
                                                  ValueChanged="@(val => OnSetWeightChanged.InvokeAsync((ExerciseIndex, row.SetIndex, ToKgWeight(val))))"
                                                  Step="@WeightStep"
                                                  Min="@WeightMin"
                                                  IsInteger="false"
                                                  Format="0.##"
                                                  Compact="true"
                                                  Unit='@(Exercise.LogType == ExerciseLogType.BodyweightReps && (row.WeightKg == 0 || !row.WeightKg.HasValue) ? "" : UnitSuffix)'
                                                  CustomDisplayText="@(Exercise.LogType == ExerciseLogType.BodyweightReps ? GetBodyweightStepperDisplayText(row.WeightKg) : null)"
                                                  Placeholder="@ToDisplayWeight(row.WeightKg)" />
                            }
                            <SetMetricStepper Value="@((double?)row.Reps)"
                                              ValueChanged="@(val => OnSetRepsChanged.InvokeAsync((ExerciseIndex, row.SetIndex, val.HasValue ? (int)Math.Round(val.Value) : (int?)null)))"
                                              Step="1"
                                              Min="1"
                                              IsInteger="true"
                                              Format="0"
                                              Compact="true"
                                              Unit='@(Exercise.LogType == ExerciseLogType.Duration ? "s" : "reps")'
                                              Placeholder="@((double?)row.Reps)" />
                        </div>
                    </div>
                }
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@Loc["No sets logged for this exercise."]</MudText>
            }
        </MudCardContent>
    }
</MudCard>

@code {
    [Parameter, EditorRequired]
    public ExercisePlan Exercise { get; set; }

    [Parameter, EditorRequired]
    public int ExerciseIndex { get; set; }

    [Parameter, EditorRequired]
    public int CompletedSetsCount { get; set; }

    [Parameter]
    public bool IsExpanded { get; set; }

    [Parameter]
    public bool IsCompleted { get; set; }

    [Parameter]
    public bool IsCompleting { get; set; }

    [Parameter]
    public int ActiveSetIndex { get; set; }

    [Parameter]
    public int DefaultReps { get; set; } = 10;

    [Parameter]
    public double? BodyweightKg { get; set; }

    [Parameter]
    public IReadOnlyDictionary<(int, int), (double? Weight, int? Reps)> SetInputs { get; set; } =
        new Dictionary<(int, int), (double? Weight, int? Reps)>();

    /// <summary>Sets already logged in the current session, keyed by (exercise index, set index).</summary>
    [Parameter]
    public IReadOnlyDictionary<(int, int), (double? Weight, int? Reps)> SessionSets { get; set; } =
        new Dictionary<(int, int), (double? Weight, int? Reps)>();

    [Parameter]
    public EventCallback<int> OnToggle { get; set; }

    [Parameter]
    public EventCallback<(int ExerciseIndex, int SetIndex)> OnToggleSet { get; set; }

    [Parameter]
    public EventCallback<(int ExerciseIndex, int SetIndex, double? Weight)> OnWeightChanged { get; set; }

    [Parameter]
    public EventCallback<(int ExerciseIndex, int SetIndex, int? Reps)> OnRepsChanged { get; set; }

    [Parameter]
    public EventCallback<(int ExerciseIndex, int SetIndex, double? WeightKg)> OnSetWeightChanged { get; set; }

    [Parameter]
    public EventCallback<(int ExerciseIndex, int SetIndex, int? Reps)> OnSetRepsChanged { get; set; }

    [Parameter]
    public EventCallback<(int ExerciseIndex, string ExerciseName)> OnSkipExercise { get; set; }

    [Parameter]
    public bool CanMoveUp { get; set; }

    [Parameter]
    public bool CanMoveDown { get; set; }

    [Parameter]
    public EventCallback<int> OnMoveUp { get; set; }

    [Parameter]
    public EventCallback<int> OnMoveDown { get; set; }

    private WeightUnit Unit => WeightUnitService.Current;

    private string UnitSuffix => ExerciseWeightFormatter.UnitSuffix(Unit);

    private double WeightStep => Unit == WeightUnit.Pounds ? 5 : 2.5;

    private double WeightMin => Exercise.LogType == ExerciseLogType.BodyweightReps
        ? ExerciseWeightFormatter.ToDisplay(-200, Unit)
        : 0;

    private double? ToDisplayWeight(double? kg) =>
        kg.HasValue ? ExerciseWeightFormatter.ToDisplay(kg.Value, Unit) : null;

    private double? ToKgWeight(double? display) =>
        display.HasValue ? ExerciseWeightFormatter.ToKg(display.Value, Unit) : null;

    private string CardClass
    {
        get
        {
            var baseClass = IsCompleted
                ? "mb-3 exercise-accordion-card exercise-accordion-card--completed"
                : "mb-3 exercise-accordion-card";
            return $"{baseClass} {ExpandedClass}".TrimEnd();
        }
    }

    private string ExpandedClass => IsExpanded ? "exercise-accordion-card--expanded" : "";

    private string HeaderClass => IsCompleted
        ? "exercise-accordion-header exercise-accordion-header--static"
        : "exercise-accordion-header";

    private Task OnHeaderClick() => OnToggle.InvokeAsync(ExerciseIndex);

    private Task SkipExercise() => OnSkipExercise.InvokeAsync((ExerciseIndex, Exercise.Name));

    private Task MoveUp() => OnMoveUp.InvokeAsync(ExerciseIndex);

    private Task MoveDown() => OnMoveDown.InvokeAsync(ExerciseIndex);

    private string PillClass =>
        IsCompleted
            ? "set-progress-pill set-progress-pill--completed"
            : "set-progress-pill";

    private (double? Weight, int? Reps) GetInputs(int exerciseIndex, int setIndex) =>
        SetInputs.GetValueOrDefault(
            (exerciseIndex, setIndex),
            (Exercise.DefaultWeightKg ?? 0.0, Exercise.DefaultReps ?? DefaultReps));

    /// <summary>Logged sets of this exercise ordered by set index, for the completed edit rows.</summary>
    private List<(int SetIndex, double? WeightKg, int? Reps)> CompletedSetRows
    {
        get
        {
            var rows = new List<(int, double?, int?)>();
            foreach (var (key, value) in SessionSets)
            {
                if (key.Item1 == ExerciseIndex)
                    rows.Add((key.Item2, value.Weight, value.Reps));
            }
            return [.. rows.OrderBy(r => r.Item1)];
        }
    }

    private static double GetProgressValue(int completed, int total) =>
        total == 0 ? 0 : (completed * 100.0) / total;

    private string? GetBodyweightStepperDisplayText(double? value)
    {
        if (value == null || value.Value == 0)
            return "BW";
        var sign = value.Value > 0 ? "+" : "-";
        return $"{sign}{ExerciseWeightFormatter.FormatWeight(Math.Abs(value.Value), Unit)}";
    }
}
