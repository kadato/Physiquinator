@* First-run walkthrough for fresh (non-demo) users: three quick steps plus an
   optional AI step when the assistant is enabled. *@
<MudDialog>
    <TitleContent>
        <div class="d-flex align-items-center gap-3">
            <MudIcon Icon="@CurrentStep.Icon" Color="Color.Primary" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.h6" Class="fw-bold">Welcome to Physiquinator!</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Step @(_step + 1) of @StepCount</MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Class="py-2">
            <MudText Typo="Typo.h6">@CurrentStep.Title</MudText>
            <MudText Typo="Typo.body1" Class="mud-text-secondary">@CurrentStep.Body</MudText>
            <MudProgressLinear Value="@ProgressPercent" Color="Color.Primary" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Close">Skip</MudButton>
        <MudStack Row="true" Spacing="2" Class="mr-auto">
            <MudButton Variant="Variant.Outlined" Disabled="_step == 0" OnClick="GoBack">Back</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="Next"
                       EndIcon="@(IsLastStep ? Icons.Material.Filled.Check : Icons.Material.Filled.ArrowForward)">
                @(IsLastStep ? "Let's go" : "Next")
            </MudButton>
        </MudStack>
    </DialogActions>
</MudDialog>

@code {
    private sealed record TourStep(string Icon, string Title, string Body);

    private static readonly TourStep[] BaseSteps =
    [
        new(
            Icons.Material.Filled.Add,
            "Create a plan",
            "Tap the + New plan button on the Home screen and build your first workout. Add exercises, set how many sets to do, and choose a rest time."),
        new(
            Icons.Material.Filled.PlayArrow,
            "Track a workout",
            "Start a plan and log each set with the check button. The rest timer counts down between sets and reminds you when it is time to go again."),
        new(
            Icons.Material.Filled.ShowChart,
            "Watch your progress",
            "Your streak, workout history, personal records, and a 53-week activity heatmap live on the History tab. Every set you log counts."),
    ];

    [Parameter]
    public bool AiEnabled { get; set; }

    private TourStep[] Steps
    {
        get
        {
            if (!AiEnabled)
                return BaseSteps;

            return
            [
                .. BaseSteps,
                new(
                    Icons.Material.Filled.SmartToy,
                    "AI assistant (optional)",
                    "Physiquinator has a built-in AI assistant that can answer questions about your training. Enable and configure it any time from Settings.")
            ];
        }
    }

    private int StepCount => Steps.Length;

    private int _step;

    private bool IsLastStep => _step >= StepCount - 1;

    private TourStep CurrentStep => Steps[Math.Clamp(_step, 0, StepCount - 1)];

    private double ProgressPercent => StepCount == 0 ? 100 : ((_step + 1) * 100.0) / StepCount;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private void GoBack() => _step = Math.Max(0, _step - 1);

    private void Next()
    {
        if (IsLastStep)
            Close();
        else
            _step++;
    }

    private void Close() => MudDialog.Close();
}
