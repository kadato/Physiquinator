@page "/history/{SessionId}"
@implements IAsyncDisposable
@using System.Text
@using Physiquinator.UI.Components.Shared
@inject WorkoutHistoryRepository HistoryRepo
@inject WorkoutSessionService SessionService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject UserProfileService UserProfileService
@inject WeightUnitService WeightUnitService
@inject IFileTransferService FileTransfer
@inject ISnackbar Snackbar
@inject TimeProvider TimeProvider
@inject IJSRuntime JS
@inject ShareCardInterop ShareCard

<PageTitle>@("Session")</PageTitle>

<PageHeader Title="@("Session")">
    @if (_ready && _session != null)
    {
        <MudButton Variant="Variant.Text" Size="Size.Small" Class="premium-btn" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopySessionAsync">@("Copy")</MudButton>
        <MudButton Variant="Variant.Text" Size="Size.Small" Class="premium-btn" StartIcon="@Icons.Material.Filled.Share" OnClick="ShareSessionAsync">@("Share")</MudButton>
    }
</PageHeader>

@if (!_ready)
{
    <DetailSkeleton />
}
else if (_session == null)
{
    <MudAlert Severity="Severity.Error">@("This workout session was not found.")</MudAlert>
}
else
{
    <MudStack Spacing="3" Class="app-fab-page-padding">
        <MudPaper Class="pa-4 settings-card" Elevation="0">
            <MudText Typo="Typo.h5" Class="settings-card__title">@_session.PlanName</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @(string.Format("Started {0}", UiDateFormats.LocalDateTimeCompact(_session.StartedAtUtc)))
            </MudText>
            @if (_session.EndedAtUtc != null)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @(string.Format("Ended {0}", UiDateFormats.LocalDateTimeCompact(_session.EndedAtUtc.Value)))
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@("In progress")</MudText>
            }
            @if (_planGuid is { } planId)
            {
                <MudButton Variant="Variant.Outlined" Class="mt-2 premium-btn premium-btn-outlined" OnClick="@(() => GoPlan(planId))">
                    @("Open plan")
                </MudButton>
            }

            @if (_sets.Count > 0)
            {
                <div class="history-stats mt-3">
                    <StatCard Value="@TotalSetCount.ToString()" Label="@("Sets")" />
                    @if (TotalVolumeLabel is { } volume)
                    {
                        <StatCard Value="@volume" Label="@("Volume")" />
                    }
                    @if (DurationLabel is { } duration)
                    {
                        <StatCard Value="@duration" Label="@("Duration")" />
                    }
                </div>
            }
        </MudPaper>

        @if (_planGuid is { } pg && _distinctExerciseNames.Count > 0)
        {
            <MudPaper Class="pa-4 settings-card" Elevation="0">
                <div class="settings-card__header">
                    <MudIcon Icon="@Icons.Material.Outlined.TrendingUp" Class="settings-card__icon" />
                    <MudText Typo="Typo.h6" Class="settings-card__title">@("Progress by exercise")</MudText>
                </div>
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                    @foreach (var name in _distinctExerciseNames)
                    {
                        var exercise = name;
                        <MudChip T="string" Variant="Variant.Outlined" Class="exercise-chip" OnClick="@(() => GoExerciseProgress(pg, exercise))">
                            @exercise
                        </MudChip>
                    }
                </MudStack>
            </MudPaper>
        }

        @if (_snapshot != null)
        {
            <MudPaper Class="pa-4 settings-card" Elevation="0">
                <div class="settings-card__header">
                    <MudIcon Icon="@Icons.Material.Outlined.Assignment" Class="settings-card__icon" />
                    <MudText Typo="Typo.h6" Class="settings-card__title">@("Plan when you trained")</MudText>
                </div>
                @foreach (var ex in _snapshot.Exercises.OrderBy(e => e.Order))
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="py-1">
                        <MudText Typo="Typo.body2">@ex.Name</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@(string.Format("{0} sets · {1}s rest", ex.SetCount, ex.RestIntervalSeconds))</MudText>
                    </MudStack>
                }
            </MudPaper>
        }

        @if (!_sets.Any())
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@("No sets logged for this session.")</MudText>
        }
        else
        {
            <MudPaper Elevation="0" Class="premium-table">
                <div class="pa-4 pb-1 d-flex align-center justify-space-between">
                    <MudText Typo="Typo.h6">@("Sets")</MudText>
                    @if (_sets.Any())
                    {
                        @if (_editMode)
                        {
                            <MudStack Row="true" Spacing="1">
                                <MudButton Variant="Variant.Text" Size="Size.Small" Class="premium-btn" StartIcon="@Icons.Material.Filled.Add" OnClick="AddSetAsync">
                                    @("Add set")
                                </MudButton>
                                <MudButton Variant="Variant.Text" Size="Size.Small" Class="premium-btn" OnClick="ToggleEditMode">
                                    @("Done")
                                </MudButton>
                            </MudStack>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small" Class="premium-btn" StartIcon="@Icons.Material.Filled.Edit" OnClick="ToggleEditMode">
                                @("Edit")
                            </MudButton>
                        }
                    }
                </div>
                <div class="infinite-table-list">
                    <div class="infinite-table-head @(_editMode ? "infinite-table-head--5" : "infinite-table-head--4x")">
                        <span>@("Exercise")</span>
                        <span>@("Reps")</span>
                        <span>@ExerciseWeightFormatter.UnitSuffix(WeightUnitService.Current)</span>
                        <span>@("Time")</span>
                        @if (_editMode)
                        {
                            <span class="infinite-table-head__action" />
                        }
                    </div>
                    @foreach (var set in _sets.Take(_loadedListCount))
                    {
                        var context = set;
                        <div @key="context.Id" class="infinite-table-row @(_editMode ? "infinite-table-row--5" : "infinite-table-row--4x")">
                            <span>
                                @if (context.IsWarmup)
                                {
                                    <span class="history-detail-warmup-badge">@("Warm-up")</span>
                                }
                                @context.ExerciseName
                            </span>
                            @if (_editingSetId == context.Id)
                            {
                                <span>
                                    <input type="number"
                                           class="history-detail-table__input"
                                           inputmode="numeric"
                                           min="0"
                                           step="1"
                                           value="@_editRepsText"
                                           aria-label="@("Reps")"
                                           @onchange="OnEditRepsChanged" />
                                </span>
                                <span>
                                    @if (GetLogType(context.ExerciseName) == ExerciseLogType.Duration)
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">—</MudText>
                                    }
                                    else
                                    {
                                        <input type="number"
                                               class="history-detail-table__input"
                                               inputmode="decimal"
                                               min="0"
                                               step="@WeightStep"
                                               value="@_editWeightText"
                                               aria-label="@(string.Format("Weight ({0})", ExerciseWeightFormatter.UnitSuffix(WeightUnitService.Current)))"
                                               @onchange="OnEditWeightChanged" />
                                    }
                                </span>
                            }
                            else
                            {
                                <span>@FormatReps(context.ExerciseName, context.Reps)</span>
                                <span>@FormatWeight(context.ExerciseName, context.WeightKg)</span>
                            }
                            <span>@UiDateFormats.LocalTimeOnly(context.CompletedAtUtc)</span>
                            @if (_editMode)
                            {
                                <span class="infinite-table-row__action">
                                    @if (_editingSetId == context.Id)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Check"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                        Class="history-detail-table__btn"
                                                        aria-label="@("Save set")"
                                                        OnClick="@(() => SaveSetAsync(context))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                       Size="Size.Small"
                                                        Class="history-detail-table__btn"
                                                        aria-label="@("Cancel edit")"
                                                        OnClick="CancelEditSet" />
                                    }
                                    else
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Size="Size.Small"
                                                        Class="history-detail-table__btn"
                                                        aria-label="@("Edit set")"
                                                        OnClick="@(() => StartEditSet(context))" />
                                        <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                        Class="history-detail-table__btn"
                                                        aria-label="@("Delete set")"
                                                        OnClick="@(() => DeleteSetAsync(context))" />
                                    }
                                </span>
                            }
                        </div>
                    }
                </div>
                @if (_isLoadingMore)
                {
                    <div class="history-infinite-scroll-loading" aria-hidden="true">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                    </div>
                }
                @if (_hasMoreListItems)
                {
                    <div id="@LoadMoreSentinelId" class="history-infinite-scroll-sentinel" aria-hidden="true"></div>
                }
            </MudPaper>
        }

    </MudStack>

    @* HistoryDetail FABs *@
    @* Delete — mini error FAB bottom-left, stacked above back FAB *@
    <MudIconButton Class="app-fab app-fab--error app-fab--mini app-fab--bl-2"
                   Icon="@Icons.Material.Filled.Delete"
                   OnClick="DeleteSessionClick"
                   aria-label="@("Delete this workout")" />

    @if (_session.EndedAtUtc == null && _planGuid is { } activePlanId2)
    {
        @* Continue Workout — primary FAB bottom-right *@
        <MudIconButton Class="app-fab app-fab--primary app-fab--br-1"
                       Icon="@Icons.Material.Filled.PlayArrow"
                       OnClick="@(() => ContinueWorkout(activePlanId2))"
                       aria-label="@("Continue workout")" />
    }

    @* Off-screen share card, captured to PNG by the Share button. *@
    <WorkoutShareCard PlanName="@_session.PlanName"
                      DateLabel="@ShareDateLabel"
                      DurationLabel="@(DurationLabel ?? "—")"
                      VolumeLabel="@TotalVolumeLabel"
                      SetsLogged="@TotalSetCount"
                      Exercises="@ShareCardExercises" />
}


@code {
    [Parameter]
    public string SessionId { get; set; } = "";

    private const int ListPageSize = 50;
    private const string LoadMoreSentinelId = "history-detail-load-more-sentinel";

    private bool _ready;
    private WorkoutSessionLogEntity? _session;
    private WorkoutPlan? _snapshot;
    private List<WorkoutSetLogEntity> _sets = new();
    private int _loadedListCount;
    private bool _hasMoreListItems;
    private bool _isLoadingMore;
    private bool _sentinelObserved;
    private DotNetObjectReference<HistoryDetail>? _dotNetRef;
    private Guid? _planGuid;
    private List<string> _distinctExerciseNames = new();
    private Dictionary<string, ExerciseLogType> _logTypesByExercise = new();
    private Dictionary<string, double?> _percentByExercise = new();
    private double? _bodyweightKg;
    private bool _editMode;
    private string? _editingSetId;
    private string _editRepsText = "";
    private string _editWeightText = "";


    private void GoPlan(Guid planId) => Navigation.NavigateTo(AppRoutes.Plan(planId));

    private void ContinueWorkout(Guid planId) => Navigation.NavigateTo(AppRoutes.Workout(planId));

    private void GoExerciseProgress(Guid planId, string exerciseName) =>
        Navigation.NavigateTo(AppRoutes.ExerciseProgress(planId, exerciseName));

    protected override async Task OnParametersSetAsync()
    {
        _ready = false;
        _editMode = false;
        _editingSetId = null;
        await ReloadAsync();
        _ready = true;
    }

    private async Task ReloadAsync()
    {
        var id = Uri.UnescapeDataString(SessionId ?? "");
        _session = string.IsNullOrWhiteSpace(id) ? null : await HistoryRepo.GetSessionAsync(id);
        _snapshot = WorkoutHistoryRepository.TryParsePlanSnapshot(_session?.PlanSnapshotJson);
        _bodyweightKg = UserProfileService.GetActiveProfile().BodyweightKg;

        var sets = _session != null
            ? (await HistoryRepo.GetSetsForSessionAsync(_session.Id)).ToList()
            : new List<WorkoutSetLogEntity>();

        _sets = sets;
        _planGuid = _session?.TryGetPlanId();
        _logTypesByExercise = new(StringComparer.OrdinalIgnoreCase);
        _percentByExercise = new(StringComparer.OrdinalIgnoreCase);
        if (_snapshot != null)
        {
            foreach (ExercisePlan exercise in _snapshot.Exercises)
            {
                // First occurrence wins; malformed snapshots may repeat a name with different casing.
                _logTypesByExercise.TryAdd(exercise.Name, exercise.LogType);
                _percentByExercise.TryAdd(exercise.Name, exercise.BodyweightPercent);
            }
        }
        _distinctExerciseNames = sets
            .Select(s => s.ExerciseName)
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .Distinct(StringComparer.Ordinal)
            .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
            .ToList();
        ResetListPaging();
    }

    /// <summary>Reveals the next chunk of logged sets for the lazy list (no pagination UI).</summary>
    private void ResetListPaging()
    {
        _loadedListCount = Math.Min(ListPageSize, _sets.Count);
        _hasMoreListItems = _loadedListCount < _sets.Count;
    }

    /// <summary>
    /// Invoked from JS when the sentinel scrolls into view. Reveals the next chunk
    /// of already-loaded sets and reports whether more pages may exist.
    /// </summary>
    [JSInvokable]
    public Task<bool> OnLoadMoreVisible()
    {
        if (_isLoadingMore || !_hasMoreListItems || _sets.Count == 0)
            return Task.FromResult(false);

        _isLoadingMore = true;
        _loadedListCount = Math.Min(_loadedListCount + ListPageSize, _sets.Count);
        _hasMoreListItems = _loadedListCount < _sets.Count;
        _isLoadingMore = false;
        StateHasChanged();
        return Task.FromResult(_hasMoreListItems);
    }

    private void ToggleEditMode()
    {
        _editMode = !_editMode;
        if (!_editMode)
            _editingSetId = null;
    }

    private void StartEditSet(WorkoutSetLogEntity set)
    {
        _editingSetId = set.Id;
        _editRepsText = set.Reps?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
        _editWeightText = GetLogType(set.ExerciseName) == ExerciseLogType.Duration || set.WeightKg is not { } kg
            ? ""
            : ExerciseWeightFormatter.ToDisplay(kg, WeightUnitService.Current)
                .ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    }

    private void CancelEditSet() => _editingSetId = null;

    private void OnEditRepsChanged(ChangeEventArgs e) =>
        _editRepsText = e.Value as string ?? "";

    private void OnEditWeightChanged(ChangeEventArgs e) =>
        _editWeightText = e.Value as string ?? "";

    private async Task SaveSetAsync(WorkoutSetLogEntity set)
    {
        if (_session == null || _editingSetId != set.Id) return;

        int? reps = null;
        if (int.TryParse(_editRepsText, System.Globalization.NumberStyles.Integer,
                System.Globalization.CultureInfo.InvariantCulture, out var parsedReps) && parsedReps >= 0)
            reps = parsedReps;

        double? weightKg = null;
        if (GetLogType(set.ExerciseName) != ExerciseLogType.Duration
            && double.TryParse(_editWeightText, System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var parsedWeight) && parsedWeight > 0)
            weightKg = ExerciseWeightFormatter.ToKg(parsedWeight, WeightUnitService.Current);

        try
        {
            await HistoryRepo.UpdateSetLogAsync(_session.Id, set.ExerciseIndex, set.SetIndex, reps, weightKg);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format("Could not update set: {0}", ex.Message), Severity.Error);
            return;
        }

        _editingSetId = null;
        await ReloadAsync();
        Snackbar.Add("Set updated.", Severity.Success);
    }

    private async Task DeleteSetAsync(WorkoutSetLogEntity set)
    {
        if (_session == null) return;

        var ok = await DialogService.ConfirmAsync(
            "Delete set",
            string.Format("Delete set {0} of '{1}'? This cannot be undone.", set.SetIndex + 1, set.ExerciseName),
            confirmText: "Delete",
            confirmColor: Color.Error);

        if (!ok) return;

        try
        {
            await HistoryRepo.DeleteSetLogAsync(_session.Id, set.ExerciseIndex, set.SetIndex);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format("Could not delete set: {0}", ex.Message), Severity.Error);
            return;
        }

        _editingSetId = null;
        await ReloadAsync();
        Snackbar.Add("Set deleted.", Severity.Success);
    }

    private async Task DeleteSessionClick()
    {
        if (_session == null) return;

        var inProgress = _session.EndedAtUtc == null;
        var ok = await DialogService.ConfirmAsync(
            "Delete workout",
            "Delete this session and all logged sets? This cannot be undone.",
            confirmText: "Delete",
            confirmColor: Color.Error);

        if (!ok) return;

        if (inProgress)
            SessionService.EndWorkout();

        await HistoryRepo.DeleteSessionAsync(_session.Id);
        Navigation.NavigateTo(AppRoutes.History);
        Snackbar.Add("Session deleted.", Severity.Success);
    }

    private async Task AddSetAsync()
    {
        if (_session == null) return;

        if (_distinctExerciseNames.Count == 0)
        {
            Snackbar.Add("No exercises to add a set to.", Severity.Info);
            return;
        }

        var parameters = new DialogParameters<AddSetDialog>
        {
            { x => x.ExerciseNames, _distinctExerciseNames },
            { x => x.LogTypes, _logTypesByExercise },
            { x => x.UnitSuffix, ExerciseWeightFormatter.UnitSuffix(WeightUnitService.Current) },
        };
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
        };

        var dialog = await DialogService.ShowAsync<AddSetDialog>("Add set", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is AddSetResult add)
        {
            var setIndex = _sets
                .Where(s => string.Equals(s.ExerciseName, add.ExerciseName, StringComparison.OrdinalIgnoreCase))
                .Select(s => s.SetIndex)
                .DefaultIfEmpty(-1)
                .Max() + 1;

            var exerciseIndex = _snapshot?.Exercises
                .FirstOrDefault(e => string.Equals(e.Name, add.ExerciseName, StringComparison.OrdinalIgnoreCase))
                ?.Order ?? 0;

            double? weightKg = add.DisplayWeightKg is { } dw
                ? ExerciseWeightFormatter.ToKg(dw, WeightUnitService.Current)
                : null;

            try
            {
                await HistoryRepo.LogSetAsync(_session.Id, exerciseIndex, add.ExerciseName, setIndex, add.Reps, weightKg);
            }
            catch (Exception ex)
            {
                Snackbar.Add(string.Format("Could not add set: {0}", ex.Message), Severity.Error);
                return;
            }

            await ReloadAsync();
            Snackbar.Add("Set added.", Severity.Success);
        }
    }

    private async Task CopySessionAsync()
    {
        if (_session == null) return;

        var text = BuildSessionText();
        var copied = false;
        try
        {
            copied = await JS.InvokeAsync<bool>("physiquinatorHelpers.copyText", text);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format("Copy failed: {0}", ex.Message), Severity.Error);
            return;
        }

        if (copied)
            Snackbar.Add("Session summary copied.", Severity.Success);
        else
            Snackbar.Add("Could not copy to clipboard.", Severity.Error);
    }

    /// <summary>Builds a readable text summary of the session for sharing or copying.</summary>
    private string BuildSessionText()
    {
        if (_session == null) return "";

        var sb = new StringBuilder();
        sb.AppendLine(_session.PlanName);
        sb.AppendLine(string.Format("Started: {0}", UiDateFormats.LocalDateTimeCompact(_session.StartedAtUtc)));
        if (_session.EndedAtUtc is { } ended)
            sb.AppendLine(string.Format("Ended: {0}", UiDateFormats.LocalDateTimeCompact(ended)));
        sb.AppendLine();

        foreach (var group in _sets.GroupBy(s => s.ExerciseName, StringComparer.OrdinalIgnoreCase))
        {
            sb.AppendLine($"{group.Key}:");
            foreach (var set in group)
            {
                sb.AppendLine(string.Format("Set {0}: {1}", set.SetIndex + 1, FormatSetForShare(set)));
            }
            sb.AppendLine();
        }

        return sb.ToString().TrimEnd();
    }

    private int TotalSetCount => _sets.Count;

    private double WeightStep => WeightUnitService.Current == WeightUnit.Pounds ? 5 : 2.5;

    private string? TotalVolumeLabel
    {
        get
        {
            if (_sets.Count == 0) return null;

            double total = 0;
            var any = false;
            foreach (var set in _sets)
            {
                var type = GetLogType(set.ExerciseName);
                if (type == ExerciseLogType.Duration || set.Reps is not { } reps)
                    continue;
                total += PersonalRecordCalculator.ComputeVolume(
                    reps, set.WeightKg, type, _bodyweightKg, GetBodyweightPercent(set.ExerciseName));
                any = true;
            }

            if (!any) return null;
            return ExerciseWeightFormatter.FormatVolumeWithUnit(total, WeightUnitService.Current);
        }
    }

    private string? DurationLabel
    {
        get
        {
            if (_session?.EndedAtUtc is not { } ended || _session.StartedAtUtc == default)
                return null;

            var minutes = (int)(ended - _session.StartedAtUtc).TotalMinutes;
            return minutes < 60 ? string.Format("{0} min", minutes) : string.Format("{0}h {1}m", minutes / 60, minutes % 60);
        }
    }

    private ExerciseLogType GetLogType(string exerciseName) =>
        _logTypesByExercise.TryGetValue(exerciseName, out var type)
            ? type
            : ExerciseLogType.WeightAndReps;

    private double? GetBodyweightPercent(string exerciseName) =>
        _percentByExercise.TryGetValue(exerciseName, out var percent)
            ? percent
            : null;

    private string FormatReps(string exerciseName, int? reps)
    {
        if (reps == null) return "—";
        var type = GetLogType(exerciseName);
        return type == ExerciseLogType.Duration ? $"{reps}s" : reps.Value.ToString();
    }

    private string FormatWeight(string exerciseName, double? weight)
    {
        var type = GetLogType(exerciseName);
        if (type == ExerciseLogType.Duration) return "—";
        if (type == ExerciseLogType.BodyweightReps)
            return ExerciseWeightFormatter.FormatBodyweightOffset(weight, _bodyweightKg, WeightUnitService.Current);
        return weight is { } w ? ExerciseWeightFormatter.FormatWeightWithUnit(w, WeightUnitService.Current) : "—";
    }

    /// <summary>Builds a readable text summary of the session for sharing.</summary>
    private async Task ShareSessionAsync()
    {
        if (_session == null) return;

        var fileName = FileTransferNames.PngFileName(
            FileTransferNames.SafeFileStem(_session.PlanName),
            TimeProvider.GetLocalNow());
        try
        {
            byte[]? png = await ShareCard.CaptureElementAsPngAsync("[data-share-card]");
            if (png == null)
            {
                Snackbar.Add("Could not create the share image.", Severity.Error);
                return;
            }

            await FileTransfer.ExportImageAsync(fileName, png, "Share workout");
            Snackbar.Add("Workout card shared.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format("Share failed: {0}", ex.Message), Severity.Error);
        }
    }

    private string ShareDateLabel => _session == null
        ? ""
        : UiDateFormats.LocalDateTimeCompact(_session.StartedAtUtc);

    private IReadOnlyList<WorkoutShareCard.ShareCardExercise> ShareCardExercises =>
        [.. _sets
            .GroupBy(s => s.ExerciseName, StringComparer.OrdinalIgnoreCase)
            .Select(g => new WorkoutShareCard.ShareCardExercise(
                g.Key,
                [.. g
                    .OrderBy(s => s.SetIndex)
                    .Select(s => new WorkoutShareCard.ShareCardSet(
                        g.Key,
                        s.SetIndex,
                        FormatShareSetMetrics(s),
                        s.IsWarmup))]))];

    private string FormatShareSetMetrics(WorkoutSetLogEntity set)
    {
        var type = GetLogType(set.ExerciseName);
        string weight;
        if (type == ExerciseLogType.Duration)
        {
            weight = "";
        }
        else if (type == ExerciseLogType.BodyweightReps)
        {
            weight = ExerciseWeightFormatter.FormatBodyweightOffset(set.WeightKg, _bodyweightKg, WeightUnitService.Current);
        }
        else
        {
            weight = set.WeightKg is { } w ? ExerciseWeightFormatter.FormatWeightWithUnit(w, WeightUnitService.Current) : "";
        }

        string reps;
        if (set.Reps is { } r)
        {
            reps = type == ExerciseLogType.Duration ? $"{r}s" : $"{r} reps";
        }
        else
        {
            reps = "";
        }

        return $"{weight} × {reps}".Trim(' ', '×');
    }

    private string FormatSetForShare(WorkoutSetLogEntity set)
    {
        var type = GetLogType(set.ExerciseName);
        var weight = type switch
        {
            ExerciseLogType.Duration => "",
            ExerciseLogType.BodyweightReps => ExerciseWeightFormatter.FormatBodyweightOffset(set.WeightKg, _bodyweightKg, WeightUnitService.Current),
            _ => set.WeightKg is { } w ? ExerciseWeightFormatter.FormatWeightWithUnit(w, WeightUnitService.Current) : ""
        };
        string reps;
        if (set.Reps is { } r)
        {
            reps = type == ExerciseLogType.Duration ? $"{r}s" : $"{r} reps";
        }
        else
        {
            reps = "";
        }
        return $"{weight} {reps}".Trim();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_hasMoreListItems)
        {
            if (_sentinelObserved)
            {
                await InfiniteScrollInterop.DisposeAsync(JS, LoadMoreSentinelId);
                _sentinelObserved = false;
            }
            return;
        }

        if (!_sentinelObserved)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await InfiniteScrollInterop.ObserveAsync(JS, LoadMoreSentinelId, _dotNetRef, nameof(OnLoadMoreVisible));
            _sentinelObserved = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_sentinelObserved)
        {
            try
            {
                await InfiniteScrollInterop.DisposeAsync(JS, LoadMoreSentinelId);
            }
            catch (JSDisconnectedException)
            {
                // WebView disposed
            }
            _sentinelObserved = false;
        }

        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }
}
