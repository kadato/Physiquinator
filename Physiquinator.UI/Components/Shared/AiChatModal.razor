@using Physiquinator.Core.Services.Ai
@using Physiquinator.Core.Models
@using Markdig
@inject AiAssistantService AiAssistant
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IStringLocalizer<UiText> Loc
@implements IDisposable


<MudDialog Class="ai-chat-dialog">
    <DialogContent>
        <div class="ai-chat-container">
            <!-- Header -->
            <div class="ai-chat-header">
                <div class="ai-chat-header__title">
                    <div class="ai-chat-header__badge" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Small" />
                    </div>
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold ai-chat-title">@Loc["Physiquinator AI"]</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary ai-chat-subtitle">@Loc["Fitness Assistant & Plan Engine"]</MudText>
                    </div>
                </div>
                <div class="ai-chat-header__actions">
                    <MudIconButton Icon="@Icons.Material.Outlined.DeleteSweep"
                                   aria-label="@Loc["Clear History"]"
                                   Size="Size.Small"
                                   OnClick="ClearHistory" />
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   aria-label="@Loc["Close"]"
                                   Size="Size.Small"
                                   OnClick="Close" />
                </div>
            </div>

            <!-- API Key Warning Banner if Not Configured -->
            @if (IsApiKeyMissing)
            {
                <div class="ai-api-key-banner">
                    <div class="ai-api-key-banner__content">
                        <MudIcon Icon="@Icons.Material.Filled.VpnKey" Color="Color.Warning" Size="Size.Medium" />
                        <div>
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold ai-banner-title">@Loc["API Key Required"]</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Loc["Provide an API key (OpenAI, OpenRouter, OpenCode) to chat with Physiquinator AI."]</MudText>
                        </div>
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" OnClick="NavigateToSettings" Class="ai-banner-button">
                        @Loc["Setup Key"]
                    </MudButton>
                </div>
            }

            <!-- Messages Area -->
            <div class="ai-chat-messages" @ref="_messagesElement">
                @if (AiAssistant.Messages.Count == 0)
                {
                    <div class="ai-chat-empty">
                        <MudIcon Icon="@Icons.Material.Outlined.FitnessCenter" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                        <MudText Typo="Typo.h6" Class="font-weight-semibold">@Loc["How can I help you train?"]</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary align-center max-w-400 ai-chat-empty__hint">
                            @Loc["Ask me to create workout plans, log bodyweight, analyze your personal records, tweak app settings, or generate progressive overload recommendations!"]
                        </MudText>
                    </div>
                }
                else
                {
                    @foreach (var msg in AiAssistant.Messages)
                    {
                        if (msg.Role == AiMessageRole.User)
                        {
                            <div class="ai-msg ai-msg--user">
                                <div class="ai-msg__bubble">
                                    @msg.Content
                                </div>
                                <span class="ai-msg__time">@FormatTime(msg.Timestamp)</span>
                            </div>
                        }
                        else if (msg.Role == AiMessageRole.Assistant)
                        {
                            <div class="@GetAssistantClass(msg)">
                                <div class="ai-msg__avatar" aria-hidden="true">
                                    <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Small" />
                                </div>
                                <div class="ai-msg__body">
                                    <div class="ai-msg__bubble">
                                        @if (msg.IsThinking)
                                        {
                                            <div class="ai-msg__thinking">
                                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                                <span>@Loc["Thinking & executing actions..."]</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="ai-msg__content markdown-body">@((MarkupString)RenderMarkdown(msg.Content))</div>
                                        }
                                    </div>
                                    @if (msg.ToolCalls != null && msg.ToolCalls.Count > 0)
                                    {
                                        <div class="ai-msg__tools">
                                            @foreach (var tc in msg.ToolCalls)
                                            {
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Icon="@Icons.Material.Filled.Build">
                                                    @Loc["Executed {0}", tc.Name]
                                                </MudChip>
                                            }
                                        </div>
                                    }
                                    <span class="ai-msg__actions">
                                        @if (!string.IsNullOrWhiteSpace(msg.Content))
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                                           Size="Size.Small"
                                                           Class="ai-msg__copy"
                                                           aria-label="@Loc["Copy message"]"
                                                           OnClick="@(() => CopyMessageAsync(msg.Content))" />
                                        }
                                        <span class="ai-msg__time">@FormatTime(msg.Timestamp)</span>
                                    </span>
                                </div>
                            </div>
                        }
                    }
                }
            </div>

            <!-- Quick Action Chips — only while the chat is still empty -->
            @if (AiAssistant.Messages.Count == 0)
            {
                <div class="ai-chat-quick-actions">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Default" Disabled="@IsApiKeyMissing" OnClick="OnProgressiveOverloadClick" Class="ai-chat-quick-chip">
                        ⚡ @Loc["Progressive Overload"]
                    </MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Default" Disabled="@IsApiKeyMissing" OnClick="OnPerformanceStatsClick" Class="ai-chat-quick-chip">
                        📊 @Loc["Performance Stats"]
                    </MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Default" Disabled="@IsApiKeyMissing" OnClick="OnLogBodyweightClick" Class="ai-chat-quick-chip">
                        ⚖️ @Loc["Log Bodyweight"]
                    </MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Default" Disabled="@IsApiKeyMissing" OnClick="OnDeloadPlanClick" Class="ai-chat-quick-chip">
                        🔄 @Loc["Deload Plan"]
                    </MudChip>
                </div>
            }

            <!-- Input Bar -->
            <div class="ai-chat-input">
                <div class="ai-chat-composer">
                    <div class="ai-chat-input__field">
                        <MudTextField T="string"
                                      Variant="Variant.Text"
                                       Placeholder="@Loc["Ask Physiquinator AI..."]"
                                      Immediate="true"
                                      @bind-Value="_inputText"
                                      OnKeyDown="HandleKeyDown"
                                      Disabled="@(_isSending || IsApiKeyMissing)"
                                      Margin="Margin.Dense"
                                      enterkeyhint="send"
                                      Class="ai-chat-textfield" />
                    </div>

                    @if (_isSending)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Stop"
                                       Color="Color.Error"
                                       Variant="Variant.Filled"
                                       aria-label="@Loc["Stop generating"]"
                                       title="@Loc["Stop generating"]"
                                       OnClick="StopGeneration"
                                       Class="ai-chat-send-button" />
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Send"
                                       Color="Color.Primary"
                                       Variant="Variant.Filled"
                                       aria-label="@Loc["Send Message"]"
                                       title="@Loc["Send Message"]"
                                       Disabled="@(string.IsNullOrWhiteSpace(_inputText) || IsApiKeyMissing)"
                                       OnClick="SendMessageAsync"
                                       Class="ai-chat-send-button" />
                    }
                </div>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    private string _inputText = string.Empty;
    private bool _isSending = false;
    private ElementReference _messagesElement;

    private bool IsApiKeyMissing
    {
        get
        {
            var settings = AiAssistant.GetSettings();
            return !settings.Enabled || (settings.Provider != AiProviderType.OllamaLocal && string.IsNullOrWhiteSpace(settings.ApiKey));
        }
    }


    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .DisableHtml()
        .Build();

    private static string RenderMarkdown(string? rawMarkdown) =>
        Markdown.ToHtml(rawMarkdown ?? string.Empty, MarkdownPipeline);

    private static string GetAssistantClass(AiChatMessage msg) =>
        msg.IsError ? "ai-msg ai-msg--assistant ai-msg--error" : "ai-msg ai-msg--assistant";

    private static string FormatTime(DateTime timestamp) =>
        timestamp.ToLocalTime().ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture);


    protected override void OnInitialized()
    {
        AiAssistant.OnMessagesChanged += HandleMessagesChanged;
    }

    private void HandleMessagesChanged()
    {
        InvokeAsync(async () =>
        {
            StateHasChanged();
            await ScrollToBottomAsync();
        });
    }

    private async Task ScrollToBottomAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("physiquinatorHelpers.scrollToBottom", _messagesElement);
        }
        catch (Exception)
        {
            // Element not rendered yet or JS unavailable
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await ScrollToBottomAsync();
    }

    private void StopGeneration()
    {
        AiAssistant.CancelCurrentTurn();
    }

    private async Task CopyMessageAsync(string content)
    {
        if (string.IsNullOrWhiteSpace(content)) return;

        var copied = false;
        try
        {
            copied = await JS.InvokeAsync<bool>("physiquinatorHelpers.copyText", content);
        }
        catch (Exception)
        {
            copied = false;
        }

        if (copied)
            Snackbar.Add(Loc["Message copied."], Severity.Success);
        else
            Snackbar.Add(Loc["Could not copy to clipboard."], Severity.Error);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !string.IsNullOrWhiteSpace(_inputText) && !_isSending)
        {
            await SendMessageAsync();
        }
    }

    private async Task OnProgressiveOverloadClick() =>
        await SendPrompt(Loc["Suggest progressive overload recommendations for my active workout plans."]);

    private async Task OnPerformanceStatsClick() =>
        await SendPrompt(Loc["Show my current workout stats and recent performance."]);

    private async Task OnLogBodyweightClick() =>
        await SendPrompt(Loc["Log my bodyweight for today and show my recent trends."]);

    private async Task OnDeloadPlanClick() =>
        await SendPrompt(Loc["Create a deload version of my primary workout plan."]);

    private async Task SendPrompt(string prompt)
    {
        _inputText = prompt;
        await SendMessageAsync();
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(_inputText) || _isSending) return;

        var text = _inputText;
        _inputText = string.Empty;
        _isSending = true;

        try
        {
            await AiAssistant.SendUserMessageAsync(text);
        }
        finally
        {
            _isSending = false;
        }
    }

    private void NavigateToSettings()
    {
        MudDialog?.Close();
        Navigation.NavigateTo(AppRoutes.Settings);
    }

    private void ClearHistory()
    {
        AiAssistant.ClearHistory();
    }

    private void Close()
    {
        MudDialog?.Close();
    }

    public void Dispose()
    {
        AiAssistant.CancelCurrentTurn();
        AiAssistant.OnMessagesChanged -= HandleMessagesChanged;
    }
}
