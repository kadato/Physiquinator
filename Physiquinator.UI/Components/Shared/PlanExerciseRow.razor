@using Physiquinator.Core.Formatting
@using Physiquinator.Core.Models
@using Physiquinator.Core.Services
@inject WeightUnitService WeightUnit

<div class="plan-exercise-row mud-paper mud-elevation-1" @key="Exercise.Id">
    <div class="plan-exercise-row__main">
        <button type="button"
                class="plan-exercise-handle"
                aria-label="@(string.Format("Drag to reorder {0}", Exercise.Name))">
            <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Medium" />
        </button>

        <button type="button"
                class="plan-exercise-row__body"
                @onclick="OnEdit">
            <span class="plan-exercise-row__index" aria-hidden="true">@DisplayIndex</span>
            <span class="plan-exercise-row__text">
                <span class="plan-exercise-row__name">
                    @Exercise.Name
                    @if (!string.IsNullOrEmpty(Exercise.SupersetGroupId))
                    {
                        <span class="plan-exercise-row__chip plan-exercise-row__chip--superset"
                              aria-label="@(string.Format("Superset group {0}", Exercise.SupersetGroupId))">@Exercise.SupersetGroupId</span>
                    }
                </span>
                <span class="plan-exercise-row__summary mud-text-secondary">@Summary</span>
            </span>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="plan-exercise-row__chevron" />
        </button>
    </div>

    <div class="plan-exercise-row__actions">
        <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                 Class="plan-exercise-row__menu"
                 Dense="true"
                 AriaLabel="@(string.Format("Actions for {0}", Exercise.Name))">
            <MudMenuItem Icon="@Icons.Material.Filled.ArrowUpward"
                         Disabled="@(!CanMoveUp)"
                         OnClick="MoveUp">Move up</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.ArrowDownward"
                         Disabled="@(!CanMoveDown)"
                         OnClick="MoveDown">Move down</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Outlined.DeleteOutline"
                         IconColor="Color.Error"
                         OnClick="OnDelete">Delete</MudMenuItem>
        </MudMenu>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ExercisePlan Exercise { get; set; }

    [Parameter]
    public int Index { get; set; }

    [Parameter]
    public bool CanMoveUp { get; set; }

    [Parameter]
    public bool CanMoveDown { get; set; }

    [Parameter]
    public EventCallback OnEdit { get; set; }

    [Parameter]
    public EventCallback OnDelete { get; set; }

    [Parameter]
    public EventCallback<int> OnMoveUp { get; set; }

    [Parameter]
    public EventCallback<int> OnMoveDown { get; set; }

    private Task MoveUp() => OnMoveUp.InvokeAsync(Index);

    private Task MoveDown() => OnMoveDown.InvokeAsync(Index);

    private int DisplayIndex => Index + 1;

    private string Summary => FormatSummary(Exercise, WeightUnit.Current);

    internal static string FormatSummary(ExercisePlan exercise, WeightUnit unit)
    {
        var parts = new List<string>
        {
            string.Format("{0} sets", exercise.TotalSetCount)
        };

        if (exercise.WarmupSetCount > 0)
            parts.Add(string.Format("{0} warm-up", exercise.WarmupSetCount));

        parts.Add(string.Format("{0}s rest", exercise.RestIntervalSeconds));

        if (exercise.DefaultReps.HasValue)
            parts.Add(string.Format("{0} reps", exercise.DefaultReps));

        if (exercise.LogType == ExerciseLogType.BodyweightReps && exercise.BodyweightPercent.HasValue)
            parts.Add(string.Format("{0} bodyweight", ExerciseCatalog.FormatShare(exercise.BodyweightPercent)));

        if (exercise.DefaultWeightKg.HasValue)
            parts.Add(string.Format("{0}", ExerciseWeightFormatter.FormatWeightWithUnit(exercise.DefaultWeightKg.Value, unit)));

        return string.Join(" · ", parts);
    }
}
