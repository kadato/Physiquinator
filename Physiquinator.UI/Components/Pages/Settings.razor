@page "/settings"
@using Physiquinator.Core.Services
@using Physiquinator.Core.Services.Ai
@using Physiquinator.Core.Models
@using Physiquinator.UI.Components.Shared
@inject ThemeService ThemeService
@inject RestAlertSettingsService RestAlertSettings
@inject INotificationService RestNotifications
@inject WorkoutPlanService PlanService
@inject WorkoutHistoryService HistoryService
@inject AppDataResetService AppDataReset
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject WorkoutScheduleService WorkoutSchedule
@inject IFileTransferService FileTransfer
@inject IAppUpdateService AppUpdateService
@inject AppUpdateSettingsService AppUpdateSettings
@inject AiAssistantService AiAssistant
@inject TimeProvider TimeProvider
@implements IDisposable


<PageTitle>Settings</PageTitle>

<MudStack Spacing="3">
    <PageHeader Title="Settings" ShowBack="false" />

    <MudText Typo="Typo.caption" Class="settings-group-label">General</MudText>
    <MudExpansionPanels Class="settings-panels" MultiExpansion="true">
        <MudExpansionPanel Class="settings-panel">
            <TitleContent>
                <div class="settings-panel__header">
                    <span class="settings-panel__icon"><MudIcon Icon="@Icons.Material.Outlined.Palette" Size="Size.Small" /></span>
                    <span class="settings-panel__text">
                        <span class="settings-panel__title">Appearance</span>
                        <span class="settings-panel__subtitle">Light or dark mode</span>
                    </span>
                </div>
            </TitleContent>
            <ChildContent>
                <div class="settings-panel__content">
                    <MudSelect T="string"
                               Variant="Variant.Filled"
                               Label="Light or dark mode"
                               Value="_preference"
                               ValueChanged="OnThemePreferenceChanged">
                        <MudSelectItem Value="@ThemePreference.System">Match system</MudSelectItem>
                        <MudSelectItem Value="@ThemePreference.Light">Light (always)</MudSelectItem>
                        <MudSelectItem Value="@ThemePreference.Dark">Dark (always)</MudSelectItem>
                    </MudSelect>
                    <MudText Typo="Typo.body2" Class="mt-2 mud-text-secondary">
                        Active mode: <strong>@_effectiveThemeLabel</strong>
                    </MudText>
                </div>
            </ChildContent>
        </MudExpansionPanel>

        <MudExpansionPanel Class="settings-panel">
            <TitleContent>
                <div class="settings-panel__header">
                    <span class="settings-panel__icon"><MudIcon Icon="@Icons.Material.Outlined.Timer" Size="Size.Small" /></span>
                    <span class="settings-panel__text">
                        <span class="settings-panel__title">Rest timer</span>
                        <span class="settings-panel__subtitle">Notifications and rest time</span>
                    </span>
                </div>
            </TitleContent>
            <ChildContent>
                <div class="settings-panel__content">
                    <MudSwitch T="bool"
                               Label="Notify when rest ends"
                               Value="_restAlertsEnabled"
                               ValueChanged="OnRestAlertsEnabledChanged" />
                    <MudText Typo="Typo.body2" Class="mt-1 mud-text-secondary">
                        Push notification when your rest timer expires. Includes the next exercise name.
                    </MudText>

                    <MudSwitch T="bool"
                               Class="mt-3"
                               Label="Sound &amp; vibration"
                               Disabled="!_restAlertsEnabled"
                               Value="_restSoundVibrationEnabled"
                               ValueChanged="OnRestSoundVibrationChanged" />
                    <MudText Typo="Typo.body2" Class="mt-1 mud-text-secondary">
                        Play the knock sound and vibrate when the rest-end notification fires.
                    </MudText>

                    <MudStack Spacing="0" Class="mt-4">
                        <SetMetricStepper Label="Add rest time (s)"
                                          @bind-Value="_addTimeSecondsValue"
                                          Step="5"
                                          Min="5"
                                          Max="300"
                                          IsInteger="true"
                                          Format="0"
                                          InputMode="numeric" />
                        <MudText Typo="Typo.body2" Class="mt-2 mud-text-secondary">
                            The + button on the rest timer adds this many seconds.
                        </MudText>
                    </MudStack>
                    <MudStack Spacing="0" Class="mt-4">
                        <MudText Typo="Typo.body2" Class="font-weight-semibold">Floating timer</MudText>
                        @if (_overlayPermissionGranted)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Success" Class="mt-1">
                                Enabled - a draggable bubble shows the rest countdown over other apps while you train.
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mt-1 mud-text-secondary">
                                The floating bubble needs the "Display over other apps" permission. Without it, no bubble appears when you leave the app during a rest.
                            </MudText>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Class="mt-3 align-self-start"
                                       StartIcon="@Icons.Material.Filled.PictureInPictureAlt"
                                       OnClick="OpenOverlaySettingsAsync">
                                Grant permission
                            </MudButton>
                        }
                    </MudStack>
                </div>
            </ChildContent>
        </MudExpansionPanel>

        <MudExpansionPanel Class="settings-panel">
            <TitleContent>
                <div class="settings-panel__header">
                    <span class="settings-panel__icon"><MudIcon Icon="@Icons.Material.Outlined.People" Size="Size.Small" /></span>
                    <span class="settings-panel__text">
                        <span class="settings-panel__title">User profiles</span>
                        <span class="settings-panel__subtitle">Create, switch, and manage profiles</span>
                    </span>
                </div>
            </TitleContent>
            <ChildContent>
                <div class="settings-panel__content">
                    <UserProfilesPanel />
                </div>
            </ChildContent>
        </MudExpansionPanel>

        <MudExpansionPanel Class="settings-panel">
            <TitleContent>
                <div class="settings-panel__header">
                    <span class="settings-panel__icon"><MudIcon Icon="@Icons.Material.Outlined.EventRepeat" Size="Size.Small" /></span>
                    <span class="settings-panel__text">
                        <span class="settings-panel__title">Workout schedule</span>
                        <span class="settings-panel__subtitle">Keep your streak alive on rest days</span>
                    </span>
                </div>
            </TitleContent>
            <ChildContent>
                <div class="settings-panel__content">
                    <MudText Typo="Typo.body2" Class="mb-2">
                        Pick the days you normally train.
                    </MudText>
                    <div class="settings-schedule-days">
                        @foreach (var day in ScheduleDayOrder)
                        {
                            var d = day;
                            <MudChip T="string"
                                     Text="@d.ToString()[..3]"
                                     Variant="@(_scheduleDays.Contains(d) ? Variant.Filled : Variant.Outlined)"
                                     Color="Color.Primary"
                                     Class="settings-schedule-day"
                                     OnClick="@(() => ToggleScheduleDay(d))" />
                        }
                    </div>
                    @if (_scheduleDays.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mt-3 mud-text-secondary">
                            No schedule yet. Without one, your streak counts every calendar day you train, so two rest days in a row end it.
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="mt-3 mud-text-secondary">
                            @ScheduleSummaryLabel
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mt-1 mud-text-secondary">
                            Rest days never break your streak. A scheduled day you skip does.
                        </MudText>
                    }
                </div>
            </ChildContent>
        </MudExpansionPanel>

        <MudExpansionPanel Class="settings-panel">
            <TitleContent>
                <div class="settings-panel__header">
                    <span class="settings-panel__icon"><MudIcon Icon="@Icons.Material.Outlined.SmartToy" Size="Size.Small" /></span>
                    <span class="settings-panel__text">
                        <span class="settings-panel__title">AI Assistant</span>
                        <span class="settings-panel__subtitle">Configure OpenAI / OpenRouter / Ollama API</span>
                    </span>
                </div>
            </TitleContent>
            <ChildContent>
                <div class="settings-panel__content">
                    <MudSwitch T="bool"
                               Label="Enable AI Assistant"
                               Value="_aiSettings.Enabled"
                               ValueChanged="OnAiEnabledChanged" />

                    @if (_aiSettings.Enabled)
                    {
                        <MudStack Spacing="3" Class="mt-3">
                            <MudSelect T="AiProviderType"
                                       Label="Provider Preset"
                                       Variant="Variant.Filled"
                                       Value="_aiSettings.Provider"
                                       ValueChanged="OnAiProviderChanged">
                                <MudSelectItem Value="AiProviderType.OpenAI">OpenAI (Official)</MudSelectItem>
                                <MudSelectItem Value="AiProviderType.OpenRouter">OpenRouter (Claude, Llama, DeepSeek)</MudSelectItem>
                                <MudSelectItem Value="AiProviderType.OpenCode">OpenCode</MudSelectItem>
                                <MudSelectItem Value="AiProviderType.OllamaLocal">Ollama / Local (http://localhost:11434/v1)</MudSelectItem>
                                <MudSelectItem Value="AiProviderType.Custom">Custom OpenAI-Compatible API</MudSelectItem>
                            </MudSelect>

                            <MudTextField T="string"
                                          Label="API Base URL"
                                          Variant="Variant.Filled"
                                          @bind-Value="_aiSettings.BaseUrl"
                                          HelperText="Standard base URL (e.g. https://api.openai.com/v1)" />

                            <MudTextField T="string"
                                          Label="API Key"
                                          Variant="Variant.Filled"
                                          InputType="@(_showApiKey ? InputType.Text : InputType.Password)"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@(_showApiKey ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                          OnAdornmentClick="@(() => _showApiKey = !_showApiKey)"
                                          @bind-Value="_aiSettings.ApiKey"
                                          HelperText="Stored securely on-device" />

                             @if (_fetchingModels)
                             {
                                 <div class="d-flex align-center gap-2 py-1">
                                     <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                                     <MudText Typo="Typo.caption" Class="mud-text-secondary">Fetching models from endpoint...</MudText>
                                 </div>
                             }

                             @if (_availableModels.Count > 0)
                             {
                                 <MudSelect T="string"
                                            Label="Model Name"
                                            Variant="Variant.Filled"
                                            Value="_aiSettings.ModelName"
                                            ValueChanged="OnModelSelected"
                                            HelperText="Select from models fetched dynamically from endpoint">
                                     @foreach (var m in _availableModels)
                                     {
                                         <MudSelectItem Value="@m">@m</MudSelectItem>
                                     }
                                 </MudSelect>
                             }
                             else
                             {
                                 <MudTextField T="string"
                                               Label="Model Name"
                                               Variant="Variant.Filled"
                                               @bind-Value="_aiSettings.ModelName"
                                               HelperText="e.g. gpt-4o-mini, anthropic/claude-3.5-sonnet, deepseek/deepseek-r1" />
                             }

                            <MudTextField T="string"
                                          Label="Custom Instructions / Prompt (Optional)"
                                          Variant="Variant.Filled"
                                          Lines="2"
                                          @bind-Value="_aiSettings.CustomSystemPrompt"
                                          HelperText="Extra instructions passed to the AI assistant" />

                            <div class="settings-btn-group mt-2">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           OnClick="SaveAiSettings"
                                           StartIcon="@Icons.Material.Filled.Save">
                                    Save Settings
                                </MudButton>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Info"
                                           Disabled="_fetchingModels"
                                           OnClick="FetchModelsAsync"
                                           StartIcon="@Icons.Material.Filled.CloudDownload">
                                    @if (_fetchingModels)
                                    {
                                        <span>Fetching...</span>
                                    }
                                    else
                                    {
                                        <span>Fetch Models</span>
                                    }
                                </MudButton>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Secondary"
                                           Disabled="_testingAiConnection"
                                           OnClick="TestAiConnectionAsync"
                                           StartIcon="@Icons.Material.Filled.CheckCircle">
                                    @if (_testingAiConnection)
                                    {
                                        <span>Testing...</span>
                                    }
                                    else
                                    {
                                        <span>Test Connection</span>
                                    }
                                </MudButton>
                            </div>
                        </MudStack>
                    }
                </div>

            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>


    <MudText Typo="Typo.caption" Class="settings-group-label">Data</MudText>
    <MudExpansionPanels Class="settings-panels" MultiExpansion="true">
        <MudExpansionPanel Class="settings-panel">
            <TitleContent>
                <div class="settings-panel__header">
                    <span class="settings-panel__icon"><MudIcon Icon="@Icons.Material.Outlined.Backup" Size="Size.Small" /></span>
                    <span class="settings-panel__text">
                        <span class="settings-panel__title">Backup</span>
                        <span class="settings-panel__subtitle">Export or import plans and history</span>
                    </span>
                </div>
            </TitleContent>
            <ChildContent>
                <div class="settings-panel__content">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                        Export all plans as JSON, or import a file you exported earlier.
                    </MudText>
                    <div class="settings-btn-group">
                        <MudButton Variant="Variant.Outlined"
                                   Disabled="@(_planCount == 0)"
                                   OnClick="ExportAllPlans"
                                   StartIcon="@Icons.Material.Filled.Upload">
                            Export all plans
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" OnClick="ImportPlans" StartIcon="@Icons.Material.Filled.Download">
                            Import plans
                        </MudButton>
                    </div>
                    @if (_planCount == 0)
                    {
                        <MudText Typo="Typo.caption" Class="mt-2 d-block mud-text-secondary">Create a plan first to enable export.</MudText>
                    }

                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-4 mb-3">
                        Export or import workout history JSON. Import merges by session and set id.
                    </MudText>
                    <div class="settings-btn-group">
                        <MudButton Variant="Variant.Outlined"
                                   Disabled="@(_historySessionCount == 0)"
                                   OnClick="ExportHistory"
                                   StartIcon="@Icons.Material.Filled.Upload">
                            Export history
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" OnClick="ImportHistory" StartIcon="@Icons.Material.Filled.Download">
                            Import history
                        </MudButton>
                    </div>
                    @if (_historySessionCount == 0)
                    {
                        <MudText Typo="Typo.caption" Class="mt-2 d-block mud-text-secondary">Finish at least one workout to enable export.</MudText>
                    }
                </div>
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>

    <MudText Typo="Typo.caption" Class="settings-group-label">About</MudText>
    <MudExpansionPanels Class="settings-panels" MultiExpansion="true">
        @if (AppUpdateService.IsSupported)
        {
            <MudExpansionPanel Class="settings-panel">
                <TitleContent>
                    <div class="settings-panel__header">
                        <span class="settings-panel__icon"><MudIcon Icon="@Icons.Material.Outlined.SystemUpdate" Size="Size.Small" /></span>
                        <span class="settings-panel__text">
                            <span class="settings-panel__title">Updates</span>
                            <span class="settings-panel__subtitle">Version @_currentVersion</span>
                        </span>
                    </div>
                </TitleContent>
                <ChildContent>
                    <div class="settings-panel__content">
                        <MudSwitch T="bool"
                                   Label="Check for updates automatically"
                                   Value="_autoCheckEnabled"
                                   ValueChanged="OnAutoCheckEnabledChanged" />
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                            When on, the app checks GitHub for a newer release on startup and shows the update popup if one is available.
                            Turn it off to never be notified about updates.
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                            New releases are published on GitHub and can be installed from here.
                        </MudText>
                        <div class="settings-btn-group">
                            <MudButton Variant="Variant.Outlined"
                                       Disabled="@_checkingForUpdates"
                                       OnClick="CheckForUpdatesAsync"
                                       StartIcon="@Icons.Material.Filled.SystemUpdate">
                                Check for updates
                            </MudButton>
                        </div>
                        @if (_checkingForUpdates)
                        {
                            <MudProgressLinear Indeterminate="true" Class="mt-3" Color="Color.Primary" />
                        }
                        @if (_latestRelease != null)
                        {
                            <div class="mt-3">
                                <MudText Typo="Typo.body2">
                                    Latest release: <strong>@_latestRelease.Tag</strong>
                                    @if (_latestRelease.PublishedAt is { } published)
                                    {
                                        <span class="mud-text-secondary">(@published.ToLocalTime():d)</span>
                                    }
                                </MudText>
                                @if (_updateAvailable && string.IsNullOrEmpty(_downloadUrl))
                                {
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                        A newer version is available, but in-app updates are not supported on this platform.
                                    </MudText>
                                }
                                else if (_updateAvailable)
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Primary">A newer version is available.</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Success">You are on the latest version.</MudText>
                                }
                            </div>
                        }
                    </div>
                </ChildContent>
            </MudExpansionPanel>
        }

        <MudExpansionPanel Class="settings-panel settings-panel--danger">
            <TitleContent>
                <div class="settings-panel__header">
                    <span class="settings-panel__icon"><MudIcon Icon="@Icons.Material.Outlined.WarningAmber" Size="Size.Small" /></span>
                    <span class="settings-panel__text">
                        <span class="settings-panel__title">Remove all data</span>
                        <span class="settings-panel__subtitle">Permanently deletes everything on this device</span>
                    </span>
                </div>
            </TitleContent>
            <ChildContent>
                <div class="settings-panel__content">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                        Permanently deletes every plan and workout log on this device. Export backups first if needed.
                    </MudText>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               OnClick="RemoveAllDataAsync"
                               StartIcon="@Icons.Material.Filled.DeleteForever"
                               Class="btn-premium-ghost">
                        Remove all data…
                    </MudButton>
                </div>
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>
</MudStack>

@code {
    private string _preference = ThemePreference.System;
    private string _effectiveTheme = ThemePreference.Dark;
    private bool _restAlertsEnabled = true;
    private bool _restSoundVibrationEnabled = true;
    private bool _overlayPermissionGranted = true;
    private int _planCount;
    private int _historySessionCount;
    private int _addTimeSeconds = 30;

    private string _effectiveThemeLabel => _effectiveTheme == ThemePreference.Light ? "Light" : "Dark";

    private static readonly DayOfWeek[] ScheduleDayOrder =
    [
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday,
        DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday
    ];

    private HashSet<DayOfWeek> _scheduleDays = [];

    private string ScheduleSummaryLabel
    {
        get
        {
            var days = string.Join(", ", ScheduleDayOrder.Where(_scheduleDays.Contains).Select(d => d.ToString()[..3]));
            var next = WorkoutSchedule.NextWorkoutDay(DateOnly.FromDateTime(DateTime.Today));
            var nextLabel = next is { } n ? $"{n.DayOfWeek} {UiDateFormats.DateOnlyCompact(n)}" : "—";
            return $"You train {_scheduleDays.Count} day(s) per week: {days}. Next training day: {nextLabel}.";
        }
    }

    private string _currentVersion = string.Empty;
    private GitHubRelease? _latestRelease;
    private bool _updateAvailable;
    private string? _downloadUrl;
    private bool _checkingForUpdates;
    private bool _autoCheckEnabled = true;

    private double? _addTimeSecondsValue
    {
        get => _addTimeSeconds;
        set
        {
            var next = (int)Math.Round(value ?? RestAlertSettings.AddTimeSeconds);
            next = Math.Clamp(next, 5, 300);
            _addTimeSeconds = next;
            RestAlertSettings.SetAddTimeSeconds(next);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ThemeService.ThemeChanged += HandleSettingsChanged;
        RestAlertSettings.Changed += HandleSettingsChanged;
        WorkoutSchedule.Changed += HandleSettingsChanged;
        SyncFromService();
        _overlayPermissionGranted = RestNotifications.HasOverlayPermission();
        await RefreshPlanCountAsync();
        await RefreshHistoryCountAsync();
        _currentVersion = AppUpdateService.CurrentVersion.ToString();
        _autoCheckEnabled = AppUpdateSettings.AutoCheckEnabled;
    }

    /// <summary>
    /// Re-checks the overlay permission on every render so the status updates
    /// after the user returns from the system settings screen.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var granted = RestNotifications.HasOverlayPermission();
        if (granted != _overlayPermissionGranted)
        {
            _overlayPermissionGranted = granted;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenOverlaySettingsAsync()
    {
        await RestNotifications.RequestOverlayPermissionAsync();
        _overlayPermissionGranted = RestNotifications.HasOverlayPermission();
    }

    private AiProviderSettings _aiSettings = new();
    private bool _showApiKey;
    private bool _testingAiConnection;
    private bool _fetchingModels;
    private List<string> _availableModels = [];

    private void OnModelSelected(string model)
    {
        _aiSettings.ModelName = model;
        SaveAiSettings();
    }

    private async Task FetchModelsAsync()
    {
        _fetchingModels = true;
        try
        {
            SaveAiSettings();
            _availableModels = await AiAssistant.FetchAvailableModelsAsync();
            if (_availableModels.Count > 0)
            {
                Snackbar.Add($"Fetched {_availableModels.Count} available models!", Severity.Success);
            }
            else
            {
                Snackbar.Add("No models returned. Verify Base URL and API key.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to fetch models: {ex.Message}", Severity.Error);
        }
        finally
        {
            _fetchingModels = false;
        }
    }


    private void SyncFromService()
    {
        _preference = ThemeService.Preference;
        _effectiveTheme = ThemeService.EffectiveTheme;
        _restAlertsEnabled = RestAlertSettings.Enabled;
        _restSoundVibrationEnabled = RestAlertSettings.SoundVibrationEnabled;
        _addTimeSeconds = RestAlertSettings.AddTimeSeconds;
        _scheduleDays = [.. WorkoutSchedule.Days];
        _aiSettings = AiAssistant.GetSettings();
    }

    private void OnAiEnabledChanged(bool enabled)
    {
        _aiSettings.Enabled = enabled;
        SaveAiSettings();
    }

    private async Task OnAiProviderChanged(AiProviderType provider)
    {
        _aiSettings.Provider = provider;
        _aiSettings.BaseUrl = _aiSettings.GetDefaultBaseUrl();
        _aiSettings.ModelName = _aiSettings.GetDefaultModel();
        SaveAiSettings();
        await FetchModelsAsync();
    }



    private void SaveAiSettings()
    {
        AiAssistant.SaveSettings(_aiSettings);
        Snackbar.Add("AI Assistant settings saved.", Severity.Success);
    }

    private async Task TestAiConnectionAsync()
    {
        _testingAiConnection = true;
        try
        {
            SaveAiSettings();
            await AiAssistant.SendUserMessageAsync("Hello! Respond with a brief 1-sentence confirmation that connection is successful.");
            var lastMsg = AiAssistant.Messages.LastOrDefault();
            if (lastMsg != null && lastMsg.IsError)
            {
                Snackbar.Add($"Connection test failed: {lastMsg.Content}", Severity.Error);
            }
            else
            {
                Snackbar.Add("AI Connection test successful!", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Test failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _testingAiConnection = false;
        }
    }


    private void ToggleScheduleDay(DayOfWeek day)
    {
        if (!_scheduleDays.Add(day))
            _scheduleDays.Remove(day);

        WorkoutSchedule.SetDays(_scheduleDays);
    }

    private void HandleSettingsChanged()
    {
        SyncFromService();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnRestAlertsEnabledChanged(bool enabled)
    {
        RestAlertSettings.SetEnabled(enabled);
        _restAlertsEnabled = enabled;
    }

    private void OnRestSoundVibrationChanged(bool enabled)
    {
        RestAlertSettings.SetSoundVibrationEnabled(enabled);
        _restSoundVibrationEnabled = enabled;
    }

    private void OnAutoCheckEnabledChanged(bool enabled)
    {
        AppUpdateSettings.SetAutoCheckEnabled(enabled);
        _autoCheckEnabled = enabled;
    }

    private async Task OnThemePreferenceChanged(string preference)
    {
        await ThemeService.SetPreferenceAsync(preference);
    }

    private async Task RefreshPlanCountAsync()
    {
        var plans = await PlanService.GetAllPlansAsync();
        _planCount = plans.Count;
    }

    private async Task RefreshHistoryCountAsync()
    {
        _historySessionCount = await HistoryService.GetSessionCountAsync();
    }

    private async Task ExportAllPlans()
    {
        try
        {
            var json = await PlanService.ExportAllPlansToJsonAsync();
            await FileTransfer.ExportJsonAsync(FileTransferNames.JsonFileName("physiquinator_plans", TimeProvider.GetLocalNow()), json);
            Snackbar.Add("All plans exported.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task ImportPlans()
    {
        try
        {
            var json = await FileTransfer.PickJsonAsync("Select workout plan JSON file");
            if (json == null)
                return;

            var importedCount = 0;
            try
            {
                var plans = await PlanService.ImportPlansFromJsonAsync(json);
                importedCount = plans.Count;
            }
            catch
            {
                await PlanService.ImportPlanFromJsonAsync(json);
                importedCount = 1;
            }

            await RefreshPlanCountAsync();
            Snackbar.Add($"Imported {importedCount} plan(s).", Severity.Success);
            Navigation.NavigateTo(AppRoutes.Home);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Import failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task ExportHistory()
    {
        try
        {
            var json = await HistoryService.ExportToJsonAsync();
            await FileTransfer.ExportJsonAsync(
                FileTransferNames.JsonFileName("physiquinator_history", TimeProvider.GetLocalNow()),
                json,
                "Export workout history");
            Snackbar.Add("Workout history exported.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task ImportHistory()
    {
        try
        {
            var json = await FileTransfer.PickJsonAsync("Select workout history JSON file");
            if (json == null)
                return;

            var (sessions, sets) = await HistoryService.ImportFromJsonAsync(json);
            await RefreshHistoryCountAsync();
            Snackbar.Add($"Imported {sessions} workout(s) and {sets} set log(s).", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Import failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task RemoveAllDataAsync()
    {
        var confirmed = await DialogService.ConfirmAsync(
            "Remove all data?",
            "This cannot be undone. Export any backups you need before continuing.",
            confirmText: "Remove",
            confirmColor: Color.Error);

        if (!confirmed)
            return;

        try
        {
            await AppDataReset.ClearAllLocalDataAsync();
            SyncFromService();
            await RefreshPlanCountAsync();
            await RefreshHistoryCountAsync();
            Snackbar.Add("All local data has been removed.", Severity.Success);
            Navigation.NavigateTo(AppRoutes.Home);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not remove data: {ex.Message}", Severity.Error);
        }
    }

    private async Task CheckForUpdatesAsync()
    {
        _checkingForUpdates = true;
        _latestRelease = null;
        _updateAvailable = false;
        _downloadUrl = null;
        try
        {
            var result = await AppUpdateService.CheckForUpdatesAsync();
            _latestRelease = result.Latest;
            _updateAvailable = result.IsUpdateAvailable;
            _downloadUrl = result.DownloadUrl;
            if (!_updateAvailable)
            {
                Snackbar.Add("You are on the latest version.", Severity.Success);
            }
            else if (string.IsNullOrEmpty(_downloadUrl))
            {
                Snackbar.Add("A newer version is available, but in-app updates are not supported on this platform.", Severity.Info);
            }
            else if (result.Latest is { } release)
            {
                var parameters = new DialogParameters<UpdateDialog>
                {
                    { x => x.Release, release },
                    { x => x.DownloadUrl, _downloadUrl },
                };

                var options = new DialogOptions
                {
                    CloseButton = true,
                    CloseOnEscapeKey = true,
                    MaxWidth = MaxWidth.Small,
                    FullWidth = true,
                };

                await DialogService.ShowAsync<UpdateDialog>("Update available", parameters, options);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not check for updates: {ex.Message}", Severity.Error);
        }
        finally
        {
            _checkingForUpdates = false;
        }
    }

    public void Dispose()
    {
        ThemeService.ThemeChanged -= HandleSettingsChanged;
        RestAlertSettings.Changed -= HandleSettingsChanged;
        WorkoutSchedule.Changed -= HandleSettingsChanged;
    }
}
