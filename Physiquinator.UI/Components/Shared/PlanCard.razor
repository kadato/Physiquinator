
<MudCard Class="plan-card" Elevation="0" data-plan-index="@(PlanIndex.ToString("D2"))">
    <MudCardContent Class="plan-card__content">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2" Class="plan-card__row">
            <button type="button"
                    class="plan-card-handle"
                    aria-label="@(string.Format("Drag to reorder {0}", PlanName))">
                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Medium" />
            </button>
            <MudStack Spacing="0" Class="plan-card__info">
                <MudText Typo="Typo.subtitle1" Class="plan-card-name">@PlanName</MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="plan-card__meta">
                    <span class="mono-token" aria-hidden="true">@PlanIndex.ToString("D2") • @ExerciseCountLabel</span>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@LastDoneSuffix.TrimStart(' ', '·')</MudText>
                </MudStack>
            </MudStack>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="plan-card__actions">
                <MudIconButton Icon="@Icons.Material.Filled.PlayArrow"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Class="plan-card-icon-btn"
                               aria-label="@(string.Format("Start {0}", PlanName))"
                               OnClick="OnStart" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Class="plan-card-icon-btn"
                               aria-label="@(string.Format("Edit {0}", PlanName))"
                               OnClick="OnEdit" />
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Class="plan-card-icon-btn" Dense="true" AriaLabel="@("Plan options")">
                    <MudMenuItem Icon="@Icons.Material.Filled.ArrowUpward"
                                 Disabled="@(!CanMoveUp)"
                                 OnClick="OnMoveUp">Move up</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.ArrowDownward"
                                 Disabled="@(!CanMoveDown)"
                                 OnClick="OnMoveDown">Move down</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Upload" OnClick="OnExport">@("Export")</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Outlined.DeleteOutline" IconColor="Color.Error" OnClick="OnDelete">@("Delete")</MudMenuItem>
                </MudMenu>
            </MudStack>
        </MudStack>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public string PlanName { get; set; } = "";
    [Parameter] public int ExerciseCount { get; set; }
    [Parameter] public string LastDoneLabel { get; set; } = "";
    [Parameter] public int PlanIndex { get; set; } = 1;
    [Parameter] public EventCallback OnStart { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnExport { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public bool CanMoveUp { get; set; }
    [Parameter] public bool CanMoveDown { get; set; }
    [Parameter] public EventCallback OnMoveUp { get; set; }
    [Parameter] public EventCallback OnMoveDown { get; set; }

    private string ExerciseCountLabel =>
        ExerciseCount == 1 ? "1 exercise" : string.Format("{0} exercises", ExerciseCount);

    private string LastDoneSuffix =>
        string.IsNullOrEmpty(LastDoneLabel) ? "" : $" · {LastDoneLabel}";
}
