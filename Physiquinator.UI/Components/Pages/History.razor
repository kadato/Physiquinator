@page "/history"
@implements IAsyncDisposable
@inject WorkoutHistoryRepository HistoryRepo
@inject NavigationManager Navigation
@inject WorkoutStatsService StatsService
@inject WorkoutScheduleService ScheduleService
@inject UserProfileService UserProfileService
@inject ISnackbar Snackbar
@inject WeightUnitService WeightUnitService
@inject IJSRuntime JS
<MudStack Spacing="3">
    <PageHeader Title="Workout history" ShowBack="false" />
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        Tap a day on the grid to filter the list. Each square is one calendar day; weeks run Monday–Sunday.
    </MudText>

    @if (_sessions == null || _activityByDay == null || _listSessions == null || _summary == null)
    {
        <LoadingCenter Label="Loading history…" />
    }
    else
    {
        <MudTextField T="string"
                      Value="_searchText"
                      ValueChanged="OnSearchTextChanged"
                      Placeholder="Search by plan or exercise name..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true"
                      Variant="Variant.Outlined"
                      Class="mb-2" />

        <MudPaper Class="pa-4 history-heatmap-panel" Elevation="1">
            <ActivityHeatmap CountsByDay="_activityByDay"
                             Weeks="@HeatmapWeeks"
                             EndLocal="@_heatmapEndLocal"
                             GetScheduleForDate="ScheduleService.GetScheduleForDate"
                             SelectedDay="_selectedDay"
                             SelectedDayChanged="OnSelectedDayChanged" />
        </MudPaper>

        <div class="history-stats">
            <StatCard Value="@_summary.CurrentStreakWorkoutDays.ToString()" Label="Streak" />
            <StatCard Value="@_summary.LongestStreakWorkoutDays.ToString()" Label="Longest streak" />
            <StatCard Value="@_summary.ThisWeekSessionCount.ToString()" Label="This week" />
            <StatCard Value="@_summary.LastWeekSessionCount.ToString()" Label="Last week" />
        </div>

        <MudPaper Class="pa-3 bodyweight-panel" Elevation="1">
            <div class="bodyweight-panel__header">
                <MudText Typo="Typo.h6">Bodyweight</MudText>
                <span class="bodyweight-panel__right">
                    @if (_latestBodyweight is { } latest)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                            @ExerciseWeightFormatter.FormatWeightWithUnit(latest.BodyweightKg, WeightUnitService.Current) · @UiDateFormats.DateOnlyCompact(latest.DateOnly)
                        </MudChip>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Class="bodyweight-panel__details-btn"
                                   StartIcon="@Icons.Material.Filled.ShowChart"
                                   OnClick="OpenBodyweightProgress">
                            View details
                        </MudButton>
                    }
                </span>
            </div>

            <div class="bodyweight-log-row">
                <SetMetricStepper Value="@BodyweightInputDisplay"
                                  ValueChanged="OnBodyweightInputChanged"
                                  Step="@BodyweightStep"
                                  Min="@BodyweightMin"
                                  Max="@BodyweightMax"
                                  IsInteger="false"
                                  Format="0.#"
                                  Compact="true"
                                  Unit="@ExerciseWeightFormatter.UnitSuffix(WeightUnitService.Current)"
                                  Placeholder="@(_bodyweightDefault is { } d ? ExerciseWeightFormatter.ToDisplay(d, WeightUnitService.Current) : null)" />
                <button type="button"
                        class="bodyweight-log-row__log-btn"
                        @onclick="LogBodyweightAsync"
                        disabled="@CannotLogBodyweight">
                    <MudIcon Icon="@Icons.Material.Filled.MonitorWeight" Size="Size.Small" />
                    Log
                </button>
            </div>
        </MudPaper>

        @if (_selectedDay is { } selectedDay)
        {
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudChip T="string" Color="Color.Primary" OnClose="ClearDayFilter">
                    @UiDateFormats.DateOnlyCompact(selectedDay)
                </MudChip>
                @if (!_listSessions.Any())
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">— none logged.</MudText>
                }
            </MudStack>
        }

        @if (!_sessions.Any())
        {
            <EmptyState Message="No logged workouts yet. Start a plan from home."
                        Icon="@Icons.Material.Outlined.History" />
        }
        else if (!_listSessions.Any() && _selectedDay != null)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Pick another day or clear the filter.
            </MudText>
        }
        else
        {
            <div class="history-session-list">
                @foreach (var s in _listSessions)
                {
                    var sid = s.Id;
                    <button @key="s.Id" type="button" class="history-session-card" @onclick="@(() => OpenSession(sid))">
                        <div class="history-session-card__inner">
                            <div class="history-session-card__left">
                                <div class="history-session-card__info">
                                    <span class="history-session-card__title">@s.PlanName</span>
                                    <span class="history-session-card__subtitle">
                                        @UiDateFormats.LocalDateTimeCompact(s.StartedAtUtc)
                                        @if (s.EndedAtUtc != null)
                                        {
                                            <span> · @UiDateFormats.LocalDateTimeCompact(s.EndedAtUtc.Value)</span>
                                        }
                                        else
                                        {
                                            <span class="history-session-card__badge-inprogress">In progress</span>
                                        }
                                    </span>
                                </div>
                            </div>
                            <div class="history-session-card__right">
                                @if (s.EndedAtUtc == null && s.TryGetPlanId() is { } continuePlanId)
                                {
                                    <span @onclick:stopPropagation="true">
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Class="history-session-card__continue-btn"
                                                   OnClick="@(() => ContinueWorkout(continuePlanId))">
                                            Continue
                                        </MudButton>
                                    </span>
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="history-session-card__chevron" />
                                }
                            </div>
                        </div>
                    </button>
                }
            </div>

            @if (_isLoadingMore)
            {
                <div class="history-infinite-scroll-loading" aria-hidden="true">
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                </div>
            }

            @if (_hasMoreSessions && _selectedDay == null)
            {
                <div id="@LoadMoreSentinelId" class="history-infinite-scroll-sentinel" aria-hidden="true"></div>
            }
        }
    }
</MudStack>

@code {
    private const int HeatmapWeeks = 53;
    private const int SessionPageSize = 50;
    private const string LoadMoreSentinelId = "history-load-more-sentinel";

    private List<WorkoutSessionLogEntity>? _sessions;
    private IReadOnlyList<WorkoutSessionLogEntity>? _listSessions;
    private IReadOnlyList<WorkoutSessionLogEntity>? _daySessions;
    private IReadOnlyDictionary<DateOnly, int>? _activityByDay;
    private DateOnly _heatmapEndLocal;
    private WorkoutDaySummary? _summary;
    private DateOnly? _selectedDay;
    private string _searchText = "";
    private int _loadedSessionCount;
    private bool _hasMoreSessions;
    private bool _isLoadingMore;
    private bool _sentinelObserved;
    private DotNetObjectReference<History>? _dotNetRef;

    private BodyweightEntry? _latestBodyweight;
    private double? _bodyweightInputKg;
    private double? _bodyweightDefault;

    private double? BodyweightInputDisplay =>
        _bodyweightInputKg is { } kg ? ExerciseWeightFormatter.ToDisplay(kg, WeightUnitService.Current) : null;

    private double BodyweightStep => WeightUnitService.Current == WeightUnit.Pounds ? 1 : 0.5;

    private double BodyweightMin => ExerciseWeightFormatter.ToDisplay(1, WeightUnitService.Current);

    private double BodyweightMax => ExerciseWeightFormatter.ToDisplay(500, WeightUnitService.Current);

    private void OpenSession(string sessionId) =>
        Navigation.NavigateTo(AppRoutes.HistorySession(sessionId));

    private void ContinueWorkout(Guid planId) =>
        Navigation.NavigateTo(AppRoutes.Workout(planId));

    private void OpenBodyweightProgress() =>
        Navigation.NavigateTo(AppRoutes.Bodyweight);

    protected override async Task OnInitializedAsync()
    {
        _heatmapEndLocal = DateOnly.FromDateTime(DateTime.Today);

        var statsTask = StatsService.GetSummaryAsync(_heatmapEndLocal, HeatmapWeeks);
        var sessionsTask = HistoryRepo.GetRecentSessionsAsync(SessionPageSize);
        var bodyweightTask = HistoryRepo.GetBodyweightLogsAsync(1);
        await Task.WhenAll(sessionsTask, statsTask, bodyweightTask);

        _sessions = [.. await sessionsTask];
        _loadedSessionCount = _sessions.Count;
        _hasMoreSessions = _sessions.Count >= SessionPageSize;
        (_summary, _activityByDay) = await statsTask;
        MapLatestBodyweight(await bodyweightTask);
        _bodyweightInputKg = _latestBodyweight?.BodyweightKg
            ?? UserProfileService.GetActiveProfile()?.BodyweightKg;
        _bodyweightDefault = _bodyweightInputKg;
        await UpdateSessionsListAsync();
    }

    /// <summary>
    /// Invoked from JS when the sentinel scrolls into view. Loads the next
    /// page of sessions and returns whether more pages may exist (the JS
    /// observer re-arms itself only while that is true).
    /// </summary>
    [JSInvokable]
    public async Task<bool> OnLoadMoreVisible()
    {
        if (_sessions == null || _selectedDay != null || !_hasMoreSessions || _isLoadingMore)
            return false;

        _isLoadingMore = true;
        try
        {
            var more = await HistoryRepo.GetRecentSessionsAsync(SessionPageSize, _loadedSessionCount);
            if (more.Count > 0)
            {
                _sessions.AddRange(more);
                _loadedSessionCount += more.Count;
            }
            _hasMoreSessions = more.Count >= SessionPageSize;
            await UpdateSessionsListAsync();
            return _hasMoreSessions;
        }
        finally
        {
            _isLoadingMore = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_selectedDay != null || !_hasMoreSessions)
        {
            if (_sentinelObserved)
            {
                await InfiniteScrollInterop.DisposeAsync(JS, LoadMoreSentinelId);
                _sentinelObserved = false;
            }
            return;
        }

        if (!_sentinelObserved)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await InfiniteScrollInterop.ObserveAsync(JS, LoadMoreSentinelId, _dotNetRef, nameof(OnLoadMoreVisible));
            _sentinelObserved = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_sentinelObserved)
        {
            try
            {
                await InfiniteScrollInterop.DisposeAsync(JS, LoadMoreSentinelId);
            }
            catch (JSDisconnectedException)
            {
                // WebView disposed
            }
            _sentinelObserved = false;
        }

        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }

    private void MapLatestBodyweight(IReadOnlyList<BodyweightLogEntity> rows)
    {
        _latestBodyweight = null;
        foreach (var row in rows)
        {
            if (row.GetDateOnlyOrNull() is { } date)
            {
                _latestBodyweight = new BodyweightEntry(date, row.BodyweightKg);
                return;
            }
        }
    }

    private async Task RefreshBodyweightAsync()
    {
        MapLatestBodyweight(await HistoryRepo.GetBodyweightLogsAsync(1));
    }

    private bool CanLogBodyweight => _bodyweightInputKg is { } weight && weight > 0;

    private bool CannotLogBodyweight => !CanLogBodyweight;

    private void OnBodyweightInputChanged(double? value) =>
        _bodyweightInputKg = value.HasValue
            ? ExerciseWeightFormatter.ToKg(value.Value, WeightUnitService.Current)
            : null;

    private async Task LogBodyweightAsync()
    {
        if (!CanLogBodyweight) return;

        var kg = _bodyweightInputKg!.Value;
        var today = DateOnly.FromDateTime(DateTime.Today);
        await HistoryRepo.UpsertBodyweightLogAsync(today, kg);

        var profile = UserProfileService.GetActiveProfile();
        if (profile != null)
        {
            UserProfileService.UpdateBodyweight(profile.Id, kg);
        }

        _bodyweightDefault = kg;
        await RefreshBodyweightAsync();
        Snackbar.Add("Bodyweight logged.", Severity.Success);
    }

    private async Task UpdateSessionsListAsync()
    {
        if (_sessions == null) return;

        IReadOnlySet<string>? exerciseSessionIds = null;
        var query = _searchText.Trim();
        if (!string.IsNullOrWhiteSpace(query))
        {
            exerciseSessionIds = await HistoryRepo.GetSessionIdsForExerciseNameAsync(query);
        }

        IEnumerable<WorkoutSessionLogEntity> source;
        if (_selectedDay == null)
        {
            source = _sessions;
        }
        else
        {
            if (_daySessions == null)
            {
                _daySessions = await HistoryRepo.GetSessionsForLocalDayAsync(_selectedDay.Value);
            }
            source = _daySessions;
        }

        if (!string.IsNullOrWhiteSpace(query))
        {
            var ids = exerciseSessionIds;
            source = source.Where(s =>
                s.PlanName.Contains(query, StringComparison.OrdinalIgnoreCase)
                || (ids != null && ids.Contains(s.Id)));
        }

        _listSessions = source.ToList();
    }

    private async Task OnSearchTextChanged(string text)
    {
        _searchText = text;
        await UpdateSessionsListAsync();
    }
 
    private async Task OnSelectedDayChanged(DateOnly? day)
    {
        _selectedDay = day;
        _daySessions = null;
        await UpdateSessionsListAsync();
    }
 
    private Task ClearDayFilter() => OnSelectedDayChanged(null);
}
