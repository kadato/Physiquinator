<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="@($"page-header mb-3 {Class}".Trim())">
    <MudText Typo="Typo.h1" Class="@($"flex-grow-1 {TitleClass}".Trim())">@Title</MudText>
    @if (ChildContent != null)
    {
        <MudStack Row="true" Spacing="1">@ChildContent</MudStack>
    }
</MudStack>

@code {
    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? TitleClass { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
