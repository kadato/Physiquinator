@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.Extensions.Logging
@using Physiquinator.Core.Services
@inject ThemeService ThemeService
@inject AppInitializationService AppInit
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject IAppUpdateService AppUpdateService
@inject AppUpdateSettingsService AppUpdateSettings
@inject WorkoutSessionService SessionService
@inject ILogger<MainLayout> Logger
@inject IJSRuntime JSRuntime
@inject Physiquinator.Core.Services.IAppPreferences AppPreferences

@{
    var appShellClasses = "app-shell" +
        (_showBottomNav ? string.Empty : " app-shell--immersive") +
        (_useFixedDockPadding ? " app-shell--fixed-dock" : string.Empty) +
        (_isDark ? " app-shell--dark-theme" : " app-shell--light-theme");
}

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (AppInit.IsReady)
{
    <div class="@appShellClasses">
        <main class="app-main-scroll">
            <MudContainer MaxWidth="MaxWidth.Small" Class="pb-4 app-page-container">
                @Body
            </MudContainer>
        </main>

        @if (_showBottomNav)
        {
            <nav class="app-nav-pill" aria-label="Main navigation">
                <div class="app-nav-pill__inner">
                    <NavLink href="@AppRoutes.Home" class="app-nav-tab" Match="NavLinkMatch.All" ActiveClass="app-nav-tab--active">
                        <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small" />
                        <span class="app-nav-tab__label">Home</span>
                    </NavLink>
                    <NavLink href="@AppRoutes.History" class="app-nav-tab" Match="NavLinkMatch.Prefix" ActiveClass="app-nav-tab--active">
                        <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" />
                        <span class="app-nav-tab__label">History</span>
                    </NavLink>
                    <NavLink href="@AppRoutes.Settings" class="app-nav-tab" Match="NavLinkMatch.Prefix" ActiveClass="app-nav-tab--active">
                        <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" />
                        <span class="app-nav-tab__label">Settings</span>
                    </NavLink>
                </div>
            </nav>
        }

        @if (ShouldShowBackFab())
        {
            <MudIconButton Class="app-fab app-fab--secondary app-fab--bl-1"
                           Icon="@Icons.Material.Filled.ArrowBack"
                           OnClick="GoBack"
                           arialabel="Go back" />
        }

        @if (ShowSimulatedOverlay)
        {
            <div class="simulated-overlay-bubble-container">
                <div class="simulated-overlay-bubble">
                    <div class="simulated-overlay-header">
                        <span class="simulated-overlay-title">Bench Press</span>
                        <div class="simulated-overlay-timer-group">
                            <span class="simulated-overlay-timer">01:15</span>
                            <button class="simulated-overlay-close-btn" aria-label="Close overlay">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                                    <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="simulated-overlay-subtitle">
                        Next: Set 2 of 4 (100 kg × 5 reps)
                    </div>
                    <div class="simulated-overlay-actions">
                        <button class="simulated-overlay-btn simulated-overlay-btn--text">+30s</button>
                        <button class="simulated-overlay-btn simulated-overlay-btn--icon" aria-label="Reset rest timer">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                                <path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/>
                            </svg>
                        </button>
                        <button class="simulated-overlay-btn simulated-overlay-btn--icon simulated-overlay-btn--primary" aria-label="Log completed set">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                                <path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/>
                            </svg>
                        </button>
                        <button class="simulated-overlay-btn simulated-overlay-btn--icon" aria-label="Skip rest timer">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                                <path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <SplashScreen ErrorMessage="@_initError"
                  RetryRequested="RetryInitializationAsync" />
}

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#0F766E", // Deep Teal
            Secondary = "#2563EB", // Active Cobalt
            Tertiary = "#D946EF",
            Success = "#10B981",
            Info = "#06B6D4",
            Warning = "#F59E0B",
            Error = "#EF4444",
            Background = "#F8F9FA",
            Surface = "#FFFFFF",
            AppbarBackground = "#F8F9FA",
            TextPrimary = "#111827",
            TextSecondary = "#6B7280",
            LinesDefault = "rgba(0, 0, 0, 0.08)",
            Divider = "rgba(0, 0, 0, 0.06)",
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#10B981", // Active Volt Green (Sporty)
            Secondary = "#3B82F6", // Cobalt Blue
            Tertiary = "#FF006E", // Energy Magenta
            Success = "#10B981",
            Info = "#06B6D4",
            Warning = "#F59E0B",
            Error = "#EF4444",
            Background = "#0B0C10", // Deep Midnight/Obsidian
            Surface = "#151821", // Sleek charcoal card surface
            AppbarBackground = "#0B0C10",
            TextPrimary = "#F3F4F6",
            TextSecondary = "#9CA3AF",
            LinesDefault = "rgba(255, 255, 255, 0.08)",
            Divider = "rgba(255, 255, 255, 0.06)",
        },
        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "16px"
        }
    };
    private bool _isDark = true;
    private bool _showBottomNav = true;
    private bool _useFixedDockPadding;
    private string? _initError;
    private bool _updatePromptShown;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await AppInit.EnsureInitializedAsync();
            SyncThemeFromService();
            _ = CheckForUpdatesAndPromptAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "App initialization failed");
            _initError = "Something went wrong while loading your data. Please try again.";
        }
    }

    /// <summary>
    /// Checks for a newer release once per session and shows the update dialog.
    /// Skipped when automatic checking is disabled or a workout is in progress.
    /// </summary>
    private async Task CheckForUpdatesAndPromptAsync()
    {
        if (_updatePromptShown)
            return;

        _updatePromptShown = true;

        if (!AppUpdateSettings.AutoCheckEnabled)
            return;

        try
        {
            UpdateCheckResult result = await AppUpdateService.CheckForUpdatesAsync();
            if (!result.IsUpdateAvailable || result.Latest is null)
                return;

            if (SessionService.CurrentPlan != null)
                return;

            var parameters = new DialogParameters<UpdateDialog>
            {
                { x => x.Release, result.Latest },
                { x => x.DownloadUrl, result.DownloadUrl },
            };

            var options = new DialogOptions
            {
                CloseButton = false,
                CloseOnEscapeKey = false,
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
            };

            await DialogService.ShowAsync<UpdateDialog>("Update available", parameters, options);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Update check failed; skipping update prompt");
        }
    }

    private async Task RetryInitializationAsync()
    {
        _initError = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            await AppInit.ReinitializeAsync();
            SyncThemeFromService();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "App initialization failed on retry");
            _initError = "Something went wrong while loading your data. Please try again.";
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        UpdateNavigationState();
    }

    private bool ShowSimulatedOverlay
    {
        get
        {
            try
            {
                return AppPreferences.Get("physiquinator_simulate_overlay_active", false);
            }
            catch
            {
                return false;
            }
        }
    }

    protected override void OnInitialized()
    {
        ThemeService.ThemeChanged += OnAppStateChanged;
        AppInit.ProgressChanged += OnAppStateChanged;
        Navigation.LocationChanged += OnLocationChanged;
        SyncThemeFromService();
        UpdateNavigationState();
    }

    private void OnAppStateChanged()
    {
        SyncThemeFromService();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateNavigationState();
        _ = InvokeAsync(StateHasChanged);
    }

    private void SyncThemeFromService() => _isDark = ThemeService.EffectiveTheme == ThemePreference.Dark;

    private void UpdateNavigationState()
    {
        var relativeUri = Navigation.ToBaseRelativePath(Navigation.Uri);
        var path = relativeUri.Split('?')[0].TrimEnd('/');
        _showBottomNav = ShouldShowBottomNav(path);
        _useFixedDockPadding = !_showBottomNav && !path.StartsWith(AppRoutes.WorkoutRoutePrefix, StringComparison.Ordinal);
    }

    private static bool ShouldShowBottomNav(string path)
    {
        if (path.StartsWith(AppRoutes.WorkoutRoutePrefix, StringComparison.Ordinal)) return false;
        if (path == AppRoutes.PlanRoutePath || path.StartsWith(AppRoutes.PlanRoutePrefix, StringComparison.Ordinal)) return false;
        if (path.StartsWith(AppRoutes.HistoryRoutePrefix, StringComparison.Ordinal)) return false;
        return true;
    }

    private bool ShouldShowBackFab()
    {
        if (_showBottomNav) return false;

        var relativeUri = Navigation.ToBaseRelativePath(Navigation.Uri);
        var path = relativeUri.Split('?')[0].TrimEnd('/');

        // Exclude plan editor route which has its own Close/Cancel and Save FABs
        if (path == AppRoutes.PlanRoutePath || path.StartsWith(AppRoutes.PlanRoutePrefix, StringComparison.Ordinal))
            return false;

        return true;
    }

    private async Task GoBack()
    {
        await JSRuntime.InvokeVoidAsync("history.back");
    }

    public void Dispose()
    {
        ThemeService.ThemeChanged -= OnAppStateChanged;
        AppInit.ProgressChanged -= OnAppStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
