@page "/settings"
@using Physiquinator.Core.Services
@using Physiquinator.Core.Services.Ai
@using Physiquinator.Core.Models
@using Physiquinator.Core.Formatting
@using Physiquinator.UI.Components.Shared
@using Physiquinator.UI.Components.Settings
@using Physiquinator.UI.Services
@inject RestAlertSettingsService RestAlertSettings
@inject INotificationService RestNotifications
@inject AppDataResetService AppDataReset
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject UiFeedbackService UiFeedback
@inject WorkoutScheduleService WorkoutSchedule
@inject IAppUpdateService AppUpdateService
@inject AppUpdateSettingsService AppUpdateSettings
@inject AiAssistantService AiAssistant
@inject WeightUnitService WeightUnitService
@inject IAccountService Account
@implements IDisposable

<PageTitle>@("Settings")</PageTitle>

<MudStack Spacing="3">
    <PageHeader Title="@("Settings")" />

    <MudTextField T="string"
                  Value="_settingsSearch"
                  ValueChanged="OnSearchChanged"
                  Placeholder="@("Search settings…")"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Clearable="true"
                  Immediate="true"
                  Variant="Variant.Outlined"
                  Class="mb-2" />

    <div class="settings-tab-row" role="tablist" aria-label="@("Settings sections")">
        <button type="button"
                role="tab"
                aria-selected="@(_activeTabIndex == 0)"
                class="settings-tab @(_activeTabIndex == 0 ? "settings-tab--active" : "")"
                @onclick="() => _activeTabIndex = 0">
            <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" />
            <span>@("General")</span>
        </button>
        <button type="button"
                role="tab"
                aria-selected="@(_activeTabIndex == 1)"
                class="settings-tab @(_activeTabIndex == 1 ? "settings-tab--active" : "")"
                @onclick="() => _activeTabIndex = 1">
            <MudIcon Icon="@Icons.Material.Filled.Memory" Size="Size.Small" />
            <span>@("AI")</span>
        </button>
        <button type="button"
                role="tab"
                aria-selected="@(_activeTabIndex == 2)"
                class="settings-tab @(_activeTabIndex == 2 ? "settings-tab--active" : "")"
                @onclick="() => _activeTabIndex = 2">
            <MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Small" />
            <span>@("Data")</span>
        </button>
        <button type="button"
                role="tab"
                aria-selected="@(_activeTabIndex == 3)"
                class="settings-tab @(_activeTabIndex == 3 ? "settings-tab--active" : "")"
                @onclick="() => _activeTabIndex = 3">
            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
            <span>@("About")</span>
        </button>
    </div>

        @if (_activeTabIndex == 0)
        {
            <MudExpansionPanels Class="settings-panels" MultiExpansion="true">
        @if (PanelMatches(AppearanceKeywords))
        {
            <SettingsAppearancePanel Expanded="@SearchActive" />
        }

        @if (PanelMatches(UnitsKeywords))
        {
            <MudExpansionPanel Class="settings-panel" Expanded="@SearchActive">
                <TitleContent>
                    <div class="settings-panel__header">
                        <span class="settings-panel__icon"><MudIcon Icon="@Icons.Material.Outlined.Straighten" Size="Size.Small" /></span>
                        <span class="settings-panel__text">
                            <span class="settings-panel__title" role="heading" aria-level="2">@("Units")</span>
                            <span class="settings-panel__subtitle">@("How weights are displayed")</span>
                        </span>
                    </div>
                </TitleContent>
            <ChildContent>
                <div class="settings-panel__content">
                    <MudSelect T="WeightUnit"
                               Variant="Variant.Outlined"
                               Label="@("Weight unit")"
                               Value="_weightUnit"
                               ValueChanged="OnWeightUnitChanged">
                        <MudSelectItem Value="WeightUnit.Kilograms">@("Kilograms (kg)")</MudSelectItem>
                        <MudSelectItem Value="WeightUnit.Pounds">@("Pounds (lb)")</MudSelectItem>
                    </MudSelect>
                    <MudText Typo="Typo.body2" Class="mt-2 mud-text-secondary">
                        @("Weights are stored in kilograms and converted when displayed.")
                    </MudText>
                </div>
            </ChildContent>
        </MudExpansionPanel>
        }

        @if (PanelMatches(RestTimerKeywords))
        {
            <MudExpansionPanel Class="settings-panel" Expanded="@SearchActive">
                <TitleContent>
                    <div class="settings-panel__header">
                        <span class="settings-panel__icon"><MudIcon Icon="@Icons.Material.Outlined.Timer" Size="Size.Small" /></span>
                        <span class="settings-panel__text">
                            <span class="settings-panel__title" role="heading" aria-level="2">@("Rest timer")</span>
                            <span class="settings-panel__subtitle">@("Notifications and rest time")</span>
                        </span>
                    </div>
                </TitleContent>
            <ChildContent>
                <div class="settings-panel__content">
                    @if (!RestNotifications.SupportsNotifications)
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-3">
                            @("Notifications are not supported on this platform. The rest timer still runs inside the app.")
                        </MudAlert>
                    }
                    <MudSwitch T="bool"
                               Label="@("Notify when rest ends")"
                               Disabled="!RestNotifications.SupportsNotifications"
                               Value="_restAlertsEnabled"
                               ValueChanged="OnRestAlertsEnabledChanged" />
                    <MudText Typo="Typo.body2" Class="mt-1 mud-text-secondary">
                        @("Push notification when your rest timer expires. Includes the next exercise name.")
                    </MudText>

                    <MudSwitch T="bool"
                               Class="mt-3"
                               Label="@("Sound and vibration")"
                               Disabled="!_restAlertsEnabled || !RestNotifications.SupportsNotifications"
                               Value="_restSoundVibrationEnabled"
                               ValueChanged="OnRestSoundVibrationChanged" />
                    <MudText Typo="Typo.body2" Class="mt-1 mud-text-secondary">
                        @("Play the knock sound and vibrate when the rest-end notification fires.")
                    </MudText>

                    <MudStack Spacing="0" Class="mt-4">
                        <SetMetricStepper Label="@("Add rest time in seconds")"
                                          @bind-Value="_addTimeSecondsValue"
                                          Step="5"
                                          Min="5"
                                          Max="300"
                                          IsInteger="true"
                                          Format="0"
                                          InputMode="numeric" />
                        <MudText Typo="Typo.body2" Class="mt-2 mud-text-secondary">
                            @("The + button on the rest timer adds this many seconds.")
                        </MudText>
                    </MudStack>
                    <MudStack Spacing="0" Class="mt-4">
                        <MudText Typo="Typo.body2" Class="font-weight-semibold">@("Floating timer")</MudText>
                        @if (RestNotifications.SupportsOverlay)
                        {
                            @if (_overlayPermissionGranted)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Success" Class="mt-1">
                                    @("When enabled, a draggable bubble shows the rest countdown over other apps while you train.")
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Class="mt-1 mud-text-secondary">
                                    @("The floating bubble needs the \"Display over other apps\" permission. Without it, no bubble appears when you leave the app during a rest.")
                                </MudText>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           Class="mt-3 align-self-start"
                                           StartIcon="@Icons.Material.Filled.PictureInPictureAlt"
                                           OnClick="OpenOverlaySettingsAsync">
                                    @("Grant permission")
                                </MudButton>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mt-1 mud-text-secondary">
                                @("Not available on this device.")
                            </MudText>
                        }
                    </MudStack>
                </div>
            </ChildContent>
        </MudExpansionPanel>
        }

        @if (PanelMatches(ProfilesKeywords))
        {
            <MudExpansionPanel Class="settings-panel" Expanded="@SearchActive">
                <TitleContent>
                    <div class="settings-panel__header">
                        <span class="settings-panel__icon"><MudIcon Icon="@Icons.Material.Outlined.People" Size="Size.Small" /></span>
                        <span class="settings-panel__text">
                            <span class="settings-panel__title" role="heading" aria-level="2">@("User profiles")</span>
                            <span class="settings-panel__subtitle">@("Create, switch, and manage profiles")</span>
                        </span>
                    </div>
                </TitleContent>
            <ChildContent>
                <div class="settings-panel__content">
                    <UserProfilesPanel />
                </div>
            </ChildContent>
        </MudExpansionPanel>
        }

        @if (PanelMatches(ScheduleKeywords))
        {
            <MudExpansionPanel Class="settings-panel" Expanded="@SearchActive">
                <TitleContent>
                    <div class="settings-panel__header">
                        <span class="settings-panel__icon"><MudIcon Icon="@Icons.Material.Outlined.EventRepeat" Size="Size.Small" /></span>
                        <span class="settings-panel__text">
                            <span class="settings-panel__title" role="heading" aria-level="2">@("Workout schedule")</span>
                            <span class="settings-panel__subtitle">@("Keep your streak alive on rest days")</span>
                        </span>
                    </div>
                </TitleContent>
            <ChildContent>
                <div class="settings-panel__content">
                    <MudText Typo="Typo.body2" Class="mb-2">
                        @("Pick the days you normally train.")
                    </MudText>
                    <div class="settings-schedule-days">
                        @foreach (var day in ScheduleDayOrder)
                        {
                            var d = day;
                            var isSelected = _scheduleDays.Contains(d);
                            <button type="button"
                                    class="settings-schedule-day"
                                    aria-pressed="@(isSelected ? "true" : "false")"
                                    aria-label="@DayName(d)"
                                    @onclick="@(() => ToggleScheduleDayAsync(d))">
                                @AbbreviatedDayName(d)
                            </button>
                        }
                    </div>
                    @if (_scheduleDays.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mt-3 mud-text-secondary">
                            @("No schedule yet. Without one, your streak counts every calendar day you train, so two rest days in a row end it.")
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="mt-3 mud-text-secondary">
                            @ScheduleSummaryLabel
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mt-1 mud-text-secondary">
                            @("Rest days never break your streak. A scheduled day you skip does.")
                        </MudText>
                    }
                </div>
            </ChildContent>
        </MudExpansionPanel>
        }

        @if (Account.IsSignOutSupported && PanelMatches(SignOutKeywords))
        {
            <MudExpansionPanel Class="settings-panel" Expanded="@SearchActive">
                <TitleContent>
                    <div class="settings-panel__header">
                        <span class="settings-panel__icon"><MudIcon Icon="@Icons.Material.Outlined.Logout" Size="Size.Small" /></span>
                        <span class="settings-panel__text">
                            <span class="settings-panel__title" role="heading" aria-level="2">@("Account")</span>
                            <span class="settings-panel__subtitle">@("Sign out of this account")</span>
                        </span>
                    </div>
                </TitleContent>
                <ChildContent>
                    <div class="settings-panel__content">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   OnClick="SignOutAsync"
                                   StartIcon="@Icons.Material.Filled.Logout"
                                   Class="btn-premium-ghost">
                            @("Sign out")
                        </MudButton>
                    </div>
                </ChildContent>
            </MudExpansionPanel>
        }

        </MudExpansionPanels>
        }

        @if (_activeTabIndex == 1)
        {
            <MudExpansionPanels Class="settings-panels" MultiExpansion="true">
        @if (PanelMatches(AiKeywords))
        {
            <MudExpansionPanel Class="settings-panel" Expanded="true">
                <TitleContent>
                    <div class="settings-panel__header">
                        <span class="settings-panel__icon"><MudIcon Icon="@Icons.Material.Filled.Memory" Size="Size.Small" /></span>
                        <span class="settings-panel__text">
                            <span class="settings-panel__title" role="heading" aria-level="2">@("AI Assistant")</span>
                            <span class="settings-panel__subtitle">@("Configure AI provider")</span>
                        </span>
                    </div>
                </TitleContent>
            <ChildContent>
                <div class="settings-panel__content">
                    <MudSwitch T="bool"
                               Label="@("Enable AI Assistant")"
                               Value="_aiSettings.Enabled"
                               ValueChanged="OnAiEnabledChanged" />

                    @if (_aiSettings.Enabled && _aiSettings.Provider != AiProviderType.OllamaLocal
                         && string.IsNullOrWhiteSpace(_aiSettings.ApiKey))
                    {
                        <MudAlert Severity="Severity.Warning" Class="mt-3">
                            @("No API key set yet. The assistant needs one to answer.")
                        </MudAlert>
                    }

                    @if (_aiSettings.Enabled)
                    {
                        <form @onsubmit="() => SaveAiSettings()" @onsubmit:preventDefault>
                        <MudStack Spacing="3" Class="mt-3">
                            <MudSelect T="AiProviderType"
                                       Label="@("Provider preset")"
                                       Variant="Variant.Outlined"
                                       Value="_aiSettings.Provider"
                                       ValueChanged="OnAiProviderChanged">
                                <MudSelectItem Value="AiProviderType.OpenAI">OpenAI Official</MudSelectItem>
                                <MudSelectItem Value="AiProviderType.OpenRouter">OpenRouter for Claude, Llama, DeepSeek</MudSelectItem>
                                <MudSelectItem Value="AiProviderType.OpenCode">OpenCode</MudSelectItem>
                                <MudSelectItem Value="AiProviderType.OllamaLocal">Ollama Local at http://localhost:11434/v1</MudSelectItem>
                                <MudSelectItem Value="AiProviderType.Custom">Custom OpenAI-Compatible API</MudSelectItem>
                            </MudSelect>

                            <MudTextField T="string"
                                          Label="@("API Base URL")"
                                          Variant="Variant.Outlined"
                                          @bind-Value="_aiSettings.BaseUrl"
                                          HelperText="@("Standard base URL, for example https://api.openai.com/v1")" />

                            <MudTextField T="string"
                                          Label="@("API Key")"
                                          Variant="Variant.Outlined"
                                          InputType="@(_showApiKey ? InputType.Text : InputType.Password)"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@(_showApiKey ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                          OnAdornmentClick="@(() => _showApiKey = !_showApiKey)"
                                          @bind-Value="_aiSettings.ApiKey"
                                          HelperText="@("Stored on-device in plaintext preferences")" />

                             @if (_fetchingModels)
                             {
                                 <div class="d-flex align-center gap-2 py-1">
                                     <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                                     <MudText Typo="Typo.caption" Class="mud-text-secondary">@("Fetching models from endpoint…")</MudText>
                                 </div>
                             }

                             <MudTextField T="string"
                                           Label="@("Model Name")"
                                           Variant="Variant.Outlined"
                                           @bind-Value="_aiSettings.ModelName"
                                           HelperText="@("For example gpt-4o-mini or deepseek-v4-flash. Any model name works.")" />

                             @if (_availableModels.Count > 0)
                             {
                                 <MudSelect T="string"
                                            Label="@("Fetched models")"
                                            Variant="Variant.Outlined"
                                            Placeholder="@("Pick from the models the provider returned")"
                                            Value="@_pickedFetchedModel"
                                            ValueChanged="OnFetchedModelPicked">
                                     @foreach (var model in _availableModels)
                                     {
                                         <MudSelectItem T="string" Value="model">@model</MudSelectItem>
                                     }
                                 </MudSelect>
                             }

                            <MudTextField T="string"
                                          Label="@("Custom instructions")"
                                          Variant="Variant.Outlined"
                                          Lines="2"
                                          @bind-Value="_aiSettings.CustomSystemPrompt"
                                          HelperText="@("Extra instructions passed to the AI assistant. Optional.")" />

                            <div class="settings-btn-group mt-2">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           ButtonType="ButtonType.Submit"
                                           StartIcon="@Icons.Material.Filled.Save">
                                    @("Save settings")
                                </MudButton>
                                <MudButton Variant="Variant.Outlined"
                                           Disabled="_fetchingModels"
                                           OnClick="FetchModelsAsync"
                                           StartIcon="@Icons.Material.Filled.CloudDownload">
                                    @if (_fetchingModels)
                                    {
                                        <span>@("Fetching…")</span>
                                    }
                                    else
                                    {
                                        <span>@("Fetch models")</span>
                                    }
                                </MudButton>
                                <MudButton Variant="Variant.Outlined"
                                           Disabled="_testingAiConnection"
                                           OnClick="TestAiConnectionAsync"
                                           StartIcon="@Icons.Material.Filled.CheckCircle">
                                    @if (_testingAiConnection)
                                    {
                                        <span>@("Testing…")</span>
                                    }
                                    else
                                    {
                                        <span>@("Test connection")</span>
                                    }
                                </MudButton>
                                <MudButton Variant="Variant.Outlined"
                                           OnClick="OpenAiChat"
                                           StartIcon="@Icons.Material.Filled.SmartToy">
                                    @("Open assistant")
                                </MudButton>
                            </div>
                        </MudStack>
                        </form>
                    }
                </div>

            </ChildContent>
        </MudExpansionPanel>
        }
    </MudExpansionPanels>
    }

    @if (_activeTabIndex == 2)
    {
        <MudExpansionPanels Class="settings-panels" MultiExpansion="true">
        @if (PanelMatches(BackupKeywords))
        {
            <SettingsBackupPanel />
        }
    </MudExpansionPanels>
    }

    @if (_activeTabIndex == 3)
    {
        <MudExpansionPanels Class="settings-panels" MultiExpansion="true">
        @if (AppUpdateService.IsSupported && PanelMatches(UpdatesKeywords))
        {
            <MudExpansionPanel Class="settings-panel" Expanded="@SearchActive">
                <TitleContent>
                    <div class="settings-panel__header">
                        <span class="settings-panel__icon"><MudIcon Icon="@Icons.Material.Outlined.SystemUpdate" Size="Size.Small" /></span>
                        <span class="settings-panel__text">
                            <span class="settings-panel__title" role="heading" aria-level="2">@("Updates")</span>
                            <span class="settings-panel__subtitle">@(string.Format("Version {0}", _currentVersion))</span>
                        </span>
                    </div>
                </TitleContent>
                <ChildContent>
                    <div class="settings-panel__content">
                        <MudSwitch T="bool"
                                   Label="@("Check for updates automatically")"
                                   Value="_autoCheckEnabled"
                                   ValueChanged="OnAutoCheckEnabledChanged" />
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                            @("Check GitHub for new releases on startup and prompt when an update is available.")
                        </MudText>
                        <div class="settings-btn-group">
                            <MudButton Variant="Variant.Outlined"
                                       Disabled="@_checkingForUpdates"
                                       OnClick="CheckForUpdatesAsync"
                                       StartIcon="@Icons.Material.Filled.SystemUpdate">
                                @("Check for updates")
                            </MudButton>
                        </div>
                        @if (_checkingForUpdates)
                        {
                            <MudProgressLinear Indeterminate="true" Class="mt-3" Color="Color.Primary" />
                        }
                        @if (_latestRelease != null)
                        {
                            <div class="mt-3">
                                <MudText Typo="Typo.body2">
                                    @("Latest release:") <strong>@_latestRelease.Tag</strong>
                                    @if (_latestRelease.PublishedAt is { } published)
                                    {
                                        <span class="mud-text-secondary">(@UiDateFormats.LocalDateCompact(published.DateTime))</span>
                                    }
                                </MudText>
                                @if (_updateAvailable && string.IsNullOrEmpty(_downloadUrl))
                                {
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                        @("A newer version is available, but in-app updates are not supported on this platform.")
                                    </MudText>
                                }
                                else if (_updateAvailable)
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Primary">@("A newer version is available.")</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Success">@("You are on the latest version.")</MudText>
                                }
                            </div>
                        }
                    </div>
                </ChildContent>
            </MudExpansionPanel>
        }

        @if (PanelMatches(RemoveDataKeywords))
        {
            <MudExpansionPanel Class="settings-panel settings-panel--danger" Expanded="@SearchActive">
                <TitleContent>
                    <div class="settings-panel__header">
                        <span class="settings-panel__icon"><MudIcon Icon="@Icons.Material.Outlined.WarningAmber" Size="Size.Small" /></span>
                        <span class="settings-panel__text">
                            <span class="settings-panel__title" role="heading" aria-level="2">@("Remove all data")</span>
                            <span class="settings-panel__subtitle">@("Permanently delete local data on this device")</span>
                        </span>
                    </div>
                </TitleContent>
            <ChildContent>
                <div class="settings-panel__content">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                        @("Permanently delete all plans, logs, and settings on this device. Export a backup first if you want to keep your data.")
                    </MudText>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               OnClick="RemoveAllDataAsync"
                               StartIcon="@Icons.Material.Filled.DeleteForever"
                               Class="btn-premium-ghost">
                        @("Remove all data…")
                    </MudButton>
                </div>
            </ChildContent>
        </MudExpansionPanel>
        }
    </MudExpansionPanels>
    }

    @if (NoResultsVisible)
    {
        <EmptyState Message="@("No settings match your search.")"
                    Icon="@Icons.Material.Outlined.SearchOff" />
    }
</MudStack>

@code {
    private WeightUnit _weightUnit = WeightUnit.Kilograms;
    private bool _restAlertsEnabled = true;
    private bool _restSoundVibrationEnabled = true;
    private bool _overlayPermissionGranted = true;
    private int _addTimeSeconds = 30;

    private string _settingsSearch = "";
    private int _activeTabIndex;

    private bool SearchActive => !string.IsNullOrWhiteSpace(_settingsSearch);

    /// <summary>Jumps to the first tab containing a panel that matches the search text.</summary>
    private void OnSearchChanged(string value)
    {
        _settingsSearch = value;

        if (!SearchActive)
            return;

        if (GeneralTabVisible) { _activeTabIndex = 0; return; }
        if (AiTabVisible) { _activeTabIndex = 1; return; }
        if (DataTabVisible) { _activeTabIndex = 2; return; }
        if (AboutTabVisible) { _activeTabIndex = 3; }
    }

    private async Task SignOutAsync()
    {
        if (!Account.IsSignOutSupported)
            return;

        var confirmed = await DialogService.ConfirmAsync(
            "Sign out?",
            "Sign out of this account? Your data stays on this device.",
            confirmText: "Sign out",
            cancelText: "Cancel",
            confirmColor: Color.Error);

        if (!confirmed)
            return;

        await Account.SignOutAsync();
    }

    private bool PanelMatches(string[] keywords)
    {
        if (!SearchActive)
            return true;

        var query = _settingsSearch.Trim();
        return keywords.Any(k => k.Contains(query, StringComparison.OrdinalIgnoreCase));
    }

    private static readonly string[] AppearanceKeywords = ["appearance", "theme", "dark", "light", "mode"];
    private static readonly string[] UnitsKeywords = ["units", "kg", "lb", "weight"];
    private static readonly string[] RestTimerKeywords = ["rest", "timer", "notification", "sound", "vibration", "overlay"];
    private static readonly string[] ProfilesKeywords = ["profiles", "profile", "user", "multi"];
    private static readonly string[] ScheduleKeywords = ["schedule", "streak", "days", "training"];
    private static readonly string[] SignOutKeywords = ["account", "sign out", "signout", "logout"];
    private static readonly string[] AiKeywords = ["ai", "assistant", "chat", "openai", "openrouter", "ollama", "model", "api"];
    private static readonly string[] BackupKeywords = ["backup", "export", "import", "data", "restore"];
    private static readonly string[] UpdatesKeywords = ["updates", "update", "version", "release"];
    private static readonly string[] RemoveDataKeywords = ["remove", "delete", "reset", "wipe"];

    private bool GeneralTabVisible => PanelMatches(AppearanceKeywords)
        || PanelMatches(UnitsKeywords)
        || PanelMatches(RestTimerKeywords)
        || PanelMatches(ProfilesKeywords)
        || PanelMatches(ScheduleKeywords)
        || (Account.IsSignOutSupported && PanelMatches(SignOutKeywords));

    private bool AiTabVisible => PanelMatches(AiKeywords);

    private bool DataTabVisible => PanelMatches(BackupKeywords);

    private bool AboutTabVisible => (AppUpdateService.IsSupported && PanelMatches(UpdatesKeywords))
        || PanelMatches(RemoveDataKeywords);

    /// <summary>True while a search is active but no panel matches anywhere.</summary>
    private bool NoResultsVisible => SearchActive
        && !GeneralTabVisible
        && !AiTabVisible
        && !DataTabVisible
        && !AboutTabVisible;

    private static readonly DayOfWeek[] ScheduleDayOrder =
    [
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday,
        DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday
    ];

    private HashSet<DayOfWeek> _scheduleDays = [];

    private static string AbbreviatedDayName(DayOfWeek day)
    {
        var name = System.Globalization.DateTimeFormatInfo.CurrentInfo?.GetAbbreviatedDayName(day);
        return string.IsNullOrEmpty(name) ? day.ToString()[..3] : name;
    }

    private static string DayName(DayOfWeek day)
    {
        var name = System.Globalization.DateTimeFormatInfo.CurrentInfo?.GetDayName(day);
        return string.IsNullOrEmpty(name) ? day.ToString() : name;
    }

    private string ScheduleSummaryLabel
    {
        get
        {
            var days = string.Join(", ", ScheduleDayOrder.Where(_scheduleDays.Contains).Select(AbbreviatedDayName));
            var next = WorkoutSchedule.NextWorkoutDay(DateOnly.FromDateTime(DateTime.Today));
            var nextLabel = next is { } n ? $"{DayName(n.DayOfWeek)} {UiDateFormats.DateOnlyCompact(n)}" : "-";
            return string.Format("You train {0} days per week: {1}. Next training day: {2}.", _scheduleDays.Count, days, nextLabel);
        }
    }

    private string _currentVersion = string.Empty;
    private GitHubRelease? _latestRelease;
    private bool _updateAvailable;
    private string? _downloadUrl;
    private bool _checkingForUpdates;
    private bool _autoCheckEnabled = true;

    private double? _addTimeSecondsValue
    {
        get => _addTimeSeconds;
        set
        {
            var next = (int)Math.Round(value ?? RestAlertSettings.AddTimeSeconds);
            next = Math.Clamp(next, 5, 300);
            _addTimeSeconds = next;
            RestAlertSettings.SetAddTimeSeconds(next);
        }
    }

    protected override void OnInitialized()
    {
        // Sync synchronously so the first render shows real values (no
        // wrong-state flash on toggles before OnInitializedAsync finishes).
        SyncFromService();
    }

    protected override Task OnInitializedAsync()
    {
        RestAlertSettings.Changed += HandleSettingsChanged;
        WorkoutSchedule.Changed += HandleSettingsChanged;
        _overlayPermissionGranted = RestNotifications.HasOverlayPermission();
        _currentVersion = AppUpdateService.CurrentVersion.ToString();
        _autoCheckEnabled = AppUpdateSettings.AutoCheckEnabled;
        return Task.CompletedTask;
    }

    /// <summary>
    /// Re-checks the overlay permission on every render so the status updates
    /// after the user returns from the system settings screen.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var granted = RestNotifications.HasOverlayPermission();
        if (granted != _overlayPermissionGranted)
        {
            _overlayPermissionGranted = granted;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenOverlaySettingsAsync()
    {
        await RestNotifications.RequestOverlayPermissionAsync();
        _overlayPermissionGranted = RestNotifications.HasOverlayPermission();
    }

    private AiProviderSettings _aiSettings = new();
    private bool _showApiKey;
    private bool _testingAiConnection;
    private bool _fetchingModels;
    private List<string> _availableModels = [];
    private string? _pickedFetchedModel;

    /// <summary>Copies a picked fetched model into the free-text model field.</summary>
    private void OnFetchedModelPicked(string? model)
    {
        _pickedFetchedModel = model;
        if (!string.IsNullOrWhiteSpace(model))
        {
            _aiSettings.ModelName = model;
        }
    }

    private async Task FetchModelsAsync()
    {
        _fetchingModels = true;
        try
        {
            SaveAiSettings(showToast: false);
            _availableModels = await AiAssistant.FetchAvailableModelsAsync();
            if (_availableModels.Count > 0)
            {
                UiFeedback.Success(string.Format("Fetched {0} available models!", _availableModels.Count));
            }
            else
            {
                UiFeedback.Warning("No models returned. Verify Base URL and API key.");
            }
        }
        catch (Exception ex)
        {
            UiFeedback.Error("Failed to fetch models", ex);
        }
        finally
        {
            _fetchingModels = false;
        }
    }

    private void SyncFromService()
    {
        _restAlertsEnabled = RestAlertSettings.Enabled;
        _restSoundVibrationEnabled = RestAlertSettings.SoundVibrationEnabled;
        _addTimeSeconds = RestAlertSettings.AddTimeSeconds;
        _scheduleDays = [.. WorkoutSchedule.Days];
        _aiSettings = AiAssistant.GetSettings();
        _weightUnit = WeightUnitService.Current;
    }

    private void OnWeightUnitChanged(WeightUnit unit)
    {
        WeightUnitService.Set(unit);
        _weightUnit = unit;
        UiFeedback.Success(string.Format("Weights now shown in {0}.", ExerciseWeightFormatter.UnitSuffix(unit)));
    }

    private void OnAiEnabledChanged(bool enabled)
    {
        _aiSettings.Enabled = enabled;
        SaveAiSettings();
    }

    private async Task OnAiProviderChanged(AiProviderType provider)
    {
        _aiSettings.Provider = provider;
        _aiSettings.BaseUrl = _aiSettings.GetDefaultBaseUrl();
        _aiSettings.ModelName = _aiSettings.GetDefaultModel();
        SaveAiSettings();
        await FetchModelsAsync();
    }

    private void SaveAiSettings(bool showToast = true)
    {
        AiAssistant.SaveSettings(_aiSettings);
        if (showToast)
            UiFeedback.Success("AI Assistant settings saved.");
    }

    private async Task TestAiConnectionAsync()
    {
        _testingAiConnection = true;
        try
        {
            SaveAiSettings(showToast: false);
            await AiAssistant.SendUserMessageAsync("Hello! Respond with a brief 1-sentence confirmation that connection is successful.");
            var lastMsg = AiAssistant.Messages.LastOrDefault();
            if (lastMsg != null && lastMsg.IsError)
            {
                UiFeedback.Error(string.Format("Connection test failed: {0}", lastMsg.Content));
            }
            else
            {
                UiFeedback.Success("AI Connection test successful!");
            }
        }
        catch (Exception ex)
        {
            UiFeedback.Error("Test failed", ex);
        }
        finally
        {
            _testingAiConnection = false;
        }
    }

    private void OpenAiChat()
    {
        Navigation.NavigateTo(AppRoutes.Ai);
    }

    private async Task ToggleScheduleDayAsync(DayOfWeek day)
    {
        if (!_scheduleDays.Add(day))
            _scheduleDays.Remove(day);

        await WorkoutSchedule.SetDaysAsync(_scheduleDays);
    }

    private void HandleSettingsChanged()
    {
        SyncFromService();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnRestAlertsEnabledChanged(bool enabled)
    {
        RestAlertSettings.SetEnabled(enabled);
        _restAlertsEnabled = enabled;
        UiFeedback.Success(enabled ? "Rest notifications on." : "Rest notifications off.");
    }

    private void OnRestSoundVibrationChanged(bool enabled)
    {
        RestAlertSettings.SetSoundVibrationEnabled(enabled);
        _restSoundVibrationEnabled = enabled;
        UiFeedback.Success(enabled ? "Sound and vibration on." : "Sound and vibration off.");
    }

    private void OnAutoCheckEnabledChanged(bool enabled)
    {
        AppUpdateSettings.SetAutoCheckEnabled(enabled);
        _autoCheckEnabled = enabled;
        UiFeedback.Success(enabled ? "Automatic update checks on." : "Automatic update checks off.");
    }

    private async Task RemoveAllDataAsync()
    {
        var confirmed = await DialogService.ConfirmAsync(
            "Remove all data?",
            "This cannot be undone. Export any backups you need before continuing.",
            confirmText: "Remove",
            confirmColor: Color.Error);

        if (!confirmed)
            return;

        var ok = await UiFeedback.TryExecuteAsync(
            async () =>
            {
                await AppDataReset.ClearAllLocalDataAsync();
                SyncFromService();
            },
            "All local data has been removed.",
            "Could not remove data");
        if (ok)
            Navigation.NavigateTo(AppRoutes.Home);
    }

    private async Task CheckForUpdatesAsync()
    {
        _checkingForUpdates = true;
        _latestRelease = null;
        _updateAvailable = false;
        _downloadUrl = null;
        try
        {
            var result = await AppUpdateService.CheckForUpdatesAsync();
            _latestRelease = result.Latest;
            _updateAvailable = result.IsUpdateAvailable;
            _downloadUrl = result.DownloadUrl;
            if (!_updateAvailable)
            {
                UiFeedback.Success("You are on the latest version.");
            }
            else if (string.IsNullOrEmpty(_downloadUrl))
            {
                UiFeedback.Info("A newer version is available, but in-app updates are not supported on this platform.");
            }
            else if (result.Latest is { } release)
            {
                var parameters = new DialogParameters<UpdateDialog>
                {
                    { x => x.Release, release },
                    { x => x.DownloadUrl, _downloadUrl },
                };

                var options = new DialogOptions
                {
                    CloseButton = true,
                    CloseOnEscapeKey = true,
                    MaxWidth = MaxWidth.Small,
                    FullWidth = true,
                };

                await DialogService.ShowAsync<UpdateDialog>("Update available", parameters, options);
            }
        }
        catch (Exception ex)
        {
            UiFeedback.Error("Could not check for updates", ex);
        }
        finally
        {
            _checkingForUpdates = false;
        }
    }

    public void Dispose()
    {
        RestAlertSettings.Changed -= HandleSettingsChanged;
        WorkoutSchedule.Changed -= HandleSettingsChanged;
    }
}
