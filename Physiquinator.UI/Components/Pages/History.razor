@page "/history"
@implements IAsyncDisposable
@inject WorkoutHistoryRepository HistoryRepo
@inject WorkoutSessionService SessionService
@inject NavigationManager Navigation
@inject WorkoutStatsService StatsService
@inject WorkoutScheduleService ScheduleService
@inject UserProfileService UserProfileService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject WeightUnitService WeightUnitService
@inject IJSRuntime JS
<MudStack Spacing="3">
    <PageTitle>@("Workout history")</PageTitle>
    <PageHeader Title="@("Workout history")">
        @if (_sessions is { Count: > 0 })
        {
            <MudButton Variant="Variant.Text"
                       Color="@(_selectMode ? Color.Primary : Color.Default)"
                       StartIcon="@(_selectMode ? Icons.Material.Filled.Close : Icons.Material.Filled.Checklist)"
                       OnClick="ToggleSelectMode"
                       Class="history-select-toggle premium-btn">
                @(_selectMode ? "Done" : "Select")
            </MudButton>
        }
    </PageHeader>

    @if (_sessions == null || _activityByDay == null || _listSessions == null || _summary == null)
    {
        <HistorySkeleton />
    }
    else
    {
        <MudTextField T="string"
                      Value="_searchText"
                      ValueChanged="OnSearchTextChanged"
                       Placeholder="@("Search by plan or exercise name…")"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true"
                      Variant="Variant.Outlined"
                      Class="mb-2" />

        <MudPaper Class="pa-4 history-heatmap-panel" Elevation="0">
            <div class="heatmap-legend" role="note" aria-label="Heatmap legend weeks 01 to 53, today hollow circle, scheduled dashed, missed hatch"><span>WEEKS 01-53</span><span class="hm-key"><i class="hm-glyph hm-glyph--today"></i>TODAY</span><span class="hm-key"><i class="hm-glyph hm-glyph--scheduled"></i>SCHEDULED</span><span class="hm-key"><i class="hm-glyph hm-glyph--missed"></i>MISSED</span></div>
            <ActivityHeatmap CountsByDay="_activityByDay"
                             Weeks="@HeatmapWeeks"
                             EndLocal="@_heatmapEndLocal"
                             GetScheduleForDate="ScheduleService.GetScheduleForDate"
                             IsDaySelected="IsDaySelected"
                             SelectionVersion="_selectionVersion"
                             DaySelectionChanged="OnHeatmapDayTapAsync" />
        </MudPaper>

        <div class="history-stats">
            <StatCard Value="@_summary.CurrentStreakWorkoutDays.ToString()" Label="@("Streak")" />
            <StatCard Value="@_summary.LongestStreakWorkoutDays.ToString()" Label="@("Longest streak")" />
            <StatCard Value="@_summary.ThisWeekSessionCount.ToString()" Label="@("This week")" />
            <StatCard Value="@_summary.LastWeekSessionCount.ToString()" Label="@("Last week")" />
        </div>

        <MudPaper Class="pa-3 bodyweight-panel" Elevation="0">
            <div class="bodyweight-panel__header">
                <div class="bodyweight-panel__left">
                    <MudText Typo="Typo.h2" Class="bodyweight-panel__title">@("Bodyweight")</MudText>
                    @if (_latestBodyweight is { } latest)
                    {
                        <span class="bodyweight-panel__latest-text">
                            @ExerciseWeightFormatter.FormatWeightWithUnit(latest.BodyweightKg, WeightUnitService.Current) · @UiDateFormats.DateOnlyCompact(latest.DateOnly)
                        </span>
                    }
                </div>
                @if (_latestBodyweight != null)
                {
                    <button type="button"
                            class="bodyweight-panel__details-link"
                            @onclick="OpenBodyweightProgress">
                        <MudIcon Icon="@Icons.Material.Filled.ShowChart" Size="Size.Small" />
                        <span>@("Details")</span>
                    </button>
                }
            </div>

            <div class="bodyweight-log-row">
                <SetMetricStepper Value="@BodyweightInputDisplay"
                                  ValueChanged="OnBodyweightInputChanged"
                                  Step="@BodyweightStep"
                                  Min="@BodyweightMin"
                                  Max="@BodyweightMax"
                                  IsInteger="false"
                                  Format="0.#"
                                  Compact="true"
                                  Unit="@ExerciseWeightFormatter.UnitSuffix(WeightUnitService.Current)"
                                  Placeholder="@(_bodyweightDefault is { } d ? ExerciseWeightFormatter.ToDisplay(d, WeightUnitService.Current) : null)" />
                <button type="button"
                        class="bodyweight-log-row__log-btn"
                        @onclick="LogBodyweightAsync"
                        @disabled="@CannotLogBodyweight"
                        aria-label="@("Log bodyweight")">
                    <MudIcon Icon="@Icons.Material.Filled.Save" Size="Size.Medium" />
                </button>
            </div>
        </MudPaper>

        @if (_selectedDays.Count > 0)
        {
            <div class="history-filter-bar" role="group" aria-label="Day filters">
                <span class="history-filter-bar__label">@("Days")</span>
                @foreach (var day in _selectedDays.OrderBy(d => d))
                {
                    <span class="history-filter-chip">
                        <span class="history-filter-chip__label">@UiDateFormats.DateOnlyCompact(day)</span>
                        <button type="button"
                                class="history-filter-chip__remove"
                                aria-label='@(string.Format("Remove {0} from filter", UiDateFormats.DateOnlyCompact(day)))'
                                @onclick="() => ToggleDayFilter(day)">
                            <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                        </button>
                    </span>
                }
                <button type="button"
                        class="history-filter-bar__clear"
                        @onclick="ClearDayFilters">
                    @("Clear all")
                </button>
            </div>
        }
        else if (_selectMode && _selectedSessionIds.Count > 0)
        {
            <div class="history-filter-bar history-filter-bar--selection" role="group" aria-label="Selected days">
                <span class="history-filter-bar__label">@("Selected")</span>
                @foreach (var day in _selectDaySessionsCache.Keys.OrderBy(d => d))
                {
                    var sessions = _selectDaySessionsCache[day];
                    var allSel = sessions.Count > 0 && sessions.All(s => _selectedSessionIds.Contains(s.Id));
                    if (!allSel) continue;
                    <span class="history-filter-chip history-filter-chip--selected">
                        <span class="history-filter-chip__label">@UiDateFormats.DateOnlyCompact(day)</span>
                        <button type="button"
                                class="history-filter-chip__remove"
                                aria-label='@(string.Format("Remove {0}", UiDateFormats.DateOnlyCompact(day)))'
                                @onclick="() => ToggleDaySessionSelectionAsync(day)">
                            <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                        </button>
                    </span>
                }
                @foreach (var sid in _selectedSessionIds.ToList())
                {
                    var s = _sessions?.FirstOrDefault(x => x.Id == sid) ?? _listSessions?.FirstOrDefault(x => x.Id == sid);
                    if (s == null) continue;
                    var day = DateOnly.FromDateTime(s.StartedAtUtc.ToLocalTime());
                    if (_selectDaySessionsCache.ContainsKey(day)) continue;
                    <span class="history-filter-chip history-filter-chip--selected">
                        <span class="history-filter-chip__label">@($"{s.PlanName} · {UiDateFormats.DateOnlyCompact(day)}")</span>
                        <button type="button"
                                class="history-filter-chip__remove"
                                aria-label="Remove"
                                @onclick="() => ToggleSelect(sid)">
                            <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                        </button>
                    </span>
                }
            </div>
        }

        @if (_sessions != null && !_sessions.Any())
        {
            <EmptyState Message="@("No logged workouts yet. Start a plan from home.")"
                        Icon="@Icons.Material.Outlined.History" />
        }
        else if (_listSessions != null && !_listSessions.Any() && _selectedDays.Count > 0)
        {
            <EmptyState Message="@("No workouts logged on these days.")"
                        Icon="@Icons.Material.Outlined.CalendarMonth">
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ClearDayFilters">
                    @("Clear filter")
                </MudButton>
            </EmptyState>
        }
        else
        {
            @if (_selectMode)
            {
                <div class="history-select-bar">
                    <div class="history-select-bar__left">
                        <span class="history-select-bar__count">
                            @(string.Format("{0} selected", _selectedSessionIds.Count))
                        </span>
                        <button type="button"
                                class="history-select-bar__btn"
                                @onclick="ToggleSelectAll">
                            @(_selectedSessionIds.Count == (_listSessions?.Count ?? 0) && (_listSessions?.Count ?? 0) > 0 ? "Deselect all" : "Select all")
                        </button>
                    </div>
                    <div class="history-select-bar__right">
                        <button type="button"
                                class="history-select-bar__btn history-select-bar__btn--delete"
                                disabled="@(_selectedSessionIds.Count == 0)"
                                @onclick="DeleteSelectedAsync">
                            <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                            <span>@("Delete")</span>
                        </button>
                        <button type="button"
                                class="history-select-bar__btn history-select-bar__btn--done"
                                @onclick="ToggleSelectMode">
                            @("Done")
                        </button>
                    </div>
                </div>
            }

            <div class="history-session-list">
                @foreach (var s in _listSessions ?? [])
                {
                    var sid = s.Id;
                    var isSel = IsSelected(sid);
                    <div @key="s.Id"
                         class="@(isSel ? "history-session-card history-session-card--selected" : "history-session-card")"
                         role="button"
                         tabindex="0"
                         aria-label="@(string.Format("Open session {0}", s.PlanName))"
                         @onclick="@(() => HandleSessionTap(sid))"
                         @onkeydown="(e) => OnSessionCardKeyDown(e, sid)">
                        <div class="history-session-card__inner">
                            <div class="history-session-card__left">
                                @if (_selectMode)
                                {
                                    <span class="history-session-check" aria-hidden="true">
                                        <MudIcon Icon="@(isSel ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)"
                                                 Color="@(isSel ? Color.Primary : Color.Default)" />
                                    </span>
                                }
                                <div class="history-session-card__info">
                                    <span class="history-session-card__title">@s.PlanName</span>
                                    <span class="history-session-card__subtitle">
                                        <span class="history-session-card__time-badge">@UiDateFormats.LocalDateTimeCompact(s.StartedAtUtc)</span>
                                        @if (s.EndedAtUtc != null)
                                        {
                                            <span class="history-session-card__duration-badge">@(FormatSessionEnd(s.StartedAtUtc, s.EndedAtUtc.Value))</span>
                                        }
                                        else
                                        {
                                            <span class="history-session-card__badge-inprogress">@("In progress")</span>
                                        }
                                    </span>
                                </div>
                            </div>
                            <div class="history-session-card__right">
                                @if (s.EndedAtUtc == null && s.TryGetPlanId() is { } continuePlanId && !_selectMode)
                                {
                                    <button type="button"
                                            class="history-card-continue-btn"
                                            @onclick:stopPropagation="true"
                                            @onclick="@(() => ContinueWorkout(continuePlanId))">
                                        <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" />
                                        <span>@("Continue")</span>
                                    </button>
                                }
                                <div @onclick:stopPropagation="true" class="history-session-card__actions">
                                    <button type="button"
                                            class="history-action-btn history-action-btn--delete"
                                            aria-label="@(string.Format("Delete session {0}", UiDateFormats.LocalDateTimeCompact(s.StartedAtUtc)))"
                                            @onclick="@(() => DeleteSession(sid, s.PlanName, s.EndedAtUtc == null))">
                                        <MudIcon Icon="@Icons.Material.Outlined.DeleteOutline" Size="Size.Small" />
                                    </button>
                                    @if (!_selectMode)
                                    {
                                        <span class="history-action-btn history-action-btn--chevron" aria-hidden="true">
                                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (_isLoadingMore)
            {
                <div class="history-infinite-scroll-loading" aria-hidden="true">
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                </div>
            }

            @if (_hasMoreSessions && _selectedDays.Count == 0)
            {
                <div id="@LoadMoreSentinelId" class="history-infinite-scroll-sentinel" aria-hidden="true"></div>
            }
        }
    }
</MudStack>

@code {
    /// <summary>End label for a session card: time-only when it ended on the start day.</summary>
    private static string FormatSessionEnd(DateTime startUtc, DateTime endUtc) =>
        endUtc.ToLocalTime().Date == startUtc.ToLocalTime().Date
            ? UiDateFormats.LocalTimeOnly(endUtc)
            : UiDateFormats.LocalDateTimeCompact(endUtc);

    private const int HeatmapWeeks = 53;
    private const int SessionPageSize = 50;
    private const string LoadMoreSentinelId = "history-load-more-sentinel";

    private List<WorkoutSessionLogEntity>? _sessions;
    private IReadOnlyList<WorkoutSessionLogEntity>? _listSessions;
    private IReadOnlyList<WorkoutSessionLogEntity>? _filterDaySessions;
    private IReadOnlyDictionary<DateOnly, int>? _activityByDay;
    private DateOnly _heatmapEndLocal;
    private WorkoutDaySummary? _summary;
    private readonly HashSet<DateOnly> _selectedDays = [];
    private string _searchText = "";
    private int _loadedSessionCount;
    private bool _hasMoreSessions;
    private bool _isLoadingMore;
    private bool _sentinelObserved;
    private DotNetObjectReference<History>? _dotNetRef;
    private bool _selectMode;
    private int _selectionVersion;
    private readonly HashSet<string> _selectedSessionIds = new(StringComparer.Ordinal);
    private readonly Dictionary<DateOnly, IReadOnlyList<WorkoutSessionLogEntity>> _selectDaySessionsCache = new();

    private BodyweightEntry? _latestBodyweight;
    private double? _bodyweightInputKg;
    private double? _bodyweightDefault;

    private double? BodyweightInputDisplay =>
        _bodyweightInputKg is { } kg ? ExerciseWeightFormatter.ToDisplay(kg, WeightUnitService.Current) : null;

    private double BodyweightStep => WeightUnitService.Current == WeightUnit.Pounds ? 1 : 0.5;

    private double BodyweightMin => ExerciseWeightFormatter.ToDisplay(1, WeightUnitService.Current);

    private double BodyweightMax => ExerciseWeightFormatter.ToDisplay(500, WeightUnitService.Current);

    private void OpenSession(string sessionId) =>
        Navigation.NavigateTo(AppRoutes.HistorySession(sessionId));

    private void OnSessionCardKeyDown(KeyboardEventArgs e, string sessionId)
    {
        if (e.Key is "Enter" or " " or "Spacebar")
            HandleSessionTap(sessionId);
    }

    private void HandleSessionTap(string sessionId)
    {
        if (_selectMode)
            ToggleSelect(sessionId);
        else
            OpenSession(sessionId);
    }

    private async Task ToggleSelectMode()
    {
        _selectMode = !_selectMode;
        if (_selectMode)
        {
            // Exit the day filters so grid taps mean session selection, not filtering.
            if (_selectedDays.Count > 0)
            {
                _selectedDays.Clear();
                _filterDaySessions = null;
                await UpdateSessionsListAsync();
            }
        }
        else
        {
            _selectedSessionIds.Clear();
            _selectDaySessionsCache.Clear();
        }
        _selectionVersion++;
    }

    private bool IsSelected(string sessionId) => _selectedSessionIds.Contains(sessionId);

    private void ToggleSelect(string sessionId)
    {
        if (!_selectedSessionIds.Add(sessionId))
            _selectedSessionIds.Remove(sessionId);
        _selectionVersion++;
    }

    private void ToggleSelectAll()
    {
        if (_listSessions == null || _listSessions.Count == 0)
            return;

        if (_selectedSessionIds.Count == _listSessions.Count)
        {
            _selectedSessionIds.Clear();
        }
        else
        {
            _selectedSessionIds.Clear();
            foreach (var s in _listSessions)
                _selectedSessionIds.Add(s.Id);
        }
        _selectionVersion++;
        StateHasChanged();
    }

    /// <summary>
    /// Heatmap cell state: filter mode reports the day-filter chips,
    /// select mode reports days whose every session is selected.
    /// </summary>
    private bool IsDaySelected(DateOnly day) => _selectMode
        ? _selectDaySessionsCache.TryGetValue(day, out var sessions)
          && sessions.Count > 0
          && sessions.All(s => _selectedSessionIds.Contains(s.Id))
        : _selectedDays.Contains(day);

    private async Task OnHeatmapDayTapAsync(DateOnly day)
    {
        if (_selectMode)
        {
            await ToggleDaySessionSelectionAsync(day);
            return;
        }

        await ToggleDayFilter(day);
    }

    private async Task ToggleDayFilter(DateOnly day)
    {
        if (!_selectedDays.Add(day))
            _selectedDays.Remove(day);
        _filterDaySessions = null;
        _selectionVersion++;
        await UpdateSessionsListAsync();
    }

    private async Task ClearDayFilters()
    {
        _selectedDays.Clear();
        _filterDaySessions = null;
        _selectionVersion++;
        await UpdateSessionsListAsync();
    }

    private async Task ToggleDaySessionSelectionAsync(DateOnly day)
    {
        IReadOnlyList<WorkoutSessionLogEntity> sessions = await HistoryRepo.GetSessionsForLocalDayAsync(day);
        _selectDaySessionsCache[day] = sessions;

        var allSelected = sessions.Count > 0 && sessions.All(s => _selectedSessionIds.Contains(s.Id));
        if (allSelected)
            _selectedSessionIds.ExceptWith(sessions.Select(s => s.Id));
        else
            _selectedSessionIds.UnionWith(sessions.Select(s => s.Id));
        _selectionVersion++;
        StateHasChanged();
    }

    private async Task DeleteSession(string sessionId, string planName, bool inProgress)
    {
        var target = string.IsNullOrWhiteSpace(planName) ? "workout" : planName;
        var confirmed = await DialogService.ConfirmAsync(
            "Delete workout?",
            inProgress
                ? string.Format("Delete the '{0}' session (in progress) and all its logged sets? You can undo this for a short time after.", target)
                : string.Format("Delete the '{0}' session and all its logged sets? You can undo this for a short time after.", target),
            confirmText: "Delete",
            confirmColor: Color.Error);

        if (!confirmed)
            return;

        var deletedSession = await HistoryRepo.GetSessionAsync(sessionId);
        var deletedSets = deletedSession == null
            ? []
            : (await HistoryRepo.GetSetsForSessionAsync(sessionId)).ToList();

        if (inProgress)
            SessionService.EndWorkout();

        await HistoryRepo.DeleteSessionAsync(sessionId);
        _selectedSessionIds.Remove(sessionId);
        await ReloadAsync();
        Snackbar.Add("Session deleted.", Severity.Success, options =>
        {
            options.Action = "Undo";
            options.ActionColor = Color.Primary;
            options.RequireInteraction = true;
            options.OnClick = _ => RestoreSessionAsync(deletedSession, deletedSets);
        });
    }

    private async Task DeleteSelectedAsync()
    {
        if (_selectedSessionIds.Count == 0)
            return;

        var confirmed = await DialogService.ConfirmAsync(
            "Delete workouts?",
            string.Format("Delete {0} sessions and all their logged sets? You can undo this for a short time after.", _selectedSessionIds.Count),
            confirmText: "Delete",
            confirmColor: Color.Error);

        if (!confirmed)
            return;

        var deleted = new List<(WorkoutSessionLogEntity? Session, List<WorkoutSetLogEntity> Sets)>(_selectedSessionIds.Count);
        foreach (var sessionId in _selectedSessionIds)
        {
            var session = await HistoryRepo.GetSessionAsync(sessionId);
            deleted.Add((session, session == null ? [] : (await HistoryRepo.GetSetsForSessionAsync(sessionId)).ToList()));
            if (session?.EndedAtUtc == null)
                SessionService.EndWorkout();

            await HistoryRepo.DeleteSessionAsync(sessionId);
        }

        _selectedSessionIds.Clear();
        _selectDaySessionsCache.Clear();
        await ReloadAsync();
        Snackbar.Add("Sessions deleted.", Severity.Success, options =>
        {
            options.Action = "Undo";
            options.ActionColor = Color.Primary;
            options.RequireInteraction = true;
            options.OnClick = _ => RestoreSessionsAsync(deleted);
        });
    }

    private async Task RestoreSessionAsync(WorkoutSessionLogEntity? session, IReadOnlyList<WorkoutSetLogEntity> sets)
    {
        if (session == null) return;

        try
        {
            await HistoryRepo.RestoreSessionAsync(session, sets);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format("Could not restore: {0}", ex.Message), Severity.Error);
            return;
        }

        await ReloadAsync();
        Snackbar.Add("Session restored.", Severity.Success);
    }

    private async Task RestoreSessionsAsync(IReadOnlyList<(WorkoutSessionLogEntity? Session, List<WorkoutSetLogEntity> Sets)> sessions)
    {
        foreach (var (session, sets) in sessions)
        {
            if (session == null) continue;
            try
            {
                await HistoryRepo.RestoreSessionAsync(session, sets);
            }
            catch (Exception ex)
            {
                Snackbar.Add(string.Format("Could not restore: {0}", ex.Message), Severity.Error);
                return;
            }
        }

        await ReloadAsync();
        Snackbar.Add("Sessions restored.", Severity.Success);
    }

    private async Task ReloadAsync()
    {
        _sessions = [.. await HistoryRepo.GetRecentSessionsAsync(SessionPageSize)];
        _loadedSessionCount = _sessions.Count;
        _hasMoreSessions = _sessions.Count >= SessionPageSize;
        _filterDaySessions = null;
        _selectionVersion++;

        var statsTask = StatsService.GetSummaryAsync(_heatmapEndLocal, HeatmapWeeks);
        var bodyweightTask = HistoryRepo.GetBodyweightLogsAsync(1);
        await Task.WhenAll(statsTask, bodyweightTask);

        (_summary, _activityByDay) = await statsTask;
        MapLatestBodyweight(await bodyweightTask);
        await UpdateSessionsListAsync();
    }

    private void ContinueWorkout(Guid planId) =>
        Navigation.NavigateTo(AppRoutes.Workout(planId));

    private void OpenBodyweightProgress() =>
        Navigation.NavigateTo(AppRoutes.Bodyweight);

    protected override async Task OnInitializedAsync()
    {
        _heatmapEndLocal = DateOnly.FromDateTime(DateTime.Today);

        var statsTask = StatsService.GetSummaryAsync(_heatmapEndLocal, HeatmapWeeks);
        var sessionsTask = HistoryRepo.GetRecentSessionsAsync(SessionPageSize);
        var bodyweightTask = HistoryRepo.GetBodyweightLogsAsync(1);
        await Task.WhenAll(sessionsTask, statsTask, bodyweightTask);

        _sessions = [.. await sessionsTask];
        _loadedSessionCount = _sessions.Count;
        _hasMoreSessions = _sessions.Count >= SessionPageSize;
        (_summary, _activityByDay) = await statsTask;
        MapLatestBodyweight(await bodyweightTask);
        _bodyweightInputKg = _latestBodyweight?.BodyweightKg
            ?? UserProfileService.GetActiveProfile()?.BodyweightKg;
        _bodyweightDefault = _bodyweightInputKg;
        await UpdateSessionsListAsync();
    }

    /// <summary>
    /// Invoked from JS when the sentinel scrolls into view. Loads the next
    /// page of sessions and returns whether more pages may exist (the JS
    /// observer re-arms itself only while that is true).
    /// </summary>
    [JSInvokable]
    public async Task<bool> OnLoadMoreVisible()
    {
        if (_sessions == null || _selectedDays.Count > 0 || !_hasMoreSessions || _isLoadingMore)
            return false;

        _isLoadingMore = true;
        try
        {
            var more = await HistoryRepo.GetRecentSessionsAsync(SessionPageSize, _loadedSessionCount);
            if (more.Count > 0)
            {
                _sessions.AddRange(more);
                _loadedSessionCount += more.Count;
            }
            _hasMoreSessions = more.Count >= SessionPageSize;
            await UpdateSessionsListAsync();
            return _hasMoreSessions;
        }
        finally
        {
            _isLoadingMore = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_selectedDays.Count > 0 || !_hasMoreSessions)
        {
            if (_sentinelObserved)
            {
                await InfiniteScrollInterop.DisposeAsync(JS, LoadMoreSentinelId);
                _sentinelObserved = false;
            }
            return;
        }

        if (!_sentinelObserved)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await InfiniteScrollInterop.ObserveAsync(JS, LoadMoreSentinelId, _dotNetRef, nameof(OnLoadMoreVisible));
            _sentinelObserved = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_sentinelObserved)
        {
            try
            {
                await InfiniteScrollInterop.DisposeAsync(JS, LoadMoreSentinelId);
            }
            catch (JSDisconnectedException)
            {
                // WebView disposed
            }
            _sentinelObserved = false;
        }

        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }

    private void MapLatestBodyweight(IReadOnlyList<BodyweightLogEntity> rows)
    {
        _latestBodyweight = null;
        foreach (var row in rows)
        {
            if (row.GetDateOnlyOrNull() is { } date)
            {
                _latestBodyweight = new BodyweightEntry(date, row.BodyweightKg);
                return;
            }
        }
    }

    private async Task RefreshBodyweightAsync()
    {
        MapLatestBodyweight(await HistoryRepo.GetBodyweightLogsAsync(1));
    }

    private bool CanLogBodyweight => _bodyweightInputKg is { } weight && weight > 0;

    private bool CannotLogBodyweight => !CanLogBodyweight;

    private void OnBodyweightInputChanged(double? value) =>
        _bodyweightInputKg = value.HasValue
            ? ExerciseWeightFormatter.ToKg(value.Value, WeightUnitService.Current)
            : null;

    private async Task LogBodyweightAsync()
    {
        if (!CanLogBodyweight) return;

        var kg = _bodyweightInputKg!.Value;
        var today = DateOnly.FromDateTime(DateTime.Today);
        await HistoryRepo.UpsertBodyweightLogAsync(today, kg);

        var profile = UserProfileService.GetActiveProfile();
        if (profile != null)
        {
            UserProfileService.UpdateBodyweight(profile.Id, kg);
        }

        _bodyweightDefault = kg;
        await RefreshBodyweightAsync();
        Snackbar.Add("Bodyweight logged.", Severity.Success);
    }

    private async Task UpdateSessionsListAsync()
    {
        if (_sessions == null) return;

        IReadOnlySet<string>? exerciseSessionIds = null;
        var query = _searchText.Trim();
        if (!string.IsNullOrWhiteSpace(query))
        {
            exerciseSessionIds = await HistoryRepo.GetSessionIdsForExerciseNameAsync(query);
        }

        IEnumerable<WorkoutSessionLogEntity> source;
        if (_selectedDays.Count == 0)
        {
            source = _sessions;
        }
        else
        {
            _filterDaySessions ??= await LoadFilteredDaySessionsAsync();
            source = _filterDaySessions;
        }

        if (!string.IsNullOrWhiteSpace(query))
        {
            var ids = exerciseSessionIds;
            source = source.Where(s =>
                s.PlanName.Contains(query, StringComparison.OrdinalIgnoreCase)
                || (ids != null && ids.Contains(s.Id)));
        }

        _listSessions = source.ToList();
    }

    /// <summary>All sessions logged on any of the filtered days, newest first. Snapshots the day set so a toggle during the awaits cannot mutate it mid-enumeration.</summary>
    private async Task<IReadOnlyList<WorkoutSessionLogEntity>> LoadFilteredDaySessionsAsync()
    {
        var sessions = new List<WorkoutSessionLogEntity>();
        var days = _selectedDays.ToArray();
        foreach (var day in days)
        {
            sessions.AddRange(await HistoryRepo.GetSessionsForLocalDayAsync(day));
        }
        return [.. sessions.OrderByDescending(s => s.StartedAtUtc)];
    }

    private async Task OnSearchTextChanged(string text)
    {
        _searchText = text;
        await UpdateSessionsListAsync();
    }
}
