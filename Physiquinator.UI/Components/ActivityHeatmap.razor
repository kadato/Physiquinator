@inject IJSRuntime JSRuntime

<div class="activity-heatmap mb-0">
    <div class="heatmap-labels" aria-hidden="true">
        @for (var r = 0; r < 7; r++)
        {
            <div class="heatmap-day-label">@DayLabel(r)</div>
        }
    </div>
    <div class="heatmap-scroll" @ref="_heatmapScroll">
        @* Roving tabindex grid: one tab stop for the whole heatmap, arrows move
           between days, Enter/Space activates. Future cells are skipped. *@
        <div class="heatmap-grid" style="@_gridStyle" role="grid"
             aria-label="@GridAriaLabel" @onkeydown="OnGridKeyDown">
            @for (var r = 0; r < 7; r++)
            {
                var row = r;
                <div class="heatmap-row" role="row">
                    @for (var c = 0; c < Weeks; c++)
                    {
                        var col = c;
                        var idx = row * Weeks + col;
                        var cellDate = GetCellDate(col, row);
                        var isFuture = cellDate > _endLocal;
                        var count = isFuture ? 0 : CountsByDay.GetValueOrDefault(cellDate, 0);
                        var active = count > 0;
                        var cellSchedule = GetScheduleForDate?.Invoke(cellDate);
                        var isScheduled = cellSchedule?.Contains(cellDate.DayOfWeek) == true;
                        var isMissed = isScheduled && !active && !isFuture;
                        var cellState = GetCellState(isFuture, active, isScheduled);
                        var title = GetCellTitle(cellDate, active, isMissed, cellSchedule);
                        var isSelected = IsDaySelected?.Invoke(cellDate) ?? false;
                        var isToday = cellDate == DateOnly.FromDateTime(DateTime.Today);
                        <button type="button"
                                @key="cellDate"
                                class="heatmap-cell @cellState @(isSelected ? "heatmap-selected" : null) @(isToday ? "heatmap-today" : null) @(isMissed ? "heatmap-missed" : null) @(isScheduled ? "heatmap-scheduled" : null)"
                                data-hm-index="@idx"
                                tabindex="@(_focusIndex == idx ? 0 : -1)"
                                role="gridcell"
                                title="@title"
                                aria-label="@title"
                                aria-selected="@(isSelected ? "true" : "false")"
                                disabled="@isFuture"
                                @onclick="() => OnCellClickAsync(cellDate)"></button>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>Monday (row 0) through Sunday (row 6); columns are weeks, oldest left.</summary>
    [Parameter]
    public IReadOnlyDictionary<DateOnly, int> CountsByDay { get; set; } = new Dictionary<DateOnly, int>();

    [Parameter]
    public int Weeks { get; set; } = 53;

    /// <summary>Last calendar day included in the grid; future days in the last week render as planned outlines when scheduled.</summary>
    [Parameter]
    public DateOnly? EndLocal { get; set; }

    /// <summary>
    /// Scheduled training days of the week. When set, past scheduled days without a workout
    /// render with a missed marker.
    /// </summary>
    [Parameter]
    public Func<DateOnly, IReadOnlySet<DayOfWeek>>? GetScheduleForDate { get; set; }

    /// <summary>Reports whether a day is currently selected (filter or multi-select mode).</summary>
    [Parameter]
    public Func<DateOnly, bool>? IsDaySelected { get; set; }

    /// <summary>
    /// Bumped by the owner whenever its selection state changes, so the grid
    /// re-renders even though <see cref="IsDaySelected"/> is a stable method group.
    /// </summary>
    [Parameter]
    public int SelectionVersion { get; set; }

    /// <summary>Raised with the tapped day; the owner toggles it in its filter or selection state.</summary>
    [Parameter]
    public EventCallback<DateOnly> DaySelectionChanged { get; set; }

    private DateOnly _endLocal;
    private DateOnly _leftMonday;
    private ElementReference _heatmapScroll;
    private string _gridStyle = "";
    private int _focusIndex;
    private bool _focusIndexInitialized;

    private IReadOnlyDictionary<DateOnly, int>? _prevCountsByDay;
    private int _prevWeeks;
    private DateOnly? _prevEndLocal;
    private Func<DateOnly, IReadOnlySet<DayOfWeek>>? _prevGetScheduleForDate;
    private Func<DateOnly, bool>? _prevIsDaySelected;
    private int _prevSelectionVersion;

    protected override bool ShouldRender()
    {
        var shouldRender =
            !ReferenceEquals(CountsByDay, _prevCountsByDay) ||
            Weeks != _prevWeeks ||
            EndLocal != _prevEndLocal ||
            GetScheduleForDate != _prevGetScheduleForDate ||
            IsDaySelected != _prevIsDaySelected ||
            SelectionVersion != _prevSelectionVersion;

        if (shouldRender)
        {
            _prevCountsByDay = CountsByDay;
            _prevWeeks = Weeks;
            _prevEndLocal = EndLocal;
            _prevGetScheduleForDate = GetScheduleForDate;
            _prevIsDaySelected = IsDaySelected;
            _prevSelectionVersion = SelectionVersion;
        }

        return shouldRender;
    }

    protected override void OnParametersSet()
    {
        Weeks = Math.Clamp(Weeks, 1, 104);
        _endLocal = EndLocal ?? DateOnly.FromDateTime(DateTime.Today);
        var mondayOfEndWeek = HeatmapGrid.GetMondayOfWeek(_endLocal);
        _leftMonday = mondayOfEndWeek.AddDays(-7 * (Weeks - 1));
        _gridStyle =
            $"grid-template-columns: repeat({Weeks}, var(--heatmap-cell-size, 26px)); grid-template-rows: repeat(7, var(--heatmap-cell-size, 26px));";
        EnsureFocusIndex();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            await Task.Delay(50);
            await JSRuntime.InvokeVoidAsync("physiquinator.scrollHeatmapToEnd", _heatmapScroll);
        }
        catch
        {
            /* WebView / interop not ready */
        }
    }

    private string GridAriaLabel =>
        $"Activity heatmap, {Weeks} weeks. Use arrow keys to move between days, Enter to select.";

    private static int RowFromMonday(DateOnly d) => ((int)d.DayOfWeek + 6) % 7;

    private int IndexAt(int row, int col) => row * Weeks + col;

    private bool IsCellEnabled(int index)
    {
        if (index < 0 || index >= 7 * Weeks) return false;
        return GetCellDate(index % Weeks, index / Weeks) <= _endLocal;
    }

    /// <summary>Default focus lands on today's cell so one Tab reaches the present day.</summary>
    private void EnsureFocusIndex()
    {
        if (_focusIndexInitialized && IsCellEnabled(_focusIndex))
        {
            _focusIndex = Math.Min(_focusIndex, 7 * Weeks - 1);
            return;
        }

        var todayIdx = IndexAt(RowFromMonday(_endLocal), Weeks - 1);
        _focusIndex = IsCellEnabled(todayIdx) ? todayIdx : LastEnabledIndex();
        _focusIndexInitialized = true;
    }

    private int LastEnabledIndex()
    {
        var idx = 7 * Weeks - 1;
        while (idx > 0 && !IsCellEnabled(idx)) idx--;
        return idx;
    }

    private int ClampToEnabled(int index)
    {
        if (IsCellEnabled(index)) return index;
        // Disabled cells sit only at the tail of the grid; walk back to the newest enabled day.
        var idx = Math.Min(index, 7 * Weeks - 1);
        while (idx > 0 && !IsCellEnabled(idx)) idx--;
        return idx;
    }

    private async Task OnGridKeyDown(KeyboardEventArgs e)
    {
        var row = _focusIndex / Weeks;
        var col = _focusIndex % Weeks;
        var raw = e.Key switch
        {
            "ArrowLeft" => IndexAt(row, Math.Max(0, col - 1)),
            "ArrowRight" => IndexAt(row, Math.Min(Weeks - 1, col + 1)),
            "ArrowUp" => IndexAt(Math.Max(0, row - 1), col),
            "ArrowDown" => IndexAt(Math.Min(6, row + 1), col),
            "Home" => IndexAt(row, 0),
            "End" => IndexAt(row, Weeks - 1),
            _ => -1
        };
        if (raw < 0)
            return;

        var next = ClampToEnabled(raw);
        if (next == _focusIndex)
            return;

        _focusIndex = next;
        StateHasChanged();
        try
        {
            await JSRuntime.InvokeVoidAsync("physiquinator.focusHeatmapCell", _heatmapScroll, _focusIndex);
        }
        catch
        {
            /* WebView / interop not ready */
        }
    }

    private DateOnly GetCellDate(int weekColumn, int dayRow) =>
        _leftMonday.AddDays(weekColumn * 7 + dayRow);

    private static string GetCellState(bool isFuture, bool active, bool isScheduled)
    {
        if (isFuture && isScheduled)
            return "heatmap-planned";
        return active ? "heatmap-on" : "heatmap-off";
    }

    private static string? DayLabel(int row) => row switch
    {
        0 => "M",
        2 => "W",
        4 => "F",
        _ => null
    };

    private string GetCellTitle(DateOnly cellDate, bool workedOut, bool missed, IReadOnlySet<DayOfWeek>? cellSchedule)
    {
        var isScheduled = cellSchedule?.Contains(cellDate.DayOfWeek) == true;
        if (cellDate > _endLocal)
        {
            return isScheduled
                ? $"{UiDateFormats.DateOnlyCompact(cellDate)} {"(future)"} · {"scheduled"}"
                : $"{UiDateFormats.DateOnlyCompact(cellDate)} {"(future)"}";
        }
        var dayLabel = UiDateFormats.DateOnlyCompact(cellDate);
        var isToday = cellDate == DateOnly.FromDateTime(DateTime.Today);
        var todaySuffix = isToday ? $" {"(today)"}" : "";
        if (missed)
            return $"{dayLabel}{todaySuffix} · {"scheduled"}, {"missed"}";
        if (workedOut)
        {
            return isScheduled
                ? $"{dayLabel}{todaySuffix} · {"scheduled"}, {"workout"}"
                : $"{dayLabel}{todaySuffix} · {"workout"}";
        }
        return $"{dayLabel}{todaySuffix} · {"off"}";
    }

    private async Task OnCellClickAsync(DateOnly cellDate)
    {
        if (cellDate > _endLocal) return;
        if (!DaySelectionChanged.HasDelegate) return;
        await DaySelectionChanged.InvokeAsync(cellDate);
    }
}
