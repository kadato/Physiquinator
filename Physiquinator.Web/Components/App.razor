@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Rendering
@using Physiquinator.Core
@using Physiquinator.UI

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Physiquinator - Workout Tracking, AI Assistant, and Agent API</title>
    <meta name="description" content="Cross-platform workout tracking with a smart rest timer, progress analytics, an on-device AI assistant, and an MCP agent API." />
    <meta property="og:title" content="Physiquinator" />
    <meta property="og:description" content="Workout tracking with a smart rest timer, progress analytics, and an AI assistant. Try the live demo." />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0E0F17" />
    <meta name="color-scheme" content="light dark" />
    <base href="/" />
    <link rel="preload" href="_content/Physiquinator.UI/fonts/DepartureMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="_content/Physiquinator.UI/fonts/jetbrains-mono-5.woff2" as="font" type="font/woff2" crossorigin />
    <script src="js/app-boot.js"></script>
    <style>
        /* Pre-CSS paint colors match the Tokyo Night tokens in app-overrides.css. */
        html[data-theme="dark"] body {
            background-color: #0E0F17 !important;
            color: #C0CAF5;
        }
        html[data-theme="light"] body {
            background-color: #D5D6DB !important;
            color: #1A1B26;
        }
        /* Startup splash - void #0E0F17 with volt plate centered: matches native MauiSplashScreen
           Paints from raw HTML before Blazor connects, then hides itself as soon as any real content renders into #app. */
        .app-splash {
            position: fixed;
            inset: 0;
            z-index: 3000;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 1.25rem;
            padding: 2rem;
            box-sizing: border-box;
            text-align: center;
            background-color: #0E0F17;
            color: #C0CAF5;
            min-height: 100vh;
            min-height: 100dvh;
        }
        .app-splash__logo {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
        }
        .app-splash__logo svg {
            width: min(68vmin, 320px);
            height: min(68vmin, 320px);
            display: block;
        }
        html[data-theme="light"] .app-splash {
            background-color: #E7E3D1;
            color: #1A1B26;
        }
        #app:has(> :not(.app-splash)) .app-splash {
            display: none;
        }
    </style>
    <link href="_content/MudBlazor/MudBlazor.min.css?v=9.7.0" rel="stylesheet" />
    <link rel="stylesheet" href="_content/Physiquinator.UI/css/tokens.css?v=89" />
    <link rel="stylesheet" href="_content/Physiquinator.UI/css/app-overrides.css?v=89" />
    <link rel="stylesheet" href="Physiquinator.Web.styles.css" />
    <link rel="stylesheet" href="css/web.css" />
    <style>
        html, body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; box-sizing: border-box; }
        body { display: flex; flex-direction: column; }
        #app { display: flex; flex-direction: column; width: 100%; flex: 1 1 0%; min-height: 0; overflow: hidden; }
        .app-shell { display: flex; flex-direction: column; flex: 1; min-height: 0; height: 100%; overflow: hidden; }
        .app-main-scroll { flex: 1 1 auto; min-height: 0; overflow-x: hidden; overflow-y: auto; }
        .app-tab-bar { flex-shrink: 0; }
    </style>
    <link rel="icon" type="image/svg+xml" href="_content/Physiquinator.UI/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="_content/Physiquinator.UI/favicon.png?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="_content/Physiquinator.UI/apple-touch-icon.png?v=2" />
</head>

<body>

    <div id="app">
        <output class="app-splash" aria-live="polite" aria-busy="true" aria-label="Loading application">
            <div class="app-splash__logo" aria-hidden="true">
                <svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Physiquinator">
                    <rect x="150" y="150" width="220" height="220" fill="#414770"/>
                    <rect x="142" y="142" width="220" height="220" fill="#FAFF00" stroke="#10111A" stroke-width="4"/>
                    <path d="M142 142 H362 V146 H142 Z" fill="white" opacity="0.42"/>
                    <path d="M142 142 V362 H146 V142 Z" fill="white" opacity="0.42"/>
                    <g fill="#414770" transform="translate(6,6)">
                        <rect x="234" y="182" width="36" height="46"/>
                        <polygon points="185,234 319,234 279,324 225,324"/>
                    </g>
                    <g fill="#10111A">
                        <rect x="234" y="182" width="36" height="46"/>
                        <polygon points="185,234 319,234 279,324 225,324"/>
                    </g>
                </svg>
            </div>
        </output>
        <AuthGate @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    </div>

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <button type="button" class="dismiss" aria-label="Dismiss error">🗙</button>
    </div>

    <!-- sortable.min.js and html2canvas.min.js are lazy-loaded on demand -->
    <script src="_content/Physiquinator.UI/js/theme.js"></script>
    <script src="_content/Physiquinator.UI/js/stepperDrag.js"></script>
    <script src="_content/Physiquinator.UI/js/appHelpers.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js?v=9.7.0"></script>
    <script src="js/dbSync.js"></script>
    <script src="js/fileTransfer.js"></script>
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script type="module" src="js/dbSyncBootstrap.js"></script>

    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />

</body>
</html>
