@* Skeleton for the Home page while stats, heatmap and plans load. *@

<div class="home-skeleton" aria-hidden="true">
    <div class="home-skeleton__overview">
        <div class="home-skeleton__hero">
            <SkeletonBlock Height="0.9rem" Width="5.5rem" />
            <SkeletonBlock Height="1.5rem" Width="70%" />
            <SkeletonBlock Height="2.75rem" />
        </div>
        <div class="home-skeleton__stats">
            <SkeletonBlock Height="4.5rem" />
            <SkeletonBlock Height="4.5rem" />
            <SkeletonBlock Height="4.5rem" />
        </div>
    </div>
    <SkeletonBlock Height="15rem" ClassName="home-skeleton__heatmap" />
    <SkeletonBlock Height="1.25rem" Width="8rem" ClassName="home-skeleton__section-title" />
    <div class="home-skeleton__plans">
        <SkeletonBlock Height="6rem" />
        <SkeletonBlock Height="6rem" />
        <SkeletonBlock Height="6rem" />
    </div>
</div>

