<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Links the e_sqlite3 static library into the wasm runtime so sqlite-net-pcl
         works in-browser (see tools/wasm-spike for the proof). -->
    <WasmBuildNative>true</WasmBuildNative>
    <!-- The linker emits documented-but-noisy WASM0001 varargs warnings for
         sqlite3_config/sqlite3_db_config; they are never called at runtime.
         S8970: [Inject] members need null-forgiving init, matching the UI library. -->
    <NoWarn>$(NoWarn);WASM0001;S8970</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <!-- Ships runtimes/browser-wasm/nativeassets/e_sqlite3.a consumed by WasmBuildNative.
         Core's bundle_green also flows in transitively via sqlite-net-pcl. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Physiquinator.UI\Physiquinator.UI.csproj" />
  </ItemGroup>

  <!-- Cloudflare Pages is a static file server. Isolated CSS is fingerprinted
       to Physiquinator.UI.*.bundle.scp.css but index.html references the
       unfingerprinted name. Copy the hashed file to the unfingerprinted
       path so the stylesheet loads without ASP.NET's MapStaticAssets. -->
  <Target Name="CopyScopedCssForStaticHost" AfterTargets="Publish">
    <ItemGroup>
      <ScopedCssHashed Include="$(PublishDir)wwwroot/_content/Physiquinator.UI/Physiquinator.UI.*.bundle.scp.css" />
    </ItemGroup>
    <Copy SourceFiles="@(ScopedCssHashed)" DestinationFiles="$(PublishDir)wwwroot/_content/Physiquinator.UI/Physiquinator.UI.bundle.scp.css" OverwriteReadOnlyFiles="true" Condition="'@(ScopedCssHashed)' != ''" />
  </Target>

</Project>
