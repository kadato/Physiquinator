@* Preview of what an import will do before anything is merged. *@

<MudDialog>
    <TitleContent>
        <div class="dialog-header-bar">
            <div class="dialog-header-bar__left">
                <span class="dialog-title-icon-box">
                    <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" />
                </span>
                <span class="dialog-header-bar__title">@Title</span>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2" Class="py-2">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @Note
            </MudText>
            <div class="import-preview-rows">
                @foreach (var row in Rows)
                {
                    <div class="import-preview-row">
                        <span class="import-preview-row__label">@row.Label</span>
                        <span class="import-preview-row__value">@row.Value</span>
                    </div>
                }
            </div>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Class="dialog-cancel-btn" OnClick="Cancel">@("Cancel")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="dialog-confirm-btn" StartIcon="@Icons.Material.Filled.Download" OnClick="Confirm">
            @("Import")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public string Title { get; set; } = "Import";

    [Parameter]
    public string Note { get; set; } = "The imported data is merged into this device. Existing matching entries are replaced.";

    [Parameter, EditorRequired]
    public IReadOnlyList<(string Label, string Value)> Rows { get; set; } = [];

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private void Cancel() => MudDialog.Cancel();

    private void Confirm() => MudDialog.Close();
}
