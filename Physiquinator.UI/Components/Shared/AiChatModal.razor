@using Physiquinator.Core.Services.Ai
@using Physiquinator.Core.Models
@using Markdig
@inject AiAssistantService AiAssistant
@inject AiClipboardBridgeService BridgeService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IDisposable

<MudDialog Class="ai-chat-dialog">
    <DialogContent>
        <div class="ai-chat-container">
            <!-- Header -->
            <div class="ai-chat-header">
                <div class="ai-chat-header__title" aria-hidden="true">
                    <div class="ai-chat-header__badge">
                        <MudIcon Icon="@Icons.Material.Filled.Memory" Size="Size.Small" />
                    </div>
                </div>

                <div class="ai-mode-tabs" role="tablist">
                    <button type="button"
                            role="tab"
                            aria-selected="@(_activeTab == 0 ? "true" : "false")"
                            class="ai-mode-tab @(_activeTab == 0 ? "ai-mode-tab--active" : "")"
                            @onclick="@(() => SetTab(0))">
                        <MudIcon Icon="@Icons.Material.Filled.Chat" Size="Size.Small" />
                        <span>@("Chat")</span>
                    </button>
                    <button type="button"
                            role="tab"
                            aria-selected="@(_activeTab == 1 ? "true" : "false")"
                            class="ai-mode-tab @(_activeTab == 1 ? "ai-mode-tab--active" : "")"
                            @onclick="@(() => SetTab(1))">
                        <MudIcon Icon="@Icons.Material.Filled.ContentPaste" Size="Size.Small" />
                        <span>@("Clipboard")</span>
                    </button>
                </div>

                <div class="ai-chat-header__actions">
                    @if (_activeTab == 0)
                    {
                        <button type="button" class="ai-header-btn" aria-label="@("Clear history")" @onclick="ClearHistory">
                            <MudIcon Icon="@Icons.Material.Outlined.DeleteSweep" Size="Size.Small" />
                        </button>
                    }
                    <button type="button" class="ai-header-btn" aria-label="@("Close")" @onclick="Close">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                    </button>
                </div>
            </div>

            @if (_activeTab == 0)
            {
                <!-- Direct In-App Chat View -->

                <!-- API Key Warning Banner if Not Configured -->
                @if (IsApiKeyMissing)
                {
                    <div class="ai-api-key-banner">
                        <div class="ai-api-key-banner__content">
                            <MudIcon Icon="@Icons.Material.Filled.VpnKey" Color="Color.Warning" Size="Size.Small" />
                            <div>
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold ai-banner-title">@("API key required")</MudText>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@(() => SetTab(1))" Class="ai-banner-button">
                                @("Clipboard")
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" OnClick="NavigateToSettings" Class="ai-banner-button">
                                @("Settings")
                            </MudButton>
                        </div>
                    </div>
                }

                <!-- Messages Area -->
                <div class="ai-chat-messages" @ref="_messagesElement" role="log" aria-live="polite" aria-relevant="additions">
                    @if (AiAssistant.Messages.Count == 0)
                    {
                        <div class="ai-chat-empty">
                            <MudIcon Icon="@Icons.Material.Filled.Memory" Size="Size.Large" Color="Color.Primary" Class="mb-1" />
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@("Ask anything")</MudText>
                        </div>
                    }
                    else
                    {
                        @foreach (var msg in AiAssistant.Messages)
                        {
                            if (msg.Role == AiMessageRole.User)
                            {
                                <div class="ai-msg ai-msg--user">
                                    <div class="ai-msg__bubble">
                                        @msg.Content
                                    </div>
                                    <span class="ai-msg__time">@FormatTime(msg.Timestamp)</span>
                                </div>
                            }
                            else if (msg.Role == AiMessageRole.Assistant)
                            {
                                <div class="@GetAssistantClass(msg)">
                                    <div class="ai-msg__avatar" aria-hidden="true">
                                        <MudIcon Icon="@Icons.Material.Filled.Memory" Size="Size.Small" />
                                    </div>
                                    <div class="ai-msg__body">
                                        <div class="ai-msg__bubble">
                                            @if (msg.IsThinking)
                                            {
                                                <div class="ai-msg__thinking">
                                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                                    <span>@("Thinking…")</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="ai-msg__content markdown-body">@((MarkupString)RenderMarkdown(msg.Content))</div>
                                            }
                                        </div>
                                        @if (msg.ToolCalls != null && msg.ToolCalls.Count > 0)
                                        {
                                            <div class="ai-msg__tools">
                                                @foreach (var tc in msg.ToolCalls)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Icon="@Icons.Material.Filled.Build">
                                                        @(string.Format("Executed {0}", tc.Name))
                                                    </MudChip>
                                                }
                                            </div>
                                        }
                                        <span class="ai-msg__actions">
                                            @if (!string.IsNullOrWhiteSpace(msg.Content))
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                                               Size="Size.Small"
                                                               Class="ai-msg__copy"
                                                               aria-label="@("Copy message")"
                                                               OnClick="@(() => CopyTextAsync(msg.Content, "Message copied."))" />
                                            }
                                            <span class="ai-msg__time">@FormatTime(msg.Timestamp)</span>
                                        </span>
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>

                <!-- Quick action buttons, shown only while the chat is still empty -->
                @if (AiAssistant.Messages.Count == 0)
                {
                    <div class="ai-chat-quick-actions">
                        <button type="button" class="ai-quick-btn ai-quick-btn--cyan" disabled="@IsApiKeyMissing" @onclick="OnProgressiveOverloadClick">
                            <span>@("Progressive Overload")</span>
                        </button>
                        <button type="button" class="ai-quick-btn ai-quick-btn--magenta" disabled="@IsApiKeyMissing" @onclick="OnPerformanceStatsClick">
                            <span>@("Performance Stats")</span>
                        </button>
                        <button type="button" class="ai-quick-btn ai-quick-btn--yellow" disabled="@IsApiKeyMissing" @onclick="OnDeloadPlanClick">
                            <span>@("Deload Plan")</span>
                        </button>
                        <button type="button" class="ai-quick-btn ai-quick-btn--green" disabled="@IsApiKeyMissing" @onclick="OnWorkoutAdviceClick">
                            <span>@("Workout Advice")</span>
                        </button>
                    </div>
                }

                <!-- Input Bar -->
                <div class="ai-chat-input">
                    <div class="ai-chat-composer">
                        <div class="ai-chat-input__field">
                            <MudTextField @ref="_inputField" T="string" Variant="Variant.Text" Placeholder="@("Ask anything…")"
                                          Immediate="true"
                                          @bind-Value="_inputText"
                                          OnKeyDown="HandleKeyDown"
                                          Disabled="@(_isSending || IsApiKeyMissing)"
                                          Margin="Margin.Dense"
                                          enterkeyhint="send"
                                          Class="ai-chat-textfield" />
                        </div>

                        @if (_isSending)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Stop"
                                           Color="Color.Error"
                                           Variant="Variant.Filled"
                                           aria-label="@("Stop generating")"
                                           title="@("Stop generating")"
                                           OnClick="StopGeneration"
                                           Class="ai-chat-send-button" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Send"
                                           Color="Color.Primary"
                                           Variant="Variant.Filled"
                                           aria-label="@("Send message")"
                                           title="@("Send message")"
                                           Disabled="@(string.IsNullOrWhiteSpace(_inputText) || IsApiKeyMissing)"
                                           OnClick="SendMessageAsync"
                                           Class="ai-chat-send-button" />
                        }
                    </div>
                </div>
            }
            else
            {
                <!-- Clipboard bridge view -->
                <div class="ai-bridge-container">
                    <!-- Step 1: Export Prompt -->
                    <div class="ai-bridge-card">
                        <div class="ai-bridge-card__header">
                            <div class="ai-bridge-step-badge">1</div>
                            <div>
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@("Copy prompt for Gemini or ChatGPT")</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@("Copies your plans, history summary, and the action list for the AI. Paste it into Gemini or ChatGPT, then paste the reply back here.")</MudText>
                            </div>
                        </div>

                        <div class="ai-bridge-field mt-2">
                            <MudTextField T="string"
                                          @bind-Value="_promptGoal"
                                          Placeholder="@("What should the AI do? For example build a 3-day push pull legs routine, analyze volume, or log weight")"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Lines="2" />
                        </div>

                        <div class="ai-bridge-presets mt-2">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => SetGoalPreset("Create a 3-day Full Body workout routine focusing on compound lifts."))">
                                @("3-Day Full Body")
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => SetGoalPreset("Design a 4-day Upper / Lower hypertrophy split with 90s rest timers."))">
                                @("Upper / Lower Split")
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => SetGoalPreset("Analyze my workout plans and calculate progressive overload weight recommendations."))">
                                @("Progressive Overload")
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => SetGoalPreset("Create a deload version of my existing routine."))">
                                @("Deload Plan")
                            </MudChip>
                        </div>

                        <div class="ai-bridge-options mt-2">
                            <MudCheckBox @bind-Value="_includePlans" Label="@("Workout plans")" Dense="true" Size="Size.Small" Color="Color.Primary" />
                            <MudCheckBox @bind-Value="_includeBodyweight" Label="@("Recent bodyweight")" Dense="true" Size="Size.Small" Color="Color.Primary" />
                            <MudCheckBox @bind-Value="_includeStats" Label="@("History stats")" Dense="true" Size="Size.Small" Color="Color.Primary" />
                        </div>

                        <div class="d-flex justify-space-between align-center mt-2">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.ContentCopy"
                                       Size="Size.Small"
                                       OnClick="GenerateAndCopyPromptAsync"
                                       Disabled="@_isGeneratingPrompt">
                                @if (_isGeneratingPrompt)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                    <span>@("Generating...")</span>
                                }
                                else
                                {
                                    <span>@("Copy prompt")</span>
                                }
                            </MudButton>

                            @if (!string.IsNullOrWhiteSpace(_generatedPromptPreview))
                            {
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Default"
                                           Size="Size.Small"
                                           OnClick="@(() => _showPromptPreview = !_showPromptPreview)">
                                    @(_showPromptPreview ? "Hide Prompt" : "Preview Prompt")
                                </MudButton>
                            }
                        </div>

                        @if (_showPromptPreview && !string.IsNullOrWhiteSpace(_generatedPromptPreview))
                        {
                            <div class="ai-bridge-prompt-preview mt-2">
                                <pre>@_generatedPromptPreview</pre>
                            </div>
                        }
                    </div>

                    <!-- Step 2: Import and apply response -->
                    <div class="ai-bridge-card mt-3">
                        <div class="ai-bridge-card__header">
                            <div class="ai-bridge-step-badge">2</div>
                            <div>
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@("Paste AI response")</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@("Paste the reply from Gemini or ChatGPT here. The app reads it and lists the actions to apply.")</MudText>
                            </div>
                        </div>

                        <div class="ai-bridge-field mt-2">
                            <MudTextField T="string"
                                          @bind-Value="_pastedResponse"
                                          Placeholder="@("Paste the full response from Gemini or ChatGPT here (including the JSON action block)...")"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Lines="3" />
                        </div>

                        <div class="d-flex justify-space-between align-center mt-2">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.FindInPage"
                                       Size="Size.Small"
                                       Disabled="@(string.IsNullOrWhiteSpace(_pastedResponse))"
                                       OnClick="InspectPastedActions">
                                @("Review actions")
                            </MudButton>

                            @if (_parsedActions.Count > 0)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Success"
                                           StartIcon="@Icons.Material.Filled.CheckCircle"
                                           Size="Size.Small"
                                           Disabled="@(_isExecutingActions || !_parsedActions.Any(a => a.IsValid))"
                                           OnClick="ApplyActionsAsync">
                                    @if (_isExecutingActions)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                        <span>@("Applying...")</span>
                                    }
                                    else
                                    {
                                        <span>@(string.Format("Apply {0} actions", _parsedActions.Count(a => a.IsValid)))</span>
                                    }
                                </MudButton>
                            }
                        </div>

                        <!-- Parsed Actions Preview -->
                        @if (_parsedActions.Count > 0)
                        {
                            <div class="ai-bridge-actions-list mt-3">
                                <MudText Typo="Typo.caption" Class="font-weight-bold mud-text-secondary text-uppercase mb-1">
                                    @("Actions found")
                                </MudText>
                                @foreach (var action in _parsedActions)
                                {
                                    <div class="ai-bridge-action-item @(action.IsValid ? "" : "ai-bridge-action-item--invalid")">
                                        <div class="d-flex align-center gap-2">
                                            @if (action.IsValid)
                                            {
                                                <MudIcon Icon="@(action.IsDestructive ? Icons.Material.Filled.Warning : Icons.Material.Filled.CheckCircleOutline)"
                                                         Color="@(action.IsDestructive ? Color.Warning : Color.Success)"
                                                         Size="Size.Small" />
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Small" />
                                            }
                                            <div class="flex-1">
                                                <MudText Typo="Typo.body2" Class="font-weight-bold">@action.HumanSummary</MudText>
                                                @if (!action.IsValid && !string.IsNullOrWhiteSpace(action.ValidationError))
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Error">@action.ValidationError</MudText>
                                                }
                                                else if (!string.IsNullOrWhiteSpace(action.Description))
                                                {
                                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@action.Description</MudText>
                                                }
                                            </div>
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                                @action.ToolName
                                            </MudChip>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else if (_hasInspected && _parsedActions.Count == 0)
                        {
                            <div class="ai-bridge-empty mt-2">
                                <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" Size="Size.Small" />
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @("No structured actions found in the pasted text. Make sure the AI included the ```json { \"actions\": [...] } ``` block.")
                                </MudText>
                            </div>
                        }

                        <!-- Execution Results -->
                        @if (_executionResults.Count > 0)
                        {
                            <div class="ai-bridge-results mt-3">
                                <MudText Typo="Typo.caption" Class="font-weight-bold mud-text-secondary text-uppercase mb-1">
                                    @("Results")
                                </MudText>
                                @foreach (var res in _executionResults)
                                {
                                    <div class="ai-bridge-result-item @(res.Success ? "ai-bridge-result-item--success" : "ai-bridge-result-item--error")">
                                        <MudIcon Icon="@(res.Success ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                                                 Color="@(res.Success ? Color.Success : Color.Error)"
                                                 Size="Size.Small" />
                                        <MudText Typo="Typo.body2">@res.Message</MudText>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    private int _activeTab = 0;

    // Chat Tab State
    private MudTextField<string>? _inputField;
    private string _inputText = string.Empty;
    private bool _isSending = false;
    private ElementReference _messagesElement;

    // Bridge Tab State
    private string _promptGoal = string.Empty;
    private bool _includePlans = true;
    private bool _includeBodyweight = true;
    private bool _includeStats = true;
    private bool _isGeneratingPrompt = false;
    private string _generatedPromptPreview = string.Empty;
    private bool _showPromptPreview = false;

    private string _pastedResponse = string.Empty;
    private bool _hasInspected = false;
    private List<AiBridgeAction> _parsedActions = [];
    private List<AiBridgeActionExecutionResult> _executionResults = [];
    private bool _isExecutingActions = false;

    private bool IsApiKeyMissing
    {
        get
        {
            var settings = AiAssistant.GetSettings();
            return !settings.Enabled || (settings.Provider != AiProviderType.OllamaLocal && string.IsNullOrWhiteSpace(settings.ApiKey));
        }
    }

    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .DisableHtml()
        .Build();

    private static string RenderMarkdown(string? rawMarkdown) =>
        Markdown.ToHtml(rawMarkdown ?? string.Empty, MarkdownPipeline);

    private static string GetAssistantClass(AiChatMessage msg) =>
        msg.IsError ? "ai-msg ai-msg--assistant ai-msg--error" : "ai-msg ai-msg--assistant";

    private static string FormatTime(DateTime timestamp) =>
        timestamp.ToLocalTime().ToString("t", System.Globalization.CultureInfo.CurrentCulture);

    protected override void OnInitialized()
    {
        AiAssistant.OnMessagesChanged += HandleMessagesChanged;
    }

    private void SetTab(int tabIndex)
    {
        _activeTab = tabIndex;
        StateHasChanged();
    }

    private void SetGoalPreset(string goal)
    {
        _promptGoal = goal;
    }

    private async Task GenerateAndCopyPromptAsync()
    {
        _isGeneratingPrompt = true;
        try
        {
            var options = new AiBridgePromptOptions
            {
                IncludeWorkoutPlans = _includePlans,
                IncludeRecentBodyweight = _includeBodyweight,
                IncludeHistoryStats = _includeStats
            };

            var prompt = await BridgeService.GeneratePromptAsync(_promptGoal, options);
            _generatedPromptPreview = prompt;

            await CopyTextAsync(prompt, "Prompt copied to clipboard! Paste it into Gemini or ChatGPT.");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to generate prompt: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isGeneratingPrompt = false;
        }
    }

    private void InspectPastedActions()
    {
        _hasInspected = true;
        _executionResults.Clear();
        _parsedActions = [.. BridgeService.ParseResponse(_pastedResponse)];

        if (_parsedActions.Count == 0)
        {
            Snackbar.Add("No actions found in that response.", Severity.Warning);
        }
        else
        {
            var validCount = _parsedActions.Count(a => a.IsValid);
            Snackbar.Add($"Found {validCount} valid actions. Ready to apply.", Severity.Info);
        }
    }

    private async Task ApplyActionsAsync()
    {
        if (_parsedActions.Count == 0 || _isExecutingActions) return;

        _isExecutingActions = true;
        try
        {
            _executionResults = await BridgeService.ExecuteActionsAsync(_parsedActions);
            var successCount = _executionResults.Count(r => r.Success);

            if (successCount > 0)
            {
                Snackbar.Add($"Successfully applied {successCount} changes to Physiquinator!", Severity.Success);
            }
            else
            {
                Snackbar.Add("Could not apply that action.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error applying actions: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isExecutingActions = false;
        }
    }

    private void HandleMessagesChanged()
    {
        InvokeAsync(async () =>
        {
            StateHasChanged();
            await ScrollToBottomAsync();
        });
    }

    private async Task ScrollToBottomAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("physiquinatorHelpers.scrollToBottom", _messagesElement);
        }
        catch (Exception)
        {
            // Element not rendered yet or JS unavailable
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                if (_inputField != null)
                    await _inputField.FocusAsync();
            }
            catch (Exception)
            {
                _ = 0;
            }
        }
        await ScrollToBottomAsync();
    }

    private void StopGeneration()
    {
        AiAssistant.CancelCurrentTurn();
    }

    private async Task CopyTextAsync(string content, string successMessage)
    {
        if (string.IsNullOrWhiteSpace(content)) return;

        var copied = false;
        try
        {
            copied = await JS.InvokeAsync<bool>("physiquinatorHelpers.copyText", content);
        }
        catch (Exception)
        {
            copied = false;
        }

        if (copied)
            Snackbar.Add(successMessage, Severity.Success);
        else
            Snackbar.Add("Could not copy to clipboard.", Severity.Error);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !string.IsNullOrWhiteSpace(_inputText) && !_isSending)
        {
            await SendMessageAsync();
        }
    }

    private async Task OnProgressiveOverloadClick() =>
        await SendPrompt("Suggest progressive overload recommendations for my active workout plans.");

    private async Task OnPerformanceStatsClick() =>
        await SendPrompt("Show my current workout stats and recent performance.");

    private async Task OnWorkoutAdviceClick() =>
        await SendPrompt("Analyze my training volume and recommend recovery adjustments.");

    private async Task OnDeloadPlanClick() =>
        await SendPrompt("Create a deload version of my primary workout plan.");

    private async Task SendPrompt(string prompt)
    {
        _inputText = prompt;
        await SendMessageAsync();
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(_inputText) || _isSending) return;

        var text = _inputText;
        _inputText = string.Empty;
        _isSending = true;

        try
        {
            await AiAssistant.SendUserMessageAsync(text);
        }
        finally
        {
            _isSending = false;
        }
    }

    private void NavigateToSettings()
    {
        MudDialog?.Close();
        Navigation.NavigateTo(AppRoutes.Settings);
    }

    private async Task ClearHistory()
    {
        if (AiAssistant.Messages.Count == 0)
            return;

        var confirmed = await DialogService.ConfirmAsync(
            "Clear chat history?",
            "This removes every message in this conversation. It cannot be undone.",
            confirmText: "Clear",
            confirmColor: Color.Error);
        if (!confirmed)
            return;

        AiAssistant.ClearHistory();
    }

    private void Close()
    {
        MudDialog?.Close();
    }

    public void Dispose()
    {
        AiAssistant.CancelCurrentTurn();
        AiAssistant.OnMessagesChanged -= HandleMessagesChanged;
    }
}
