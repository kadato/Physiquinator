@* Edit a bodyweight entry (upserts the value for the entry's date). *@

<MudDialog>
    <TitleContent>
        <div class="d-flex align-items-center gap-3">
            <MudIcon Icon="@Icons.Material.Filled.MonitorWeight" Color="Color.Primary" Size="Size.Medium" />
            <MudText Typo="Typo.h6" Class="fw-bold">@("Edit entry")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <form @onsubmit="Confirm" @onsubmit:preventDefault>
            <MudStack Spacing="2" Class="py-2">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @DateLabel — @UnitSuffix
                </MudText>
                <MudTextField T="string"
                              Label="@("Bodyweight")"
                              Variant="Variant.Filled"
                              InputMode="@((InputMode)2)"
                              @bind-Value="_valueText"
                              Placeholder="@("e.g. 80.5")"
                              enterkeyhint="done" />
            </MudStack>
            <div class="mud-dialog-actions">
                <MudButton Variant="Variant.Text" ButtonType="ButtonType.Button" OnClick="Cancel">@("Cancel")</MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@(!TryParseValue(out _))"
                           StartIcon="@Icons.Material.Filled.Save"
                           ButtonType="ButtonType.Submit">
                    @("Save")
                </MudButton>
            </div>
        </form>
    </DialogContent>
</MudDialog>

@code {
    [Parameter]
    public string DateLabel { get; set; } = "";

    [Parameter]
    public string UnitSuffix { get; set; } = "kg";

    [Parameter]
    public double? CurrentValue { get; set; }

    private string _valueText = "";

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    protected override void OnInitialized()
    {
        _valueText = CurrentValue is { } v
            ? v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)
            : "";
    }

    private void Cancel() => MudDialog.Cancel();

    private bool TryParseValue(out double value) =>
        (double.TryParse(_valueText, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.CurrentCulture, out value)
         || double.TryParse(_valueText, System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out value))
        && value > 0;

    private void Confirm()
    {
        if (TryParseValue(out var value))
        {
            MudDialog.Close(DialogResult.Ok(value));
        }
    }
}
