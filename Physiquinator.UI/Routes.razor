@inject IStringLocalizer<UiText> Loc

<Router AppAssembly="@typeof(Routes).Assembly">
    <Found Context="routeData">
        <Microsoft.AspNetCore.Components.Web.ErrorBoundary>
            <ChildContent>
                <RouteView RouteData="@routeData" DefaultLayout="@typeof(Components.Layout.MainLayout)" />
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </ChildContent>
            <ErrorContent>
                <MudAlert Severity="Severity.Error" Class="ma-3">
                    @Loc["Something went wrong while showing this page. Please try again."]
                </MudAlert>
            </ErrorContent>
        </Microsoft.AspNetCore.Components.Web.ErrorBoundary>
    </Found>
    <NotFound>
        <PageTitle>@Loc["Not found"]</PageTitle>
        <LayoutView Layout="@typeof(Components.Layout.MainLayout)">
            <EmptyState Message="@Loc["Sorry, there's nothing at this address."]"
                        Icon="@Icons.Material.Outlined.SearchOff">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/">@Loc["Go home"]</MudButton>
            </EmptyState>
        </LayoutView>
    </NotFound>
</Router>
