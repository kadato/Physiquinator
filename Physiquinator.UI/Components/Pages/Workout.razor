@page "/workout/{PlanId:guid}"
@using Microsoft.Extensions.Logging
@using System.Globalization
@inject WorkoutPlanService PlanService
@inject WorkoutSessionService SessionService
@inject RestAlertSettingsService RestAlertSettings
@inject INotificationService RestNotifications
@inject RestTimerCoordinator RestTimer
@inject WorkoutHistoryRepository HistoryRepository
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject UserProfileService UserProfileService
@inject WorkoutTimerInterop TimerInterop
@inject ISnackbar Snackbar
@inject ILogger<Workout> Logger
@inject TimeProvider TimeProvider
@inject WeightUnitService WeightUnitService
@implements IAsyncDisposable

<PageTitle>@(SessionService.CurrentPlan?.Name ?? "Workout")</PageTitle>

<PageHeader Title="@(SessionService.CurrentPlan?.Name ?? "Workout")"  />

@if (_isLoading)
{
    <WorkoutSkeleton />
}
else if (SessionService.CurrentPlan == null)
{
    <EmptyState Message="@("No active workout. Start a plan from home.")"
                Icon="@Icons.Material.Outlined.Warning">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/">@("Go home")</MudButton>
    </EmptyState>
}
else
{
    <MudStack Spacing="3">
        @if (_overlayPermissionMissing)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-2">
                <div class="d-flex align-center gap-2">
                    <div class="flex-grow-1">
                        @("Enable \\\"Display over other apps\\\" so the floating rest timer shows when you leave the app.")
                    </div>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Warning"
                               Class="flex-shrink-0"
                               OnClick="OpenOverlaySettingsAsync">
                        @("Grant")
                    </MudButton>
                </div>
            </MudAlert>
        }

        <div class="workout-top">
            @if (_sessionStartedAtUtc != default)
            {
                <div class="workout-session-stats">
                    <div class="workout-session-stat">
                        <span class="workout-session-stat__value">@ElapsedLabel</span>
                        <span class="workout-session-stat__label">@("Elapsed")</span>
                    </div>
                    @if (SessionVolumeLabel is { } volume)
                    {
                        <div class="workout-session-stat-divider" aria-hidden="true"></div>
                        <div class="workout-session-stat">
                            <span class="workout-session-stat__value">@volume</span>
                            <span class="workout-session-stat__label">@("Volume")</span>
                        </div>
                    }
                </div>
            }

            @if (SessionService.IsResting || _isRestComplete)
            {
                <RestTimerPanel @ref="_restPanel"
                                IsRestComplete="_isRestComplete"
                                AddRestSeconds="@RestAlertSettings.AddTimeSeconds"
                                OnReset="ResetRest"
                                OnSkip="SkipRest"
                                OnAddTime="AddRestTime" />
            }
        </div>

        <div class="workout-exercise-layout">
            @foreach (var item in UpcomingExercises)
            {
                <WorkoutExerciseCard Exercise="@item.Exercise"
                                     ExerciseIndex="@item.ExerciseIndex"
                                     CompletedSetsCount="@item.CompletedSets"
                                     IsExpanded="@(_activeExerciseIndex == item.ExerciseIndex)"
                                     IsCompleting="@_isCompleting"
                                     ActiveSetIndex="@_activeSetIndices.GetValueOrDefault(item.ExerciseIndex, 0)"
                                     DefaultReps="@DefaultReps"
                                     BodyweightKg="@_bodyweightKg"
                                     SetInputs="@_setInputs"
                                     SessionSets="@_sessionSets"
                                     CanMoveUp="@(item.ExerciseIndex > 0)"
                                     CanMoveDown="@(item.ExerciseIndex < ExerciseCount - 1)"
                                     OnMoveUp="@(() => MoveExerciseAsync(item.ExerciseIndex, item.ExerciseIndex - 1))"
                                     OnMoveDown="@(() => MoveExerciseAsync(item.ExerciseIndex, item.ExerciseIndex + 1))"
                                     OnToggle="ToggleAccordion"
                                     OnToggleSet="ToggleSetComplete"
                                     OnWeightChanged="HandleWeightStepperChanged"
                                     OnRepsChanged="HandleRepsStepperChanged"
                                     OnSetWeightChanged="HandleSetWeightChanged"
                                     OnSetRepsChanged="HandleSetRepsChanged"
                                     OnSkipExercise="SkipExerciseAsync" />
            }

            @if (DoneExercises.Any())
            {
                <div class="workout-completed-divider-title mt-4 mb-2">
                    <MudText Typo="Typo.overline" Color="Color.Success" Class="font-weight-bold">@("Completed")</MudText>
                </div>

                @foreach (var item in DoneExercises)
                {
                    <WorkoutExerciseCard Exercise="@item.Exercise"
                                         ExerciseIndex="@item.ExerciseIndex"
                                         CompletedSetsCount="@item.CompletedSets"
                                         IsExpanded="@(_activeExerciseIndex == item.ExerciseIndex)"
                                         IsCompleted="true"
                                         IsCompleting="@_isCompleting"
                                         ActiveSetIndex="@_activeSetIndices.GetValueOrDefault(item.ExerciseIndex, 0)"
                                         DefaultReps="@DefaultReps"
                                         BodyweightKg="@_bodyweightKg"
                                         SetInputs="@_setInputs"
                                         SessionSets="@_sessionSets"
                                         OnToggle="ToggleAccordion"
                                         OnToggleSet="ToggleSetComplete"
                                         OnWeightChanged="HandleWeightStepperChanged"
                                         OnRepsChanged="HandleRepsStepperChanged"
                                         OnSetWeightChanged="HandleSetWeightChanged"
                                         OnSetRepsChanged="HandleSetRepsChanged"
                                         OnSkipExercise="SkipExerciseAsync" />
                }
            }

            @if (!UpcomingExercises.Any() && DoneExercises.Any())
            {
                <MudAlert Severity="Severity.Success" Class="mt-2">@("Workout complete!")</MudAlert>
            }
            <MudStack Row="true" Spacing="3" Class="mt-4 w-100 workout-actions-row" Justify="Justify.Center">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete"
                           Class="premium-btn premium-btn-lg premium-btn-error-outlined"
                           OnClick="DiscardWorkoutClick">
                    @("Discard")
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Check"
                           Class="premium-btn premium-btn-lg premium-btn-filled"
                           OnClick="EndWorkoutClick">
                    @("End")
                </MudButton>
            </MudStack>
        </div>

    </MudStack>
}

@if (_undoVisible)
{
    <MudIconButton Class="workout-undo-btn"
                   Icon="@Icons.Material.Filled.Restore"
                   OnClick="UndoLastSetCoreAsync"
                   aria-label="@("Undo last set")" />
}

@code {
    [Parameter]
    public Guid PlanId { get; set; }

    [SupplyParameterFromQuery(Name = "forceNew")]
    public bool ForceNew { get; set; }

    private const int DefaultReps = 10;
    private const int RestTickIntervalMs = 1000;
    private const int UndoToastDurationMs = 4000;

    private bool _isRestComplete;
    private bool _overlayPermissionMissing;
    private int _lastRestDurationSeconds;
    private Guid? _loadedPlanId;
    private bool _loadedForceNew;
    private bool _isCompleting;
    private bool _disposed;
    private bool _isLoading = true;
    private DotNetObjectReference<Workout>? _dotNetRef;
    private RestTimerPanel? _restPanel;
    private string? _historySessionId;
    private double? _bodyweightKg;
    private bool _undoVisible;
    private System.Threading.Timer? _undoTimer;
    private DateTime _sessionStartedAtUtc;
    private System.Threading.Timer? _elapsedTimer;

    private sealed class SetInputsDictionary : Dictionary<(int, int), (double? Weight, int? Reps)> { }

    private readonly SetInputsDictionary _setInputs = new();
    private readonly Dictionary<(int, int), (double? Weight, int? Reps)> _sessionSets = new();
    private readonly HashSet<(int, int)> _skippedSets = [];
    private int _activeExerciseIndex;
    private readonly Dictionary<int, int> _activeSetIndices = new();

    private string ElapsedLabel
    {
        get
        {
            var elapsedMinutes = (TimeProvider.GetUtcNow().UtcDateTime - _sessionStartedAtUtc).TotalMinutes;
            var mins = (int)Math.Max(0, elapsedMinutes);
            return mins < 60 ? string.Format("{0} min", mins) : string.Format("{0}h {1}m", mins / 60, mins % 60);
        }
    }

    private string? SessionVolumeLabel
    {
        get
        {
            var kg = ComputeSessionVolumeKg();
            if (kg is not { } v || v <= 0) return null;
            return ExerciseWeightFormatter.FormatVolumeWithUnit(v, WeightUnitService.Current);
        }
    }

    private double? ComputeSessionVolumeKg()
    {
        var plan = SessionService.CurrentPlan;
        if (plan == null || _sessionSets.Count == 0) return null;

        double total = 0;
        var any = false;
        foreach (var (key, value) in _sessionSets)
        {
            var (exerciseIndex, setIndex) = key;
            if (exerciseIndex < 0 || exerciseIndex >= plan.Exercises.Count) continue;
            var exercise = plan.Exercises[exerciseIndex];
            if (exercise.LogType == ExerciseLogType.Duration) continue;
            if (setIndex < exercise.WarmupSetCount) continue;
            total += PersonalRecordCalculator.ComputeVolume(value.Reps, value.Weight, exercise.LogType, _bodyweightKg, exercise.BodyweightPercent);
            any = true;
        }

        return any ? total : null;
    }

    private sealed record ExerciseProgress(ExercisePlan Exercise, int ExerciseIndex, int CompletedSets, int TotalSets);

    private List<ExerciseProgress> _doneExercises = [];
    private List<ExerciseProgress> _upcomingExercises = [];
    private IReadOnlyList<ExerciseProgress> DoneExercises => _doneExercises;
    private IReadOnlyList<ExerciseProgress> UpcomingExercises => _upcomingExercises;

    protected override async Task OnInitializedAsync()
    {
        SessionService.RestCompletedWhileBackground += OnSessionRestCompletedWhileBackground;
        SessionService.RestStateChanged += OnSessionRestStateChanged;

        _dotNetRef = DotNetObjectReference.Create(this);
        _bodyweightKg = UserProfileService.GetActiveProfile().BodyweightKg;

        await TimerInterop.InitializeAsync();
        await TimerInterop.RegisterUndoKeyHandlerAsync(_dotNetRef);

        _elapsedTimer = new System.Threading.Timer(
            _ => OnElapsedTick(),
            null,
            TimeSpan.FromSeconds(30),
            TimeSpan.FromSeconds(30));

        // Workout start (session restore, back guard, rest-timer arming) is
        // driven from OnParametersSetAsync so it runs exactly once per
        // parameter set. Starting here too would double-arm the JS back guard,
        // whose re-registration pops a history entry and could surface the
        // "Leave workout?" dialog on page load.
    }

    private void OnElapsedTick()
    {
        _ = InvokeAsync(SafeStateHasChangedAsync);
    }

    /// <summary>
    /// Re-checks the overlay permission on every render so the warning
    /// disappears after the user grants it in system settings and returns.
    /// Hidden entirely on platforms without a floating overlay.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var missing = RestAlertSettings.Enabled
                      && RestNotifications.SupportsOverlay
                      && !RestNotifications.HasOverlayPermission();
        if (missing != _overlayPermissionMissing)
        {
            _overlayPermissionMissing = missing;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenOverlaySettingsAsync()
    {
        await RestNotifications.RequestOverlayPermissionAsync();
        _overlayPermissionMissing = RestAlertSettings.Enabled
                                    && RestNotifications.SupportsOverlay
                                    && !RestNotifications.HasOverlayPermission();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_disposed) return;

        if (_loadedPlanId == PlanId && _loadedForceNew == ForceNew)
            return;

        _loadedPlanId = PlanId;
        _loadedForceNew = ForceNew;
        await EnsureWorkoutStartedAsync();
    }

    private async Task EnsureWorkoutStartedAsync()
    {
        _isLoading = true;
        try
        {
            var plan = await PlanService.GetPlanAsync(PlanId);
            if (_disposed || plan == null)
                return;

            if (RestAlertSettings.Enabled)
            {
                await RestNotifications.EnsurePermissionAsync();
                _overlayPermissionMissing = RestNotifications.SupportsOverlay && !RestNotifications.HasOverlayPermission();
            }

            // Every path from here results in an active session: keep the
            // screen on and arm the leave-workout back guard.
            await TimerInterop.SetKeepScreenOnAsync(true);
            await TimerInterop.RegisterBackHandlerAsync(_dotNetRef!);

            // Capture before loading the workout: loading stops the rest timer and
            // would otherwise consume the persisted snapshot of a rest that
            // survived process death.
            string? pendingRest = RestTimer.CapturePendingSnapshot();

            if (!ForceNew)
            {
                if (SessionService.CurrentPlan?.Id == PlanId)
                {
                    var openSession = await HistoryRepository.GetInProgressSessionForPlanAsync(PlanId);
                    _historySessionId = openSession?.Id;
                    _sessionStartedAtUtc = openSession?.StartedAtUtc ?? TimeProvider.GetUtcNow().UtcDateTime;
                    await InitializeWorkoutStateAsync(SessionService.CurrentPlan);
                    RefreshExerciseProgress();

                    if (SessionService.IsResting)
                    {
                        var remainingMs = RestRemainingMs;
                        if (remainingMs > 0)
                        {
                            _isRestComplete = false;
                            await StartJsTimerAsync(remainingMs);
                        }
                        else
                        {
                            _isRestComplete = true;
                        }
                    }
                    else
                    {
                        await RestorePendingRestAsync(pendingRest);
                    }
                    return;
                }

                var open = await HistoryRepository.GetInProgressSessionForPlanAsync(PlanId);
                if (open != null)
                {
                    var workoutPlan = WorkoutHistoryRepository.TryParsePlanSnapshot(open.PlanSnapshotJson) ?? plan;
                    var sets = await HistoryRepository.GetSetsForSessionAsync(open.Id);
                    var completions = sets.Select(s => new SetCompletion(s.ExerciseIndex, s.SetIndex));
                    SessionService.ResumeWorkout(workoutPlan, completions);
                    _historySessionId = open.Id;
                    _sessionStartedAtUtc = open.StartedAtUtc;
                    await InitializeWorkoutStateAsync(workoutPlan);
                    RefreshExerciseProgress();
                    await RestorePendingRestAsync(pendingRest);
                    return;
                }
            }
            else
            {
                var open = await HistoryRepository.GetInProgressSessionForPlanAsync(PlanId);
                if (open != null)
                    await HistoryRepository.EndSessionAsync(open.Id);
            }

            SessionService.StartWorkout(plan);
            var snapshot = WorkoutPlanService.SerializePlanToJson(plan);
            _historySessionId = await HistoryRepository.BeginSessionAsync(plan.Id, plan.Name, snapshot);
            _sessionStartedAtUtc = TimeProvider.GetUtcNow().UtcDateTime;
            await InitializeWorkoutStateAsync(plan);
            RefreshExerciseProgress();
            await RestorePendingRestAsync(pendingRest);
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// Restores a rest countdown that survived process death (persisted by the
    /// coordinator) and restarts the JS ticker so the page keeps counting.
    /// </summary>
    private async Task RestorePendingRestAsync(string? pendingRest)
    {
        if (!RestTimer.RestoreRestIfPending(pendingRest))
            return;

        var remainingMs = RestRemainingMs;
        if (remainingMs > 0)
            await StartJsTimerAsync(remainingMs);

        await SafeStateHasChangedAsync();
    }

    private async Task InitializeWorkoutStateAsync(WorkoutPlan plan)
    {
        _setInputs.Clear();
        _sessionSets.Clear();
        _skippedSets.Clear();
        _activeSetIndices.Clear();
        int firstUncompletedExIdx = -1;

        IReadOnlyDictionary<string, LastSetMetrics> latestMetrics =
            await HistoryRepository.GetLatestSetMetricsByExerciseAsync(plan.Id);

        for (int e = 0; e < plan.Exercises.Count; e++)
        {
            var exercise = plan.Exercises[e];
            LastSetMetrics? lastMetrics = latestMetrics.TryGetValue(exercise.Name, out var lm) ? lm : null;
            var initialReps = lastMetrics?.Reps ?? exercise.DefaultReps ?? DefaultReps;
            var initialWeight = lastMetrics?.WeightKg ?? exercise.DefaultWeightKg ?? 0;

            for (int s = 0; s < exercise.TotalSetCount; s++)
            {
                _setInputs[(e, s)] = (initialWeight, initialReps);
            }

            var firstUncompletedSetIdx = SessionService.GetFirstUncompletedSetIndex(e);
            _activeSetIndices[e] = firstUncompletedSetIdx == -1 ? 0 : firstUncompletedSetIdx;

            if (!SessionService.IsExerciseDone(e) && firstUncompletedExIdx == -1)
            {
                firstUncompletedExIdx = e;
            }
        }

        if (_historySessionId != null)
        {
            var currentSets = await HistoryRepository.GetSetsForSessionAsync(_historySessionId);
            foreach (var set in currentSets)
            {
                _setInputs[(set.ExerciseIndex, set.SetIndex)] = (set.WeightKg ?? 0, set.Reps ?? 0);
                _sessionSets[(set.ExerciseIndex, set.SetIndex)] = (set.WeightKg, set.Reps);
            }

            // For each exercise, find the last completed set in the current session (if any)
            // and use its values to default the remaining uncompleted sets.
            for (int e = 0; e < plan.Exercises.Count; e++)
            {
                var exercise = plan.Exercises[e];
                var completedSets = currentSets
                    .Where(s => s.ExerciseIndex == e)
                    .OrderBy(s => s.CompletedAtUtc)
                    .ToList();

                if (completedSets.Any())
                {
                    var lastCompletedSet = completedSets[^1];
                    var lastWeight = lastCompletedSet.WeightKg ?? 0;
                    var lastReps = lastCompletedSet.Reps ?? 0;

                    for (int s = 0; s < exercise.TotalSetCount; s++)
                    {
                        if (!SessionService.IsSetCompleted(e, s))
                        {
                            _setInputs[(e, s)] = (lastWeight, lastReps);
                        }
                    }
                }
            }

            // Re-evaluate first uncompleted set index after loading session sets
            for (int e = 0; e < plan.Exercises.Count; e++)
            {
                var firstUncompletedSetIdx = SessionService.GetFirstUncompletedSetIndex(e);
                _activeSetIndices[e] = firstUncompletedSetIdx == -1 ? 0 : firstUncompletedSetIdx;
            }
        }

        _activeExerciseIndex = firstUncompletedExIdx == -1 ? -1 : firstUncompletedExIdx;
    }
    /// <summary>
    /// Recomputes the done/upcoming exercise split once per render. Uses the
    /// session's O(1) lookup instead of rebuilding a HashSet from the list.
    /// The split is exclusive: an exercise lives in exactly one section so it
    /// renders as a single card. Partially completed exercises stay in
    /// "upcoming" (where their remaining sets are logged); the "Completed"
    /// section lists only fully completed exercises. Otherwise the same
    /// exercise would render twice and both copies would share the active
    /// expansion state.
    /// </summary>
    private void RefreshExerciseProgress()
    {
        var plan = SessionService.CurrentPlan;
        if (plan == null)
        {
            _doneExercises = [];
            _upcomingExercises = [];
            return;
        }

        var done = new List<ExerciseProgress>(plan.Exercises.Count);
        var upcoming = new List<ExerciseProgress>(plan.Exercises.Count);

        for (var ei = 0; ei < plan.Exercises.Count; ei++)
        {
            var ex = plan.Exercises[ei];
            var completedSets = 0;

            for (var si = 0; si < ex.TotalSetCount; si++)
            {
                if (SessionService.IsSetCompleted(ei, si))
                    completedSets++;
            }

            if (completedSets == ex.TotalSetCount)
                done.Add(new ExerciseProgress(ex, ei, completedSets, ex.TotalSetCount));
            else
                upcoming.Add(new ExerciseProgress(ex, ei, completedSets, ex.TotalSetCount));
        }

        _doneExercises = done;
        _upcomingExercises = upcoming;
    }


    private async Task EndWorkoutClick()
    {
        // Everything completed: nothing is lost by ending, so skip the dialog.
        if (SessionService.GetFirstUncompletedExerciseIndex() == -1)
        {
            await EndWorkout();
            return;
        }

        var confirmed = await DialogService.ConfirmAsync(
            "End workout?",
            "Save this session and return home?",
            confirmText: "End",
            confirmColor: Color.Primary);
        if (confirmed)
            await EndWorkout();
    }

    private async Task DiscardWorkoutClick()
    {
        var planName = SessionService.CurrentPlan?.Name ?? "Workout";
        var confirmed = await DialogService.ConfirmAsync(
            "Discard workout?",
            ConfirmDialogService.DiscardWorkoutMessage(planName),
            confirmText: "Discard",
            cancelText: "Cancel",
            confirmColor: Color.Error);
        if (confirmed)
            await DiscardWorkout();
    }

    private async Task DiscardWorkout()
    {
        if (_disposed) return;

        await TimerInterop.SetKeepScreenOnAsync(false);
        await TimerInterop.UnregisterBackHandlerAsync();
        await TimerInterop.StopTimerAsync();

        if (_historySessionId != null)
        {
            try
            {
                await HistoryRepository.DeleteSessionAsync(_historySessionId);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "History DeleteSession error");
            }
        }

        _historySessionId = null;
        SessionService.EndWorkout();
        Navigation.NavigateTo(AppRoutes.Home);
    }

    private void ToggleAccordion(int exerciseIndex)
    {
        _activeExerciseIndex = _activeExerciseIndex == exerciseIndex ? -1 : exerciseIndex;
    }

    private int ExerciseCount => SessionService.CurrentPlan?.Exercises.Count ?? 0;

    /// <summary>
    /// First exercise after <paramref name="exerciseIndex"/> that shares its
    /// superset group and still has uncompleted sets, or -1 when the group
    /// round is finished or the exercise is not in a group.
    /// </summary>
    private int GetNextUncompletedExerciseInSameGroup(int exerciseIndex)
    {
        var plan = SessionService.CurrentPlan;
        if (plan == null || exerciseIndex < 0 || exerciseIndex >= plan.Exercises.Count)
            return -1;

        var groupId = plan.Exercises[exerciseIndex].SupersetGroupId;
        if (string.IsNullOrEmpty(groupId))
            return -1;

        for (var i = exerciseIndex + 1; i < plan.Exercises.Count; i++)
        {
            var candidate = plan.Exercises[i];
            if (!string.Equals(candidate.SupersetGroupId, groupId, StringComparison.Ordinal))
                continue;

            if (!SessionService.IsExerciseDone(i))
                return i;
        }

        return -1;
    }

    /// <summary>
    /// Moves an exercise to a different position for the rest of this session
    /// only. The plan on disk stays untouched; the session snapshot and every
    /// logged set index are remapped so history stays consistent.
    /// </summary>
    private async Task MoveExerciseAsync(int fromIndex, int toIndex)
    {
        if (_disposed || _isCompleting) return;

        var plan = SessionService.CurrentPlan;
        if (plan == null || fromIndex == toIndex) return;
        if (fromIndex < 0 || toIndex < 0 || fromIndex >= plan.Exercises.Count || toIndex >= plan.Exercises.Count)
            return;

        var exercise = plan.Exercises[fromIndex];
        plan.Exercises.RemoveAt(fromIndex);
        plan.Exercises.Insert(toIndex, exercise);
        for (var i = 0; i < plan.Exercises.Count; i++)
            plan.Exercises[i].Order = i;

        var mapping = new Dictionary<int, int>(plan.Exercises.Count);
        for (var i = 0; i < plan.Exercises.Count; i++)
        {
            int newIndex;
            if (i == fromIndex)
                newIndex = toIndex;
            else if (fromIndex < toIndex && i > fromIndex && i <= toIndex)
                newIndex = i - 1;
            else if (fromIndex > toIndex && i >= toIndex && i < fromIndex)
                newIndex = i + 1;
            else
                newIndex = i;
            mapping[i] = newIndex;
        }

        RemapSetDictionary(_setInputs, mapping);
        RemapSetDictionary(_sessionSets, mapping);

        var skipped = _skippedSets.Select(k => (mapping.GetValueOrDefault(k.Item1, k.Item1), k.Item2)).ToList();
        _skippedSets.Clear();
        foreach (var key in skipped)
            _skippedSets.Add(key);

        var actives = _activeSetIndices.Select(kv => (kv.Key, kv.Value)).ToList();
        _activeSetIndices.Clear();
        foreach (var (oldIndex, setIndex) in actives)
            _activeSetIndices[mapping.GetValueOrDefault(oldIndex, oldIndex)] = setIndex;

        SessionService.RemapExerciseIndexes(mapping);

        // Keep only the top exercise expanded after a reorder.
        _activeExerciseIndex = 0;

        try
        {
            if (_historySessionId != null)
            {
                await HistoryRepository.RemapSetLogExerciseIndexesAsync(_historySessionId, mapping);
                await HistoryRepository.UpdateSessionSnapshotAsync(
                    _historySessionId,
                    WorkoutPlanService.SerializePlanToJson(plan));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exercise reorder persistence error");
        }

        Snackbar.Add(string.Format("'{0}' moved.", exercise.Name), Severity.Info);
        await SafeStateHasChangedAsync();
    }

    private static void RemapSetDictionary(
        Dictionary<(int, int), (double? Weight, int? Reps)> target,
        IReadOnlyDictionary<int, int> mapping)
    {
        var items = target
            .Select(kv => (
                Key: (Index: mapping.GetValueOrDefault(kv.Key.Item1, kv.Key.Item1), kv.Key.Item2),
                kv.Value))
            .ToList();

        target.Clear();
        foreach (var (key, value) in items)
            target[key] = value;
    }

    private void HandleWeightStepperChanged((int ExerciseIndex, int SetIndex, double? Weight) input)
    {
        var (exIdx, setIdx, weight) = input;
        var key = (exIdx, setIdx);
        var current = _setInputs.GetValueOrDefault(key, (null, null));
        _setInputs[key] = (weight, current.Reps);
    }

    private void HandleRepsStepperChanged((int ExerciseIndex, int SetIndex, int? Reps) input)
    {
        var (exIdx, setIdx, reps) = input;
        var key = (exIdx, setIdx);
        var current = _setInputs.GetValueOrDefault(key, (null, null));
        _setInputs[key] = (current.Weight, reps);
    }

    /// <summary>Persists an in-place edit of an already logged set (weight).</summary>
    private async Task HandleSetWeightChanged((int ExerciseIndex, int SetIndex, double? WeightKg) input)
    {
        var (exIdx, setIdx, weightKg) = input;
        var key = (exIdx, setIdx);
        var current = _sessionSets.GetValueOrDefault(key, (null, null));
        _sessionSets[key] = (weightKg, current.Reps);
        await PersistSetEditAsync(exIdx, setIdx);
    }

    /// <summary>Persists an in-place edit of an already logged set (reps).</summary>
    private async Task HandleSetRepsChanged((int ExerciseIndex, int SetIndex, int? Reps) input)
    {
        var (exIdx, setIdx, reps) = input;
        var key = (exIdx, setIdx);
        var current = _sessionSets.GetValueOrDefault(key, (null, null));
        _sessionSets[key] = (current.Weight, reps);
        await PersistSetEditAsync(exIdx, setIdx);
    }

    private async Task PersistSetEditAsync(int exerciseIndex, int setIndex)
    {
        if (_disposed || _historySessionId == null) return;

        var values = _sessionSets.GetValueOrDefault((exerciseIndex, setIndex));
        try
        {
            await HistoryRepository.UpdateSetLogAsync(_historySessionId, exerciseIndex, setIndex, values.Reps, values.Weight);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "History update set log error");
        }

        await SafeStateHasChangedAsync();
    }

    /// <summary>
    /// Marks the remaining sets of an exercise as done without logging them,
    /// e.g. when the machine is taken. Skipped sets are not written to history.
    /// </summary>
    private async Task SkipExerciseAsync((int ExerciseIndex, string ExerciseName) input)
    {
        if (_disposed || _isCompleting) return;

        var (exerciseIndex, exerciseName) = input;
        var plan = SessionService.CurrentPlan;
        if (plan == null || exerciseIndex < 0 || exerciseIndex >= plan.Exercises.Count) return;

        var confirmed = await DialogService.ConfirmAsync(
            "Skip exercise?",
            string.Format("Mark the remaining sets of '{0}' as done for this session? Skipped sets are not logged to history.", exerciseName),
            confirmText: "Skip",
            confirmColor: Color.Primary,
            cancelText: "Cancel");
        if (!confirmed) return;

        var exercise = plan.Exercises[exerciseIndex];
        for (var s = 0; s < exercise.TotalSetCount; s++)
        {
            if (!SessionService.IsSetCompleted(exerciseIndex, s))
            {
                SessionService.CompleteSet(exerciseIndex, s);
                _skippedSets.Add((exerciseIndex, s));
            }
        }

        _activeExerciseIndex = SessionService.GetFirstUncompletedExerciseIndex();
        await SafeStateHasChangedAsync();
        Snackbar.Add(string.Format("'{0}' skipped.", exerciseName), Severity.Info);
    }

    private async Task ToggleSetComplete((int ExerciseIndex, int SetIndex) set)
    {
        var (exerciseIndex, setIndex) = set;
        if (_isCompleting) return;
        if (_disposed) return;

        var plan = SessionService.CurrentPlan;
        if (plan == null || exerciseIndex < 0 || exerciseIndex >= plan.Exercises.Count) return;
        var exercise = plan.Exercises[exerciseIndex];

        _isCompleting = true;
        await SafeStateHasChangedAsync();
        try
        {
            await TimerInterop.UnlockAudioAsync();

            var inputKey = (exerciseIndex, setIndex);
            var inputs = _setInputs.GetValueOrDefault(inputKey, (null, null));

            var finalWeight = inputs.Weight ?? exercise.DefaultWeightKg ?? 0.0;
            var finalReps = inputs.Reps ?? exercise.DefaultReps ?? DefaultReps;

            var willBeLastSetOfWorkout = SessionService.WouldCompleteWorkout(exerciseIndex, setIndex);

            if (willBeLastSetOfWorkout && SessionService.IsResting)
            {
                SessionService.SkipRest();
            }

            _isRestComplete = false;
            SessionService.CompleteSet(exerciseIndex, setIndex);

            // Auto active set update
            var firstUncompletedSetIdx = SessionService.GetFirstUncompletedSetIndex(exerciseIndex);
            _activeSetIndices[exerciseIndex] = firstUncompletedSetIdx == -1 ? 0 : firstUncompletedSetIdx;

            var isWarmupSet = setIndex < exercise.WarmupSetCount;

            if (_historySessionId != null)
            {
                var loggedWeight = exercise.LogType == ExerciseLogType.Duration ? (double?)null : finalWeight;
                await HistoryRepository.LogSetAsync(_historySessionId, exerciseIndex, exercise.Name, setIndex, finalReps, loggedWeight, isWarmup: isWarmupSet);
            }

            _sessionSets[inputKey] = (
                exercise.LogType == ExerciseLogType.Duration ? (double?)null : finalWeight,
                finalReps);
            _setInputs[inputKey] = (finalWeight, finalReps);

            // Update remaining uncompleted sets of this exercise to default to the logged weight and reps
            for (int s = 0; s < exercise.TotalSetCount; s++)
            {
                if (!SessionService.IsSetCompleted(exerciseIndex, s))
                {
                    _setInputs[(exerciseIndex, s)] = (finalWeight, finalReps);
                }
            }

            if (!isWarmupSet)
                await TryShowPersonalRecordToastAsync(plan, exercise, finalWeight, finalReps);

            ShowUndoToast();

            if (willBeLastSetOfWorkout)
            {
                _activeExerciseIndex = -1;
                await SafeStateHasChangedAsync();
                return;
            }

            // Superset / circuit: skip the rest and move to the next exercise
            // of the same group when it still has sets left.
            var nextInGroup = GetNextUncompletedExerciseInSameGroup(exerciseIndex);
            if (nextInGroup >= 0)
            {
                await TimerInterop.StopTimerAsync();
                SessionService.SkipRest();
                _activeExerciseIndex = nextInGroup;
                Snackbar.Add(string.Format("Next: {0}", plan.Exercises[nextInGroup].Name), Severity.Info);
                await SafeStateHasChangedAsync();
                return;
            }

            _isRestComplete = false;
            await TimerInterop.StopTimerAsync();
            _lastRestDurationSeconds = exercise.RestIntervalSeconds;
            SessionService.StartRest(exercise.RestIntervalSeconds);
            await StartJsTimerAsync();

            // Auto accordion transition
            if (SessionService.IsExerciseDone(exerciseIndex))
            {
                _activeExerciseIndex = SessionService.GetFirstUncompletedExerciseIndex();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error logging set");
        }
        finally
        {
            _isCompleting = false;
            await SafeStateHasChangedAsync();
        }
    }

    private void ShowUndoToast()
    {
        HideUndoToast();
        _undoVisible = true;
        _undoTimer = new System.Threading.Timer(
            _ => OnUndoTimerElapsed(),
            null,
            TimeSpan.FromMilliseconds(UndoToastDurationMs),
            Timeout.InfiniteTimeSpan);
    }

    /// <summary>
    /// Shows a "New PR" toast when the just-logged set beats the best previous
    /// performance for the exercise on this plan. The current session is
    /// excluded so its own earlier sets are not mistaken for the old record.
    /// </summary>
    private async Task TryShowPersonalRecordToastAsync(WorkoutPlan plan, ExercisePlan exercise, double weightKg, int reps)
    {
        try
        {
            IReadOnlyList<ExerciseSetLogRow> rows = await HistoryRepository.GetExerciseSetLogRowsAsync(plan.Id, exercise.Name);
            var prior = rows.Where(r => r.SessionId != _historySessionId);
            PersonalRecords records = PersonalRecordCalculator.Compute(prior, exercise.LogType, _bodyweightKg, exercise.BodyweightPercent);

            var (kind, message) = BuildPersonalRecordMessage(records, exercise, weightKg, reps);
            if (message != null && kind != ExerciseRecordKind.BestVolume)
                Snackbar.Add(message, Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Personal record check failed");
        }
    }

    /// <summary>
    /// Builds the recap shown after the workout ends: session stats and every
    /// personal record earned in this session (one per record kind and exercise).
    /// Returns null when nothing was logged, so no dialog is shown.
    /// </summary>
    private async Task<IReadOnlyList<WorkoutSummaryPr>?> BuildWorkoutSummaryAsync()
    {
        var plan = SessionService.CurrentPlan;
        if (plan == null || _sessionSets.Count == 0)
            return null;

        var prs = new List<WorkoutSummaryPr>();
        foreach (var exercise in plan.Exercises)
        {
            var exIdx = plan.Exercises.IndexOf(exercise);

            IReadOnlyList<ExerciseSetLogRow> rows;
            try
            {
                rows = await HistoryRepository.GetExerciseSetLogRowsAsync(plan.Id, exercise.Name);
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Personal record check failed");
                continue;
            }

            var prior = rows.Where(r => r.SessionId != _historySessionId);
            PersonalRecords records = PersonalRecordCalculator.Compute(prior, exercise.LogType, _bodyweightKg, exercise.BodyweightPercent);

            var claimed = new HashSet<ExerciseRecordKind>();
            foreach (var (key, value) in _sessionSets)
            {
                if (key.Item1 != exIdx)
                    continue;

                if (key.Item2 < exercise.WarmupSetCount)
                    continue;

                var (kind, message) = BuildPersonalRecordMessage(records, exercise, value.Weight ?? 0, value.Reps ?? 0);
                if (kind is not { } k || message == null || !claimed.Add(k))
                    continue;

                prs.Add(new WorkoutSummaryPr(exercise.Name, message));
            }
        }

        return prs;
    }

    /// <summary>
    /// Returns the record kind and human message when the given set beats the
    /// best previous performance, otherwise nulls. Checks kinds in priority
    /// order: duration, best weight, most reps, best volume.
    /// </summary>
    private (ExerciseRecordKind? Kind, string? Message) BuildPersonalRecordMessage(
        PersonalRecords records,
        ExercisePlan exercise,
        double weightKg,
        int reps)
    {
        var setVolumeKg = PersonalRecordCalculator.ComputeVolume(reps, weightKg, exercise.LogType, _bodyweightKg, exercise.BodyweightPercent);

        if (exercise.LogType == ExerciseLogType.Duration)
        {
            if (TryBeat(records, ExerciseRecordKind.LongestDuration, reps))
                return (ExerciseRecordKind.LongestDuration, string.Format("{0}s set", reps));
        }
        else if (TryBeat(records, ExerciseRecordKind.BestWeight, weightKg))
        {
            return (ExerciseRecordKind.BestWeight, FormatPersonalWeight(exercise.LogType, weightKg));
        }
        else if (TryBeat(records, ExerciseRecordKind.MostReps, reps))
        {
            return (ExerciseRecordKind.MostReps, string.Format("{0} reps", reps));
        }
        else if (TryBeat(records, ExerciseRecordKind.BestVolume, setVolumeKg))
        {
            return (ExerciseRecordKind.BestVolume, string.Format("{0} set volume", ExerciseWeightFormatter.FormatWeightWithUnit(setVolumeKg, WeightUnitService.Current)));
        }

        return (null, null);
    }

    private static bool TryBeat(PersonalRecords records, ExerciseRecordKind kind, double value)
    {
        PersonalRecordEntry? current = records.Entries.FirstOrDefault(e => e.Kind == kind);
        return current == null || value > current.Value;
    }

    private string FormatPersonalWeight(ExerciseLogType logType, double weightKg) =>
        logType == ExerciseLogType.BodyweightReps
            ? ExerciseWeightFormatter.FormatBodyweightOffset(weightKg, _bodyweightKg)
            : ExerciseWeightFormatter.FormatWeightWithUnit(weightKg, WeightUnitService.Current);

    private void HideUndoToast()
    {
        _undoVisible = false;
        _undoTimer?.Dispose();
        _undoTimer = null;
    }

    private void OnUndoTimerElapsed()
    {
        _ = InvokeAsync(() =>
        {
            if (_disposed) return;
            HideUndoToast();
            StateHasChanged();
        });
    }

    /// <summary>
    /// Invoked from JS when the user presses Ctrl+Z (or Cmd+Z) to undo the
    /// last logged set, including while the undo toast is hidden.
    /// </summary>
    [JSInvokable]
    public Task OnUndoKeyDown() => UndoLastSetCoreAsync();

    /// <summary>
    /// Invoked from JS by the back guard (browser back, back gesture, Android
    /// hardware back). Returns <c>true</c> when the user chose to leave; the
    /// session is kept in progress and can be resumed from Home.
    /// </summary>
    [JSInvokable]
    public async Task<bool> OnLeaveWorkoutRequested()
    {
        if (_disposed || SessionService.CurrentPlan == null)
            return true;

        var confirmed = await DialogService.ConfirmAsync(
            "Leave workout?",
            "Your session is still in progress. You can resume it from Home.",
            confirmText: "Leave",
            cancelText: "Stay",
            confirmColor: Color.Warning);
        if (!confirmed)
            return false;

        await TimerInterop.SetKeepScreenOnAsync(false);
        await TimerInterop.UnregisterBackHandlerAsync();
        Navigation.NavigateTo(AppRoutes.Home);
        return true;
    }

    private async Task UndoLastSetCoreAsync()
    {
        if (_disposed || _isCompleting) return;
        if (!SessionService.TryUndoLastSet(out var removed)) return;
        HideUndoToast();
        await TimerInterop.StopTimerAsync();
        _isRestComplete = false;
        SessionService.SkipRest();

        _activeSetIndices[removed.ExerciseIndex] = removed.SetIndex;
        _activeExerciseIndex = removed.ExerciseIndex; // Re-expand the card for re-logging
        _sessionSets.Remove((removed.ExerciseIndex, removed.SetIndex));

        var wasSkipped = _skippedSets.Remove((removed.ExerciseIndex, removed.SetIndex));
        if (_historySessionId != null && !wasSkipped)
        {
            try
            {
                await HistoryRepository.TryDeleteLastSetLogAsync(_historySessionId);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "History undo set log error");
            }
        }

        await SafeStateHasChangedAsync();
    }

    private async Task ResetRest()
    {
        if (_disposed) return;

        _isRestComplete = false;

        if (SessionService.IsResting)
            SessionService.ResetRest();
        else if (_lastRestDurationSeconds > 0)
            SessionService.StartRest(_lastRestDurationSeconds);
        else
            return;

        if (SessionService.IsResting)
        {
            await StartJsTimerAsync();
        }

        await SafeStateHasChangedAsync();
    }

    private async Task SkipRest()
    {
        if (_disposed) return;

        await TimerInterop.StopTimerAsync();
        _isRestComplete = false;
        SessionService.SkipRest();
        await SafeStateHasChangedAsync();
    }

    private async Task AddRestTime(int seconds)
    {
        if (_disposed || seconds <= 0) return;

        if (!SessionService.IsResting)
        {
            // Rest already finished: +add restarts a fresh short countdown.
            if (!_isRestComplete) return;

            _isRestComplete = false;
            _lastRestDurationSeconds = seconds;
            SessionService.StartRest(seconds);
            await StartJsTimerAsync();
            await SafeStateHasChangedAsync();
            return;
        }

        SessionService.AddRestSeconds(seconds);

        var remainingMs = RestRemainingMs;
        if (remainingMs > 0)
        {
            await StartJsTimerAsync(remainingMs, continueMode: true);
        }
        await SafeStateHasChangedAsync();
    }

    private async Task PlayRestCompleteAlertsAsync()
    {
        // The knock is an in-app sound, so it follows the "Sound & vibration"
        // setting only. Push notifications are a separate native concern and
        // are gated by RestAlertSettings.Enabled elsewhere.
        if (!RestAlertSettings.SoundVibrationEnabled)
            return;

        try
        {
            await TimerInterop.PlayRestCompleteSoundAsync();
        }
        catch
        {
            // Silently fail if audio not supported
        }
    }

    private void OnSessionRestStateChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;

            try
            {
                if (!SessionService.IsResting)
                {
                    await TimerInterop.StopTimerAsync();
                    _restPanel?.Refresh();
                    await SafeStateHasChangedAsync();
                    return;
                }

                // A rest can be started or extended by a platform surface
                // (floating overlay +Ns, notification action, exact-alarm
                // restore) while the page believes the previous rest is
                // complete. Clear the stale completion flag and always
                // (re)start the JS ticker, or the countdown stays frozen
                // on the checkmark while the session keeps running.
                _isRestComplete = false;

                var remainingMs = RestRemainingMs;
                if (remainingMs > 0)
                    await StartJsTimerAsync(remainingMs, continueMode: true);

                _restPanel?.Refresh();
                await SafeStateHasChangedAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Rest state sync error");
            }
        });
    }

    private void OnSessionRestCompletedWhileBackground(object? sender, EventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;

            try
            {
                await TimerInterop.StopTimerAsync();
                _isRestComplete = true;
                await SafeStateHasChangedAsync();
                await PlayRestCompleteAlertsAsync();
                await SafeStateHasChangedAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Background rest completion error");
            }
        });
    }

    private async Task EndWorkout()
    {
        if (_disposed) return;

        var planName = SessionService.CurrentPlan?.Name ?? "Workout";

        await TimerInterop.SetKeepScreenOnAsync(false);
        await TimerInterop.UnregisterBackHandlerAsync();
        await TimerInterop.StopTimerAsync();

        IReadOnlyList<WorkoutSummaryPr>? summaryPrs = null;
        var durationLabel = ElapsedLabel;
        var volumeLabel = SessionVolumeLabel ?? "";
        var setsLogged = _sessionSets.Count;

        try
        {
            summaryPrs = await BuildWorkoutSummaryAsync();
            await HistoryRepository.EndSessionAsync(_historySessionId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "History EndSession error");
        }

        _historySessionId = null;
        SessionService.EndWorkout();

        if (summaryPrs != null)
        {
            var parameters = new DialogParameters<WorkoutSummaryDialog>
            {
                { x => x.PlanName, planName },
                { x => x.DurationLabel, durationLabel },
                { x => x.VolumeLabel, volumeLabel },
                { x => x.SetsLogged, setsLogged },
                { x => x.PersonalRecords, summaryPrs },
            };

            var options = new DialogOptions
            {
                CloseButton = false,
                CloseOnEscapeKey = false,
                BackdropClick = false,
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
            };

            // ShowAsync completes when the dialog opens; await Result so the
            // recap stays up until the user dismisses it instead of being
            // torn down by the navigation below.
            IDialogReference dialog = await DialogService.ShowAsync<WorkoutSummaryDialog>("Workout complete", parameters, options);
            await dialog.Result;
        }
        else
        {
            Snackbar.Add("No sets were logged, so nothing was saved.", Severity.Info);
        }

        Navigation.NavigateTo(AppRoutes.Home);
    }

    /// <summary>
    /// Called by the JS timer on each tick. Returns <c>true</c> when the rest
    /// period ends, signalling JS to stop rescheduling.
    /// </summary>
    [JSInvokable]
    public async Task<bool> OnTimerTick()
    {
        if (_disposed) return true;

        try
        {
            var done = SessionService.TickRest();
            if (done)
            {
                // TickRest clears IsResting; without this flag first, the timer block unmounts for one frame.
                _isRestComplete = true;
            }

            if (_restPanel != null)
            {
                _restPanel.Refresh();
            }

            await SafeStateHasChangedAsync();

            if (done)
            {
                await PlayRestCompleteAlertsAsync();
                return true;
            }

            return false;
        }
        catch (Exception ex)
        {
            // Keep the tick chain alive; a single failed tick must not freeze
            // the countdown for the rest of the period.
            Logger.LogError(ex, "Rest tick failed");
            return false;
        }
    }

    /// <summary>
    /// Re-arms the JS rest timer. Millisecond precision matters: the JS
    /// progress bar derives its fraction from remaining time, and a
    /// ceil-quantized value would make every re-arm snap the bar backward.
    /// <paramref name="continueMode"/> tells JS whether the rest continues
    /// from its current position (add time, sync) or restarts (fresh/reset).
    /// </summary>
    private async Task StartJsTimerAsync(int? remainingMs = null, bool continueMode = false)
    {
        if (_dotNetRef == null) return;

        var ms = Math.Max(1, remainingMs ?? SessionService.ActiveRestDurationSeconds * RestTickIntervalMs);
        var activeDurationMs = SessionService.ActiveRestDurationSeconds * RestTickIntervalMs;
        await TimerInterop.StartTimerAsync(_dotNetRef, RestTickIntervalMs, ms, activeDurationMs, continueMode);
    }

    /// <summary>Exact wall-clock milliseconds left in the active rest (not ceiling-rounded).</summary>
    private int RestRemainingMs
    {
        get
        {
            if (SessionService.RestEndsAtUtc is not { } end) return 0;
            var ms = (int)(end - TimeProvider.GetUtcNow().UtcDateTime).TotalMilliseconds;
            return Math.Max(0, ms);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_elapsedTimer != null)
        {
            await _elapsedTimer.DisposeAsync();
            _elapsedTimer = null;
        }

        await TimerInterop.SetKeepScreenOnAsync(false);
        await TimerInterop.UnregisterBackHandlerAsync();
        await TimerInterop.DisposeAsync();

        _disposed = true;
        HideUndoToast();
        SessionService.RestCompletedWhileBackground -= OnSessionRestCompletedWhileBackground;
        SessionService.RestStateChanged -= OnSessionRestStateChanged;
        _dotNetRef?.Dispose();
    }

    private async Task SafeStateHasChangedAsync()
    {
        if (_disposed) return;

        RefreshExerciseProgress();

        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // Component disposed during teardown
        }
        catch (InvalidOperationException)
        {
            // No render handle available (e.g. prerendering)
        }
    }
}
