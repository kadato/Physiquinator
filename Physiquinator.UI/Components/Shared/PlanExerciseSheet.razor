@using Physiquinator.Core.Models
@using Physiquinator.Core.Formatting
@inject IJSRuntime JS
@inject WorkoutHistoryRepository HistoryRepository
@inject WeightUnitService WeightUnitService

<MudDialog Class="plan-exercise-sheet">
    <TitleContent>
        <div class="d-flex align-items-center gap-3">
            <MudIcon Icon="@(IsNew ? Icons.Material.Filled.AddCircle : Icons.Material.Filled.Edit)" Color="Color.Primary" Size="Size.Medium" />
            <MudText Typo="Typo.h6" Class="fw-bold">@(IsNew ? "Add exercise" : "Edit exercise")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <form @onsubmit="Confirm" @onsubmit:preventDefault class="plan-exercise-sheet__form">
            <MudStack Spacing="3" Class="plan-exercise-sheet__body">
                <MudAutocomplete T="string"
                                 Value="_name"
                                 id="exercise-sheet-name-input"
                                 Variant="Variant.Outlined"
                                 Label="@("Exercise name")"
                                 Placeholder="@("For example, bench press")"
                                 SearchFunc="SearchExerciseNamesAsync"
                                 ValueChanged="OnNameChanged"
                                 CoerceValue="false"
                                 ResetValueOnEmptyText="true"
                                 MaxItems="50"
                                 Dense="false"
                                 autocapitalize="words"
                                 @onfocus="OnExerciseNameFocus" />
                <MudText Typo="Typo.caption" Class="plan-exercise-sheet__catalog-hint">
                    @("Type to search the built-in exercise catalog.")
                </MudText>

            <MudSelect Value="_logType"
                       ValueChanged="OnLogTypeChanged"
                       Variant="Variant.Outlined"
                       Label="@("Exercise type")"
                       Class="mb-2"
                       T="ExerciseLogType">
                <MudSelectItem Value="ExerciseLogType.WeightAndReps">@("Weight and reps")</MudSelectItem>
                <MudSelectItem Value="ExerciseLogType.BodyweightReps">@("Bodyweight (reps)")</MudSelectItem>
                <MudSelectItem Value="ExerciseLogType.Duration">@("Duration (s)")</MudSelectItem>
            </MudSelect>

            <SetMetricStepper Label="@("Sets")"
                              Value="_setCount"
                              ValueChanged="OnSetCountChanged"
                              Step="1"
                              Min="1"
                              IsInteger="true"
                              Format="0"
                              InputMode="numeric" />
            <SetMetricStepper Label="@("Warm-up sets")"
                              Value="_warmupSetCount"
                              ValueChanged="OnWarmupSetCountChanged"
                              Step="1"
                              Min="0"
                              Max="20"
                              IsInteger="true"
                              Format="0"
                              InputMode="numeric" />
            <SetMetricStepper Label="@("Rest (s)")"
                              Value="_restSeconds"
                              ValueChanged="OnRestSecondsChanged"
                              Step="5"
                              Min="0"
                              IsInteger="true"
                              Format="0"
                              InputMode="numeric" />

            <MudSelect T="string"
                       Value="_supersetGroupId"
                       ValueChanged="OnSupersetGroupChanged"
                       Variant="Variant.Outlined"
                       Label="@("Superset group")"
                       Class="mb-2"
                       HelperText="@("Exercises in the same group are logged back-to-back without rest.")">
                <MudSelectItem Value="@string.Empty">@("None")</MudSelectItem>
                <MudSelectItem Value="@("A")">A</MudSelectItem>
                <MudSelectItem Value="@("B")">B</MudSelectItem>
                <MudSelectItem Value="@("C")">C</MudSelectItem>
                <MudSelectItem Value="@("D")">D</MudSelectItem>
            </MudSelect>
            <SetMetricStepper @key="@($"reps-stepper-{_logType}")"
                              Label="@(_logType == ExerciseLogType.Duration ? "Default duration (s)" : "Default reps")"
                              Value="_defaultReps"
                              ValueChanged="OnDefaultRepsChanged"
                              Step="1"
                              Min="0"
                              IsInteger="true"
                              Format="0"
                              InputMode="numeric" />
            
            @if (_logType != ExerciseLogType.Duration)
            {
                <SetMetricStepper @key="@($"weight-stepper-{_logType}")"
                                  Label="@DefaultWeightLabel"
                                  Value="@DefaultWeightDisplay"
                                  ValueChanged="OnDefaultWeightChanged"
                                  Step="@DefaultWeightStep"
                                  Min="@DefaultWeightMin"
                                  Format="0.#"
                                  InputMode="decimal" />
            }

            @if (_logType == ExerciseLogType.BodyweightReps)
            {
                <SetMetricStepper Label="@("Bodyweight share")"
                                  Value="_bodyweightPercent"
                                  ValueChanged="OnBodyweightPercentChanged"
                                  Step="5"
                                  Min="0"
                                  Max="300"
                                  IsInteger="true"
                                  Format="0"
                                  InputMode="numeric"
                                  Unit="%" />
                <MudText Typo="Typo.caption">
                    @(string.Format("{0} of your bodyweight counts toward volume.", BodyweightShareLabel))
                </MudText>
            }

                <div class="plan-exercise-sheet__footer">
                    @if (IsNew)
                    {
                        <MudButton Variant="Variant.Text"
                                   FullWidth="true"
                                   OnClick="Cancel">
                            @("Cancel")
                        </MudButton>
                    }
                    <MudButton Color="Color.Primary"
                               Variant="Variant.Filled"
                               FullWidth="true"
                               ButtonType="ButtonType.Submit"
                               Disabled="@ConfirmDisabled">
                        @(IsNew ? "Save exercise" : "Done")
                    </MudButton>
                </div>
            </MudStack>
        </form>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public ExercisePlan Exercise { get; set; } = new();

    [Parameter]
    public bool IsNew { get; set; }

    [Parameter]
    public EventCallback<ExercisePlan> OnAutoSave { get; set; }

    private string _name = "";
    private double? _setCount;
    private double? _warmupSetCount;
    private double? _restSeconds;
    private double? _defaultReps;
    private double? _defaultWeightKg;
    private double? _bodyweightPercent;
    private ExerciseLogType _logType = ExerciseLogType.WeightAndReps;
    private string _supersetGroupId = "";
    private List<string> _exerciseNames = [];
    private string _nameAtOpen = "";

    private bool ConfirmDisabled => string.IsNullOrWhiteSpace(_name);

    private string BodyweightShareLabel =>
        string.Format("{0}%", _bodyweightPercent ?? 100);

    private string DefaultWeightLabel =>
        _logType == ExerciseLogType.BodyweightReps
            ? string.Format("Default weight offset ({0})", ExerciseWeightFormatter.UnitSuffix(WeightUnitService.Current))
            : string.Format("Default weight ({0})", ExerciseWeightFormatter.UnitSuffix(WeightUnitService.Current));

    private double? DefaultWeightDisplay =>
        _defaultWeightKg is { } kg
            ? ExerciseWeightFormatter.ToDisplay(kg, WeightUnitService.Current)
            : null;

    private double DefaultWeightStep => WeightUnitService.Current == WeightUnit.Pounds ? 5 : 2.5;

    private double DefaultWeightMin => _logType == ExerciseLogType.BodyweightReps
        ? ExerciseWeightFormatter.ToDisplay(-200, WeightUnitService.Current)
        : 0;

    private Task OnSetCountChanged(double? value)
    {
        _setCount = value;
        return AutoSaveAsync();
    }

    private Task OnWarmupSetCountChanged(double? value)
    {
        _warmupSetCount = value;
        return AutoSaveAsync();
    }

    private Task OnRestSecondsChanged(double? value)
    {
        _restSeconds = value;
        return AutoSaveAsync();
    }

    private Task OnDefaultRepsChanged(double? value)
    {
        _defaultReps = value;
        return AutoSaveAsync();
    }

    private Task OnBodyweightPercentChanged(double? value)
    {
        _bodyweightPercent = value;
        return AutoSaveAsync();
    }

    private Task OnDefaultWeightChanged(double? displayValue)
    {
        _defaultWeightKg = displayValue.HasValue
            ? ExerciseWeightFormatter.ToKg(displayValue.Value, WeightUnitService.Current)
            : null;
        return AutoSaveAsync();
    }

    private Task OnSupersetGroupChanged(string groupId)
    {
        _supersetGroupId = groupId;
        return AutoSaveAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        _name = Exercise.Name;
        _nameAtOpen = Exercise.Name;
        _setCount = Exercise.SetCount;
        _warmupSetCount = Exercise.WarmupSetCount;
        _restSeconds = Exercise.RestIntervalSeconds;
        _defaultReps = Exercise.DefaultReps;
        _defaultWeightKg = Exercise.DefaultWeightKg;
        _bodyweightPercent = Exercise.BodyweightPercent;
        _logType = Exercise.LogType;
        _supersetGroupId = Exercise.SupersetGroupId ?? "";
        var historyNames = await HistoryRepository.GetExerciseNamesAsync(100);
        _exerciseNames = [.. ExerciseCatalog.MergeSuggestionNames(historyNames)];
    }

    private Task<IEnumerable<string>> SearchExerciseNamesAsync(string? text, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(text))
            return Task.FromResult<IEnumerable<string>>(_exerciseNames);

        var query = text.Trim();
        return Task.FromResult<IEnumerable<string>>(
            _exerciseNames.Where(n => n.Contains(query, StringComparison.OrdinalIgnoreCase)));
    }

    /// <summary>
    /// When the typed name matches a catalog entry and differs from the name
    /// the exercise had when the sheet opened, pre-fill the entry's logging
    /// type, bodyweight share, and default metrics.
    /// </summary>
    private Task OnNameChanged(string? name)
    {
        _name = name ?? "";
        if (!string.IsNullOrWhiteSpace(_name)
            && !string.Equals(_name.Trim(), _nameAtOpen, StringComparison.OrdinalIgnoreCase)
            && ExerciseCatalog.Find(_name.Trim()) is { } entry)
        {
            _logType = entry.LogType;
            _bodyweightPercent = entry.BodyweightPercent;
            if (entry.DefaultReps.HasValue)
                _defaultReps = entry.DefaultReps;
            if (entry.DefaultWeightKg.HasValue)
                _defaultWeightKg = entry.DefaultWeightKg;
            StateHasChanged();
        }

        return AutoSaveAsync();
    }

    private void Cancel() => MudDialog.Cancel();

    private ExercisePlan BuildSnapshot() => new()
    {
        Id = Exercise.Id,
        Name = _name.Trim(),
        SetCount = Math.Max(1, (int)Math.Round(_setCount ?? 1)),
        WarmupSetCount = Math.Clamp((int)Math.Round(_warmupSetCount ?? 0), 0, 20),
        SupersetGroupId = string.IsNullOrWhiteSpace(_supersetGroupId) ? null : _supersetGroupId,
        RestIntervalSeconds = Math.Max(0, (int)Math.Round(_restSeconds ?? 0)),
        Order = Exercise.Order,
        DefaultReps = _defaultReps.HasValue ? (int)Math.Round(_defaultReps.Value) : null,
        DefaultWeightKg = _logType == ExerciseLogType.Duration ? null : _defaultWeightKg,
        BodyweightPercent = _logType == ExerciseLogType.BodyweightReps ? _bodyweightPercent : null,
        LogType = _logType
    };

    private Task AutoSaveAsync() => OnAutoSave.InvokeAsync(BuildSnapshot());

    private void Confirm()
    {
        if (ConfirmDisabled)
            return;

        MudDialog.Close(DialogResult.Ok(BuildSnapshot()));
    }

    private async Task OnLogTypeChanged(ExerciseLogType type)
    {
        // Add a small delay to allow event propagation to finish
        // and popovers to close before structural changes occur.
        await Task.Delay(50);
        _logType = type;
        StateHasChanged();
        await AutoSaveAsync();
    }

    private async Task OnExerciseNameFocus()
    {
        try
        {
            await JS.InvokeVoidAsync("physiquinator.scrollSelectorIntoView", "#exercise-sheet-name-input");
        }
        catch (Exception)
        {
            // JS interop might not be ready or fail during initialization/disposal.
        }
    }
}
