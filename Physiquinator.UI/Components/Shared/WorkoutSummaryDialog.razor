@* Post-workout recap: session stats plus any personal records set this session. *@
@inject IStringLocalizer<UiText> Loc

<MudDialog>
    <TitleContent>
        <div class="d-flex align-items-center gap-3">
            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Primary" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.h6" Class="fw-bold">@Loc["Workout complete!"]</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@PlanName</MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Class="py-2">
            <div class="workout-summary-stats">
                <div class="workout-summary-stat">
                    <span class="workout-summary-stat__value">@DurationLabel</span>
                    <span class="workout-summary-stat__label">@Loc["Duration"]</span>
                </div>
                @if (!string.IsNullOrEmpty(VolumeLabel))
                {
                    <div class="workout-summary-stat">
                        <span class="workout-summary-stat__value">@VolumeLabel</span>
                        <span class="workout-summary-stat__label">@Loc["Volume"]</span>
                    </div>
                }
                <div class="workout-summary-stat">
                    <span class="workout-summary-stat__value">@SetsLogged</span>
                    <span class="workout-summary-stat__label">@Loc["Sets logged"]</span>
                </div>
            </div>

            @if (PersonalRecords.Any())
            {
                <div>
                    <MudText Typo="Typo.overline" Class="mud-text-secondary">@Loc["New personal records"]</MudText>
                    <MudStack Spacing="1" Class="mt-2">
                        @foreach (var pr in PersonalRecords)
                        {
                            <div class="workout-summary-pr">
                                <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Small" />
                                <MudText Typo="Typo.body2">
                                    <strong>@pr.ExerciseName</strong>
                                    <span class="mud-text-secondary"> — @pr.Message</span>
                                </MudText>
                            </div>
                        }
                    </MudStack>
                </div>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @Loc["No personal records this time. Keep pushing — they are shown here whenever you beat your best."]
                </MudText>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Class="py-2"
                   OnClick="Close">
            @Loc["Back to home"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public string PlanName { get; set; } = "Workout";

    [Parameter]
    public string DurationLabel { get; set; } = "0 min";

    [Parameter]
    public string VolumeLabel { get; set; } = "";

    [Parameter]
    public int SetsLogged { get; set; }

    [Parameter]
    public IReadOnlyList<WorkoutSummaryPr> PersonalRecords { get; set; } = [];

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private void Close() => MudDialog.Close();
}
