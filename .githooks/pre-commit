#!/bin/sh
# Pre-commit hook to format staged C# and Razor files and run unit tests.

staged=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cs|razor|xaml)$' || true)
if [ -z "$staged" ]; then
    exit 0
fi

echo "Running code format checks..."
fail=0
for proj in \
    Physiquinator.Core/Physiquinator.Core.csproj \
    Physiquinator.UI/Physiquinator.UI.csproj \
    Physiquinator.Web/Physiquinator.Web.csproj \
    Physiquinator.Tests/Physiquinator.Tests.csproj; do
    if ! dotnet format "$proj" --verify-no-changes --severity warn; then
        echo "Format check failed for $proj. Run: dotnet format $proj"
        fail=1
    fi
done

if [ $fail -ne 0 ]; then
    echo "Formatting errors found. Please format code before committing."
    exit 1
fi

echo "Running unit tests..."
if ! dotnet test Physiquinator.Tests/Physiquinator.Tests.csproj --no-restore; then
    echo "Unit tests failed. Resolve failing tests before committing."
    exit 1
fi

exit 0
