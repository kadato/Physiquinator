@inject IStringLocalizer<UiText> Loc

<MudDialog>
    <TitleContent>
        <div class="d-flex align-items-center gap-3">
            <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h5" Class="fw-bold">@Loc["Welcome to Physiquinator!"]</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Class="py-2">
            <MudText Typo="Typo.body1" Class="mud-text-secondary">
                @Loc["To help you get started right away, we have seeded a"] <strong>Demo User</strong> @Loc["profile with sample workout plans (Push, Pull, Legs) and 1 year of mock workout history."]
            </MudText>

            <MudPaper Class="pa-4 onboarding-tip" Elevation="0">
                <MudStack Spacing="2">
                    <div class="d-flex align-items-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.GroupAdd" Color="Color.Primary" Size="Size.Medium" />
                        <MudText Typo="Typo.subtitle1" Class="fw-semibold">@Loc["Multi-user profiles"]</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @Loc["You can create your own clean profile in"] <strong>@Loc["Settings"]</strong>. @Loc["Each profile operates in its own isolated database with separate plans, progress, and history."]
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-4 onboarding-tip onboarding-tip--warning" Elevation="0">
                <MudStack Spacing="2">
                    <div class="d-flex align-items-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.DeleteForever" Color="Color.Warning" Size="Size.Medium" />
                        <MudText Typo="Typo.subtitle1" Class="fw-semibold">@Loc["Removing demo data"]</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @Loc["When you are ready to start fresh, simply go to"] <strong>@Loc["Settings"]</strong>, @Loc["switch to your new profile, and delete the"] <strong>Demo User</strong>.
                    </MudText>
                </MudStack>
            </MudPaper>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close" FullWidth="true" Class="py-2 mt-2">
            @Loc["Get started"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private void Close() => MudDialog.Close();
}
