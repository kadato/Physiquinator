<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net11.0-android;net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>

        <!-- Note for MacCatalyst:
            The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
            When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
            The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
            either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

        <OutputType>Exe</OutputType>
        <RootNamespace>Physiquinator</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <EnableDefaultCssItems>true</EnableDefaultCssItems>
        <!-- MAUI Debug AppX only ships wwwroot files; ensure scoped CSS bundle is generated and copied -->
        <GenerateScopedCssFiles>true</GenerateScopedCssFiles>
        <BundleScopedCssFiles>true</BundleScopedCssFiles>

        <!-- Display name -->
        <ApplicationTitle>Physiquinator</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>dev.karoly.physiquinator</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.1.0</ApplicationDisplayVersion>
        <ApplicationVersion>7</ApplicationVersion>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">14.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>

        <!-- Bundle Windows App SDK runtime with app so it runs without system-wide install -->
        <WindowsAppSDKSelfContained Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</WindowsAppSDKSelfContained>

        <!-- CS1591: XML doc comments are not required for an application project -->
        <NoWarn>$(NoWarn);CS1591;XA0141</NoWarn>
    </PropertyGroup>

    <!-- Debug Configuration: Optimize for fast deployment -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <!-- Android optimizations for faster wireless debugging -->
        <AndroidUseSharedRuntime>true</AndroidUseSharedRuntime>
        <AndroidLinkMode>None</AndroidLinkMode>
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

        <!-- iOS optimizations -->
        <MtouchLink>None</MtouchLink>
        <MtouchDebug>true</MtouchDebug>
        <MtouchFastDev>true</MtouchFastDev>

        <!-- General debug optimizations -->
        <DebugType>portable</DebugType>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>

    <!-- Release Configuration: Optimize for performance -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <!-- Android release optimizations -->
        <AndroidLinkMode>None</AndroidLinkMode>
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
        <RunAOTCompilation Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</RunAOTCompilation>
        <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
        <AndroidPackageFormat>aab</AndroidPackageFormat>

        <!-- Additional Android optimizations -->
        <AndroidEnableSGenConcurrent>true</AndroidEnableSGenConcurrent>
        <AndroidDexTool>d8</AndroidDexTool>
        <AndroidEnableMultiDex>true</AndroidEnableMultiDex>

        <!-- .NET 11 preview SDK workarounds (dotnet/android#11025): R8 9.1.31 crashes on R2R
             inputs and on pre-desugared androidx 1.17 classes -->
        <PublishReadyToRun Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</PublishReadyToRun>
        <AndroidEnableDesugar Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</AndroidEnableDesugar>

        <!-- iOS release optimizations -->
        <MtouchLink>SdkOnly</MtouchLink>
        <MtouchEnableSGenConc>true</MtouchEnableSGenConc>
        <EnableLLVM Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">true</EnableLLVM>

        <!-- General release optimizations -->
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <Optimize>true</Optimize>

        <!-- .NET 11 performance features -->
        <EventSourceSupport>false</EventSourceSupport>
        <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
        <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
        <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#d5d6db" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#d5d6db" BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
      <AndroidResource Remove="docs\screenshots\**" />
      <Compile Remove="docs\screenshots\**" />
      <Content Remove="docs\screenshots\**" />
      <Compile Remove="Physiquinator.Core\**" />
      <Content Remove="Physiquinator.Core\**" />
      <None Remove="Physiquinator.Core\**" />
      <EmbeddedResource Remove="Physiquinator.Core\**" />
      <Compile Remove="Physiquinator.Tests\**" />
      <Content Remove="Physiquinator.Tests\**" />
      <None Remove="Physiquinator.Tests\**" />
      <EmbeddedResource Remove="docs\screenshots\**" />
      <MauiXaml Remove="docs\screenshots\**" />
      <None Remove="docs\screenshots\**" />
      <Compile Remove="artifacts\**" />
      <Content Remove="artifacts\**" />
      <None Remove="artifacts\**" />
      <EmbeddedResource Remove="artifacts\**" />
      <MauiXaml Remove="artifacts\**" />
      <AndroidResource Remove="artifacts\**" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="Physiquinator.Core\Physiquinator.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
        <PackageReference Include="MudBlazor" />
        <PackageReference Include="Plugin.LocalNotification" />
    </ItemGroup>

    <ItemGroup>
      <None Include=".github\workflows\ci.yml" />
      <None Include=".github\workflows\release.yml" />
      <None Include="Physiquinator.Tests\Physiquinator.Tests.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include=".vscode\" />
      <Folder Include="scripts\" />
    </ItemGroup>

    <!-- Debug skips scoped CSS bundling on Windows; copy bundle when present (Release fallback) -->
    <Target Name="CopyScopedCssBundleToWwwRoot" AfterTargets="Build">
        <PropertyGroup>
            <_ScopedCssBundle>$(IntermediateOutputPath)scopedcss\bundle\$(AssemblyName).styles.css</_ScopedCssBundle>
            <_ScopedCssBundleRelease>$(MSBuildProjectDirectory)\obj\Release\net11.0-windows10.0.19041.0\win-x64\scopedcss\bundle\$(AssemblyName).styles.css</_ScopedCssBundleRelease>
            <_ScopedCssSource>$(_ScopedCssBundle)</_ScopedCssSource>
            <_ScopedCssSource Condition="!Exists('$(_ScopedCssBundle)') and Exists('$(_ScopedCssBundleRelease)')">$(_ScopedCssBundleRelease)</_ScopedCssSource>
        </PropertyGroup>
        <Copy SourceFiles="$(_ScopedCssSource)"
              DestinationFiles="$(MSBuildProjectDirectory)\wwwroot\$(AssemblyName).styles.css"
              Condition="Exists('$(_ScopedCssSource)')"
              SkipUnchangedFiles="false" />
    </Target>

    <!-- Workaround for MAUI WinUI 3 packaging bug where generated splash screen assets are not copied to the AppX package layout -->
    <Target Name="CopyMauiSplashScreensToAppX" AfterTargets="Build">
        <ItemGroup>
            <SplashFiles Include="$(IntermediateOutputPath)resizetizer\sp\splashSplashScreen.scale-*.png" />
        </ItemGroup>
        <Copy SourceFiles="@(SplashFiles)"
              DestinationFolder="$(TargetDir)AppX\"
              SkipUnchangedFiles="false" />
    </Target>

</Project>
