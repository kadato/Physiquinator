<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net11.0-android;net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('linux'))">net11.0-android</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>

        <!-- Note for MacCatalyst:
            The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
            When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
            The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
            either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

        <OutputType>Exe</OutputType>
        <RootNamespace>Physiquinator</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <EnableDefaultCssItems>true</EnableDefaultCssItems>
        <!-- MAUI Debug AppX only ships wwwroot files; ensure scoped CSS bundle is generated and copied -->
        <GenerateScopedCssFiles>true</GenerateScopedCssFiles>
        <BundleScopedCssFiles>true</BundleScopedCssFiles>

        <!-- Display name -->
        <ApplicationTitle>Physiquinator</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>dev.karoly.physiquinator</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.25.1</ApplicationDisplayVersion>
        <ApplicationVersion>12501</ApplicationVersion>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">14.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>

        <!-- Bundle Windows App SDK runtime with app so it runs without system-wide install -->
        <WindowsAppSDKSelfContained Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</WindowsAppSDKSelfContained>

        <!-- CS1591: XML doc comments are not required for an application project -->
        <NoWarn>$(NoWarn);CS1591;XA0141</NoWarn>
        <DefaultItemExcludes>$(DefaultItemExcludes);Physiquinator.Core\**;Physiquinator.UI\**;Physiquinator.Tests\**;Physiquinator.Web\**;Physiquinator.Wasm\**;artifacts\**;tools\**</DefaultItemExcludes>
    </PropertyGroup>

    <!-- Debug Configuration: Optimize for fast deployment -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <!-- Unpackaged Windows debug: plain `dotnet build -t:Run` / `dotnet run`
             must copy wwwroot (index.html) to the output root. With the default
             packaged (MSIX) layout the BlazorWebView cannot find its host page
             and shows the "https://0.0.0.1/ ERR_ADDRESS_UNREACHABLE" page.
             Release and CI pass their own WindowsPackageType explicitly. -->
        <WindowsPackageType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</WindowsPackageType>

        <!-- Android optimizations for faster wireless debugging -->
        <AndroidUseSharedRuntime>true</AndroidUseSharedRuntime>
        <AndroidLinkMode>None</AndroidLinkMode>
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

        <!-- iOS optimizations -->
        <MtouchLink>None</MtouchLink>
        <MtouchDebug>true</MtouchDebug>
        <MtouchFastDev>true</MtouchFastDev>

        <!-- General debug optimizations -->
        <DebugType>portable</DebugType>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>

    <!-- Release Configuration: Optimize for performance -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <!-- Android release optimizations -->
        <AndroidLinkMode>None</AndroidLinkMode>
        <!-- Profiled AOT is harmless with RunAOTCompilation=false below;
             re-enabled so it takes effect if full AOT is switched on later. -->
        <AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
        <RunAOTCompilation Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</RunAOTCompilation>
        <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
        <AndroidPackageFormat>aab</AndroidPackageFormat>

        <!-- Additional Android optimizations -->
        <AndroidEnableSGenConcurrent>true</AndroidEnableSGenConcurrent>
        <!-- D8 handles multidex output natively. Do NOT set AndroidEnableMultiDex=true:
             it forces R8 as the dexer, and R8 9.1.31 either crashes on desugaring
             pre-desugared androidx 1.17 classes or, with desugaring disabled, emits
             dex 037 containing invoke-dynamic instructions that fail on-device at
             process start ("Instruction is unrepresentable in DEX V37"). -->
        <AndroidDexTool>d8</AndroidDexTool>

        <!-- .NET 11 preview SDK workaround (dotnet/android#11025): R2R produces
             mixed-mode assemblies that Mono.Cecil cannot write on Android.
             Re-enable once the upstream issue is fixed. -->
        <PublishReadyToRun Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</PublishReadyToRun>

        <!-- iOS release optimizations -->
        <MtouchLink>SdkOnly</MtouchLink>
        <MtouchEnableSGenConc>true</MtouchEnableSGenConc>
        <EnableLLVM Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">true</EnableLLVM>

        <!-- General release optimizations -->
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <Optimize>true</Optimize>

        <!-- .NET 11 performance features -->
        <EventSourceSupport>false</EventSourceSupport>
        <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
        <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
        <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon - 06 Square Bald Big: volt #FAFF00 plate, #10111A ink figure, #414770 10px violet-grey shadow -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FAFF00" />

        <!-- Splash Screen - void background with volt plate centered: matches app shell void + yellow plate -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0E0F17" BaseSize="168,168" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="Physiquinator.Core\**" />
      <Content Remove="Physiquinator.Core\**" />
      <None Remove="Physiquinator.Core\**" />
      <EmbeddedResource Remove="Physiquinator.Core\**" />
      <Compile Remove="Physiquinator.Tests\**" />
      <Content Remove="Physiquinator.Tests\**" />
      <None Remove="Physiquinator.Tests\**" />
      <EmbeddedResource Remove="Physiquinator.Tests\**" />
      <Compile Remove="Physiquinator.UI\**" />
      <Content Remove="Physiquinator.UI\**" />
      <None Remove="Physiquinator.UI\**" />
      <EmbeddedResource Remove="Physiquinator.UI\**" />
      <Compile Remove="Physiquinator.Web\**" />
      <Content Remove="Physiquinator.Web\**" />
      <None Remove="Physiquinator.Web\**" />
      <EmbeddedResource Remove="Physiquinator.Web\**" />
      <Compile Remove="Physiquinator.Wasm\**" />
      <Content Remove="Physiquinator.Wasm\**" />
      <None Remove="Physiquinator.Wasm\**" />
      <EmbeddedResource Remove="Physiquinator.Wasm\**" />
      <Compile Remove="artifacts\**" />
      <Content Remove="artifacts\**" />
      <None Remove="artifacts\**" />
      <EmbeddedResource Remove="artifacts\**" />
      <MauiXaml Remove="artifacts\**" />
      <AndroidResource Remove="artifacts\**" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="Physiquinator.Core\Physiquinator.Core.csproj" />
        <ProjectReference Include="Physiquinator.UI\Physiquinator.UI.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
        <PackageReference Include="MudBlazor" />
        <PackageReference Include="Plugin.LocalNotification" />
    </ItemGroup>

    <!-- Workaround for MAUI WinUI 3 packaging bug where generated splash screen assets are not copied to the AppX package layout -->
    <Target Name="CopyMauiSplashScreensToAppX" BeforeTargets="GetAppxPackageFiles;GenerateAppxPackageFileMap;AssignTargetPaths" AfterTargets="ResizetizeImages;Build">
        <ItemGroup>
            <SplashFiles Include="$(IntermediateOutputPath)resizetizer\sp\splashSplashScreen*.png" />
            <FallbackSplashFiles Include="$(IntermediateOutputPath)resizetizer\r\appiconStoreLogo.scale-*.png" />
        </ItemGroup>

        <!-- Copy sp splash files if generated by resizetizer -->
        <Copy SourceFiles="@(SplashFiles)"
              DestinationFolder="$(TargetDir)AppX\"
              SkipUnchangedFiles="false"
              Condition="Exists('%(SplashFiles.Identity)')" />

        <!-- Fallback if resizetizer did not output to sp folder for WinUI -->
        <Copy SourceFiles="$(IntermediateOutputPath)resizetizer\r\appiconStoreLogo.scale-100.png"
              DestinationFiles="$(TargetDir)AppX\splashSplashScreen.png"
              SkipUnchangedFiles="false"
              Condition="!Exists('$(TargetDir)AppX\splashSplashScreen.png') And Exists('$(IntermediateOutputPath)resizetizer\r\appiconStoreLogo.scale-100.png')" />

        <Copy SourceFiles="$(IntermediateOutputPath)resizetizer\r\appiconStoreLogo.scale-100.png"
              DestinationFiles="$(TargetDir)AppX\splashSplashScreen.scale-100.png"
              SkipUnchangedFiles="false"
              Condition="!Exists('$(TargetDir)AppX\splashSplashScreen.scale-100.png') And Exists('$(IntermediateOutputPath)resizetizer\r\appiconStoreLogo.scale-100.png')" />

        <Copy SourceFiles="$(TargetDir)AppX\splashSplashScreen.png"
              DestinationFiles="$(TargetDir)splashSplashScreen.png"
              SkipUnchangedFiles="false"
              Condition="Exists('$(TargetDir)AppX\splashSplashScreen.png')" />
    </Target>

    <!-- MAUI packages the referenced Razor class library's scoped CSS bundle under
         a content-hashed file name (Physiquinator.UI.{hash}.bundle.scp.css), but the
         BlazorWebView shell references the un-hashed name in index.html. Ship a copy
         under the expected name so component-scoped styles actually load in the app. -->
    <Target Name="CopyScopedCssBundleForWebView"
            BeforeTargets="GetAppxPackageFiles;GenerateAppxPackageFileMap;AssignTargetPaths"
            AfterTargets="Build">
        <ItemGroup>
            <_ScopedBundleSource Include="$(MSBuildProjectDirectory)\Physiquinator.UI\obj\$(Configuration)\net11.0\scopedcss\projectbundle\Physiquinator.UI.bundle.scp.css" />
        </ItemGroup>

        <Copy SourceFiles="@(_ScopedBundleSource)"
              DestinationFolder="$(TargetDir)AppX\wwwroot\_content\Physiquinator.UI"
              SkipUnchangedFiles="false"
              Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and Exists('$(TargetDir)AppX')" />

        <Copy SourceFiles="@(_ScopedBundleSource)"
              DestinationFolder="$(IntermediateOutputPath)assets\wwwroot\_content\Physiquinator.UI"
              SkipUnchangedFiles="false"
              Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
    </Target>



</Project>

