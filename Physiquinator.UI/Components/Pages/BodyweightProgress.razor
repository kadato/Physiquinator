@page "/history/bodyweight"
@using System.Globalization
@using System.Linq
@using MudBlazor.Charts
@using Physiquinator.UI.Services
@inject WorkoutHistoryRepository HistoryRepo
@inject IDialogService DialogService
@inject UiFeedbackService UiFeedback
@inject WeightUnitService WeightUnitService

<PageTitle>@("Bodyweight")</PageTitle>

<PageHeader Title="@("Bodyweight")" ShowBackButton="true" />

@if (!_ready)
{
    <DetailSkeleton />
}
else if (_allEntries.Count == 0)
{
    <EmptyState Message="@("No bodyweight logged yet. Use the quick log on the history page to record your weight.")"
                Icon="@Icons.Material.Outlined.MonitorWeight" />
}
else
{
    <MudStack Spacing="3">
        <div class="bodyweight-range-row">
            <MudSelect T="BodyweightTimeRange"
                       Label="@("Time range")"
                       Variant="Variant.Outlined"
                       Dense="true"
                       Margin="Margin.Dense"
                       AnchorOrigin="Origin.BottomRight"
                       TransformOrigin="Origin.TopRight"
                       Class="bodyweight-range-row__select"
                       Value="_range"
                       ValueChanged="OnRangeChanged">
                @foreach (var range in Enum.GetValues<BodyweightTimeRange>().Reverse())
                {
                    <MudSelectItem Value="@range">@RangeLabel(range)</MudSelectItem>
                }
            </MudSelect>
        </div>

        @if (_entries.Count == 0)
        {
            <EmptyState Message="@("No entries logged in the selected time range.")"
                        Icon="@Icons.Material.Outlined.DateRange" />
        }
        else
        {
            <div class="history-stats">
                <StatCard Value="@FormatWeightWithUnit(_entries[0].BodyweightKg)" Label="@("Latest")" />
                <StatCard Value="@TrendLabel" Label="@("Change")" />
                <StatCard Value="@_entries.Count.ToString()" Label="@("Entries")" />
            </div>

            @if (_hasChartData)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @($"Showing {_entries.Count} entries")
                </MudText>
            }

            <ProgressChartShell Title="@("Bodyweight")"
                                HasData="_hasChartData"
                                EmptyMessage="@("Log your weight to see the chart.")"
                                Class="pa-3 exercise-progress-chart bodyweight-chart-panel">
                <div class="bodyweight-chart">
                    <MudChart T="double"
                              ChartType="ChartType.Line"
                              ChartSeries="@_chartSeries"
                              ChartLabels="@_chartLabels"
                              ChartOptions="@_chartOptions"
                              Width="100%"
                              Height="@_chartHeightPx" />
                </div>
            </ProgressChartShell>

            <MudPaper Class="premium-table bodyweight-table" Elevation="0">
                <div class="infinite-table-list">
                    <div class="infinite-table-head infinite-table-head--3">
                        <span>@("Date")</span>
                        <span>@(string.Format("Weight ({0})", ExerciseWeightFormatter.UnitSuffix(WeightUnitService.Current)))</span>
                        <span class="infinite-table-head__action" />
                    </div>
                    @foreach (var entry in _entries.Take(_loadedListCount))
                    {
                        var item = entry;
                        <div @key="item.DateOnly" class="infinite-table-row infinite-table-row--3">
                            <span>@UiDateFormats.DateOnlyCompact(item.DateOnly)</span>
                            <span>@FormatWeight(item.BodyweightKg)</span>
                            <span class="infinite-table-row__action">
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                         Class="bodyweight-table__menu"
                                         Dense="true"
                                         AriaLabel="@(string.Format("Actions for entry {0}", UiDateFormats.DateOnlyCompact(item.DateOnly)))">
                                    <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                                 OnClick="@(() => EditEntryAsync(item))">Edit entry</MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Outlined.DeleteOutline"
                                                 IconColor="Color.Error"
                                                 OnClick="@(() => DeleteEntryAsync(item))">Delete entry</MudMenuItem>
                                </MudMenu>
                            </span>
                        </div>
                    }
                </div>
                <InfiniteScrollSentinel IsLoadingMore="_isLoadingMore"
                                        HasMoreItems="_hasMoreListItems"
                                        SentinelId="@LoadMoreSentinelId"
                                        OnLoadMore="OnLoadMoreVisible" />
            </MudPaper>
        }
    </MudStack>
}

@code {
    private enum BodyweightTimeRange
    {
        OneMonth,
        ThreeMonths,
        SixMonths,
        OneYear,
        AllTime
    }

    private const int EntryLimit = 1000;
    private const int MaxChartAxisLabels = 6;
    private const int MaxYAxisTicks = 4;
    private const int ListPageSize = 50;
    private const string LoadMoreSentinelId = "bodyweight-load-more-sentinel";

    /// <summary>Show per-entry dots only for sparse series. Dense series render as a clean line.</summary>
    private const int MaxChartMarkerEntries = 12;

    private bool _ready;
    private IReadOnlyList<BodyweightEntry> _allEntries = Array.Empty<BodyweightEntry>();
    private IReadOnlyList<BodyweightEntry> _entries = Array.Empty<BodyweightEntry>();
    private int _loadedListCount;
    private bool _hasMoreListItems;
    private bool _isLoadingMore;
    private BodyweightTimeRange _range = BodyweightTimeRange.AllTime;
    private string[] _chartLabels = Array.Empty<string>();
    private ChartSeriesList _chartSeries = [];
    private LineChartOptions _chartOptions = new();
    private string _chartHeightPx = "200px";
    private bool _hasChartData;

    private string TrendLabel
    {
        get
        {
            if (_entries.Count < 2) return "-";
            var diff = _entries[0].BodyweightKg - _entries[^1].BodyweightKg;
            var formatted = ExerciseWeightFormatter.FormatWeight(Math.Abs(diff), WeightUnitService.Current);
            var unit = ExerciseWeightFormatter.UnitSuffix(WeightUnitService.Current);
            if (diff == 0) return $"{formatted} {unit}";
            var sign = diff > 0 ? "+" : "-";
            return $"{sign}{formatted} {unit}";
        }
    }

    private string FormatWeightWithUnit(double kg) =>
        ExerciseWeightFormatter.FormatWeightWithUnit(kg, WeightUnitService.Current);

    private string FormatWeight(double kg) =>
        ExerciseWeightFormatter.FormatWeight(kg, WeightUnitService.Current);


    private async Task OnRangeChanged(BodyweightTimeRange range)
    {
        _range = range;
        ApplyRangeAndRebuild();
    }

    /// <summary>Reveals the next chunk of entries for the lazy list (no pagination UI).</summary>
    private void ResetListPaging()
    {
        _loadedListCount = Math.Min(ListPageSize, _entries.Count);
        _hasMoreListItems = _loadedListCount < _entries.Count;
    }

    public Task<bool> OnLoadMoreVisible()
    {
        if (_isLoadingMore || !_hasMoreListItems || _entries.Count == 0)
            return Task.FromResult(false);

        _isLoadingMore = true;
        _loadedListCount = Math.Min(_loadedListCount + ListPageSize, _entries.Count);
        _hasMoreListItems = _loadedListCount < _entries.Count;
        _isLoadingMore = false;
        StateHasChanged();
        return Task.FromResult(_hasMoreListItems);
    }

    private static int RangeDays(BodyweightTimeRange range) => range switch
    {
        BodyweightTimeRange.OneMonth => 30,
        BodyweightTimeRange.ThreeMonths => 90,
        BodyweightTimeRange.SixMonths => 180,
        BodyweightTimeRange.OneYear => 365,
        _ => int.MaxValue
    };

    private static string RangeLabel(BodyweightTimeRange range) => range switch
    {
        BodyweightTimeRange.OneMonth => "Last month",
        BodyweightTimeRange.ThreeMonths => "Last 3 months",
        BodyweightTimeRange.SixMonths => "Last 6 months",
        BodyweightTimeRange.OneYear => "Last year",
        _ => "All time"
    };

    protected override async Task OnInitializedAsync()
    {
        _allEntries = await LoadEntriesAsync();
        ApplyRangeAndRebuild();
        _ready = true;
    }

    private async Task<BodyweightEntry[]> LoadEntriesAsync()
    {
        var rows = await HistoryRepo.GetBodyweightLogsAsync(EntryLimit);
        var entries = new List<BodyweightEntry>(rows.Count);
        foreach (var row in rows)
        {
            if (row.GetDateOnlyOrNull() is { } date)
                entries.Add(new BodyweightEntry(date, row.BodyweightKg));
        }
        return entries.ToArray();
    }

    private void ApplyRangeAndRebuild()
    {
        _entries = ApplyRange(_allEntries);
        BuildChartData();
        ResetListPaging();
    }

    private IReadOnlyList<BodyweightEntry> ApplyRange(IReadOnlyList<BodyweightEntry> entries)
    {
        if (_range == BodyweightTimeRange.AllTime)
            return entries;

        var cutoff = DateOnly.FromDateTime(DateTime.Today).AddDays(-RangeDays(_range));
        return entries.Where(e => e.DateOnly >= cutoff).ToArray();
    }

    private void BuildChartData()
    {
        _hasChartData = _entries.Count >= 2;
        if (!_hasChartData)
        {
            _chartLabels = Array.Empty<string>();
            _chartSeries = [];
            return;
        }

        var chronological = _entries.AsEnumerable().Reverse().ToList();
        _chartLabels = SparseChartLabelBuilder.BuildLabels(
            chronological.Select(e => e.DateOnly).ToList(),
            UiDateFormats.DateOnlyCompact,
            MaxChartAxisLabels);
        var values = chronological
            .Select(e => Math.Round(ExerciseWeightFormatter.ToDisplay(e.BodyweightKg, WeightUnitService.Current), 1, MidpointRounding.AwayFromZero))
            .ToArray();

        var minValue = values.Min();
        var maxValue = values.Max();
        var range = maxValue - minValue;

        // Tight max for high base with small range on mobile.
        ChartAxisScale.Scale axisScale;
        if (range > 0 && range / Math.Max(1, maxValue) < 0.35)
        {
            var target = maxValue * 1.06;
            var wide = ChartAxisScale.SuggestYAxis(target);
            var tightMax = minValue + range * 1.6 + 1.5;
            var tight = ChartAxisScale.SuggestYAxis(tightMax);
            axisScale = wide.Max > tightMax * 1.25 ? tight : wide;
        }
        else
        {
            axisScale = ChartAxisScale.SuggestYAxis(maxValue);
        }

        _ = ChartAxisScale.SuggestYAxisMin(minValue);

        var series = new ChartSeriesList
        {
            new ChartSeries<double>
            {
                Name = "Bodyweight",
                Data = values
            }
        };

        if (chronological.Count >= 10)
        {
            var movingAvg = new double[values.Length];
            for (var i = 0; i < values.Length; i++)
            {
                var start = Math.Max(0, i - 6);
                var window = i - start + 1;
                var sum = 0.0;
                for (var j = start; j <= i; j++)
                {
                    sum += values[j];
                }

                movingAvg[i] = Math.Round(sum / window, 1, MidpointRounding.AwayFromZero);
            }

            series.Add(new ChartSeries<double>
            {
                Name = "7-day avg",
                Data = movingAvg
            });
        }

        _chartSeries = series;

        var rotateXLabels = chronological.Count > 4;
        if (chronological.Count <= 2)
            _chartHeightPx = "180px";
        else if (rotateXLabels)
            _chartHeightPx = "240px";
        else
            _chartHeightPx = "200px";
        _chartOptions = new LineChartOptions
        {
            YAxisRequireZeroPoint = false,
            ShowDataMarkers = chronological.Count <= MaxChartMarkerEntries,
            MaxNumYAxisTicks = MaxYAxisTicks,
            YAxisTicks = SuggestYAxisUnits(minValue, maxValue, MaxYAxisTicks),
            YAxisToStringFunc = value => value.ToString("0.#", CultureInfo.InvariantCulture),
            YAxisSuggestedMax = axisScale.Max,
            XAxisLabelRotation = rotateXLabels ? -35 : 0
        };
    }

    /// <summary>
    /// Smallest "nice" integer grid step that keeps the number of Y-axis lines at or
    /// below <paramref name="maxLines"/>. MudBlazor's default 20-unit grid wastes most
    /// of the vertical space for bodyweight values, so the step is derived from the
    /// data range to keep the axis hugging the plotted values.
    /// </summary>
    private static readonly int[] NiceYAxisUnits = [1, 2, 5, 10, 20, 50, 100];

    private static int SuggestYAxisUnits(double minValue, double maxValue, int maxLines)
    {
        var range = maxValue - minValue;
        if (range <= 0)
            return 1;

        return NiceYAxisUnits.FirstOrDefault(unit => range / unit <= maxLines, NiceYAxisUnits[^1]);
    }

    private async Task EditEntryAsync(BodyweightEntry entry)
    {
        var parameters = new DialogParameters<BodyweightEditDialog>
        {
            { x => x.DateLabel, UiDateFormats.DateOnlyCompact(entry.DateOnly) },
            { x => x.UnitSuffix, ExerciseWeightFormatter.UnitSuffix(WeightUnitService.Current) },
            { x => x.CurrentValue, ExerciseWeightFormatter.ToDisplay(entry.BodyweightKg, WeightUnitService.Current) },
        };
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
        };

        var dialog = await DialogService.ShowAsync<BodyweightEditDialog>("Edit entry", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is double displayWeight)
        {
            var kg = ExerciseWeightFormatter.ToKg(displayWeight, WeightUnitService.Current);
            await UiFeedback.TryExecuteAsync(
                async () =>
                {
                    await HistoryRepo.UpsertBodyweightLogAsync(entry.DateOnly, kg);
                    _allEntries = await LoadEntriesAsync();
                    ApplyRangeAndRebuild();
                },
                "Entry updated.",
                "Could not update entry");
        }
    }

    private async Task DeleteEntryAsync(BodyweightEntry entry)
    {
        var confirmed = await DialogService.ConfirmAsync(
            "Delete entry",
            string.Format("Delete the {0} bodyweight entry ({1})? You can undo this for a short time after.",
                UiDateFormats.DateOnlyCompact(entry.DateOnly), FormatWeightWithUnit(entry.BodyweightKg)),
            confirmText: "Delete",
            confirmColor: Color.Error);

        if (!confirmed) return;

        try
        {
            await HistoryRepo.DeleteBodyweightLogAsync(entry.DateOnly);
        }
        catch (Exception ex)
        {
            UiFeedback.Error("Could not delete entry", ex);
            return;
        }

        _allEntries = await LoadEntriesAsync();
        ApplyRangeAndRebuild();
        UiFeedback.SuccessWithUndo("Entry deleted.", () => RestoreEntryAsync(entry));
    }

    private async Task RestoreEntryAsync(BodyweightEntry entry) =>
        await UiFeedback.TryExecuteAsync(
            async () =>
            {
                await HistoryRepo.UpsertBodyweightLogAsync(entry.DateOnly, entry.BodyweightKg);
                _allEntries = await LoadEntriesAsync();
                ApplyRangeAndRebuild();
            },
            "Entry restored.",
            "Could not restore entry");

}
