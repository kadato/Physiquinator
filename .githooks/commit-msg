#!/bin/sh
# Commit message hook to check for standard commit prefixes.
# Allowed prefixes: feat:, fix:, perf:, refactor:, style:, docs:, test:, chore:, build:, ci:, revert:

commit_msg_file="$1"
commit_msg=$(head -n 1 "$commit_msg_file")

# Allow merge commits and initial commits
if echo "$commit_msg" | grep -qE '^(Merge|Initial)'; then
    exit 0
fi

# Check for conventional commit format
if ! echo "$commit_msg" | grep -qE '^(feat|fix|perf|refactor|style|docs|test|chore|build|ci|revert)(\([a-zA-Z0-9_-]+\))?: .+'; then
    echo "ERROR: Invalid commit message format."
    echo "Commit message must start with a prefix like feat:, fix:, perf:, refactor:, style:, docs:, test:, chore:, build:, ci:, or revert:."
    echo "Example: feat: add workout plan export feature"
    exit 1
fi

exit 0
