@page "/workout/{PlanId:guid}"
@using Microsoft.Extensions.Logging
@using System.Globalization
@inject WorkoutPlanService PlanService
@inject WorkoutSessionService SessionService
@inject RestAlertSettingsService RestAlertSettings
@inject INotificationService RestNotifications
@inject RestTimerCoordinator RestTimer
@inject WorkoutHistoryRepository HistoryRepository
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject UserProfileService UserProfileService
@inject WorkoutTimerInterop TimerInterop
@inject ISnackbar Snackbar
@inject ILogger<Workout> Logger
@inject TimeProvider TimeProvider
@inject WeightUnitService WeightUnitService
@inject WorkoutStatsService StatsService
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>@(SessionService.CurrentPlan?.Name ?? "Workout")</PageTitle>

@if (_isLoading)
{
    <WorkoutSkeleton />
}
else if (SessionService.CurrentPlan == null)
{
    <EmptyState Message="@("No active workout. Start a plan from home.")"
                Icon="@Icons.Material.Outlined.Warning">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/">@("Go home")</MudButton>
    </EmptyState>
}
else
{
    <div class="workout-brutal">
        <!-- PLAN PLATE HEADER — brutal, machined, volt edge -->
        <div class="workout-brutal__header">
            <div class="workout-brutal__title-wrap">
                <span class="workout-brutal__kicker">ACTIVE SEQUENCE</span>
                <h1 class="workout-brutal__title">@SessionService.CurrentPlan.Name</h1>
            </div>
        </div>

        @if (_overlayPermissionMissing)
        {
            <div class="workout-brutal__alert">
                <span class="workout-brutal__alert-dot" aria-hidden="true"></span>
                <span class="workout-brutal__alert-text">Enable “Display over other apps” for floating rest timer</span>
                <button type="button" class="workout-brutal__alert-btn" @onclick="OpenOverlaySettingsAsync">GRANT</button>
            </div>
        }

        <div class="workout-hud">
            <div class="workout-hud__stats">
                <div class="workout-hud__stat">
                    <span class="workout-hud__label">ELAPSED</span>
                    <span class="workout-hud__value">@ElapsedLabel</span>
                </div>
                <div class="workout-hud__stat workout-hud__stat--sets">
                    <span class="workout-hud__label">LOGGED</span>
                    <span class="workout-hud__value">@TotalCompletedSets / @TotalSetsCount</span>
                </div>
            </div>
            <div class="workout-hud__bar-wrap">
                <div class="workout-hud__bar-head">
                    <span class="workout-hud__bar-label">PROGRESS</span>
                    <span class="workout-hud__bar-pct">@OverallProgressPct%</span>
                </div>
                <div class="workout-hud__bar">
                    <div class="workout-hud__fill" style="width: @(OverallProgressPct)%"></div>
                    <div class="workout-hud__bar-grid" aria-hidden="true"></div>
                </div>
            </div>
        </div>

        <!-- FOCUS DECK — only one thing at a time. BRUTAL. -->
        <div class="workout-deck">
            @if (SessionService.IsResting || _isRestComplete)
            {
                <div class="workout-rest-takeover">
                    <div class="workout-rest-card">
                        <div class="workout-rest-takeover__head">
                            <span class="workout-rest-takeover__kicker">
                                <span class="workout-rest-takeover__dot" aria-hidden="true"></span>
                                REST INTERVAL
                            </span>
                        </div>
                        <RestTimerPanel @ref="_restPanel"
                                        IsRestComplete="_isRestComplete"
                                        AddRestSeconds="@RestAlertSettings.AddTimeSeconds"
                                        OnReset="ResetRest"
                                        OnSkip="SkipRestFromPanel"
                                        OnAddTime="AddRestTime" />
                    </div>
                    <div class="workout-rest-takeover__next">
                        <span class="workout-rest-takeover__next-kicker">UP NEXT</span>
                        <span class="workout-rest-takeover__next-name">@NextExerciseName</span>
                        @if (!string.IsNullOrEmpty(NextSetPreview))
                        {
                            <span class="workout-rest-takeover__next-preview">@NextSetPreview</span>
                        }
                    </div>
                </div>
            }
            else if (FocusedExercise != null)
            {
                <div class="workout-focus" data-exercise-index="@_activeExerciseIndex">
                    <div class="workout-focus__head">
                        <div class="workout-focus__head-left">
                            <span class="workout-focus__index">/@((_activeExerciseIndex + 1).ToString("D2"))</span>
                            @if (!string.IsNullOrEmpty(FocusedExercise.SupersetGroupId))
                            {
                                <span class="workout-focus__superset">S@FocusedExercise.SupersetGroupId</span>
                            }
                            <span class="workout-focus__pill @(FocusedCompletedSets == FocusedTotalSets ? "workout-focus__pill--done" : "")">
                                @FocusedCompletedSets/@FocusedTotalSets
                            </span>
                        </div>
                        <div class="workout-focus__head-right">
                            <div class="workout-focus__menu" @onclick:stopPropagation="true">
                                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
                                    <ActivatorContent>
                                        <button type="button" class="workout-focus__menu-btn" aria-label="@(string.Format("Actions for {0}", FocusedExercise.Name))" @onclick="@context.ToggleAsync">
                                            <span class="workout-focus__menu-dots"><i></i><i></i><i></i></span>
                                        </button>
                                    </ActivatorContent>
                                    <ChildContent>
                                        @if (CanMoveUp)
                                        {
                                            <MudMenuItem Icon="@Icons.Material.Filled.ArrowUpward" OnClick="() => MoveExerciseAsync(_activeExerciseIndex, _activeExerciseIndex - 1)">Move up</MudMenuItem>
                                        }
                                        @if (CanMoveDown)
                                        {
                                            <MudMenuItem Icon="@Icons.Material.Filled.ArrowDownward" OnClick="() => MoveExerciseAsync(_activeExerciseIndex, _activeExerciseIndex + 1)">Move down</MudMenuItem>
                                        }
                                        <MudMenuItem Icon="@Icons.Material.Filled.SkipNext" OnClick="() => SkipExerciseAsync((_activeExerciseIndex, FocusedExercise.Name))">Skip exercise</MudMenuItem>
                                    </ChildContent>
                                </MudMenu>
                            </div>
                        </div>
                    </div>

                    <h2 class="workout-focus__name">@FocusedExercise.Name</h2>

                    <div class="workout-focus__set-head">
                        @if (IsFocusedWarmup)
                        {
                            <span class="workout-focus__warmup">WARM-UP @(FocusedActiveSetIndex + 1)</span>
                        }
                        else
                        {
                            <span class="workout-focus__set-label">SET @(FocusedActiveSetIndex + 1)</span>
                        }
                    </div>

                    <div class="workout-focus__controls">
                        <span class="workout-focus__bumper" aria-hidden="true"></span>
                        <div class="workout-focus__steppers">
                            @if (FocusedExercise.LogType != ExerciseLogType.Duration)
                            {
                                <div class="workout-focus__stepper">
                                    <span class="workout-focus__stepper-label">WEIGHT</span>
                                    <SetMetricStepper Value="@ToDisplayWeight(FocusedInputs.Weight)"
                                                      ValueChanged="@(val => HandleWeightStepperChanged((_activeExerciseIndex, FocusedActiveSetIndex, ToKgWeight(val))))"
                                                      Step="@WeightStep"
                                                      Min="@WeightMin"
                                                      IsInteger="false"
                                                      Format="0.##"
                                                      Compact="true"
                                                      Unit='@(FocusedExercise.LogType == ExerciseLogType.BodyweightReps && (FocusedInputs.Weight == 0 || !FocusedInputs.Weight.HasValue) ? "" : UnitSuffix)'
                                                      CustomDisplayText="@(FocusedExercise.LogType == ExerciseLogType.BodyweightReps ? GetBodyweightStepperDisplayText(FocusedInputs.Weight) : null)"
                                                      Placeholder="@ToDisplayWeight(FocusedDefaultWeight)" />
                                </div>
                            }
                            <div class="workout-focus__stepper">
                                <span class="workout-focus__stepper-label">@(FocusedExercise.LogType == ExerciseLogType.Duration ? "DURATION" : "REPS")</span>
                                <SetMetricStepper Value="@((double?)FocusedInputs.Reps)"
                                                  ValueChanged="@(val => HandleRepsStepperChanged((_activeExerciseIndex, FocusedActiveSetIndex, val.HasValue ? (int)Math.Round(val.Value) : (int?)null)))"
                                                  Step="1"
                                                  Min="1"
                                                  IsInteger="true"
                                                  Format="0"
                                                  Compact="true"
                                                  Unit='@(FocusedExercise.LogType == ExerciseLogType.Duration ? "s" : "reps")'
                                                  Placeholder="@((double)FocusedDefaultReps)" />
                            </div>
                        </div>
                        <button type="button"
                                class="workout-focus__log"
                                @onclick="@(() => ToggleSetComplete((_activeExerciseIndex, FocusedActiveSetIndex)))"
                                disabled="@_isCompleting"
                                aria-label="@(string.Format("Log set {0} for {1}", FocusedActiveSetIndex + 1, FocusedExercise.Name))">
                            <MudIcon Icon="@Icons.Material.Filled.Bolt" Class="workout-focus__log-icon" />
                        </button>
                    </div>

                    @if (NextExerciseInfo.Exercise != null)
                    {
                        <div class="workout-next">
                            <span class="workout-next__kicker">NEXT</span>
                            <span class="workout-next__name">@NextExerciseInfo.Exercise.Name</span>
                            <span class="workout-next__preview">@NextExerciseInfo.Preview</span>
                        </div>
                    }

                    @{ var loggedRows = GetLoggedRowsForFocused(); }
                    @if (loggedRows.Any())
                    {
                        <details class="workout-focus__history">
                            <summary class="workout-focus__history-summary">
                                <span class="workout-focus__history-label">Logged @loggedRows.Count / @FocusedTotalSets</span>
                                <span class="workout-focus__history-chevron"><MudIcon Icon="@Icons.Material.Filled.ExpandMore" /></span>
                            </summary>
                            <div class="workout-focus__history-list">
                            @foreach (var row in loggedRows)
                            {
                                var isWarmupRow = row.SetIndex < FocusedExercise.WarmupSetCount;
                                <div class="workout-focus__history-row @(isWarmupRow ? "workout-focus__history-row--warmup" : "")">
                                    <span class="workout-focus__history-set">
                                        @if (isWarmupRow)
                                        {
                                            <span class="workout-focus__history-warmup">W@(row.SetIndex + 1)</span>
                                        }
                                        else
                                        {
                                            <span>S@(row.SetIndex + 1)</span>
                                        }
                                    </span>
                                    <div class="workout-focus__history-steppers">
                                        @if (FocusedExercise.LogType != ExerciseLogType.Duration)
                                        {
                                            <SetMetricStepper Value="@ToDisplayWeight(row.WeightKg)"
                                                              ValueChanged="@(val => HandleSetWeightChanged((_activeExerciseIndex, row.SetIndex, ToKgWeight(val))))"
                                                              Step="@WeightStep"
                                                              Min="@WeightMin"
                                                              IsInteger="false"
                                                              Format="0.##"
                                                              Compact="true"
                                                              Unit='@(FocusedExercise.LogType == ExerciseLogType.BodyweightReps && (row.WeightKg == 0 || !row.WeightKg.HasValue) ? "" : UnitSuffix)'
                                                              CustomDisplayText="@(FocusedExercise.LogType == ExerciseLogType.BodyweightReps ? GetBodyweightStepperDisplayText(row.WeightKg) : null)"
                                                              Placeholder="@ToDisplayWeight(row.WeightKg)" />
                                        }
                                        <SetMetricStepper Value="@((double?)row.Reps)"
                                                          ValueChanged="@(val => HandleSetRepsChanged((_activeExerciseIndex, row.SetIndex, val.HasValue ? (int)Math.Round(val.Value) : (int?)null)))"
                                                          Step="1"
                                                          Min="1"
                                                          IsInteger="true"
                                                          Format="0"
                                                          Compact="true"
                                                          Unit='@(FocusedExercise.LogType == ExerciseLogType.Duration ? "s" : "reps")'
                                                          Placeholder="@((double?)row.Reps)" />
                                    </div>
                                </div>
                            }
                            </div>
                        </details>
                    }
                </div>
            }
            else if (!UpcomingExercises.Any() && DoneExercises.Any())
            {
                <div class="workout-done">
                    <span class="workout-done__plate">ALL SETS CAPTURED</span>
                    <h2 class="workout-done__title">SEQUENCE COMPLETE</h2>
                    <p class="workout-done__sub">Every set logged. Hit END to seal the session.</p>
                </div>
            }
        </div>

        <!-- TRANSPORT — brutal thumb bar, prev/next between exercises -->
        @if (!SessionService.IsResting && !_isRestComplete && UpcomingExercises.Count > 1)
        {
            <div class="workout-transport">
                <button type="button"
                        class="workout-transport__btn workout-transport__btn--prev"
                        disabled="@(FocusedPosition == 0)"
                        @onclick="FocusPrev"
                        aria-label="Previous exercise">
                    <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" />
                </button>
                <div class="workout-transport__center">
                    <span class="workout-transport__pos">@(FocusedPosition + 1) / @(UpcomingExercises.Count)</span>
                </div>
                <button type="button"
                        class="workout-transport__btn workout-transport__btn--next"
                        disabled="@(FocusedPosition >= UpcomingExercises.Count - 1)"
                        @onclick="FocusNext"
                        aria-label="Next exercise">
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />
                </button>
            </div>
        }

        @if (UpcomingExercises.Count > 1)
        {
            <div class="workout-sequence-strip" role="navigation" aria-label="Exercise sequence">
                @foreach (var item in UpcomingExercises)
                {
                    var exerciseIndex = item.ExerciseIndex;
                    var isActive = exerciseIndex == _activeExerciseIndex;
                    <button type="button"
                            class="workout-sequence-strip__item @(isActive ? "workout-sequence-strip__item--active" : "")"
                            aria-label="@($"Go to {item.Exercise.Name}, exercise {(exerciseIndex + 1):D2}")"
                            aria-current="@(isActive ? "true" : null)"
                            @onclick="() => FocusExercise(exerciseIndex)">
                        <span class="workout-sequence-strip__num">@((item.ExerciseIndex + 1).ToString("D2"))</span>
                        <span class="workout-sequence-strip__pips">
                            @for (int si = 0; si < item.TotalSets; si++)
                            {
                                var done = SessionService.IsSetCompleted(item.ExerciseIndex, si);
                                <span class="workout-sequence-strip__pip @(done ? "workout-sequence-strip__pip--done" : "") @(si == _activeSetIndices.GetValueOrDefault(item.ExerciseIndex, 0) && isActive ? "workout-sequence-strip__pip--active" : "")"></span>
                            }
                        </span>
                    </button>
                }
            </div>
        }

        @if (DoneExercises.Any())
        {
            <details class="workout-completed-rail">
                <summary class="workout-completed-rail__summary">
                    <span class="workout-completed-rail__summary-left">
                        <span class="workout-completed-rail__check">✓</span>
                        Completed @DoneExercises.Count / @ExerciseCount
                    </span>
                    <span class="workout-completed-rail__summary-right">
                        <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Class="workout-completed-rail__icon" />
                    </span>
                </summary>
                <div class="workout-completed-rail__list">
                    @foreach (var item in DoneExercises)
                    {
                        <button type="button" class="workout-completed-rail__item" @onclick="() => FocusExercise(item.ExerciseIndex)">
                            <span class="workout-completed-rail__item-num">@((item.ExerciseIndex + 1).ToString("D2"))</span>
                            <span class="workout-completed-rail__item-name">@item.Exercise.Name</span>
                            <span class="workout-completed-rail__item-meta">@item.CompletedSets/@item.TotalSets</span>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="workout-completed-rail__item-chevron" />
                        </button>
                    }
                </div>
            </details>
        }

        <div class="workout-actions">
            <button type="button" class="workout-actions__btn workout-actions__btn--discard" @onclick="DiscardWorkoutClick">
                <MudIcon Icon="@Icons.Material.Filled.Delete" />
                DISCARD
            </button>
            <button type="button" class="workout-actions__btn workout-actions__btn--end" @onclick="EndWorkoutClick">
                <MudIcon Icon="@Icons.Material.Filled.Check" />
                END WORKOUT
            </button>
        </div>
    </div>
}

@if (_undoVisible)
{
    <MudIconButton Class="app-fab app-fab--secondary app-fab--bl-1 workout-undo-fab"
                   Icon="@Icons.Material.Filled.Restore"
                   OnClick="UndoLastSetCoreAsync"
                   aria-label="@("Undo last set")" />
}

@code {
    [Parameter]
    public Guid PlanId { get; set; }

    [SupplyParameterFromQuery(Name = "forceNew")]
    public bool ForceNew { get; set; }

    private const int DefaultReps = 10;
    private const int RestTickIntervalMs = 1000;
    private const int UndoToastDurationMs = 8000;

    private bool _isRestComplete;
    private bool _overlayPermissionMissing;
    private int _lastRestDurationSeconds;
    private Guid? _loadedPlanId;
    private bool _loadedForceNew;
    private bool _isCompleting;
    private bool _disposed;
    private bool _isLoading = true;
    private DotNetObjectReference<Workout>? _dotNetRef;
    private RestTimerPanel? _restPanel;
    private string? _historySessionId;
    private double? _bodyweightKg;
    private bool _undoVisible;
    private System.Threading.Timer? _undoTimer;
    private DateTime _sessionStartedAtUtc;
    private System.Threading.Timer? _elapsedTimer;

    private sealed class SetInputsDictionary : Dictionary<(int, int), (double? Weight, int? Reps)> { }

    private readonly SetInputsDictionary _setInputs = new();
    private readonly Dictionary<(int, int), (double? Weight, int? Reps)> _sessionSets = new();
    private readonly HashSet<(int, int)> _skippedSets = [];
    private int _activeExerciseIndex;
    private readonly Dictionary<int, int> _activeSetIndices = new();
    private int? _restNextExerciseOverride;

    private string ElapsedLabel
    {
        get
        {
            var elapsedMinutes = (TimeProvider.GetUtcNow().UtcDateTime - _sessionStartedAtUtc).TotalMinutes;
            var mins = (int)Math.Max(0, elapsedMinutes);
            return mins < 60 ? string.Format("{0} MIN", mins) : string.Format("{0}H {1}M", mins / 60, mins % 60);
        }
    }

    private string? SessionVolumeLabel
    {
        get
        {
            var kg = ComputeSessionVolumeKg();
            if (kg is not { } v || v <= 0) return null;
            return ExerciseWeightFormatter.FormatVolumeWithUnit(v, WeightUnitService.Current);
        }
    }

    private double? ComputeSessionVolumeKg()
    {
        var plan = SessionService.CurrentPlan;
        if (plan == null || _sessionSets.Count == 0) return null;

        double total = 0;
        var any = false;
        foreach (var (key, value) in _sessionSets)
        {
            var (exerciseIndex, _) = key;
            if (exerciseIndex < 0 || exerciseIndex >= plan.Exercises.Count) continue;
            var exercise = plan.Exercises[exerciseIndex];
            if (exercise.LogType == ExerciseLogType.Duration) continue;
            total += PersonalRecordCalculator.ComputeVolume(value.Reps, value.Weight, exercise.LogType, _bodyweightKg, exercise.BodyweightPercent);
            any = true;
        }

        return any ? total : null;
    }

    private sealed record ExerciseProgress(ExercisePlan Exercise, int ExerciseIndex, int CompletedSets, int TotalSets);

    private List<ExerciseProgress> _doneExercises = [];
    private List<ExerciseProgress> _upcomingExercises = [];
    private IReadOnlyList<ExerciseProgress> DoneExercises => _doneExercises;
    private IReadOnlyList<ExerciseProgress> UpcomingExercises => _upcomingExercises;

    // ---- Brutal focus helpers ----
    private ExercisePlan? FocusedExercise => _activeExerciseIndex >= 0 && SessionService.CurrentPlan != null && _activeExerciseIndex < SessionService.CurrentPlan.Exercises.Count ? SessionService.CurrentPlan.Exercises[_activeExerciseIndex] : null;
    private int FocusedTotalSets => FocusedExercise?.TotalSetCount ?? 0;
    private int FocusedActiveSetIndex => _activeSetIndices.GetValueOrDefault(_activeExerciseIndex, 0);
    private (double? Weight, int? Reps) FocusedInputs => _setInputs.GetValueOrDefault((_activeExerciseIndex, FocusedActiveSetIndex), (FocusedExercise?.DefaultWeightKg ?? 0.0, FocusedExercise?.DefaultReps ?? DefaultReps));
    private double FocusedDefaultWeight => FocusedInputs.Weight ?? FocusedExercise?.DefaultWeightKg ?? 0.0;
    private int FocusedDefaultReps => FocusedInputs.Reps ?? FocusedExercise?.DefaultReps ?? DefaultReps;
    private bool IsFocusedWarmup => FocusedExercise != null && FocusedActiveSetIndex < FocusedExercise.WarmupSetCount;
    private int FocusedCompletedSets
    {
        get
        {
            if (FocusedExercise == null) return 0;
            int c = 0;
            for (int si = 0; si < FocusedExercise.TotalSetCount; si++)
                if (SessionService.IsSetCompleted(_activeExerciseIndex, si)) c++;
            return c;
        }
    }
    private int TotalSetsCount => SessionService.CurrentPlan?.Exercises.Sum(e => e.TotalSetCount) ?? 0;
    private int TotalCompletedSets
    {
        get
        {
            var plan = SessionService.CurrentPlan;
            if (plan == null) return 0;
            int c = 0;
            for (int ei = 0; ei < plan.Exercises.Count; ei++)
                for (int si = 0; si < plan.Exercises[ei].TotalSetCount; si++)
                    if (SessionService.IsSetCompleted(ei, si)) c++;
            return c;
        }
    }
    private int OverallProgressPct => TotalSetsCount == 0 ? 0 : (int)Math.Round(TotalCompletedSets * 100.0 / TotalSetsCount);
    private int ExerciseCount => SessionService.CurrentPlan?.Exercises.Count ?? 0;
    private int FocusedPosition
    {
        get
        {
            var idx = UpcomingExercises.ToList().FindIndex(u => u.ExerciseIndex == _activeExerciseIndex);
            return idx < 0 ? 0 : idx;
        }
    }
    private bool CanMoveUp => _activeExerciseIndex > 0;
    private bool CanMoveDown => SessionService.CurrentPlan != null && _activeExerciseIndex < SessionService.CurrentPlan.Exercises.Count - 1;

    private (ExercisePlan? Exercise, int ExerciseIndex, string Preview) NextExerciseInfo
    {
        get
        {
            if (FocusedExercise == null) return (null, -1, "");
            var pos = FocusedPosition;
            if (pos < 0 || pos >= UpcomingExercises.Count - 1) return (null, -1, "");
            var next = UpcomingExercises[pos + 1];
            var ex = next.Exercise;
            var setIdx = _activeSetIndices.GetValueOrDefault(next.ExerciseIndex, 0);
            var inputs = _setInputs.GetValueOrDefault((next.ExerciseIndex, setIdx), (ex.DefaultWeightKg ?? 0, ex.DefaultReps ?? DefaultReps));
            return (ex, next.ExerciseIndex, FormatLogPreview(ex, inputs));
        }
    }

    private List<(int SetIndex, double? WeightKg, int? Reps)> GetLoggedRowsForFocused()
    {
        var rows = new List<(int, double?, int?)>();
        if (FocusedExercise == null) return rows;
        foreach (var (key, value) in _sessionSets)
            if (key.Item1 == _activeExerciseIndex)
                rows.Add((key.Item2, value.Weight, value.Reps));
        return rows.OrderBy(r => r.Item1).ToList();
    }

    private string NextExerciseName
    {
        get
        {
            var (ex, _) = NextPendingSet;
            return ex?.Name ?? "--";
        }
    }
    private string NextSetPreview
    {
        get
        {
            var (ex, si) = NextPendingSet;
            if (ex == null || si < 0) return "";
            var exIdx = SessionService.CurrentPlan!.Exercises.IndexOf(ex);
            var inputs = _setInputs.GetValueOrDefault((exIdx, si), (ex.DefaultWeightKg ?? 0, ex.DefaultReps ?? DefaultReps));
            return FormatLogPreview(ex, inputs);
        }
    }
    private (ExercisePlan? Exercise, int SetIndex) NextPendingSet
    {
        get
        {
            var plan = SessionService.CurrentPlan;
            if (plan == null) return (null, -1);
            if ((SessionService.IsResting || _isRestComplete) && _restNextExerciseOverride.HasValue)
            {
                var ov = _restNextExerciseOverride.Value;
                if (ov >= 0 && ov < plan.Exercises.Count && !SessionService.IsExerciseDone(ov))
                {
                    var ovSetIdx = SessionService.GetFirstUncompletedSetIndex(ov);
                    if (ovSetIdx != -1)
                        return (plan.Exercises[ov], ovSetIdx);
                }
            }
            var nextExIdx = SessionService.GetFirstUncompletedExerciseIndex();
            if (nextExIdx == -1) return (null, -1);
            var setIdx = SessionService.GetFirstUncompletedSetIndex(nextExIdx);
            return (plan.Exercises[nextExIdx], setIdx);
        }
    }
    private string FormatLogPreview(ExercisePlan ex, (double? Weight, int? Reps) inputs)
    {
        if (ex.LogType == ExerciseLogType.Duration)
            return $"{inputs.Reps ?? DefaultReps}s";
        var w = ToDisplayWeight(inputs.Weight);
        var r = inputs.Reps ?? DefaultReps;
        var unit = WeightUnitService.Current == WeightUnit.Pounds ? "LB" : "KG";
        if (ex.LogType == ExerciseLogType.BodyweightReps)
        {
            var bw = GetBodyweightStepperDisplayText(inputs.Weight);
            return $"{bw} × {r}";
        }
        return $"{(w?.ToString("0.##", CultureInfo.InvariantCulture) ?? "0")} {unit} × {r}";
    }

    private WeightUnit Unit => WeightUnitService.Current;
    private string UnitSuffix => ExerciseWeightFormatter.UnitSuffix(Unit);
    private double WeightStep => Unit == WeightUnit.Pounds ? 5 : 2.5;
    private double WeightMin => FocusedExercise?.LogType == ExerciseLogType.BodyweightReps ? ExerciseWeightFormatter.ToDisplay(-200, Unit) : 0;
    private double? ToDisplayWeight(double? kg) => kg.HasValue ? ExerciseWeightFormatter.ToDisplay(kg.Value, Unit) : null;
    private double? ToKgWeight(double? display) => display.HasValue ? ExerciseWeightFormatter.ToKg(display.Value, Unit) : null;
    private string? GetBodyweightStepperDisplayText(double? value)
    {
        if (value == null || value.Value == 0) return "BW";
        var sign = value.Value > 0 ? "+" : "-";
        return $"{sign}{ExerciseWeightFormatter.FormatWeight(Math.Abs(value.Value), Unit)}";
    }

    private void FocusPrev()
    {
        if (UpcomingExercises.Count <= 1) return;
        var idx = UpcomingExercises.ToList().FindIndex(u => u.ExerciseIndex == _activeExerciseIndex);
        if (idx > 0)
        {
            _activeExerciseIndex = UpcomingExercises[idx - 1].ExerciseIndex;
            if (SessionService.IsResting || _isRestComplete)
                _restNextExerciseOverride = _activeExerciseIndex;
        }
    }

    private void FocusNext()
    {
        if (UpcomingExercises.Count <= 1) return;
        var idx = UpcomingExercises.ToList().FindIndex(u => u.ExerciseIndex == _activeExerciseIndex);
        if (idx >= 0 && idx < UpcomingExercises.Count - 1)
        {
            _activeExerciseIndex = UpcomingExercises[idx + 1].ExerciseIndex;
            if (SessionService.IsResting || _isRestComplete)
                _restNextExerciseOverride = _activeExerciseIndex;
        }
    }

    private void FocusExercise(int exIdx)
    {
        if (SessionService.CurrentPlan == null) return;
        if (exIdx < 0 || exIdx >= SessionService.CurrentPlan.Exercises.Count) return;
        _activeExerciseIndex = exIdx;
        if (SessionService.IsResting || _isRestComplete)
            _restNextExerciseOverride = exIdx;
        StateHasChanged();
    }

