@* Plan Editor FABs *@
@inject IStringLocalizer<UiText> Loc

@* Save — bottom-right primary FAB *@
<MudIconButton Class="@SaveFabClasses"
               Icon="@Icons.Material.Filled.Check"
               Disabled="@SaveDisabled"
               OnClick="OnSave"
               aria-label="@Loc["Save plan"]" />

@if (!IsNew)
{
    @* Export — mini FAB above Save *@
    <MudIconButton Class="app-fab app-fab--secondary app-fab--mini app-fab--br-2"
                   Icon="@Icons.Material.Filled.Upload"
                   OnClick="OnExport"
                   aria-label="@Loc["Export plan"]" />
}

@* Cancel — bottom-left secondary mini FAB *@
    <MudIconButton Class="app-fab app-fab--secondary app-fab--mini app-fab--bl-1"
                   Icon="@Icons.Material.Filled.ArrowBack"
                   OnClick="OnCancel"
                   aria-label="@Loc["Go back"]" />


@code {
    private string SaveFabClasses =>
        $"app-fab app-fab--primary app-fab--br-1{(SaveDisabled ? " app-fab--disabled" : string.Empty)}";

    [Parameter]
    public bool IsNew { get; set; }

    [Parameter]
    public bool SaveDisabled { get; set; }

    [Parameter]
    public EventCallback OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public EventCallback OnExport { get; set; }
}